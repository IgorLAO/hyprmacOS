+
+void Tray::reloadPolicy() {
+  std::ifstream stream(policy_path_);
+  if (!stream) return;
+  stream.seekg(0, std::ios::end);
+  if (stream.tellg() > 65536) { spdlog::warn("SNI preferences exceed 64 KiB"); return; }
+  stream.seekg(0);
+  Json::Value root;
+  Json::CharReaderBuilder builder;
+  std::string error;
+  if (!Json::parseFromStream(builder, stream, &root, &error) || !root["tray"].isObject()) {
+    spdlog::warn("Invalid SNI preferences: {}", error);
+    return;
+  }
+  const auto& policy = root["tray"];
+  for (const auto* name : {"hidden-items", "order-items"}) {
+    if (!policy[name].isNull() && !policy[name].isArray()) return;
+    for (const auto& value : policy[name]) if (!value.isString()) return;
+  }
+  for (const auto* name : {"hidden-items", "order-items"}) policy_[name] = policy[name];
+  for (auto* widget : box_.get_children()) {
+    auto* item = static_cast<Item*>(g_object_get_data(G_OBJECT(widget->gobj()), "hyprmac-sni-item"));
+    if (item) { item->policy = policy_; item->refreshVisibility(); }
+  }
+  reorderItems();
+  dp.emit();
+}
+
