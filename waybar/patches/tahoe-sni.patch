+void Tray::reorderItems() {
+  auto children = box_.get_children();
+  auto rank = [this](Gtk::Widget* w) {
+    auto item = static_cast<Item*>(g_object_get_data(G_OBJECT(w->gobj()), "hyprmac-sni-item"));
+    int i = 0;
+    for (const auto& key : policy_["order-items"]) {
+      if (key.isString() && item && item->matches(key.asString())) return i;
+      ++i;
+    }
+    return i;
+  };
+  std::stable_sort(children.begin(), children.end(), [&](auto a, auto b) { return rank(a) < rank(b); });
+  int position = 0;
+  for (auto w : children) box_.reorder_child(*w, position++);
+}
