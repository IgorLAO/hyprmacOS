   if (config_["reverse-direction"].isBool() && config_["reverse-direction"].asBool()) {
     box_.pack_end(item->event_box);
   } else {
     box_.pack_start(item->event_box);
   }
+  item->changed.connect([this]() { reorderItems(); dp.emit(); });
+  reorderItems();
   dp.emit();
 }
 
