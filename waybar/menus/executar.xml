<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu Run do VS Code (como no Mac: só com o Code em foco). O atalho mostrado é
     a tecla real do Code no Linux, que a ação envia à janela em foco. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child><object class="GtkMenuItem" id="debug"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Start Debugging</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">F5</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="run"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Run Without Debugging</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌃F5</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="stop"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Stop Debugging</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⇧F5</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkSeparatorMenuItem" id="sep1"/></child>
    <child><object class="GtkMenuItem" id="breakpoint"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Toggle Breakpoint</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">F9</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
  </object>
</interface>
