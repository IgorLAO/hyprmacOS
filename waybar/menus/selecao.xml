<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu Selection do VS Code (como no Mac: só com o Code em foco). O atalho mostrado é
     a tecla real do Code no Linux, que a ação envia à janela em foco. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child><object class="GtkMenuItem" id="selectall"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Select All</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌃A</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="expand"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Expand Selection</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⇧⌥→</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="shrink"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Shrink Selection</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⇧⌥←</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkSeparatorMenuItem" id="sep1"/></child>
    <child><object class="GtkMenuItem" id="copyup"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Copy Line Up</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⇧⌥↑</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="copydown"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Copy Line Down</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⇧⌥↓</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="moveup"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Move Line Up</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌥↑</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="movedown"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Move Line Down</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌥↓</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkSeparatorMenuItem" id="sep2"/></child>
    <child><object class="GtkMenuItem" id="cursorup"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Add Cursor Above</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌃⇧↑</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="cursordown"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Add Cursor Below</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌃⇧↓</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
    <child><object class="GtkMenuItem" id="nextocc"><child><object class="GtkBox"><property name="visible">True</property><property name="spacing">24</property>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Add Next Occurrence</property><property name="xalign">0</property></object><packing><property name="expand">True</property></packing></child>
      <child><object class="GtkLabel"><property name="visible">True</property><property name="label">⌃D</property><property name="xalign">1</property><style><class name="shortcut"/></style></object></child>
    </object></child></object></child>
  </object>
</interface>
