MEDIA_STATE = os.path.expanduser("~/.local/state/hyprmac/media.json")
MEDIA_LAYOUTS = ("compact", "large", "side")
MEDIA_ANIM_MS = 420
MEDIA_COVER_R = 30 - 18     # .media-panel: border-radius 30, padding 18


def fmt_time(s):
    s = max(0, int(s))
    return f"{s // 60}:{s % 60:02d}"


def ease_in_out(t):
    return 4 * t * t * t if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2


class MediaPanel:
    """Player no estilo da tela de bloqueio do iPhone. Abre ao clicar no nome da
    música na barra (módulo waybar/cffi/nowplaying). Clicar na capa alterna entre
    três arranjos — compacto → capa grande → capa ao lado — com animação, e o
    último escolhido fica salvo."""

    # alturas fixas de cada bloco
    H_HEAD, H_PROG, H_CTRL, H_VOL, AIR = 52, 34, 50, 24, 28

    def __init__(self):
        self.open = False
        self.player = None             # nome no playerctl (ex.: "spotify")
        self.sink = None               # saída de áudio ativa (nome no pactl)
        self.status = "Stopped"
        self.length = 0.0
        self.position = 0.0
        self.pos_at = time.monotonic()
        self.art_url = None
        self.art_surface = None
        self._art_previous = None
        self._art_mix = 1.0
        self._art_tick = None
        self._polls = []
        self._anim = None
        self.layout = self._load_layout()
        register_panel(self)

        self.catchers = ClickCatchers("hyprmac-media-catcher", self.hide)
        self.win = layer_window("hyprmac-media", LS.Layer.OVERLAY, anchors=(E.TOP, E.RIGHT),
                                margins={E.TOP: 8, E.RIGHT: 10},
                                keyboard=LS.KeyboardMode.ON_DEMAND)
        add_class(self.win, "media")
        self.win.connect("key-press-event",
                         lambda _w, ev: ev.keyval == Gdk.KEY_Escape and self.hide())

        self.fixed = Gtk.Fixed()

        # capa (clique = troca o arranjo)
        self.cover = Gtk.DrawingArea()
        self.cover.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.cover.connect("draw", self._draw_cover)
        self.cover.connect("button-press-event",
                           lambda _w, ev: ev.button == 1 and self._cycle_layout())
        self.cover.connect("realize", lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), "pointer")))

        # origem · título · artista — álbum
        self.head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.head.set_valign(Gtk.Align.CENTER)
        self.source = label("", "np-source")
        self.title = label("Not Playing", "np-title")
        self.artist = label("", "np-artist")
        for lb in (self.source, self.title, self.artist):
            lb.set_ellipsize(3)
            lb.set_size_request(10, -1)
            self.head.pack_start(lb, False, False, 0)

        # saída de áudio (o botão AirPlay das imagens): abre as saídas no pavucontrol
        self.air = Gtk.Button()
        add_class(self.air, "np-air")
        self.air.add(label(I["airplay"], "icon", 0.5))
        self.air.set_tooltip_text("Audio Output")
        self.air.connect("clicked", lambda _b: (self.hide(), open_settings("sound")))

        # minutagem
        self.prog = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.seek = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.001)
        self.seek.set_draw_value(False)
        self.seek.connect("change-value", self._on_seek)
        times = Gtk.Box()
        self.elapsed = label("-:--", "np-time")
        self.remain = label("--:--", "np-time", xalign=1.0)
        times.pack_start(self.elapsed, True, True, 0)
        times.pack_end(self.remain, True, True, 0)
        self.prog.pack_start(self.seek, False, False, 0)
        self.prog.pack_start(times, False, False, 0)

        # anterior · play/pause · próxima
        self.ctrl = Gtk.Box(spacing=0)
        self.ctrl.set_halign(Gtk.Align.FILL)
        inner = Gtk.Box(spacing=26)
        inner.set_halign(Gtk.Align.CENTER)
        inner.set_hexpand(True)
