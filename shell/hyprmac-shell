class Banner(Gtk.Revealer):
    """Um banner no estilo macOS: ícone do app, título, "now", texto e ações."""

    def __init__(self, center, nid, app_icon, image, summary, body, actions, timeout):
        super().__init__(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                         transition_duration=240)
        self.center, self.nid = center, nid
        self.timeout, self.timer, self.started, self.remaining = timeout, None, 0, timeout
        self.created = time.time()
        self.actions = actions

        ev = Gtk.EventBox()
        ev.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK
                      | Gdk.EventMask.BUTTON_PRESS_MASK)
        ev.connect("enter-notify-event", self._enter)
        ev.connect("leave-notify-event", self._leave)
        ev.connect("button-press-event", self._click)

        overlay = Gtk.Overlay()
        card = notif_card()

        self.icon_pb = app_icon or image
        self.thumb_pb = image if (app_icon and image) else None
        self.icon_cache, self.thumb_cache = {}, {}
        card.pack_start(notif_icon(self._draw_icon), False, False, 0)

        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.title = label("", "title")
        self.title.set_ellipsize(3)
        self.title.set_hexpand(True)
        self.when = label("now", "time", xalign=1.0)
        texts.pack_start(self.title, False, False, 0)
        self.body = label("", "body")
        self.body.set_line_wrap(True)
        self.body.set_line_wrap_mode(2)        # Pango.WrapMode.WORD_CHAR
        self.body.set_lines(4)
        self.body.set_ellipsize(3)
        self.body.set_max_width_chars(34)
        texts.pack_start(self.body, False, False, 0)

        self.action_box = Gtk.Box(spacing=6)
        add_class(self.action_box, "actions")
        texts.pack_start(self.action_box, False, False, 0)
        card.pack_start(texts, True, True, 0)
        card.pack_end(notif_side(self.when, self._draw_thumb if self.thumb_pb else None),
                      False, False, 0)

        self.card = card
        self.app = None              # para empilhar banners do mesmo app
        overlay.add(card)
        self.close_btn = Gtk.Button()
        add_class(self.close_btn, "close")
        self.close_btn.add(label("✕", xalign=0.5))
        self.close_btn.set_halign(Gtk.Align.START)
        self.close_btn.set_valign(Gtk.Align.START)
        self.close_btn.connect("clicked", lambda _b: self.center.close(self.nid, CLOSE_DISMISSED))
        overlay.add_overlay(self.close_btn)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        col.pack_start(overlay, False, False, 0)
        # Pilha (NOT-08): cartões de trás aparecem ~7 px embaixo, recuados 16 px
        self.peeks = []
        for k in (1, 2):
            pk = Gtk.Box()
            add_class(pk, "notif-peek", f"notif-peek-{k}")
            pk.set_size_request(-1, 7 if k == 1 else 6)
            pk.set_margin_start(16 * k)
            pk.set_margin_end(16 * k)
            pk.set_no_show_all(True)
            col.pack_start(pk, False, False, 0)
            self.peeks.append(pk)
        ev.add(col)
        self.add(ev)
        self.stack = 1
        self.update(summary, body, actions, timeout)

    def set_stack(self, n):
        """n notificações do mesmo app empilhadas neste banner (o mais novo na frente)."""
        self.stack = n
        set_class(self.card, "stacked", n > 1)
        for k, pk in enumerate(self.peeks, start=1):
            pk.set_visible(n > k)
        set_class(self.peeks[0], "last", n == 2)

    # ── conteúdo ──
    def update(self, summary, body, actions, timeout):
        self.title.set_text(summary or "")
        markup = _safe_markup(body)
        self.body.set_markup(markup)
        self.body.set_visible(bool(body))
        self.body.set_no_show_all(not body)
        for child in self.action_box.get_children():
            child.destroy()
        self.actions = actions
        for key, text in actions:
            if key == "default":
                continue
            b = Gtk.Button()
            b.add(label(text, xalign=0.5))
            b.connect("clicked", lambda _b, k=key: self.center.invoke(self.nid, k))
            self.action_box.pack_start(b, False, False, 0)
        has_buttons = any(k != "default" for k, _ in actions)
        self.action_box.set_no_show_all(not has_buttons)
        self.action_box.set_visible(has_buttons)
        self.timeout = self.remaining = timeout
        self._arm()

    def _draw_icon(self, area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        if self.icon_pb:
            paint_cover(cr, self.icon_pb, w, h, radius=ICON_R, cache=self.icon_cache)
            return
        rounded_rect(cr, 0, 0, w, h, ICON_R)
        cr.set_source_rgb(0.0, 0.569, 1.0)   # #0091FF
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Symbols Nerd Font")
        cr.set_font_size(17)
        glyph = G("f009a")                       # md-bell
        ext = cr.text_extents(glyph)
        cr.move_to((w - ext.width) / 2 - ext.x_bearing, (h - ext.height) / 2 - ext.y_bearing)
        cr.show_text(glyph)

    def _draw_thumb(self, area, cr):
        paint_cover(cr, self.thumb_pb, area.get_allocated_width(), area.get_allocated_height(),
                    radius=THUMB_R, cache=self.thumb_cache)

    # ── tempo ──
    def _arm(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        if self.remaining and self.remaining > 0:
            self.started = time.monotonic()
            self.timer = GLib.timeout_add(self.remaining, self._expire)

    def _expire(self):
        self.timer = None
        self.center.close(self.nid, CLOSE_EXPIRED)
        return False

    def refresh_time(self):
        self.when.set_text(when_text(self.created))   # o mesmo "now"/"2m ago" da Central

    # ── mouse ──
    def _enter(self, _w, ev):
        if ev.detail == Gdk.NotifyType.INFERIOR:
            return
        set_class(self.close_btn, "revealed", True)
        if self.timer:                           # pausa enquanto o mouse está em cima
            GLib.source_remove(self.timer)
            self.timer = None
            self.remaining = max(1500, self.remaining - int((time.monotonic() - self.started) * 1000))

    def _leave(self, _w, ev):
        if ev.detail == Gdk.NotifyType.INFERIOR:
            return
        set_class(self.close_btn, "revealed", False)
        if self.timeout and self.timeout > 0:
            self._arm()

    def _click(self, _w, ev):
        if ev.button != 1:
            self.center.close(self.nid, CLOSE_DISMISSED)
            return True
        if any(k == "default" for k, _ in self.actions):
            self.center.invoke(self.nid, "default")
        else:
            self.center.close(self.nid, CLOSE_DISMISSED)
        return True

    def dismiss(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.set_reveal_child(False)
        GLib.timeout_add(self.get_transition_duration() + 40, lambda: self.destroy() or False)


class NotificationCenter:
    """Servidor org.freedesktop.Notifications com banners no canto superior direito."""

    def __init__(self, monitor):
        self.win = layer_window("hyprmac-notifications", LS.Layer.OVERLAY, monitor,
                                anchors=(E.TOP, E.RIGHT),
                                margins={E.TOP: NOTIF_TOP, E.RIGHT: NOTIF_RIGHT})
        add_class(self.win, "notifications")
        self.stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.win.add(self.stack)
        self.stack.show()
        self.banners = {}
        self.history = []        # central de notificações: mais antigas primeiro
        self._dnd = False        # Não Perturbe: sem banners (só críticas), tudo vai para a central
        self.dnd = False         # apaga o estado deixado por uma sessão anterior
        self.next_id = 1
        self.conn = None
        self._badge = None       # último estado do ponto verde no relógio da barra
        self.listeners = []      # chamados a cada mudança da central (selos do Dock)
        self.iface = Gio.DBusNodeInfo.new_for_xml(NOTIF_XML).interfaces[0]
        self.panel = NotifPanel(self)
        self.sync_badge()        # apaga o estado deixado por uma sessão anterior
        # a waybar pode subir junto e perder o primeiro sinal: avisa de novo
        GLib.timeout_add_seconds(3, lambda: spawn("pkill -RTMIN+9 -x waybar"))
        self.owner = Gio.bus_own_name(
            Gio.BusType.SESSION, NOTIF_IFACE,
            Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
            self._bus_acquired, None, self._name_lost)
        GLib.timeout_add_seconds(30, self._tick)

    # ── D-Bus ──
    def _bus_acquired(self, conn, _name):
        self.conn = conn
        conn.register_object(NOTIF_PATH, self.iface, self._method, None, None)

    def _name_lost(self, _conn, _name):
        print("notificações: outro serviço já é dono de org.freedesktop.Notifications",
              file=sys.stderr)

    def _method(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "Notify":
            invocation.return_value(GLib.Variant("(u)", (self.notify(params),)))
        elif method == "CloseNotification":
            self.close(params.get_child_value(0).get_uint32(), CLOSE_CALL)
            invocation.return_value(None)
        elif method == "GetCapabilities":
            invocation.return_value(GLib.Variant(
                "(as)", (["actions", "body", "body-markup", "icon-static", "persistence"],)))
        elif method == "GetServerInformation":
            invocation.return_value(GLib.Variant("(ssss)", ("hyprmac", "hyprmac", "1.0", "1.2")))

    def _emit(self, signal_name, fmt, values):
        if self.conn:
            self.conn.emit_signal(None, NOTIF_PATH, NOTIF_IFACE, signal_name, GLib.Variant(fmt, values))

    # ── notificações ──
    def notify(self, params):
        app_name = params.get_child_value(0).get_string()
        replaces = params.get_child_value(1).get_uint32()
        app_icon = params.get_child_value(2).get_string()
        summary = params.get_child_value(3).get_string()
        body = params.get_child_value(4).get_string()
        flat = params.get_child_value(5).unpack()
        actions = list(zip(flat[0::2], flat[1::2]))
        hints = _hints(params.get_child_value(6))
        expire = params.get_child_value(7).get_int32()

        image = None
        for key in ("image-data", "image_data", "icon_data"):
            if key in hints:
                try:
                    image = _pixbuf_from_image_data(hints[key])
                except Exception:
                    image = None
                break
        if image is None:
            for key in ("image-path", "image_path"):
                if key in hints:
                    image = _pixbuf_from_icon(hints[key].get_string())
                    break
        desktop = hints["desktop-entry"].get_string() if "desktop-entry" in hints else ""
        icon = (_pixbuf_from_icon(app_icon) or _pixbuf_from_desktop(desktop)
                or _pixbuf_from_desktop(app_name.lower()) or _pixbuf_from_icon(app_name.lower()))

        critical = "urgency" in hints and hints["urgency"].get_byte() == 2
        timeout = 0 if (critical or expire == 0) else (expire if expire > 0 else DEFAULT_TIMEOUT)
        if not summary:
            summary, body = (app_name or "Notification"), body

        entry = {"app": app_name or summary, "desktop": desktop,
                 "icon": icon, "image": image, "summary": summary,
                 "body": body, "actions": actions, "time": time.time()}
        old = next((e for e in self.history if replaces and e["id"] == replaces), None)
        if old:
            old.update(entry)
            self.panel.refresh()
        if replaces and replaces in self.banners:
            self.banners[replaces].update(summary, body, actions, timeout)
            return replaces
        if old:
            return replaces

        nid = self.next_id
        self.next_id += 1
        entry["id"] = nid
        self.history.append(entry)
        del self.history[:-60]
        self.sync_badge()
        if self.panel.open or (self.dnd and not critical):   # direto para a lista
            self.panel.refresh()
            return nid
        banner = Banner(self, nid, icon, image, summary, body, actions, timeout)
        banner.app = entry["app"]
        # mesmo app já com banner na tela: o novo entra na frente e o antigo vira a
        # pilha atrás dele (como no macOS); o antigo continua na central
        anteriores = [b for b in self.banners.values() if b.app == banner.app]
        if anteriores:
            banner.set_stack(1 + sum(b.stack for b in anteriores))
            for b in anteriores:
                b.set_transition_type(Gtk.RevealerTransitionType.NONE)
                self.close(b.nid, CLOSE_EXPIRED)
        self.banners[nid] = banner
        self.stack.pack_start(banner, False, False, 0)
        self.stack.reorder_child(banner, 0)            # o mais novo fica em cima
        banner.show_all()
        if not self.win.get_visible() or anteriores:
            # Janela escondida, ou empilhando sobre um banner do mesmo app (que some
            # no mesmo quadro): o banner já entra aberto — a entrada fica com a
            # animação da camada no Hyprland. Com o revealer animando nesses casos,
            # o layer-shell prendia a altura em 1 px.
            banner.set_transition_type(Gtk.RevealerTransitionType.NONE)
            banner.set_reveal_child(True)
            banner.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
            self.win.show()
        else:
            # só se ainda estiver na tela: um banner do mesmo app pode tê-lo empilhado
            GLib.idle_add(lambda: nid in self.banners and banner.set_reveal_child(True) and False)
        if anteriores:            # a camada precisa crescer para mostrar a pilha
            GLib.idle_add(lambda: self.win.resize(1, 1) or False)
        while len(self.banners) > MAX_BANNERS:
            oldest = min(self.banners)
            self.close(oldest, CLOSE_EXPIRED)
        return nid

    def invoke(self, nid, key):
        self._emit("ActionInvoked", "(us)", (nid, key))
        self.close(nid, CLOSE_DISMISSED)
        self.forget(nid)

    @property
    def dnd(self):
        return self._dnd

    @dnd.setter
    def dnd(self, on):
        # a barra mostra a lua (Foco) enquanto o Não Perturbe está ligado, como no Tahoe
        self._dnd = on
        try:
            if on:
                open(DND_STATE, "w").close()
            elif os.path.exists(DND_STATE):
                os.remove(DND_STATE)
        except OSError:
            pass
        spawn("pkill -RTMIN+10 -x waybar")

    def sync_badge(self):
        """Ponto verde ao lado do relógio enquanto houver notificações na central;
        também avisa quem acompanha a contagem (selos do Dock)."""
        for f in self.listeners:
            f()
        has = bool(self.history)
        if has == self._badge:
            return
        self._badge = has
        try:
            if has:
                open(NOTIF_STATE, "w").close()
            elif os.path.exists(NOTIF_STATE):
                os.remove(NOTIF_STATE)
        except OSError:
            pass
        spawn("pkill -RTMIN+9 -x waybar")

    # ── histórico (central de notificações) ──
    def count_for(self, *names):
        """Quantas notificações na central são de um app (selo do Dock). Casa pelo
        desktop-entry ou pelo nome do app, sem caixa."""
        alvo = {n.lower() for n in names if n}
        alvo |= {n.split(".")[-1] for n in alvo}
        return sum(1 for e in self.history
                   if (e.get("desktop") or "").lower() in alvo or (e.get("app") or "").lower() in alvo)

    def forget(self, nid):
        self.history = [e for e in self.history if e["id"] != nid]
        self.panel.refresh()

    def activate(self, entry):
        """Clique na central: ação padrão do app (se houver) e sai da lista."""
        if any(k == "default" for k, _ in entry["actions"]):
            self._emit("ActionInvoked", "(us)", (entry["id"], "default"))
        self.forget(entry["id"])

    def clear(self, app=None):
        self.history = [e for e in self.history if app is not None and e["app"] != app]
        self.panel.refresh()

    def close(self, nid, reason):
        if reason in (CLOSE_DISMISSED, CLOSE_CALL):   # expiradas ficam na central
            self.history = [e for e in self.history if e["id"] != nid]
            self.panel.refresh()
        banner = self.banners.pop(nid, None)
        if not banner:
            return
        banner.dismiss()
        self._emit("NotificationClosed", "(uu)", (nid, reason))
        if not self.banners:
            GLib.timeout_add(banner.get_transition_duration() + 80,
                             lambda: (not self.banners and self.win.hide()) and False)

    def _tick(self):
        for b in self.banners.values():
            b.refresh_time()
        return True


