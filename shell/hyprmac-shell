        add_class(scale, "xm-scale")
        scale.set_draw_value(False)
        scale.set_value(value)
        scale.connect("change-value", lambda _s, _sc, v: on_change(round(min(max(v, 0), 100))) and False)
        row.pack_start(label(lo, "icon xm-slider-icon", 0.5), False, False, 0)
        row.pack_start(scale, True, True, 0)
        row.pack_start(label(hi, "icon xm-slider-icon", 0.5), False, False, 0)
        self.box.pack_start(row, False, False, 0)
        return scale


class WifiMenu(BarPanel):
    """Menu Wi‑Fi: interruptor, rede atual, redes conhecidas, "Other Networks"
    (abre/fecha) e "Wi‑Fi Settings…". Sem placa Wi‑Fi mostra a(s) Ethernet."""

    def __init__(self, hosted=False):
        super().__init__(hosted)
        self.show_other = False
        self._scanned = 0

    def show(self):
        if self.show_other:
            self.show_other = False
            if self.data is not None:
                self.rebuild()
        super().show()

    def fetch(self):
        wifi_dev, eth = None, []
        for line in run("nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device").splitlines():
            f = nm_fields(line) + ["", "", "", ""]
            dev, typ, state, conn = f[:4]
            if typ == "wifi" and wifi_dev is None:
                wifi_dev = (dev, state, conn)
            elif typ == "ethernet":
                eth.append((dev, state.startswith("connected"), conn))
        radio = run("nmcli radio wifi") == "enabled"
        nets = {}
        profiles = {}
        if wifi_dev and radio:
            if time.monotonic() - self._scanned > 20:     # pede uma busca nova de vez em quando
                self._scanned = time.monotonic()
                spawn("nmcli device wifi rescan")
            for line in run("nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan no").splitlines():
                f = nm_fields(line) + ["", "", "", ""]
                inuse, ssid, sig, sec = f[:4]
                if not ssid:
                    continue
                try:
                    sig = int(sig)
                except ValueError:
                    sig = 0
                old = nets.get(ssid)
                cur = (inuse.strip() == "*") or (old and old[1])
                if not old or sig > old[0] or cur:
                    nets[ssid] = (max(sig, old[0] if old else 0), bool(cur),
                                  bool(sec and sec != "--"))
            uuids = set()
            for line in run("nmcli -t -f UUID,TYPE connection show").splitlines():
                f = nm_fields(line)
                if len(f) >= 2 and f[0] and f[1] == "802-11-wireless":
                    uuids.add(f[0])
            now = time.monotonic()
            if (uuids != getattr(self, "_profile_ids", None) or
                    now - getattr(self, "_profiles_read", 0) >= 20):
                saved = {}
                for uuid in sorted(uuids):
                    # O nome do perfil pode ser renomeado; SSID identifica a
                    # rede e UUID identifica as credenciais a reutilizar.
                    detail = run("nmcli -t -f 802-11-wireless.ssid connection show uuid "
                                 + GLib.shell_quote(uuid))
                    fields = nm_fields(detail)
                    if len(fields) == 2 and fields[0] == "802-11-wireless.ssid":
                        saved.setdefault(fields[1], uuid)
                self._saved_profiles = saved
                self._profile_ids = uuids
                self._profiles_read = now
            # SSID muda raramente: reler a cada scan ou mudança de UUID evita
            # N subprocessos extras em cada polling dos sinais da rede.
            profiles = {ssid: uuid for ssid, uuid in self._saved_profiles.items() if ssid in nets}
        nets = sorted(((ssid, *v, ssid in profiles) for ssid, v in nets.items()),
                      key=lambda n: (-n[2], -n[1]))
        return {"dev": wifi_dev, "radio": radio, "eth": eth, "nets": nets,
                "profiles": profiles}

    @staticmethod
    def _bars(sig):
        return I["wifi4"] if sig >= 75 else I["wifi3"] if sig >= 50 else I["wifi2"] if sig >= 25 else I["wifi1"]

    def signature(self, d):
        # RSSI oscila durante o polling. Preserva ordem, hover e foco enquanto
        # a lista e os estados de conexão/segurança continuam os mesmos.
        networks = sorted((ssid, connected, secure, known)
                          for ssid, _signal, connected, secure, known in d["nets"])
        return repr((d["dev"], d["radio"], d["eth"], networks,
                     sorted(d.get("profiles", {}).items())))

    def update(self, d):
        for ssid, signal, *_ in d["nets"]:
            row = self._network_rows.get(ssid)
            if row is not None:
                row._device_dot.set_text(self._bars(signal))

    def build(self, d):
        if getattr(self, "_other_tick", None) is not None:
            self.box.remove_tick_callback(self._other_tick)
            self._other_tick = None
        self._network_rows = {}
        if d["dev"]:
            self.title_row("Wi‑Fi", d["radio"], self._set_radio)
            if d["radio"]:
                nets = d["nets"]
                cur = [n for n in nets if n[2]]
                known = [n for n in nets if n[4] and not n[2]]
                other = [n for n in nets if not n[4] and not n[2]]
                for ssid, sig, _c, secure, _k in cur:
                    self._network_rows[ssid] = self.device(
                        self._bars(sig), ssid, True, right=I["lock"] if secure else None,
                        right_icon=True, action=None)
                if known:
                    self.head("Known Networks" if len(known) > 1 else "Known Network")
                    for n in known:
                        self._net_row(*n)
                if other:
                    self._other_button = self.disclosure("Other Networks", self.show_other, self._toggle_other)
                    self._other_revealer, group = self.reveal_group(self.show_other)
                    for n in other:
                        self._net_row(*n, container=group)
                if not nets:
                    self.note("Searching for networks…")
        else:
            self.title_row("Wi‑Fi", False, sensitive=False)
            self.note("No Wi‑Fi hardware found")
        if d["eth"]:
            self.sep()
            self.head("Ethernet")
            for dev, up, conn in d["eth"]:
                self.device(I["ethernet"], conn if up and conn else dev, up,
                            sub="Connected" if up else "Not Connected")
        self.sep()
        self.item("Wi‑Fi Settings…" if d["dev"] else "Network Settings…",
                  lambda: open_settings("wifi" if d["dev"] else "network"))

    def _net_row(self, ssid, sig, _cur, secure, known, container=None):
        # conhecida: sobe a conexão salva; nova: o NetworkManager pede a senha ao
        # agente do shell (NMSecretAgent), que mostra a janela de senha
        uuid = self.data.get("profiles", {}).get(ssid) if known else None
        cmd = ("nmcli connection up uuid " + GLib.shell_quote(uuid) if uuid else
               "nmcli device wifi connect " + GLib.shell_quote(ssid))
        self._network_rows[ssid] = self.device(
            self._bars(sig), ssid, False, action=lambda: spawn(cmd),
            right=I["lock"] if secure else None, right_icon=True, container=container)

    def _toggle_other(self):
        self.show_other = not self.show_other
        self._other_button._chevron.set_text(I["chev_d"] if self.show_other else I["chev_r"])
        revealer = self._other_revealer
        revealer.set_transition_duration(0 if reduce_motion() else 240)
        revealer.set_reveal_child(self.show_other)
        # Ajustar também a superfície; deixar a altura anterior mantinha um
        # espaço vazio após recolher. Sem reconstruir switch, foco ou callbacks.
        if getattr(self, "_other_tick", None) is not None:
            self.box.remove_tick_callback(self._other_tick)
        started, last_height = None, None
        def frame(_box, clock):
            nonlocal started, last_height
            now = clock.get_frame_time() / 1e6
            if started is None:
                started = now
            if reduce_motion():
                revealer.set_transition_duration(0)
                revealer.set_reveal_child(self.show_other)
            height = self.box.get_preferred_height()[1]
            if height != last_height:
                self.box.get_toplevel().resize(1, 1)
                last_height = height
            if reduce_motion() or now - started >= 0.26:
                self._other_tick = None
                return False
            return True
        self._other_tick = self.box.add_tick_callback(frame)

    def _set_radio(self, on):
        spawn(f"nmcli radio wifi {'on' if on else 'off'}")
        self.refresh_soon(900)


BT_ICONS = {"audio-headset": "headphones", "audio-headphones": "headphones",
            "audio-card": "speaker", "input-gaming": "gamepad", "input-keyboard": "keyboard",
            "input-mouse": "mouse", "input-tablet": "mouse", "phone": "phone"}


class BluetoothMenu(BarPanel):
    """Menu Bluetooth: interruptor, dispositivos pareados (azul = conectado,
    bateria à direita) — clique conecta/desconecta — e "Bluetooth Settings…"."""

    def fetch(self):
        show = run("bluetoothctl show")
        has = bool(show) and "Controller" in show
        powered = "Powered: yes" in show
        devs = []
        if powered:
            lines = run("bluetoothctl devices Paired").splitlines() or run("bluetoothctl devices").splitlines()
            for line in lines:
                parts = line.split(" ", 2)
                if len(parts) < 3 or parts[0] != "Device":
                    continue
                mac, name = parts[1], parts[2]
                info = run(f"bluetoothctl info {mac}")
                connected = "Connected: yes" in info
                icon = re.search(r"Icon: (\S+)", info)
                batt = re.search(r"Battery Percentage: \S+ \((\d+)\)", info)
                devs.append((mac, name, connected, icon.group(1) if icon else "",
                             int(batt.group(1)) if batt else None))
        devs.sort(key=lambda d: (not d[2], d[1].lower()))
        return {"has": has, "powered": powered, "devs": devs}

    def signature(self, d):
        return repr((d["has"], d["powered"],
                     [(mac, name, connected, icon)
                      for mac, name, connected, icon, _battery in d["devs"]]))

    def update(self, d):
        for mac, _name, _connected, _icon, battery in d["devs"]:
            row = self._device_rows.get(mac)
            if row is not None:
                row._device_right.set_text(f"{battery}%" if battery is not None else "")
                row._device_right.set_visible(battery is not None)

    def build(self, d):
        self._device_rows = {}
        self.title_row("Bluetooth", d["powered"], self._set_power, sensitive=d["has"])
        if not d["has"]:
            self.note("No Bluetooth controller found")
        elif d["powered"]:
            if d["devs"]:
                self.head("Devices")
                for mac, name, conn, icon, batt in d["devs"]:
                    glyph = I[BT_ICONS.get(icon, "bt")]
                    act = "disconnect" if conn else "connect"
                    self._device_rows[mac] = self.device(
                        glyph, name, conn,
                        action=lambda m=mac, a=act: spawn(f"bluetoothctl {a} {m}"),
                        right=f"{batt}%" if batt is not None else None, right_dynamic=True)
            else:
                self.note("No paired devices")
        self.sep()
        self.item("Bluetooth Settings…", lambda: open_settings("bluetooth"))

    def _set_power(self, on):
        spawn(f"bluetoothctl power {'on' if on else 'off'}")
        self.refresh_soon(900)


class SoundMenu(BarPanel):
    """Menu Som: slider da saída padrão (wpctl), saídas (a atual em azul; clique
    troca a padrão) e "Sound Settings…". Guarda onde fica o ícone (para o OSD)."""

    POLL_S = 2

    def placed(self, x, y):
        if y > 30:          # aberto pelo D-Bus fora da barra: não é a posição do ícone
            return
        try:
            with open(SOUND_X, "w") as f:
                f.write(f"{round(x)}")
        except OSError:
            pass

    def fetch(self):
        try:
            sinks = json.loads(run("pactl -f json list sinks") or "[]")
        except ValueError:
            sinks = []
        default = run("pactl get-default-sink")
        outs = []
        for s in sinks:
            name = s.get("name", "")
            desc = s.get("description") or name
            low = (name + " " + desc + " " + str(s.get("active_port") or "")).lower()
            kind = ("monitor" if "hdmi" in low or "displayport" in low
                    else "headphones" if "headphone" in low or "headset" in low or "bluez" in low
                    else "speaker")
            outs.append((name, desc, kind, name == default))
        vol = run("wpctl get-volume @DEFAULT_AUDIO_SINK@")
        try:
            level = round(float(vol.split()[1]) * 100)
        except (IndexError, ValueError):
            level = 0
        return {"outs": outs, "level": min(level, 100), "muted": "MUTED" in vol}

    def signature(self, d):
        return repr(d["outs"])          # o volume muda ao vivo, sem remontar

    def build(self, d):
        self.title_row("Sound")
        self.scale = self.slider(d["level"], self._set_volume, I["vol_lo"], I["vol_hi"])
        self.sep()
        self.head("Output")
        for name, desc, kind, cur in d["outs"]:
            self.device(I[kind], desc, cur, close=False,
                        action=lambda n=name: self._set_output(n))
        if not d["outs"]:
            self.note("No output devices")
        self.sep()
        self.item("Sound Settings…", lambda: open_settings("sound"))

    def update(self, d):
        sc = getattr(self, "scale", None)
        if sc and not sc.has_grab():
            sc.set_value(0 if d["muted"] else d["level"])

    def _set_volume(self, v):
        self._vol_cmd = getattr(self, "_vol_cmd", None) or LatestCommand(volume_argv)
        self._vol_cmd.set(v)

    def _set_output(self, name):
        spawn(f"pactl set-default-sink {GLib.shell_quote(name)}")
        self.refresh_soon(350)


# ───────────────────────────── OSD de volume/brilho (BAR-11) ─────────────────────────────
# Tahoe (referencias/telas/osd-volume-alto-falantes.png e osd-volume-arrastando.png; escala
# 1,125 px/pt calibrada pela largura das notificações, 344): painel de vidro 344×74, canto
# contínuo de ~26 (raio 24 aqui), a ~7 da barra e da borda direita. Título com o nome da saída
# ("MacBook Air Speakers", Semibold 13) a 19 da esquerda; linha: speaker · trilha · speaker.wave.3
# (ícones a ~17 das bordas, 8 até a trilha). Trilha: linha de 4,5 centrada a 47,6 do topo,
# preenchimento branco, resto branco fraco, e uma FILEIRA DE PONTOS 7 abaixo (a cada 15,7).
# É interativo: com o ponteiro em cima aparece o puxador (cápsula branca ~28×18) e dá para
# arrastar; enquanto o ponteiro está nele, não some. Brilho: o mesmo, com sóis e "Display".

OSD_W, OSD_H = 344, 74
OSD_SHOW_MS, OSD_FADE_MS = 1500, 220


class LevelOSD:
    def __init__(self, cc):
        self.cc = cc
        self.value, self.kind, self.muted = 0, "volume", False
        self._timer = None
        self._fade = None
        self.hover = False
        self.dragging = False
        self.win = layer_window("hyprmac-osd", LS.Layer.OVERLAY, anchors=(E.TOP, E.RIGHT),
                                margins={E.TOP: 7, E.RIGHT: 7})
        add_class(self.win, "osd-win")
        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        ev.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        ev.connect("enter-notify-event", lambda *_: self._set_hover(True))
        ev.connect("leave-notify-event", lambda _w, e: e.detail != Gdk.NotifyType.INFERIOR
                   and self._set_hover(False))
        self.pill = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self.pill, "osd")
        self.pill.set_size_request(OSD_W, OSD_H)
        self.title = label("", "osd-title")
        self.title.set_ellipsize(Pango.EllipsizeMode.END)
        self.title.set_max_width_chars(1)
        self.title.set_hexpand(True)
        self.pill.pack_start(self.title, False, False, 0)
        line = Gtk.Box(spacing=0)
        add_class(line, "osd-line")
        self.icon = SFIcon("speaker", 10, 16, "osd-icon")
        self.icon_hi = SFIcon("speaker.wave.3", 21, 16, "osd-icon")
        for ic in (self.icon, self.icon_hi):      # centrados na linha (y = 8 na área de 22)
            ic.set_valign(Gtk.Align.START)
        self.icon.set_margin_end(8)
        self.icon_hi.set_margin_start(8)
        self.bar = Gtk.DrawingArea()
        add_class(self.bar, "osd-bar")
        self.bar.set_size_request(-1, 22)
        self.bar.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                            Gdk.EventMask.POINTER_MOTION_MASK)
        self.bar.connect("draw", self._draw)
        self.bar.connect("button-press-event", self._press)
        self.bar.connect("button-release-event", self._release)
        self.bar.connect("motion-notify-event", self._drag)
        line.pack_start(self.icon, False, False, 0)
        line.pack_start(self.bar, True, True, 0)
        line.pack_start(self.icon_hi, False, False, 0)
        self.pill.pack_start(line, False, False, 0)
        ev.add(self.pill)
        self.win.add(ev)
        ev.show_all()
        # só o painel pega o ponteiro; fora dele, o que estiver embaixo continua clicável
        self.pill.connect("size-allocate", self._input_region)

    def _input_region(self, w, a):
        if self.win.get_window():
            self.win.input_shape_combine_region(cairo.Region(cairo.RectangleInt(a.x, a.y, a.width, a.height)))

    def _set_hover(self, on):
        self.hover = on
        self.bar.queue_draw()
        if on:
            if self._timer:
                GLib.source_remove(self._timer)
                self._timer = None
            if self._fade:
                GLib.source_remove(self._fade)
                self._fade = None
                self.pill.set_opacity(1.0)
        elif not self.dragging and self.win.get_visible() and not self._timer:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return False

    # ── arrastar no próprio OSD (como no Tahoe) ──
    def _track_x(self):
        """(x0, x1) da trilha dentro da área: o puxador cabe inteiro nas pontas."""
        w = self.bar.get_allocated_width()
        return 2.25, w - 2.25

    def _value_at(self, x):
        x0, x1 = self._track_x()
        return int(round(max(0.0, min(1.0, (x - x0) / max(1, x1 - x0))) * 100))

    def _apply(self, v):
        control = self.cc.display if self.kind == "brightness" else self.cc.sound
        if not control.get_sensitive():
            return
        self.value, self.muted = v, False
        self.bar.queue_draw()
        if self.kind == "brightness":
            self.cc.display.set_value(v)
            self.cc._set_brightness(v)
        else:
            self.cc._set_volume(v)

    def _press(self, _w, ev):
        if ev.button == 1:
            self.dragging = True
            self._apply(self._value_at(ev.x))
        return True

    def _drag(self, _w, ev):
        if self.dragging:
            self._apply(self._value_at(ev.x))
        return True

    def _release(self, _w, ev):
        self.dragging = False
        if not self.hover and not self._timer:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return True

    # comando "osd volume" | "osd brightness [N]"
    def command(self, arg=""):
        parts = arg.split()
        kind = parts[0] if parts else "volume"
        if kind.startswith("bright"):
            v = None
            if len(parts) > 1:
                try:
                    v = int(float(parts[1]))
                except ValueError:
                    v = None
            if v is None:
                v = self.cc.brightness if self.cc.brightness is not None else int(self.cc.display.scale.get_value())
            self.present("brightness", v, False)
        else:
            # Tahoe ▸ Ajustes ▸ Som: "Play feedback when volume is changed" (som a cada
            # tecla de volume; Shift inverte). A tecla de mudo não toca.
            feedback = "mute" not in parts and (bool(load_config().get("volume_feedback", True)) != ("shift" in parts))
            in_thread(self._read_volume, feedback)

    def _feedback(self):
        now = time.monotonic()
        if now - getattr(self, "_feedback_at", 0.0) < 0.1:     # tecla repetindo: não empilha
            return
        self._feedback_at = now
        spawn("canberra-gtk-play -i audio-volume-change -d hyprmac-volume")

    @staticmethod
    def _sink_name():
        """Nome da saída como o Mac mostra ("MacBook Air Speakers"): a descrição do
        PipeWire sem o sufixo técnico entre parênteses."""
        out = run("wpctl inspect @DEFAULT_AUDIO_SINK@")
        m = re.search(r'node\.description = "([^"]+)"', out) or re.search(r'node\.nick = "([^"]+)"', out)
        name = m.group(1) if m else "Speakers"
        return re.sub(r"\s*\([^)]*\)\s*$", "", name).strip() or "Speakers"

    def _read_volume(self, feedback=False):
        out = run("wpctl get-volume @DEFAULT_AUDIO_SINK@")
        try:
            v = round(float(out.split()[1]) * 100)
        except (IndexError, ValueError):
            return
        if feedback and "MUTED" not in out:
            GLib.idle_add(lambda: self._feedback() or False)
        name = self._sink_name()
        GLib.idle_add(lambda: self.title.set_text(name) or False)
        GLib.idle_add(self.present, "volume", v, "MUTED" in out)

    # comando "brightness up|down|N": muda o brilho (DDC/CI, como a Central) e mostra o OSD
    def brightness(self, arg=""):
        if not self.cc.display.get_sensitive():
            return
        cur = self.cc.brightness
        if cur is None:
            cur = int(self.cc.display.scale.get_value())
        a = arg.strip()
        if a in ("up", "+"):
            v = cur + 5
        elif a in ("down", "-"):
            v = cur - 5
        else:
            try:
                v = int(float(a))
            except ValueError:
                v = cur
        v = max(0, min(100, v))
        self.cc.display.set_value(v)
        self.cc._set_brightness(v)
        self.present("brightness", v, False)

    def present(self, kind, value, muted):
        self.kind, self.value, self.muted = kind, max(0, min(100, value)), muted
        if kind == "brightness":
            self.title.set_text("Display")
            self.icon.set_name_("sun.min")
            self.icon_hi.set_name_("sun.max")
        else:
            self.icon.set_name_("speaker")
            self.icon_hi.set_name_("speaker.wave.3")
        self.bar.queue_draw()
        if not self.win.get_visible():
            self._place()
        if self._fade:
            GLib.source_remove(self._fade)
            self._fade = None
        self.pill.set_opacity(1.0)
        self.win.show()
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None
        if not self.hover and not self.dragging:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return False

    def _place(self):
        """No monitor em foco, no canto direito sob a barra (âncora TOP|RIGHT)."""
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)

    def _start_fade(self):
        self._timer = None
        t0 = time.monotonic()

        def step():
            t = (time.monotonic() - t0) * 1000 / OSD_FADE_MS
            if t >= 1:
                self._fade = None
                self.win.hide()
                self.pill.set_opacity(1.0)
                return False
            self.pill.set_opacity(1 - t)
            return True
        self._fade = GLib.timeout_add(16, step)
        return False

    def _draw(self, area, cr):
        """Trilha do Tahoe (medida em osd-volume-alto-falantes.png): linha de 4,5 com pontas
        redondas — preenchida em branco, o resto branco fraco —, uma fileira de pontos 7 abaixo
        (a cada 15,7) e, com o ponteiro em cima, o puxador: cápsula branca ~28×18."""
        w, h = area.get_allocated_width(), area.get_allocated_height()
        col = area.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        x0, x1 = self._track_x()
        y, th = h / 2 - 3, 4.5
        fx = x0 + (x1 - x0) * self.value / 100
        # pontos sob a trilha
        cr.set_source_rgba(col.red, col.green, col.blue, 0.40)
        n = max(2, int(round((x1 - x0) / 15.7)))
        for i in range(n + 1):
            cr.arc(x0 + (x1 - x0) * i / n, y + 7, 0.9, 0, 2 * math.pi)
            cr.fill()
        rounded_rect(cr, x0 - th / 2, y - th / 2, x1 - x0 + th, th, th / 2)
        cr.set_source_rgba(col.red, col.green, col.blue, 0.18)
        cr.fill()
        if fx > x0:
            rounded_rect(cr, x0 - th / 2, y - th / 2, fx - x0 + th, th, th / 2)
            cr.set_source_rgba(col.red, col.green, col.blue, 0.45 if self.muted else 0.97)
            cr.fill()
        if self.hover or self.dragging:
            kw, kh = 28, 18
            kx = max(0, min(w - kw, fx - kw / 2))
            cr.save()
            rounded_rect(cr, kx, y - kh / 2 + 1, kw, kh, kh / 2)       # sombra
            cr.set_source_rgba(0, 0, 0, 0.18)
            cr.fill()
            cr.restore()
            rounded_rect(cr, kx, y - kh / 2, kw, kh, kh / 2)
            cr.set_source_rgba(1, 1, 1, 0.98)
