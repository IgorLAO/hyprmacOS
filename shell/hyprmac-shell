            ("Sound & Focus", (("headphones", "Headphones", "◖", "Connected audio output", None),
                               ("sleep", "Sleep Focus", "☾", "Quickly turn Sleep on or off", None))),
            ("System", (("wifi", "Wi-Fi", "◉", "Wireless network status", None),
                        ("battery", "Battery", "▰", "Battery level and power", None),
                        ("focus", "Focus", "☾", "Focus mode status", None),
                        ("spotlight", "Spotlight", "⌕", "Search your Mac", None))),
