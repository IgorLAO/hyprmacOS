# Tahoe (referencias/telas/osd-volume-alto-falantes.png e osd-volume-arrastando.png; escala
# 1,125 px/pt calibrada pela largura das notificações, 344): painel de vidro 344×74, canto
# contínuo de ~26 (raio 24 aqui), a ~7 da barra e da borda direita. Título com o nome da saída
# ("MacBook Air Speakers", Semibold 13) a 19 da esquerda; linha: speaker · trilha · speaker.wave.3
# (ícones a ~17 das bordas, 8 até a trilha). Trilha: linha de 4,5 centrada a 47,6 do topo,
# preenchimento branco, resto branco fraco, e uma FILEIRA DE PONTOS 7 abaixo (a cada 15,7).
# É interativo: com o ponteiro em cima aparece o puxador (cápsula branca ~28×18) e dá para
# arrastar; enquanto o ponteiro está nele, não some. Brilho: o mesmo, com sóis e "Display".

OSD_W, OSD_H = 344, 74
OSD_SHOW_MS, OSD_FADE_MS = 1500, 220
OSD_APPEAR_MS = 180  # acompanha a transição do glifo na barra


class LevelOSD:
    def __init__(self, cc):
        self.cc = cc
        self.value, self.kind, self.muted = 0, "volume", False
        self._timer = None
        self._fade = None
        self._appear = None
        self._bar_kind = None
        try:
            os.remove(OSD_STATE)
        except FileNotFoundError:
            pass
        self.hover = False
        self.dragging = False
        self.win = layer_window("hyprmac-osd", LS.Layer.OVERLAY, anchors=(E.TOP, E.RIGHT),
                                margins={E.TOP: 20, E.RIGHT: 28})
        add_class(self.win, "osd-win")
        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        ev.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        ev.connect("enter-notify-event", lambda *_: self._set_hover(True))
        ev.connect("leave-notify-event", lambda _w, e: e.detail != Gdk.NotifyType.INFERIOR
                   and self._set_hover(False))
        self.pill = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self.pill, "osd")
        self.pill.set_size_request(OSD_W, OSD_H)
        self.title = label("", "osd-title")
        self.title.set_ellipsize(Pango.EllipsizeMode.END)
        self.title.set_max_width_chars(1)
        self.title.set_hexpand(True)
        self.pill.pack_start(self.title, False, False, 0)
        line = Gtk.Box(spacing=0)
        add_class(line, "osd-line")
        self.icon = SFIcon("speaker", 10, 16, "osd-icon")
        self.icon_hi = SFIcon("speaker.wave.3", 21, 16, "osd-icon")
        for ic in (self.icon, self.icon_hi):      # centrados na linha (y = 8 na área de 22)
            ic.set_valign(Gtk.Align.START)
        self.icon.set_margin_end(8)
        self.icon_hi.set_margin_start(8)
        self.bar = Gtk.DrawingArea()
        add_class(self.bar, "osd-bar")
        self.bar.set_size_request(-1, 22)
        self.bar.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                            Gdk.EventMask.POINTER_MOTION_MASK)
        self.bar.connect("draw", self._draw)
        self.bar.connect("button-press-event", self._press)
        self.bar.connect("button-release-event", self._release)
        self.bar.connect("motion-notify-event", self._drag)
        line.pack_start(self.icon, False, False, 0)
        line.pack_start(self.bar, True, True, 0)
        line.pack_start(self.icon_hi, False, False, 0)
        self.pill.pack_start(line, False, False, 0)
        ev.add(self.pill)
        self.win.add(ev)
        ev.show_all()
        # só o painel pega o ponteiro; fora dele, o que estiver embaixo continua clicável
        self.pill.connect("size-allocate", self._input_region)

    def _input_region(self, w, a):
        if self.win.get_window():
            self.win.input_shape_combine_region(cairo.Region(cairo.RectangleInt(a.x, a.y, a.width, a.height)))

    def _set_hover(self, on):
        self.hover = on
        self.bar.queue_draw()
        if on:
            if self._timer:
                GLib.source_remove(self._timer)
                self._timer = None
            if self._fade:
                GLib.source_remove(self._fade)
                self._fade = None
                self.pill.set_opacity(1.0)
        elif not self.dragging and self.win.get_visible() and not self._timer:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return False

    # ── arrastar no próprio OSD (como no Tahoe) ──
    def _track_x(self):
        """(x0, x1) da trilha dentro da área: o puxador cabe inteiro nas pontas."""
        w = self.bar.get_allocated_width()
        return 2.25, w - 2.25

    def _value_at(self, x):
        x0, x1 = self._track_x()
        return int(round(max(0.0, min(1.0, (x - x0) / max(1, x1 - x0))) * 100))

    def _apply(self, v):
        control = self.cc.display if self.kind == "brightness" else self.cc.sound
        if not control.get_sensitive():
            return
        self.value, self.muted = v, False
        self.bar.queue_draw()
        if self.kind == "brightness":
            self.cc.display.set_value(v)
            self.cc._set_brightness(v)
        else:
            self.cc._set_volume(v)

    def _press(self, _w, ev):
        if ev.button == 1:
            self.dragging = True
            self._apply(self._value_at(ev.x))
        return True

    def _drag(self, _w, ev):
        if self.dragging:
            self._apply(self._value_at(ev.x))
        return True

    def _release(self, _w, ev):
        self.dragging = False
        if not self.hover and not self._timer:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return True

    # comando "osd volume" | "osd brightness [N]"
    def command(self, arg=""):
        parts = arg.split()
        kind = parts[0] if parts else "volume"
        if kind.startswith("bright"):
            v = None
            if len(parts) > 1:
                try:
                    v = int(float(parts[1]))
                except ValueError:
                    v = None
            if v is None:
                v = self.cc.brightness if self.cc.brightness is not None else int(self.cc.display.scale.get_value())
            self.present("brightness", v, False)
        else:
            # Tahoe ▸ Ajustes ▸ Som: "Play feedback when volume is changed" (som a cada
            # tecla de volume; Shift inverte). A tecla de mudo não toca.
            feedback = "mute" not in parts and (bool(load_config().get("volume_feedback", True)) != ("shift" in parts))
            in_thread(self._read_volume, feedback)

    def _feedback(self):
        now = time.monotonic()
        if now - getattr(self, "_feedback_at", 0.0) < 0.1:     # tecla repetindo: não empilha
            return
        self._feedback_at = now
        spawn("canberra-gtk-play -i audio-volume-change -d hyprmac-volume")

    @staticmethod
    def _sink_name():
        """Nome da saída como o Mac mostra ("MacBook Air Speakers"): a descrição do
        PipeWire sem o sufixo técnico entre parênteses."""
        out = run("wpctl inspect @DEFAULT_AUDIO_SINK@")
        m = re.search(r'node\.description = "([^"]+)"', out) or re.search(r'node\.nick = "([^"]+)"', out)
        name = m.group(1) if m else "Speakers"
        return re.sub(r"\s*\([^)]*\)\s*$", "", name).strip() or "Speakers"

    def _read_volume(self, feedback=False):
        out = run("wpctl get-volume @DEFAULT_AUDIO_SINK@")
        try:
            v = round(float(out.split()[1]) * 100)
        except (IndexError, ValueError):
            return
        if feedback and "MUTED" not in out:
            GLib.idle_add(lambda: self._feedback() or False)
        name = self._sink_name()
        GLib.idle_add(lambda: self.title.set_text(name) or False)
        GLib.idle_add(self.present, "volume", v, "MUTED" in out)

    # comando "brightness up|down|N": muda o brilho (DDC/CI, como a Central) e mostra o OSD
    def brightness(self, arg=""):
        if not self.cc.display.get_sensitive():
            return
        cur = self.cc.brightness
        if cur is None:
            cur = int(self.cc.display.scale.get_value())
        a = arg.strip()
        if a in ("up", "+"):
            v = cur + 5
        elif a in ("down", "-"):
            v = cur - 5
        else:
            try:
                v = int(float(a))
            except ValueError:
                v = cur
        v = max(0, min(100, v))
        self.cc.display.set_value(v)
        self.cc._set_brightness(v)
        self.present("brightness", v, False)

    def present(self, kind, value, muted):
        self.kind, self.value, self.muted = kind, max(0, min(100, value)), muted
        if kind == "brightness":
            self.title.set_text("Display")
            self.icon.set_name_("sun.min")
            self.icon_hi.set_name_("sun.max")
        else:
            self.icon.set_name_("speaker")
            self.icon_hi.set_name_("speaker.wave.3")
        self.bar.queue_draw()
        if not self.win.get_visible():
            self._place()
        if self._fade:
            GLib.source_remove(self._fade)
            self._fade = None
        if self._appear:
            GLib.source_remove(self._appear)
            self._appear = None
        first = not self.win.get_visible()
        self.pill.set_opacity(0.0 if first and not reduce_motion() else 1.0)
        self.win.show()
        self._bar_state(kind)
        if first and not reduce_motion():
            started = time.monotonic()
            def appear():
                t = min(1.0, (time.monotonic() - started) * 1000 / OSD_APPEAR_MS)
                self.pill.set_opacity(1 - (1 - t) ** 3)
                if t >= 1:
                    self._appear = None
                    return False
                return True
            self._appear = GLib.timeout_add(16, appear)
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None
        if not self.hover and not self.dragging:
            self._timer = GLib.timeout_add(OSD_SHOW_MS, self._start_fade)
        return False

    def _place(self):
        """No monitor em foco, no canto direito sob a barra (âncora TOP|RIGHT)."""
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)

    def _bar_state(self, kind):
        if kind == self._bar_kind:
            return
        self._bar_kind = kind
        try:
            if kind:
                with open(OSD_STATE, "w") as marker:
                    marker.write(kind)
            elif os.path.exists(OSD_STATE):
                os.remove(OSD_STATE)
        except OSError:
            pass
        spawn("pkill -RTMIN+8 -x waybar")

    def _start_fade(self):
        self._timer = None
        t0 = time.monotonic()

        def step():
            t = (time.monotonic() - t0) * 1000 / OSD_FADE_MS
            if t >= 1:
                self._fade = None
                self.win.hide()
                self.pill.set_opacity(1.0)
                self._bar_state(None)
                return False
            self.pill.set_opacity(1 - t)
            return True
        self._fade = GLib.timeout_add(16, step)
        return False

    def _draw(self, area, cr):
        """Trilha do Tahoe (medida em osd-volume-alto-falantes.png): linha de 4,5 com pontas
        redondas — preenchida em branco, o resto branco fraco —, uma fileira de pontos 7 abaixo
        (a cada 15,7) e, com o ponteiro em cima, o puxador: cápsula branca ~28×18."""
        w, h = area.get_allocated_width(), area.get_allocated_height()
        col = area.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        x0, x1 = self._track_x()
        y, th = h / 2 - 3, 4.5
        fx = x0 + (x1 - x0) * self.value / 100
        # pontos sob a trilha
        cr.set_source_rgba(col.red, col.green, col.blue, 0.40)
        n = max(2, int(round((x1 - x0) / 15.7)))
        for i in range(n + 1):
            cr.arc(x0 + (x1 - x0) * i / n, y + 7, 0.9, 0, 2 * math.pi)
            cr.fill()
        rounded_rect(cr, x0 - th / 2, y - th / 2, x1 - x0 + th, th, th / 2)
        cr.set_source_rgba(col.red, col.green, col.blue, 0.18)
        cr.fill()
        if fx > x0:
            rounded_rect(cr, x0 - th / 2, y - th / 2, fx - x0 + th, th, th / 2)
            cr.set_source_rgba(col.red, col.green, col.blue, 0.45 if self.muted else 0.97)
            cr.fill()
        if self.hover or self.dragging:
            kw, kh = 28, 18
            kx = max(0, min(w - kw, fx - kw / 2))
            cr.save()
            rounded_rect(cr, kx, y - kh / 2 + 1, kw, kh, kh / 2)       # sombra
            cr.set_source_rgba(0, 0, 0, 0.18)
            cr.fill()
            cr.restore()
            rounded_rect(cr, kx, y - kh / 2, kw, kh, kh / 2)
            cr.set_source_rgba(1, 1, 1, 0.98)
            cr.fill()


