        self.g_search.connect("search-changed", lambda _e: self._filter_gallery())
        # no Mac o "Search Controls" fica visível com o campo focado e vazio (ui_0122); o GTK 3
        # esconde o placeholder com foco, então um rótulo por cima faz esse papel
