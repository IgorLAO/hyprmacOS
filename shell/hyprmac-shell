    # ── arranjos ──
    def _layout_rects(self, name):
        """Retângulos (x, y, w, h) de cada bloco + tamanho total, por arranjo."""
        hh, hp, hc, hv, air = self.H_HEAD, self.H_PROG, self.H_CTRL, self.H_VOL, self.AIR
        if name == "large":
            W = c = 300
            y = c + 16
            r = {"cover": (0, 0, c, c),
                 "head": (0, y, W - air - 8, hh),
                 "air": (W - air, y + (hh - air) / 2, air, air),
                 "prog": (0, y + hh + 8, W, hp),
                 "ctrl": (0, y + hh + 8 + hp + 6, W, hc),
                 "vol": (0, y + hh + 8 + hp + 6 + hc + 8, W, hv)}
        elif name == "side":
            W, c = 420, 150
            x = c + 20
            cw = W - x
            col = hh + 6 + hp + 4 + hc + 6 + hv
            r = {"cover": (0, (col - c) / 2, c, c),
                 "head": (x, 0, cw - air - 8, hh),
                 "air": (W - air, (hh - air) / 2, air, air),
                 "prog": (x, hh + 6, cw, hp),
                 "ctrl": (x, hh + 6 + hp + 4, cw, hc),
                 "vol": (x, hh + 6 + hp + 4 + hc + 6, cw, hv)}
        else:   # compact: como a tela de bloqueio (capa pequena ao lado do título)
            W, c = 320, 62
            x = c + 14
            r = {"cover": (0, 0, c, c),
                 "head": (x, (c - hh) / 2, W - x - air - 8, hh),
                 "air": (W - air, (c - air) / 2, air, air),
                 "prog": (0, c + 14, W, hp),
                 "ctrl": (0, c + 14 + hp + 4, W, hc),
                 "vol": (0, c + 14 + hp + 4 + hc + 8, W, hv)}
        H = max(y + h for (_x, y, _w, h) in r.values())
        r["size"] = (W, H)
        return r

    def _apply_rects(self, r):
        for key, w in self.parts.items():
            x, y, ww, hh = r[key]
            self.fixed.move(w, round(x), round(y))
            w.set_size_request(max(1, round(ww)), max(1, round(hh)))
        W, H = r["size"]
        self.fixed.set_size_request(round(W), round(H))
        self.win.resize(1, 1)

    def _cycle_layout(self):
        i = MEDIA_LAYOUTS.index(self.layout)
        self.layout = MEDIA_LAYOUTS[(i + 1) % len(MEDIA_LAYOUTS)]
        self._save_layout()
        start, end = self.rects, self._layout_rects(self.layout)
        if reduce_motion():
            if self._anim:
                self.fixed.remove_tick_callback(self._anim)
                self._anim = None
            self.rects = end
            self._apply_rects(end)
            self.cover.queue_draw()
            return True
        t0 = time.monotonic()

        def frame(*_):
            t = min(1.0, (time.monotonic() - t0) * 1000 / MEDIA_ANIM_MS)
            e = ease_in_out(t)
            cur = {k: tuple(a + (b - a) * e for a, b in zip(start[k], end[k])) for k in end}
            self.rects = cur
            self._apply_rects(cur)
            self.cover.queue_draw()
            if t >= 1.0:
                self._anim = None
                return False
            return True
        if self._anim:
            self.fixed.remove_tick_callback(self._anim)
        self._anim = self.fixed.add_tick_callback(frame)
        return True

    def _load_layout(self):
        try:
            with open(MEDIA_STATE) as f:
                name = json.load(f).get("layout")
            return name if name in MEDIA_LAYOUTS else "compact"
        except (OSError, ValueError, AttributeError):
            return "compact"

    def _save_layout(self):
        try:
            os.makedirs(os.path.dirname(MEDIA_STATE), exist_ok=True)
            with open(MEDIA_STATE, "w") as f:
                json.dump({"layout": self.layout}, f)
        except OSError:
            pass

    # ── abrir/fechar ──
    def toggle(self, arg=""):
        self.hide() if self.open else self.show(arg)

    def show(self, arg=""):
        close_other_panels(self)
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)
        # centraliza sob o nome na barra ("x largura-da-barra", vindo do módulo)
        right = 10
        try:
            cx, bar_w = (int(v) for v in arg.split())
            outer = self.rects["size"][0] + 36
            right = max(10, round(bar_w - cx - outer / 2))
        except ValueError:
            pass
        LS.set_margin(self.win, E.RIGHT, right)
        self._right = right
        self.open = True
        self.refresh()
        self.catchers.show()
        self.win.show()
        emerge(self.win, {E.TOP: 8, E.RIGHT: right})   # do nome da música, no centro
        self._polls = [GLib.timeout_add(1000, self._tick), GLib.timeout_add(250, self._advance)]

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        for p in self._polls:
            GLib.source_remove(p)
        self._polls = []
        self.win.hide()
        stop_emerge(self.win, {E.TOP: 8, E.RIGHT: self._right})
        self.catchers.hide()

    # ── estado ──
    def _tick(self):
        self.refresh()
        return True

    def refresh(self):
        in_thread(self._fetch)

    def _fetch(self):
        fmt = ("{{playerName}}\t{{status}}\t{{title}}\t{{artist}}\t{{album}}\t"
               "{{mpris:artUrl}}\t{{mpris:length}}\t{{position}}")
        rows = [ln.split("\t") for ln in
                run(f"playerctl -a metadata --format '{fmt}' 2>/dev/null").splitlines()]
        rows = [r for r in rows if len(r) == 8]
        # o mesmo critério da barra: quem está tocando; senão, o primeiro
        row = next((r for r in rows if r[1] == "Playing"), rows[0] if rows else None)
        # a saída que está tocando (nem sempre é a padrão) — a mesma das barrinhas
        try:
            sinks = json.loads(run("pactl -f json list sinks") or "[]")
        except ValueError:
            sinks = []
        default = run("pactl get-default-sink")
        running = [x for x in sinks if x.get("state") == "RUNNING"]
        sink = (next((x for x in running if x.get("name") == default), None)
                or (running[0] if running else None)
                or next((x for x in sinks if x.get("name") == default), None))
        GLib.idle_add(self._apply, row, sink)

    def _apply(self, row, sink_info):
        sink = ""
        if sink_info:
            self.sink = sink_info.get("name")
            sink = sink_info.get("description", "")
            try:
                ch = next(iter(sink_info["volume"].values()))
                vol = 0 if sink_info.get("mute") else int(ch["value_percent"].rstrip("%"))
                if not self.vol_scale.has_grab():
                    self.vol_scale.set_value(vol)
            except (KeyError, StopIteration, ValueError, AttributeError):
                pass
        if not row:
            self.player, self.status, self.length, self.position = None, "Stopped", 0, 0
            self.source.set_text(sink)
            self.title.set_text("Not Playing")
            self.artist.set_text("")
            self.play_lbl.set_text(I["play"])
            self.play_button.set_tooltip_text("Play")
            self._set_art(None)
            self._show_progress()
            return False
        name, status, title, artist, album, art, length, pos = row
        self.player, self.status = name, status
        player = app_name(name.split(".")[0])
        self.source.set_text(f"{player}  ›  {sink}" if sink else player)
        self.title.set_text(title or "Sem título")
        self.artist.set_text(" — ".join(p for p in (artist, album) if p))
        self.play_lbl.set_text(I["pause"] if status == "Playing" else I["play"])
        self.play_button.set_tooltip_text("Pause" if status == "Playing" else "Play")
        try:
            self.length = int(length) / 1e6
        except ValueError:
            self.length = 0
        # O polling pode devolver a posição anterior ao seek. Enquanto o
        # puxador pertence ao gesto, conservar também o tempo escolhido;
        # só proteger o GtkScale deixava os rótulos saltarem para trás.
        if not self.seek.has_grab():
            try:
                self.position = int(pos) / 1e6
            except ValueError:
                self.position = 0
            self.pos_at = time.monotonic()
        self._set_art(art)
        self._show_progress()
        return False

    def _current_pos(self):
        p = self.position
        if self.status == "Playing":
            p += time.monotonic() - self.pos_at
        return min(p, self.length) if self.length else p

    def _advance(self):
        if self.status == "Playing":
            self._show_progress()
        return True

    def _show_progress(self, preview=None):
        if not self.length:
            self.elapsed.set_text("-:--")
            self.remain.set_text("--:--")
            if not self.seek.has_grab():
                self.seek.set_value(0)
            return
        p = (preview if preview is not None else
             self.seek.get_value() * self.length if self.seek.has_grab()
             else self._current_pos())
        self.elapsed.set_text(fmt_time(p))
        self.remain.set_text("-" + fmt_time(self.length - p))
        if not self.seek.has_grab():
            self.seek.set_value(p / self.length)

    # ── ações ──
    def _pctl(self, args):
        who = f"-p {GLib.shell_quote(self.player)} " if self.player else ""
        spawn(f"playerctl {who}{args}")

    def _command(self, cmd):
        self._pctl(cmd)
        if cmd == "play-pause":
            playing = self.status != "Playing"
            self.position, self.pos_at = self._current_pos(), time.monotonic()
            self.status = "Playing" if playing else "Paused"
            self.play_lbl.set_text(I["pause"] if playing else I["play"])
            self.play_button.set_tooltip_text("Pause" if playing else "Play")
        GLib.timeout_add(350, lambda: self.refresh() and False)

    def _on_seek(self, _scale, _scroll, value):
        if not self.length:
            return True
        value = min(max(value, 0), 1)
        self.position, self.pos_at = value * self.length, time.monotonic()
        self._pctl(f"position {self.position:.2f}")
        self._show_progress(preview=self.position)
        return False

    def _on_volume(self, _scale, _scroll, value):
        v = round(min(max(value, 0), 100))
        target = GLib.shell_quote(self.sink) if self.sink else "@DEFAULT_SINK@"
        spawn(f"pactl set-sink-mute {target} 0; pactl set-sink-volume {target} {v}%")
        return False

    # ── capa ──
    def _set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url:
            in_thread(self._load_art, url)
        else:
            self._transition_art(None)

    def _load_art(self, url):
        try:
            if url.startswith("file://"):
                path = urllib.parse.unquote(url[7:])
            else:
                os.makedirs(CACHE, exist_ok=True)
                path = os.path.join(CACHE, "art-media")
                urllib.request.urlretrieve(url, path)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 640, 640, True)
        except Exception:
            return
        GLib.idle_add(self._art_loaded, url, pb)

    def _art_loaded(self, url, pb):
        if url == self.art_url:
            # superfície do cairo: redimensiona rápido a cada quadro da animação
            self._transition_art(Gdk.cairo_surface_create_from_pixbuf(pb, 1, None))
        return False

    def _transition_art(self, surface):
        previous = self.art_surface
        if self._art_tick is not None and not reduce_motion():
            w, h = self.cover.get_allocated_width(), self.cover.get_allocated_height()
            if w > 0 and h > 0:
                previous = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
                self._draw_cover(self.cover, cairo.Context(previous))
        if self._art_tick is not None:
            self.cover.remove_tick_callback(self._art_tick)
            self._art_tick = None
        self._art_previous = previous
        self.art_surface = surface
        if reduce_motion() or self._art_previous is surface:
            self._art_previous = None
            self._art_mix = 1.0
            self.cover.queue_draw()
            return
        self._art_mix = 0.0
        started = None
        def frame(_area, clock):
            nonlocal started
            now = clock.get_frame_time() / 1e6
            if started is None:
                started = now
            u = min(1.0, (now - started) / 0.24)
            self._art_mix = 1 - (1 - u) ** 3
            self.cover.queue_draw()
            if u >= 1:
                self._art_previous = None
                self._art_tick = None
                return False
            return True
        self._art_tick = self.cover.add_tick_callback(frame)

    def _draw_cover(self, area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        # concêntrica com o painel: raio 30 − padding 18 (a capa encosta no canto)
        radius = MEDIA_COVER_R
        cr.save()
        rounded_rect(cr, 0, 0, w, h, radius)
        cr.clip()
        cr.push_group()
        if self._art_previous is not None or self._art_mix < 1:
            self._paint_art(cr, self._art_previous, w, h, 1 - self._art_mix)
        self._paint_art(cr, self.art_surface, w, h, self._art_mix)
        cr.pop_group_to_source()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.paint()
        cr.restore()

    def _paint_art(self, cr, s, w, h, alpha):
        if alpha <= 0:
            return
        cr.save()
        cr.push_group()
        cr.set_operator(cairo.OPERATOR_OVER)
        if s is None:
            g = cairo.LinearGradient(0, 0, w, h)
            g.add_color_stop_rgba(0, 0.36, 0.52, 0.86, 0.55)
            g.add_color_stop_rgba(1, 0.62, 0.66, 0.74, 0.35)
            cr.set_source(g)
            cr.paint()
            cr.set_source_rgba(1, 1, 1, 0.75)
            cr.select_font_face("Symbols Nerd Font")
            cr.set_font_size(min(w, h) * 0.38)
            ext = cr.text_extents(I["note"])
            cr.move_to((w - ext.width) / 2 - ext.x_bearing, (h - ext.height) / 2 - ext.y_bearing)
            cr.show_text(I["note"])
        else:
            sw, sh = s.get_width(), s.get_height()
            k = max(w / sw, h / sh)
            cr.translate((w - sw * k) / 2, (h - sh * k) / 2)
            cr.scale(k, k)
            cr.set_source_surface(s, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint()
        cr.pop_group_to_source()
        cr.set_operator(cairo.OPERATOR_ADD)
        cr.paint_with_alpha(alpha)
        cr.restore()


# ───────────────────────────── área de transferência ─────────────────────────────

CLIP_DIR = os.path.expanduser("~/.cache/hyprmac/clipboard")
CLIP_INDEX = os.path.join(CLIP_DIR, "index.json")
CLIP_KEEP_S = 8 * 3600
TERMINALS = ("ghostty", "kitty", "konsole", "alacritty", "foot", "wezterm", "xterm",
             "gnome-terminal", "terminator", "tilix")


def clip_ago(t):
    m = int((time.time() - t) // 60)
    if m < 1:
        return "Now"
    return f"{m} min ago" if m < 60 else f"{m // 60} hr ago"   # interface em inglês, como no Mac


class ClipboardPanel:
    """Histórico da área de transferência (o que o hyprmac-clipboard guarda).
    Abre como o scratchpad: no centro, na frente de tudo, com a tela esmaecida
    atrás. Digitar filtra, ↑↓ escolhem, Enter/clique colam, Esc ou clique fora fecham."""

    W, H = 600, 470

    def __init__(self):
        self.open = False
        self.items = []
        register_panel(self)
        # camada da tela inteira: o fundo esmaecido é a própria janela
        # (teclado exclusivo; o clique fora do painel cai no fundo e fecha)
        self.win = layer_window("hyprmac-clipboard", LS.Layer.OVERLAY,
                                anchors=(E.TOP, E.BOTTOM, E.LEFT, E.RIGHT), exclusive=-1,
                                keyboard=LS.KeyboardMode.EXCLUSIVE)
        add_class(self.win, "clip-backdrop")
        # a janela é "app-paintable": o fundo esmaecido do CSS é pintado aqui
        self.win.connect("draw", lambda w, cr: Gtk.render_background(
            w.get_style_context(), cr, 0, 0, w.get_allocated_width(), w.get_allocated_height()))
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect("button-press-event", self._backdrop_click)
        self.win.connect("key-press-event", self._on_key)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self.panel, "clip-panel")
        self.panel.set_size_request(self.W, self.H)
        self.panel.set_halign(Gtk.Align.CENTER)
        self.panel.set_valign(Gtk.Align.CENTER)

        head = Gtk.Box(spacing=8)
        add_class(head, "clip-head")
        head.pack_start(label("Clipboard", "clip-title"), True, True, 0)
        # Tahoe (Mac User Guide ▸ Clipboard history): "click the More button to the right of
        # the search field, then choose Clear History"
        self.clear_btn = Gtk.Button()
        add_class(self.clear_btn, "clip-pill", "clip-more")
        self.clear_btn.add(label(G("f01d8"), "icon", 0.5))
        self.clear_btn.set_tooltip_text("More")
        self.clear_btn.connect("clicked", self._more_menu)
        head.pack_end(self.clear_btn, False, False, 0)

        self.search = Gtk.SearchEntry()
        self._cocoa_keys = CocoaEntryKeys(self.search)
        add_class(self.search, "clip-search")
        self.search.set_placeholder_text("Search History")
        self.search.connect("search-changed", lambda _e: self.list.invalidate_filter())
        self.search.connect("activate", lambda _e: self._paste_selected())

        self.list = Gtk.ListBox()
        add_class(self.list, "clip-list")
        self.list.set_selection_mode(Gtk.SelectionMode.BROWSE)
        self.list.set_filter_func(self._filter)
        self.list.set_activate_on_single_click(True)
        self.list.connect("row-activated", lambda _l, row: self._paste(row.item))
        self.scroll = scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.list)
        self.empty = label("Nothing copied in the last 8 hours", "clip-empty", xalign=0.5)
        self.empty.set_no_show_all(True)

        self.foot = label("", "clip-foot")
        self.panel.pack_start(head, False, False, 0)
        self.panel.pack_start(self.search, False, False, 0)
        self.panel.pack_start(scroll, True, True, 0)
        self.panel.pack_start(self.empty, True, True, 0)
        self.panel.pack_end(self.foot, False, False, 0)

        # o painel engole os cliques (não chegam ao fundo)
        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        ev.add(self.panel)
        ev.set_halign(Gtk.Align.CENTER)
        ev.set_valign(Gtk.Align.CENTER)
        ev.connect("button-press-event", lambda *_: True)
        self.win.add(ev)
        ev.show_all()

    # ── abrir/fechar ──
    def toggle(self):
        self.hide() if self.open else self.show()

    def show(self):
        close_other_panels(self)
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)
        self.open = True
        self._load()
        self.search.set_text("")
        self.win.show()
        self.search.grab_focus()

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        self.win.hide()
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.EXCLUSIVE)

    def preview(self, *_):
        """Testes: mostra o histórico por 2 s sem pegar o teclado."""
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.NONE)
        self.show()
        GLib.timeout_add(2000, lambda: self.hide() and False)

    def _backdrop_click(self, _w, ev):
        self.hide()
        return True

    def _on_key(self, _w, ev):
        if is_modified_arrow(ev):
            return False
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            self.hide()
            return True
        # "select the item and press Command-C": no Linux o copiar dos apps é Ctrl+C
        # (Super+C fecha a janela no Hyprland); só sem texto selecionado no campo
        if (k in (Gdk.KEY_c, Gdk.KEY_C) and ev.state & Gdk.ModifierType.CONTROL_MASK
                and not self.search.get_selection_bounds()):
            row = self._selected_row()
            if row is not None:
                in_thread(self._to_clipboard, row.item)
            return True
        if k in (Gdk.KEY_Down, Gdk.KEY_Up):
            rows = [r for r in self.list.get_children() if self._filter(r)]
            if not rows:
                return True
            cur = self.list.get_selected_row()
            i = rows.index(cur) if cur in rows else -1
            i = min(len(rows) - 1, i + 1) if k == Gdk.KEY_Down else max(0, i - 1)
            self.list.select_row(rows[i])
            rows[i].grab_focus()
            self.search.grab_focus_without_selecting()
            return True
        return False

    # ── conteúdo ──
    def _load(self):
        try:
            with open(CLIP_INDEX) as f:
                items = json.load(f)
        except (OSError, ValueError):
            items = []
        now = time.time()
        self.items = [i for i in items if now - i.get("t", 0) < CLIP_KEEP_S]
        for row in self.list.get_children():
            row.destroy()
        for item in self.items:
            self.list.add(self._row(item))
        self.list.show_all()
        has = bool(self.items)
        self.empty.set_visible(not has)
        self.scroll.set_visible(has)
        n = len(self.items)
        self.foot.set_text(f"{n} {'item' if n == 1 else 'items'}  ·  ↩ Paste  ·  ⌃C Copy  ·  esc Close"
                           if has else "esc Close")
        first = self.list.get_row_at_index(0)
        if first:
            self.list.select_row(first)

    def _row(self, item):
        row = Gtk.ListBoxRow()
        row.item = item
        box = Gtk.Box(spacing=12)
        add_class(box, "clip-row")
        kind = item.get("kind")
        if kind == "image":
            pb = None
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(item.get("thumb") or item["file"], 44, 44, True)
            except Exception:
                pass
            cache = {}
            thumb = Gtk.DrawingArea()
            thumb.set_size_request(44, 44)
            thumb.connect("draw", lambda a, cr: paint_cover(
                cr, pb, a.get_allocated_width(), a.get_allocated_height(), radius=8, cache=cache)
                if pb else None)
            box.pack_start(thumb, False, False, 0)
            text = f"Image  ·  {item.get('w')}×{item.get('h')}"
            row.search = "image imagem"
        else:
            icon = (label(I["folder"], "icon clip-kind", 0.5) if kind == "files"
                    else label("Aa", "clip-kind clip-kind-text", 0.5))
            icon.set_size_request(44, 44)
            box.pack_start(icon, False, False, 0)
            raw = item.get("text", "")
            if kind == "files":
                names = [urllib.parse.unquote(os.path.basename(u.rstrip("/"))) for u in raw.split()]
                text = ", ".join(n for n in names if n)
            else:
                text = " ".join(raw.split())
            row.search = raw.lower()
        main = label(text[:300], "clip-text")
        main.set_ellipsize(3)
        main.set_lines(2)
        main.set_line_wrap(True)
        main.set_line_wrap_mode(2)
        main.set_max_width_chars(48)
        box.pack_start(main, True, True, 0)
        # "Click the copy icon to the right of the item" (copia sem colar)
        copy = Gtk.Button()
        add_class(copy, "clip-copy")
        copy.set_relief(Gtk.ReliefStyle.NONE)
        copy.set_can_focus(False)
        copy.set_valign(Gtk.Align.CENTER)
        copy.add(label(G("f018f"), "icon", 0.5))
        copy.set_tooltip_text("Copy")
        copy.connect("clicked", lambda _b, it=item: in_thread(self._to_clipboard, it))
        box.pack_end(copy, False, False, 0)
        box.pack_end(label(clip_ago(item["t"]), "clip-time", xalign=1.0), False, False, 0)
        row.add(box)
        return row

    def _filter(self, row):
        q = self.search.get_text().strip().lower()
        return not q or q in getattr(row, "search", "")

    # ── colar ──
    def _selected_row(self):
        row = self.list.get_selected_row()
        if row is None or not self._filter(row):
            row = next((r for r in self.list.get_children() if self._filter(r)), None)
        return row

    def _paste_selected(self):
        row = self._selected_row()
        if row is not None:
            self._paste(row.item)

    def _paste(self, item):
        self.hide()
        in_thread(self._do_paste, item)

    @staticmethod
    def _to_clipboard(item):
        if item.get("kind") == "image":
            with open(item["file"], "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], stdin=f)
        else:
            # como no macOS: o histórico cola texto puro
            subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"],
                           input=item.get("text", "").encode())

    @staticmethod
    def _do_paste(item):
        ClipboardPanel._to_clipboard(item)
        time.sleep(0.2)   # o teclado volta para a janela de antes
        cls = (hypr_json("activewindow") or {}).get("class", "").lower()
        mods = "CTRL SHIFT" if any(t in cls for t in TERMINALS) else "CTRL"
        run("hyprctl dispatch " + GLib.shell_quote(
            f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "v" }})'))

    def _more_menu(self, button):
        menu = Gtk.Menu()
        add_class(menu, "xmenu")
        mi = Gtk.MenuItem(label="Clear History")
        mi.set_sensitive(bool(self.items))
        mi.connect("activate", lambda _m: self._clear())
        menu.append(mi)
        menu.show_all()
        menu.popup_at_widget(button, Gdk.Gravity.SOUTH_EAST, Gdk.Gravity.NORTH_EAST, None)

    def _clear(self):
        spawn(os.path.join(ROOT, "scripts", "clipboard") + " clear")
        self.items = []
        for row in self.list.get_children():
            row.destroy()
        GLib.timeout_add(300, lambda: self.open and self._load() and False)


