def pointer_origin(win, base):
    """Ponto do ponteiro dentro da camada (anchors TOP + LEFT/RIGHT em `base`), se ele
    estiver sobre a barra — senão None (centro do topo)."""
    cur = hypr_json("cursorpos") or {}
    mon = next((m for m in hypr_json("monitors")
                if m["x"] <= cur.get("x", -1) < m["x"] + m["width"]), None)
    if not mon or cur.get("y", 999) - mon["y"] > 30:
        return None
    w = win.get_preferred_size()[1].width
    x = cur["x"] - mon["x"]
    if E.LEFT in base:
        left = base[E.LEFT]
    else:
        left = mon["width"] - base.get(E.RIGHT, 0) - w
    return x - left, 0


