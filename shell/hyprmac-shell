def nm_fields(line):
    """Campos de uma linha do nmcli -t (os ':' dentro dos valores vêm escapados)."""
    return [p.replace("\\:", ":").replace("\\\\", "\\") for p in re.split(r"(?<!\\):", line)]


def cursor_on_monitor():
    """(x, y do cursor no monitor, largura lógica do monitor, Gdk.Monitor, nome)."""
    cur = hypr_json("cursorpos") or {"x": 0, "y": 0}
    for m in hypr_json("monitors"):
        scale = m.get("scale") or 1
        w, h = m["width"] / scale, m["height"] / scale
        if m["x"] <= cur["x"] < m["x"] + w and m["y"] <= cur["y"] < m["y"] + h:
            return (cur["x"] - m["x"], cur["y"] - m["y"], w,
                    gdk_monitors()[0].get(m["name"]), m["name"])
    return 0, 0, 0, None, None


class BarPanel:
    """Menu de vidro preso sob um extra da barra. O Waybar não diz onde fica o
    ícone: usamos a posição do cursor no clique (como o menu Janela) e alinhamos
    a borda esquerda do menu à do ícone, sem passar da borda direita da tela.

    Subclasses: fetch() (em thread) → dados; build(dados) monta as linhas;
    signature(dados) decide se precisa remontar; update(dados) para valores vivos."""

    W = XM_W
    POLL_S = 3

    def __init__(self, hosted=False):
        self.open = False
        self.data = None
        self._sig = None
        self._poll = None
        # hosted: o mesmo menu vira a "vista detalhada" de um módulo da Central de
        # Controle (como no Tahoe, Wi‑Fi/Bluetooth/Som abrem ali mesmo, sem janela
        # externa). Sem janela própria: a Central mostra self.box e chama
        # open_hosted()/stop(); escolher um item fecha a Central (on_close).
        self.hosted = hosted
        self.on_close = None
        self.on_back = None
        self.on_ready = None
        if hosted:
            self.win = self.catchers = None
            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            add_class(self.box, "xmenu", "cc-detail")
            self.box.set_size_request(W4, -1)
            return
        register_panel(self)
        self.catchers = ClickCatchers("hyprmac-extras-catcher", self.hide)
        self.win = layer_window("hyprmac-extras", LS.Layer.OVERLAY, anchors=(E.TOP, E.LEFT),
                                margins={E.TOP: XM_TOP, E.LEFT: 10},
                                keyboard=LS.KeyboardMode.ON_DEMAND)
        add_class(self.win, "xmenu-win")
        self.win.connect("key-press-event",
                         lambda _w, ev: ev.keyval == Gdk.KEY_Escape and self.hide())
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self.box, "xmenu")
        self.box.set_size_request(self.W, -1)
        self.win.add(self.box)
        self.box.show()

    # ── abrir/fechar ──
    def toggle(self, arg=""):
        self.hide() if self.open else self.show()

    def show(self):
        close_other_panels(self)
        x, y, mon_w, gmon, mon = cursor_on_monitor()
        if gmon:
            LS.set_monitor(self.win, gmon)
        left = x - 15                      # borda esquerda da cápsula do ícone
        if mon_w:
            left = min(left, mon_w - self.W - 2 - 10)
        self._left = max(10, round(left))
        self._origin = (x - self._left, 0)        # o ícone, dentro do menu
        LS.set_margin(self.win, E.LEFT, self._left)
        self.placed(x, y)
        self.open = True
        self.catchers.show()
        # Reabrir não espera outra consulta a nmcli/bluetoothctl/pactl para
        # começar a materializar. O conteúdo conhecido permanece interativo
        # enquanto a leitura assíncrona atualiza os estados reais.
        if self.data is not None:
            self.win.show()
            emerge(self.win, {E.TOP: XM_TOP, E.LEFT: self._left}, self._origin)
        in_thread(self._fetch)
        self._poll = GLib.timeout_add_seconds(self.POLL_S, self._tick)

    def placed(self, x, y):
        pass

    def open_hosted(self):
        """Dentro da Central: busca os dados e passa a atualizar sozinho."""
        self.open = True
        in_thread(self._fetch)
        self._poll = GLib.timeout_add_seconds(self.POLL_S, self._tick)

    def stop(self):
        self.open = False
        if self._poll:
            GLib.source_remove(self._poll)
            self._poll = None

    def hide(self):
        if self.hosted:
            self.stop()
            if self.on_close:
                self.on_close()
            return
        if not self.open:
            return
        self.open = False
        if self._poll:
            GLib.source_remove(self._poll)
            self._poll = None
        self.win.hide()
        stop_emerge(self.win, {E.TOP: XM_TOP, E.LEFT: self._left})
        self.catchers.hide()

    def _tick(self):
        in_thread(self._fetch)
        return True

    def refresh_soon(self, ms=700):
        def go():
            if self.open:
                in_thread(self._fetch)
            return False
        GLib.timeout_add(ms, go)

    def _fetch(self):
        data = self.fetch()
        GLib.idle_add(self._apply, data)

    def _apply(self, data):
        if not self.open:
            return False
        self.data = data
        sig = self.signature(data)
        if sig != self._sig:
            self._sig = sig
            self.rebuild()
        self.update(data)
        if self.hosted:
            if self.on_ready:
                self.on_ready()
            return False
        if not self.win.get_visible():
            self.win.show()
            emerge(self.win, {E.TOP: XM_TOP, E.LEFT: self._left}, self._origin)
        return False

    def rebuild(self):
        for ch in self.box.get_children():
            ch.destroy()
        self.build(self.data)
        self.box.show_all()
        if self.win:
            self.win.resize(1, 1)

    def signature(self, data):
        return repr(data)

    def update(self, data):
        pass

    # ── peças do menu ──
    def _button(self, action, close):
        b = Gtk.Button()
        add_class(b, "xm-item")
        b.set_relief(Gtk.ReliefStyle.NONE)
        if action:
            def clicked(_b):
                if not close:
                    action()
                    return
                # O estado pressed já fornece feedback; esperar mais 120 ms depois
                # do release fazia o menu parecer lento em sequências rápidas.
                self.hide()
                action()
            b.connect("clicked", clicked)
        return b

    def item(self, text, action, close=True, sensitive=True):
        b = self._button(action, close)
        b.add(label(text, "xm-label"))
        b.set_sensitive(sensitive)
        self.box.pack_start(b, False, False, 0)
        return b

    def head(self, text):
        self.box.pack_start(label(text, "xm-head"), False, False, 0)

    def note(self, text):
        self.box.pack_start(label(text, "xm-note"), False, False, 0)

    def sep(self):
        s = Gtk.Box()
        add_class(s, "xm-sep")
        self.box.pack_start(s, False, False, 0)

    def title_row(self, title, on=None, on_toggle=None, sensitive=True):
        """Título Bold 13 com interruptor à direita (Wi‑Fi, Bluetooth)."""
        row = Gtk.Box(spacing=8)
        add_class(row, "xm-title-row")
        if self.hosted and self.on_back:
            back = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.MENU)
            back.set_tooltip_text("Back to Control Center")
            back.get_accessible().set_name("Back to Control Center")
            back.connect("clicked", lambda _button: self.on_back())
            row.pack_start(back, False, False, 0)
        row.pack_start(label(title, "xm-title"), True, True, 0)
        if on is not None:
            sw = Gtk.Switch()
            add_class(sw, "xm-switch")
            sw.set_active(on)
            sw.set_valign(Gtk.Align.CENTER)
            sw.set_sensitive(sensitive)
            # Add transition duration for smooth state change animation
            sw.get_style_context().add_class("xm-switch")
            if on_toggle:
                sw.connect("notify::active", lambda s, _p: on_toggle(s.get_active()))
            row.pack_end(sw, False, False, 0)
        self.box.pack_start(row, False, False, 0)
        return row

    def disclosure(self, text, expanded, on_click):
        """Cabeçalho que abre/fecha um grupo ("Other Networks ›")."""
        b = self._button(on_click, close=False)
        add_class(b, "xm-disclosure")
        row = Gtk.Box(spacing=6)
        row.pack_start(label(text, "xm-head-in"), True, True, 0)
        b._chevron = label(I["chev_d"] if expanded else I["chev_r"], "icon xm-chev", 0.5)
        row.pack_end(b._chevron, False, False, 0)
        b.add(row)
        self.box.pack_start(b, False, False, 0)
        return b

    def reveal_group(self, expanded):
        group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        revealer = Gtk.Revealer()
        revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        # Mesmos 240 ms estimados da expansão interna da Central; sem vídeo
        # nativo equivalente. A inversão usa o progresso atual do GTK.
        revealer.set_transition_duration(0 if reduce_motion() else 240)
        revealer.add(group)
        revealer.set_reveal_child(expanded)
        self.box.pack_start(revealer, False, False, 0)
        return revealer, group

    def device(self, glyph, name, on, action=None, right=None, sub=None, close=True,
               right_icon=False, right_dynamic=False, container=None):
        """Linha com círculo de 26 (azul = em uso), nome e detalhe à direita."""
        if action:
            w = self._button(action, close)
