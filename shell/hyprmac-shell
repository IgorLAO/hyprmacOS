    # ── abrir/fechar ──
    def toggle(self):
        self.hide() if self.open else self.show()

    def edit(self):
        """Abre a central já em "Editar Controles"."""
        if not self.open:
            self.show()
        self._set_editing(True)

    def show(self):
        close_other_panels(self)
        self.open = True
        self._place()
        for c in self.catchers:
            c.show_all()
        base = {E.TOP: CC_TOP - CC_BLEED, E.RIGHT: CC_RIGHT}
        origin = pointer_origin(self.win, base)
        self.win.show_all()
        # brota do ícone da Central na barra (ou do canto, aberta por atalho)
        emerge(self.win, base, origin or (self.win.get_preferred_size()[1].width, 0))
        self._sync_mic()
        self.refresh()
        self._poll = GLib.timeout_add_seconds(2, self._tick)
        self._notify_bar()

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        if self.editing:
            self._set_editing(False)
        self.close_detail(animate=False)
        if self._resize_anim is not None:
            self.win.remove_tick_callback(self._resize_anim)
            self._resize_anim = None
            self._clip_to(self.grid.get_preferred_height()[1])
        GLib.source_remove(self._poll)
        self.win.hide()
        stop_emerge(self.win, {E.TOP: CC_TOP - CC_BLEED, E.RIGHT: CC_RIGHT})
        for c in self.catchers:
            c.hide()
        self._notify_bar()

    def _place(self):
        """Abre no monitor em foco."""
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)

    def _notify_bar(self):
        try:
            if self.open:
                open(CC_STATE, "w").close()
            elif os.path.exists(CC_STATE):
                os.remove(CC_STATE)
        except OSError:
            pass
        spawn("pkill -RTMIN+8 -x waybar")

    def _on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            if self._detail:
                self.close_detail()
            elif self.editing:
                self._set_editing(False)
            else:
                self.hide()
            return True
        return False

    def preview(self, key=""):
        """Testes: abre a Central (e a vista de um módulo, ou "edit") sem pegar o teclado e
        fecha sozinha em 2 s — para prints enquanto alguém usa o computador."""
        if self.open:
            return
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.NONE)
        self.show()
        if key in self.details:
            GLib.timeout_add(300, lambda: self.open_detail(key) and False)
        elif key == "edit":
            GLib.timeout_add(300, lambda: self._set_editing(True) and False)

        def done():
            if self.editing:
                self._set_editing(False)
            self.hide()
            LS.set_keyboard_mode(self.win, LS.KeyboardMode.ON_DEMAND)
            return False
        GLib.timeout_add(2000, done)

    # ── vista detalhada de um módulo ──
    def open_detail(self, key):
        menu = self.details[key]
        if self._detail is menu:
            return self.close_detail()
        self.close_detail(animate=False)
        if getattr(menu, "show_other", False):
            menu.show_other = False
            if menu.data is not None:
                menu.rebuild()
        self._detail = menu
        menu.open_hosted()
        # Na primeira consulta, conservar a grade até existir conteúdo real.
        # Animar uma caixa vazia fazia o painel colapsar e saltar ao receber os
        # dispositivos. Na reabertura, o conteúdo conhecido aparece já.
        if menu.data is not None:
            self._show_detail(menu)

    def _show_detail(self, menu):
        if not self.open or self._detail is not menu:
            return
        if self.stack.get_visible_child_name() == "detail":
            return
        for child in self.detail_holder.get_children():
            if child is not menu.box:
                self.detail_holder.remove(child)
        # A animação de saída pode ainda manter esta caixa no holder.
        if menu.box.get_parent() is None:
            self.detail_holder.pack_start(menu.box, False, False, 0)
        menu.box.show_all()
        self.stack.set_visible_child_full(
            "detail", Gtk.StackTransitionType.NONE if reduce_motion()
            else Gtk.StackTransitionType.CROSSFADE)
        self.edit_btn.hide()

    def close_detail(self, animate=True):
        menu, self._detail = self._detail, None
        if menu is None:
            return
        menu.stop()
        self.stack.set_visible_child_full(
            "grid", Gtk.StackTransitionType.CROSSFADE
            if animate and not reduce_motion() else Gtk.StackTransitionType.NONE)
        self._prune_details()
        if not self.editing:
            self.edit_btn.show()

    def _prune_details(self, *_):
        # A vista que está saindo precisa sobreviver até o último frame. O sinal
        # também cobre redução de movimento e mudanças de duração em runtime.
        if self.stack.get_transition_running():
            return
        for child in self.detail_holder.get_children():
            if self._detail is None or child is not self._detail.box:
                self.detail_holder.remove(child)
        self.win.resize(1, 1)

    def _launch(self, cmd):
        self.hide()
        spawn(cmd)

    # ── arranjo e edição (como "Editar Controles" do Tahoe) ──
    def _load_layout(self):
        try:
            with open(CONTROLS_PATH) as f:
                items = [(k, sz) for k, sz in json.load(f)]
        except (OSError, ValueError, TypeError):
            return list(DEFAULT_CONTROLS)
        return [(k, sz if sz in self.catalog[k][1] else self.catalog[k][1][0])
                for k, sz in items if k in self.catalog]

    def _save_layout(self):
        try:
            os.makedirs(os.path.dirname(CONTROLS_PATH), exist_ok=True)
            with open(CONTROLS_PATH, "w") as f:
                json.dump(self.layout, f)
        except OSError:
            pass

    def _build_grid(self):
        """Encaixa os controles em 4 colunas, na ordem, no primeiro lugar livre."""
        for child in self.grid.get_children():
            # solta os controles (são reaproveitados); fantasmas são descartados
            for w in (child.get_children() if isinstance(child, Gtk.Overlay) else ()):
                if isinstance(w, (Circle, Tile, SliderTile, NowPlaying)):
                    child.remove(w)
            self.grid.remove(child)
        used = set()
        self.wrappers = []
        for idx, (key, size) in enumerate(self.layout):
            cw, ch = SPANS[size]
            row = 0
            while True:
                col = next((c for c in range(5 - cw)
                            if all((c + dx, row + dy) not in used
                                   for dx in range(cw) for dy in range(ch))), None)
                if col is not None:
                    break
                row += 1
            used |= {(col + dx, row + dy) for dx in range(cw) for dy in range(ch)}
            wrap = self._wrapper(idx, key, size)
            self.grid.attach(wrap, col, row, cw, ch)
            self.wrappers.append(wrap)
        # Círculos fantasmas (Tahoe, ao editar): vidro bem fraco, sem ícone, em
        # cada espaço livre até completar a última linha e mais uma linha inteira.
        rows = max((r for _c, r in used), default=-1) + 2
        self.ghosts = []
        for r in range(rows):
            for c in range(4):
                if (c, r) in used:
                    continue
                g = label("", "ghost")
                g.set_size_request(C, C)
                g.set_margin_start(CC_BLEED)
                g.set_margin_top(CC_BLEED)
                g.set_halign(Gtk.Align.CENTER)
                g.set_valign(Gtk.Align.CENTER)
                g.set_no_show_all(True)
                g.set_visible(self.editing)
                self.grid.attach(g, c, r, 1, 1)
                self.ghosts.append(g)
        self._build_gallery()
        self._sync_mic()
        if hasattr(self, "clip"):
            self._clip_to(self.grid.get_preferred_height()[1])
        self.win.resize(1, 1)

    def _wrapper(self, idx, key, size):
        ctl, sizes = self.catalog[key]
        widget = ctl.widget(size)
        widget.set_margin_start(CC_BLEED)
        widget.set_margin_top(CC_BLEED)
        ov = Gtk.Overlay()
        ov.add(widget)
        widget.show_all()
        # no modo de edição, uma película por cima recebe os cliques/arrastos
        shield = Gtk.EventBox()
        shield.set_visible_window(False)
        shield.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                          | Gdk.EventMask.POINTER_MOTION_MASK)
        shield.connect("button-press-event", self._edit_press, idx)
        shield.connect("motion-notify-event", self._edit_motion)
        shield.connect("button-release-event", self._edit_release, idx)
        # Tahoe (Mac User Guide ▸ Use Control Center): arrastar move, arrastar para fora
        # remove, Control-clique escolhe outro tamanho
        if len(sizes) > 1:
            shield.set_tooltip_text("Drag to move · Control-click to change size")
        else:
            shield.set_tooltip_text("Drag to move")
        ov.add_overlay(shield)
        rm = Gtk.Button()
        add_class(rm, "ctl-remove")
        rm.add(label("−", xalign=0.5))
        rm.set_halign(Gtk.Align.START)
        rm.set_valign(Gtk.Align.START)
        rm.set_tooltip_text("Remove")
        rm.connect("clicked", lambda _b: self._remove(idx))
        ov.add_overlay(rm)
        for w in (shield, rm):
            w.show_all()
            w.set_no_show_all(True)
            w.set_visible(self.editing)
        ov.show()
        ov.key = key
        return ov

    # ── Galeria de Controles (CC-06) ──
    def _build_gallery_shell(self):
        """Moldura fixa da galeria: busca + categorias à esquerda, controles à
        direita (remontados por _build_gallery), rodapé com o Done azul."""
