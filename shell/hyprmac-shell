def update_app_menus(classe):
    """Publica o foco uma vez e atualiza os módulos de menu da Waybar."""
    classe = classe or ""
    if getattr(update_app_menus, "_last", None) == classe:
        return False
    data = json.dumps({"pid": os.getpid(), "class": classe})
    temp = ACTIVE_CLASS_STATE + f".{os.getpid()}"
    with open(temp, "w") as f:
        f.write(data)
    os.replace(temp, ACTIVE_CLASS_STATE)
    update_app_menus._last = classe
    spawn("pkill -RTMIN+11 -x waybar")
    return False


