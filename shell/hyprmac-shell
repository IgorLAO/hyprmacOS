def gdk_monitors():
    """Mapeia nome do monitor do Hyprland → Gdk.Monitor (pela posição)."""
    display = Gdk.Display.get_default()
    gmons = [display.get_monitor(i) for i in range(display.get_n_monitors())]
    try:
        hmons = json.loads(run("hyprctl monitors -j"))
    except ValueError:
        hmons = []
    out = {}
    for hm in hmons:
        for gm in gmons:
            geo = gm.get_geometry()
            if (geo.x, geo.y) == (hm["x"], hm["y"]):
                out[hm["name"]] = gm
    return out, gmons


