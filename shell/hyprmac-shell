def app_name(cls):
    if not cls:
        return "Window"
    known = APP_NAMES.get(cls.lower())
    if known:
        return known
    base = cls.split(".")[-1] if "." in cls else cls
    return base[:1].upper() + base[1:]


def hypr_json(what):
    expected = dict if what in ("activewindow", "activeworkspace", "cursorpos") else list
    try:
        data = json.loads(run(f"hyprctl {what} -j"))
    except ValueError:
        return expected()
    return data if isinstance(data, expected) else expected()


def dispatch(lua):
    spawn("hyprctl dispatch " + GLib.shell_quote(lua))


class ShellMenu:
    """Menu da barra montado na hora (Gtk.Menu), com o visual dos menus do kit.

    Um Gtk.Menu precisa de uma superfície-mãe: usamos uma camada invisível de
    1×30 px sobre a barra, na posição do cursor, e abrimos o menu logo abaixo.
    Só um menu do shell fica aberto por vez (e nenhum painel junto)."""

    current = None

    def __init__(self):
        self.anchor_win = None
        self.menu = None

    def popup(self):
        if self.menu is not None:          # clicar de novo fecha
            self.menu.popdown()
            self._closed()                 # popdown() nem sempre emite "deactivate"
            return
        other = ShellMenu.current
        if other is not None and other.menu is not None:
            other.menu.popdown()
            other._closed()
        close_other_panels(None)
        cur = hypr_json("cursorpos") or {"x": 0, "y": 0}
        mon_name, mon_x = None, 0
        for m in hypr_json("monitors"):
            if m["x"] <= cur["x"] < m["x"] + m["width"] and m["y"] <= cur["y"] < m["y"] + m["height"]:
                mon_name, mon_x = m["name"], m["x"]
        gmon = gdk_monitors()[0].get(mon_name)

        win = layer_window("hyprmac-menu", LS.Layer.TOP, gmon, anchors=(E.TOP, E.LEFT),
                           margins={E.LEFT: max(0, cur["x"] - mon_x - 16)}, exclusive=-1)
        area = Gtk.Box()
        area.set_size_request(1, 30)
        win.add(area)
        self.anchor_win = win

        menu = menu_check_column(self._build())
        menu.connect("deactivate", lambda _m: GLib.idle_add(self._closed, _m))
        self.menu = menu
        ShellMenu.current = self
        # Abrir após mapear a âncora, sem uma espera arbitrária. Um clique rápido
        # pode fechar/trocar o menu antes deste idle; nesse caso não o ressuscitar.
        def present():
            if self.menu is menu and self.anchor_win is win and area.get_mapped():
                menu.popup_at_widget(area, Gdk.Gravity.SOUTH_WEST,
                                     Gdk.Gravity.NORTH_WEST, None)
            return False
        area.connect("map", lambda *_: GLib.idle_add(present))
        win.show_all()

    def _closed(self, expected_menu=None):
        if expected_menu is not None and self.menu is not expected_menu:
            return False
        if self.menu is None and self.anchor_win is None:
            return False
        self.menu = None
        if ShellMenu.current is self:
            ShellMenu.current = None
        if self.anchor_win:
            self.anchor_win.destroy()
            self.anchor_win = None
        return False

    # ── conteúdo ──
    @staticmethod
    def _new_menu():
        m = Gtk.Menu()
        m.set_reserve_toggle_size(False)
        add_class(m, "hyprmac-menu")
        return m

    @staticmethod
    def _attach_submenu(item, submenu):
        # Menus.txt distingue Hover (seleção) de Submenu/Open (tint neutro).
        # O estado acompanha o popup real, tanto pelo mouse quanto pelo teclado.
        item.set_submenu(submenu)
        # Chevron do kit (􀆊 Bold 13, cinza dos atalhos) no lugar da seta do tema GTK
        box = menu_item_box(item)
        chevron = label(MENU_CHEVRON, "shortcut chevron", 1.0)
        chevron.set_margin_start(24)
        box.pack_end(chevron, False, False, 0)
        chevron.show()
        submenu.connect("map", lambda _menu: set_class(item, "submenu-open", True))
        submenu.connect("unmap", lambda _menu: set_class(item, "submenu-open", False))

    def _item(self, menu, text, action=None, markup=False, sensitive=True, submenu=None,
              shortcut=None, check=None, icon_name=None):
        """Item de 24 px; `shortcut` (ex.: "⌘H") vai à direita, em cinza; `check`
        True/False faz dele um item de estado (coluna da marca, menu_check_column)."""
        it = Gtk.MenuItem()
        lb = Gtk.Label(xalign=0)
        (lb.set_markup if markup else lb.set_text)(text)
        if shortcut:
            box = Gtk.Box()
            box.pack_start(lb, True, True, 0)
            sc = label(shortcut, "shortcut", 1.0)
            sc.set_margin_start(24)
            box.pack_end(sc, False, False, 0)
            it.add(box)
        else:
            it.add(lb)
        if check is not None:
            menu_check(it, check)
        if icon_name:
            if not Gtk.IconTheme.get_default().has_icon(icon_name):
                icon_name = "application-x-executable-symbolic"
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            icon.set_pixel_size(14)
            icon.set_size_request(16, 16)
            icon.set_margin_end(8)
            box = menu_item_box(it)
            box.pack_start(icon, False, False, 0)
            box.reorder_child(icon, 0)
        it.set_sensitive(sensitive)
        if submenu is not None:
            self._attach_submenu(it, submenu)
        elif action:
            it.connect("activate", lambda _i: action())
        menu.append(it)
        return it

    def _sep(self, menu):
        menu.append(Gtk.SeparatorMenuItem())

    def _build(self):
        raise NotImplementedError


APPS = None     # AppIndex compartilhado (nomes/ícones dos .desktop), criado em main()
A11Y_PATH = os.path.expanduser("~/.config/hyprmac/acessibilidade.json")
A11Y = {"reduce_transparency": False, "increase_contrast": False}   # hyprmac-acessibilidade

# Ajustes ▸ Aparência ▸ Estilo de ícones e widgets: default · dark · clear · tinted
APPEARANCE_PATH = os.path.expanduser("~/.config/hyprmac/aparencia.json")
ICON_STYLES = ("default", "dark", "clear", "tinted")


def icon_style():
    try:
        with open(APPEARANCE_PATH) as f:
            v = json.load(f).get("icon_style", "default")
        return v if v in ICON_STYLES else "default"
    except (OSError, ValueError, AttributeError):
        return "default"


def icon_style_effective():
    """O estilo que o Dock desenha (Ajustes ▸ Aparência, referencias/telas/clear-dark-1 e
    dark-icons-widgets-macos-1): Dark tem "Always / Auto" (Auto = só no tema escuro); Clear
    tem "Light / Dark / Auto" (o vidro dos ícones claro ou escuro)."""
    st = icon_style()
    try:
        with open(APPEARANCE_PATH) as f:
            var = json.load(f).get("icon_style_variant", {})
    except (OSError, ValueError, AttributeError):
        var = {}
    v = var.get(st) if isinstance(var, dict) else None
    if st == "dark" and v == "auto" and not is_dark():
        return "default"
    if st == "clear" and (v == "dark" or (v == "auto" and is_dark())):
        return "clear-dark"
    return st


def set_icon_style(style):
    try:
        with open(APPEARANCE_PATH) as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    d["icon_style"] = style
    os.makedirs(os.path.dirname(APPEARANCE_PATH), exist_ok=True)
    with open(APPEARANCE_PATH, "w") as f:
        json.dump(d, f, indent=1)


def accent_rgb():
    """Cor de destaque atual (gerada por hyprmac-accent em gtk/accent3.css)."""
    try:
        with open(os.path.join(ROOT, "gtk", "accent3.css")) as f:
            m = re.search(r"@define-color mac_accent\s+#([0-9A-Fa-f]{6})", f.read())
        if m:
            h = m.group(1)
            return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except OSError:
        pass
    return (0.0, 122 / 255, 1.0)


def styled_icon(pb, style):
    """Ícone de app no estilo do sistema (Tahoe): Dark escurece mantendo as cores;
    Clear vira vidro monocromático claro; Tinted vira monocromático na cor de destaque.
    Devolve uma superfície do tamanho do pixbuf."""
    w, h = pb.get_width(), pb.get_height()
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(surf)
    orig = Gdk.cairo_surface_create_from_pixbuf(pb, 1, None)
    if style in ("clear", "clear-dark", "tinted"):
        gray = pb.copy()
        pb.saturate_and_pixelate(gray, 0.0, False)
        cr.set_source_surface(Gdk.cairo_surface_create_from_pixbuf(gray, 1, None), 0, 0)
    else:
        cr.set_source_surface(orig, 0, 0)
    cr.paint()
    if style == "dark":
        cr.set_operator(cairo.OPERATOR_ATOP)
        cr.set_source_rgba(0, 0, 0, 0.42)
        cr.paint()
    elif style == "clear":
        cr.set_operator(cairo.OPERATOR_SCREEN)
        cr.set_source_rgba(1, 1, 1, 0.38)
        cr.paint()
    elif style == "clear-dark":                      # vidro escuro: cinza puxado para baixo
        cr.set_operator(cairo.OPERATOR_ATOP)
        cr.set_source_rgba(0, 0, 0, 0.38)
        cr.paint()
    elif style == "tinted":
        cr.set_operator(cairo.OPERATOR_MULTIPLY)
        cr.set_source_rgb(*accent_rgb())
        cr.paint()
        cr.set_operator(cairo.OPERATOR_SCREEN)
        cr.set_source_rgba(*accent_rgb(), 0.28)
        cr.paint()
    cr.set_operator(cairo.OPERATOR_DEST_IN)          # só onde o ícone original existe
    cr.set_source_surface(orig, 0, 0)
    cr.paint()
    return surf


def display_name(cls):
    """Nome do app como na barra ("Brave", "Ghostty"); sem apelido conhecido,
    o Name do .desktop; por último a classe com inicial maiúscula."""
    if not cls:
        return ""
    known = APP_NAMES.get(cls.lower())
    if known:
        return known
    if APPS is not None:
        name = APPS.name(cls)
        if name:
            return name
    return app_name(cls)


