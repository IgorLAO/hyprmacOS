MESES = ["January", "February", "March", "April", "May", "June", "July", "August",
         "September", "October", "November", "December"]


def when_text(ts, now=None):
    """Horário relativo da Central de Notificações (NotificationCenter.app 26.6.1,
    Localizable: now, %dm ago, Yesterday, %d days ago)."""
    now = time.time() if now is None else now
    delta = now - ts
    if delta < 60:
        return "now"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    lt = time.localtime(ts)
    dias = (datetime.date.fromtimestamp(now) - datetime.date.fromtimestamp(ts)).days
    if dias <= 0:
        return f"{lt.tm_hour}:{lt.tm_min:02d}"
    if dias == 1:
        return "Yesterday"
    if dias < 7:
        return f"{dias} days ago"
    return f"{lt.tm_mon}/{lt.tm_mday}/{lt.tm_year % 100:02d}"


class ClickCatchers:
    """Camadas por monitor; deixam a Waybar receber o clique de troca de menu."""

    def __init__(self, namespace, on_click):
        self.windows = []
        for mon in gdk_monitors()[1]:
            c = layer_window(namespace, LS.Layer.TOP, mon,
                             anchors=(E.TOP, E.BOTTOM, E.LEFT, E.RIGHT),
                             margins={E.TOP: BAR_STRIP}, exclusive=-1)
            c.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.TOUCH_MASK)
            c.connect("button-press-event", lambda *_: on_click())
            c.connect("touch-event", lambda *_: on_click())
            self.windows.append(c)

    def show(self):
        for c in self.windows:
            c.show_all()

    def hide(self):
        for c in self.windows:
            c.hide()


class CalendarWidget(Gtk.Box):
    """Widget de calendário do mês, com o dia de hoje num círculo vermelho."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        add_class(self, "notif", "calendar")
        self.refresh()

    def refresh(self):
        import calendar
        for child in self.get_children():
            child.destroy()
        today = time.localtime()
        self.pack_start(label(MESES[today.tm_mon - 1].upper(), "cal-month"), False, False, 0)
        grid = Gtk.Grid(column_homogeneous=True, row_spacing=2)
        for col, d in enumerate("SMTWTFS"):
            grid.attach(label(d, "cal-head", xalign=0.5), col, 0, 1, 1)
        cal = calendar.Calendar(firstweekday=6)          # semana começa no domingo
        for row, week in enumerate(cal.monthdayscalendar(today.tm_year, today.tm_mon), start=1):
            for col, day in enumerate(week):
                if not day:
                    continue
                cls = "cal-day cal-today" if day == today.tm_mday else "cal-day"
                grid.attach(label(str(day), cls, xalign=0.5), col, row, 1, 1)
        self.pack_start(grid, False, False, 0)
        self.show_all()


class NotifPanel:
    """Central de Notificações: abre ao clicar no relógio da barra."""

    def __init__(self, center):
        self.center = center
        self.open = False
        self.max_list_h = 700
        register_panel(self)
        self.catchers = ClickCatchers("hyprmac-nc-catcher", self.hide)
        # mesma coluna dos banners: 16 da direita, 15 abaixo da barra
        self.win = layer_window("hyprmac-nc", LS.Layer.OVERLAY, anchors=(E.TOP, E.RIGHT),
                                margins={E.TOP: NOTIF_TOP, E.RIGHT: NOTIF_RIGHT},
                                keyboard=LS.KeyboardMode.ON_DEMAND)
        add_class(self.win, "nc")
        self.win.connect("key-press-event",
                         lambda _w, ev: ev.keyval == Gdk.KEY_Escape and self.hide())
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_propagate_natural_height(True)
        self.scroll.set_min_content_width(BANNER_W)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.scroll.add(self.list)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        # largura fixa dos cartões (344): com rolagem horizontal NEVER o GTK ignora
        # min_content_width, e a central vazia encolhia para a largura do calendário
        outer.set_size_request(BANNER_W, -1)
        outer.pack_start(self.scroll, True, True, 0)
        self.calendar = CalendarWidget()
        outer.pack_end(self.calendar, False, False, 0)
        self.win.add(outer)
        outer.show_all()

    def toggle(self):
        self.hide() if self.open else self.show()

    def show(self):
        close_other_panels(self)
        # banners na tela passam para a lista
        for nid in list(self.center.banners):
            banner = self.center.banners.pop(nid)
            banner.dismiss()
        self.center.win.hide()
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)
            geo = gmon.get_geometry()
            self.max_list_h = max(200, geo.height - 330)
        self.open = True
        self.calendar.refresh()
        self.refresh()
        self.catchers.show()
        self.win.show()

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        self.win.hide()
        self.catchers.hide()

    # ── conteúdo ──
    def refresh(self):
        self.center.sync_badge()
        if not self.open:
            return
        for child in self.list.get_children():
            child.destroy()
        history = self.center.history
        if not history:
            empty = label("No notifications available", "nc-empty", xalign=0.5)
            add_class(empty, "notif")
            self.list.pack_start(empty, False, False, 0)
            self.list.show_all()
            self._fit()
            return

        # textos do NotificationCenter.app 26.6.1 (Localizable.loctable): Clear All, Clear,
        # Show less, "%u more notifications"; sem título inventado acima da lista
        head = Gtk.Box()
        clear_all = Gtk.Button()
        add_class(clear_all, "nc-pill")
        clear_all.add(label("Clear All", xalign=0.5))
        clear_all.connect("clicked", lambda _b: self.center.clear())
        head.pack_end(clear_all, False, False, 0)
        add_class(head, "nc-head")
        self.list.pack_start(head, False, False, 0)

        # agrupa por app; o grupo com a notificação mais recente vem primeiro
        groups = {}
        for e in reversed(history):
            groups.setdefault(e["app"], []).append(e)
        expanded = getattr(self, "expanded", set())
        self.expanded = expanded & set(groups)      # esquece grupos que sumiram
        for app, entries in groups.items():
            if len(entries) > 1 and app not in self.expanded:
                # empilhado, como no Tahoe: o mais recente na frente, "N more notifications"
                self.list.pack_start(self._card(entries[0], more=len(entries) - 1), False, False, 0)
                continue
            if len(entries) > 1:
                gh = Gtk.Box()
                add_class(gh, "nc-group")
                gh.pack_start(label(app, "nc-app"), True, True, 0)
                x = Gtk.Button()
                add_class(x, "nc-x")
                x.add(label("✕", xalign=0.5))
                x.set_tooltip_text("Clear")
                x.connect("clicked", lambda _b, a=app: self.center.clear(a))
                gh.pack_end(x, False, False, 0)
                less = Gtk.Button()
                add_class(less, "nc-pill")
                less.add(label("Show less", xalign=0.5))
                less.connect("clicked", lambda _b, a=app: (self.expanded.discard(a), self.refresh()))
                gh.pack_end(less, False, False, 6)
                self.list.pack_start(gh, False, False, 0)
            for e in entries:
                self.list.pack_start(self._card(e), False, False, 0)
        self.list.show_all()
        self._fit()
        # rótulos com quebra só sabem a altura real depois da alocação: reajusta em seguida
        GLib.idle_add(lambda: self.open and self._fit() and False)

    def _fit(self):
        """A janela do GTK3 usa a altura mínima da área rolável: pedimos a altura
        natural da lista (até o limite da tela) e reajustamos a janela."""
        nat = self.list.get_preferred_height()[1]
        h = min(nat, self.max_list_h)
        self.scroll.set_min_content_height(h)
        self.scroll.set_max_content_height(h)
        self.win.resize(1, 1)

    def _card(self, e, more=0):
        ev = Gtk.EventBox()
        overlay = Gtk.Overlay()
        card = notif_card()
        icon_pb, thumb_pb = (e["icon"] or e["image"]), (e["image"] if e["icon"] else None)
        cache = {}
        card.pack_start(notif_icon(lambda a, cr: self._draw_icon(a, cr, icon_pb, cache)),
                        False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        title = label(e["summary"], "title")
        title.set_ellipsize(3)
        title.set_hexpand(True)
        texts.pack_start(title, False, False, 0)
        if e["body"]:
            body = label("", "body")
            body.set_markup(_safe_markup(e["body"]))
            body.set_line_wrap(True)
            body.set_line_wrap_mode(2)
            body.set_lines(4)
            body.set_ellipsize(3)
            body.set_max_width_chars(34)
            texts.pack_start(body, False, False, 0)
        if more:
            texts.pack_start(label("1 more notification" if more == 1 else f"{more} more notifications",
                                   "nc-more"), False, False, 0)
        # ações (CCN-08): como no Tahoe, aparecem ao passar o ponteiro sobre a notificação
        acoes = [(k, t) for k, t in (e.get("actions") or []) if k != "default"] if not more else []
        abox = None
        if acoes:
            abox = Gtk.Box(spacing=8)
            add_class(abox, "actions")
            for k, t in acoes:
                b = Gtk.Button()
                b.add(label(t, xalign=0.5))
                b.connect("clicked", lambda _b, k=k: (self.center.invoke(e["id"], k), self.refresh()))
                abox.pack_start(b, False, False, 0)
            abox.set_no_show_all(True)
            texts.pack_start(abox, False, False, 0)
            if getattr(self, "preview_actions", False):     # gancho de teste
                abox.set_no_show_all(False)
                abox.show_all()
        card.pack_start(texts, True, True, 0)
        tcache = {}
        card.pack_end(notif_side(
            label(when_text(e["time"]), "time", xalign=1.0),
            (lambda a, cr: paint_cover(cr, thumb_pb, a.get_allocated_width(),
                                       a.get_allocated_height(), radius=THUMB_R, cache=tcache))
            if thumb_pb else None), False, False, 0)
        overlay.add(card)
        close = Gtk.Button()
        add_class(close, "close")
        close.add(label("✕", xalign=0.5))
        close.set_halign(Gtk.Align.START)
        close.set_valign(Gtk.Align.START)
        close.connect("clicked", lambda _b: self.center.forget(e["id"]))
        overlay.add_overlay(close)
        ev.add(overlay)
        ev.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        def mostrar_acoes(on):
            if abox is not None and abox.get_visible() != on:
                # no_show_all impede o show_all do próprio box: desliga antes de mostrar
                abox.set_no_show_all(not on)
                abox.show_all() if on else abox.hide()
                GLib.idle_add(lambda: self._fit() and False)
        ev.connect("enter-notify-event", lambda *_: (set_class(close, "revealed", True), mostrar_acoes(True)))
        ev.connect("leave-notify-event",
                   lambda _w, evt: evt.detail != Gdk.NotifyType.INFERIOR and (
                       set_class(close, "revealed", False), mostrar_acoes(False)))
        if more:
            # pilha: o clique expande o grupo (não abre a notificação)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            ev.remove(overlay)
            col.pack_start(overlay, False, False, 0)
            for k in (1, 2):
                if more >= k:
                    pk = Gtk.Box()
                    add_class(pk, "notif-peek", f"notif-peek-{k}")
                    pk.set_size_request(-1, 7 if k == 1 else 6)
                    pk.set_margin_start(16 * k)
                    pk.set_margin_end(16 * k)
                    col.pack_start(pk, False, False, 0)
            set_class(card, "stacked", True)
            ev.add(col)
            ev.connect("button-press-event", lambda _w, evt: evt.button == 1 and (
                self.expanded.add(e["app"]), self.refresh()))
            return ev
        ev.connect("button-press-event", lambda _w, evt: evt.button == 1 and self.center.activate(e))
        return ev

    @staticmethod
    def _draw_icon(area, cr, pb, cache):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        if pb:
            paint_cover(cr, pb, w, h, radius=ICON_R, cache=cache)
            return
        rounded_rect(cr, 0, 0, w, h, ICON_R)
        cr.set_source_rgb(0.0, 0.569, 1.0)   # #0091FF
        cr.fill()


# ───────────────────────────── agente de senhas do NetworkManager ─────────────────────────────

AGENT_XML = """
<node>
  <interface name="org.freedesktop.NetworkManager.SecretAgent">
    <method name="GetSecrets">
      <arg type="a{sa{sv}}" name="connection" direction="in"/>
      <arg type="o" name="connection_path" direction="in"/>
      <arg type="s" name="setting_name" direction="in"/>
      <arg type="as" name="hints" direction="in"/>
      <arg type="u" name="flags" direction="in"/>
      <arg type="a{sa{sv}}" name="secrets" direction="out"/>
    </method>
    <method name="CancelGetSecrets">
      <arg type="o" name="connection_path" direction="in"/>
      <arg type="s" name="setting_name" direction="in"/>
    </method>
    <method name="SaveSecrets">
      <arg type="a{sa{sv}}" name="connection" direction="in"/>
      <arg type="o" name="connection_path" direction="in"/>
    </method>
    <method name="DeleteSecrets">
      <arg type="a{sa{sv}}" name="connection" direction="in"/>
      <arg type="o" name="connection_path" direction="in"/>
    </method>
  </interface>
</node>
"""

NM_BUS = "org.freedesktop.NetworkManager"
AGENT_PATH = "/org/freedesktop/NetworkManager/SecretAgent"
ALLOW_INTERACTION, REQUEST_NEW = 0x1, 0x2
SECRET_LABELS = {
    "password": "Senha",
    "ipsec-psk": "Chave pré-compartilhada (IPsec)",
    "psk": "Senha da rede",
    "cert-pass": "Senha do certificado",
    "Xauth password": "Senha (XAuth)",
}


class NMSecretAgent:
    """Faz o papel do GNOME Shell: entrega ao NetworkManager as senhas guardadas no
    chaveiro (libsecret, mesmo esquema do GNOME) e, se faltar alguma, pergunta numa
    janela no estilo macOS com a opção de lembrar no chaveiro."""

    def __init__(self):
        gi.require_version("Secret", "1")
        from gi.repository import Secret
        self.Secret = Secret
        self.schema = Secret.Schema.new(
            "org.freedesktop.NetworkManager.Connection", Secret.SchemaFlags.DONT_MATCH_NAME,
            {"connection-uuid": Secret.SchemaAttributeType.STRING,
             "setting-name": Secret.SchemaAttributeType.STRING,
             "setting-key": Secret.SchemaAttributeType.STRING})
        self.pending = {}           # (path, setting) → (invocation, janela)
        self.iface = Gio.DBusNodeInfo.new_for_xml(AGENT_XML).interfaces[0]
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.bus.register_object(AGENT_PATH, self.iface, self._method, None, None)
        # (re)registra sempre que o NetworkManager aparece
        Gio.bus_watch_name_on_connection(self.bus, NM_BUS, Gio.BusNameWatcherFlags.NONE,
                                         lambda *_: self._register(), None)

    def _register(self):
        self.bus.call(NM_BUS, "/org/freedesktop/NetworkManager/AgentManager",
                      "org.freedesktop.NetworkManager.AgentManager", "Register",
                      GLib.Variant("(s)", ("dev.hyprmac.agent",)), None,
                      Gio.DBusCallFlags.NONE, -1, None, self._registered)

    @staticmethod
    def _registered(bus, res):
        try:
            bus.call_finish(res)
        except GLib.Error as e:
            print("agente de senhas:", e.message, file=sys.stderr)

    # ── chaveiro ──
    def _attrs(self, uuid, setting, key):
        return {"connection-uuid": uuid, "setting-name": setting, "setting-key": key}

    def _lookup(self, uuid, setting, key):
        try:
            return self.Secret.password_lookup_sync(self.schema, self._attrs(uuid, setting, key), None)
        except GLib.Error:
            return None

    def _store(self, uuid, conn_id, setting, key, value):
        try:
            self.Secret.password_store_sync(
                self.schema, self._attrs(uuid, setting, key), self.Secret.COLLECTION_DEFAULT,
                f"Network secret for {conn_id}/{setting}/{key}", value, None)
        except GLib.Error as e:
            print("chaveiro:", e.message, file=sys.stderr)

    # ── quais segredos a conexão guarda com o agente (flag 1) ──
    @staticmethod
    def _agent_keys(conn, setting):
        props = conn.get(setting, {})
        if setting == "vpn":
            data = props.get("data", {})
            keys = [k[:-6] for k, v in data.items() if k.endswith("-flags") and str(v).strip() == "1"]
        else:
            keys = [k[:-6] for k, v in props.items() if k.endswith("-flags") and v == 1]
        return keys

    @staticmethod
    def _reply(setting, secrets):
        if setting == "vpn":
            inner = {"secrets": GLib.Variant("a{ss}", secrets)}
        else:
            inner = {k: GLib.Variant("s", v) for k, v in secrets.items()}
        return GLib.Variant("(a{sa{sv}})", ({setting: inner},))

    # ── D-Bus ──
    def _method(self, _conn, _sender, _path, _iface, method, params, inv):
        if method == "GetSecrets":
            conn, path, setting, hints, flags = params.unpack()
            self._get(inv, conn, path, setting, hints, flags)
        elif method == "CancelGetSecrets":
            path, setting = params.unpack()
            item = self.pending.pop((path, setting), None)
            if item:
                item[1].destroy()
                item[0].return_dbus_error("org.freedesktop.NetworkManager.SecretAgent.AgentCanceled",
                                          "Cancelado")
            inv.return_value(None)
        elif method == "SaveSecrets":
            conn, _path = params.unpack()
            self._save_all(conn)
            inv.return_value(None)
        elif method == "DeleteSecrets":
            conn, _path = params.unpack()
            uuid = conn.get("connection", {}).get("uuid", "")
            try:
                self.Secret.password_clear_sync(self.schema, {"connection-uuid": uuid}, None)
            except GLib.Error:
                pass
            inv.return_value(None)

    def _save_all(self, conn):
        c = conn.get("connection", {})
        uuid, cid = c.get("uuid", ""), c.get("id", "")
        for setting, props in conn.items():
            if setting == "vpn":
                for k, v in props.get("secrets", {}).items():
                    self._store(uuid, cid, "vpn", k, v)
            else:
                for k in self._agent_keys(conn, setting):
                    if isinstance(props.get(k), str) and props[k]:
                        self._store(uuid, cid, setting, k, props[k])

    def _get(self, inv, conn, path, setting, hints, flags):
        c = conn.get("connection", {})
        uuid, cid = c.get("uuid", ""), c.get("id", "connection")
        keys = self._agent_keys(conn, setting)
        for h in hints:                           # o plugin pode pedir chaves extras
            if h in SECRET_LABELS and h not in keys:
                keys.append(h)
        found = {} if flags & REQUEST_NEW else {
            k: v for k in keys if (v := self._lookup(uuid, setting, k)) is not None}
        missing = [k for k in keys if k not in found]
        if not missing:
            inv.return_value(self._reply(setting, found))
            return
        if not flags & ALLOW_INTERACTION:
            inv.return_dbus_error("org.freedesktop.NetworkManager.SecretAgent.NoSecrets",
                                  "Password not found in Keychain")
            return
        GLib.idle_add(self._ask, inv, path, setting, uuid, cid, keys, found)

    # ── janela de senha (estilo macOS) ──
    def _ask(self, inv, path, setting, uuid, cid, keys, found):
        win = Gtk.Window(title="Network Password")
        win.set_resizable(False)
        win.set_keep_above(True)
        add_class(win, "hyprmac-agent")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(22)
        box.set_size_request(360, -1)
        lock = label(G("f033e"), "icon agent-lock", xalign=0.5)
        box.pack_start(lock, False, False, 0)
        kind = "The VPN" if setting == "vpn" else "The Wi‑Fi network"
        box.pack_start(label(f"{kind} “{cid}” requires a password.", "agent-title", xalign=0.5), False, False, 0)
        box.pack_start(label("Enter the password to join.", "agent-sub", xalign=0.5), False, False, 0)
        entries = {}
        for k in keys:
            e = Gtk.Entry()
            e.set_visibility(False)
            e.set_placeholder_text(SECRET_LABELS.get(k, k))
            e.set_text(found.get(k, ""))
            e.set_activates_default(True)
            box.pack_start(e, False, False, 0)
            entries[k] = e
        remember = Gtk.CheckButton(label="Remember this network")
        remember.set_active(True)
        box.pack_start(remember, False, False, 4)
        buttons = Gtk.Box(spacing=8, homogeneous=True)
        cancel, ok = Gtk.Button(label="Cancel"), Gtk.Button(label="Join")
        add_class(ok, "suggested-action")
        ok.set_can_default(True)
        buttons.pack_start(cancel, True, True, 0)
        buttons.pack_start(ok, True, True, 0)
        box.pack_start(buttons, False, False, 4)
        win.add(box)

        def finish(accepted):
            if (path, setting) not in self.pending:
                return
            self.pending.pop((path, setting))
            if accepted:
                secrets = {k: e.get_text() for k, e in entries.items()}
                if remember.get_active():
                    for k, v in secrets.items():
                        self._store(uuid, cid, setting, k, v)
                inv.return_value(self._reply(setting, secrets))
            else:
                inv.return_dbus_error("org.freedesktop.NetworkManager.SecretAgent.UserCanceled",
                                      "Cancelado pelo usuário")
            win.destroy()

        ok.connect("clicked", lambda _b: finish(True))
        cancel.connect("clicked", lambda _b: finish(False))
        win.connect("delete-event", lambda *_: finish(False) or True)
        self.pending[(path, setting)] = (inv, win)
        win.show_all()
        ok.grab_default()
        next(iter(entries.values())).grab_focus()
        return False


