    a11y_css["reduce_transparency"].load_from_path(os.path.join(HERE, "a11y-transparencia.css"))
    a11y_css["increase_contrast"].load_from_path(os.path.join(HERE, "a11y-contraste.css"))
    a11y_on = {}

    def apply_a11y(*_):
        try:
