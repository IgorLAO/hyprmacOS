class Toggle:
    """Controle em dois tamanhos: pequeno (círculo) ou médio (bloco com título).
    Guarda o estado para que qualquer tamanho criado depois já nasça certo."""

    def __init__(self, icon, title, on_click, on_detail=None):
        self.icon, self.title, self.subtitle, self.on = icon, title, "", False
        self.on_click = on_click
        self.on_detail = on_detail
        self.widgets = {}

    def widget(self, size):
        w = self.widgets.get(size)
        if w is None:
            if size == "small":
                w = Circle(self.icon, self.title, self.on_click, on_detail=self.on_detail)
            else:
                w = Tile(self.icon, self.title, self.subtitle, self.on_click,
                         on_detail=self.on_detail)
            self.widgets[size] = w
            self._sync(w)
        return w

    def set(self, on=None, icon=None, title=None, subtitle=None):
        for k, v in (("on", on), ("icon", icon), ("title", title), ("subtitle", subtitle)):
            if v is not None:
                setattr(self, k, v)
        for w in self.widgets.values():
            self._sync(w)

    def _sync(self, w):
        if isinstance(w, Circle):
            w.set_state(self.on, self.icon)
            w.set_tooltip_text(f"{self.title} · {self.subtitle}" if self.subtitle else self.title)
        else:
            w.dot.set_text(self.icon)
            set_class(w.dot, "off", not self.on)
            # bloco médio ligado: no Tahoe só o Foco/Não Perturbe ganha tinta azul (frame 0020);
            # Wi‑Fi/Bluetooth ligados continuam cinza, só o disco vira branco + glifo azul
            # (frame 0020 e referencias/telas/cc-tahoe-alvo-usuario.png)
            set_class(w, "on", self.on and getattr(self, "tint_on", False))
            w.set_title(self.title)
            w.subtitle.set_text(self.subtitle)


