        nm.set_ellipsize(3)
        nm.set_max_width_chars(26)
        texts.pack_start(nm, False, False, 0)
        if sub:
            texts.pack_start(label(sub, "xm-sub"), False, False, 0)
        row.pack_start(texts, True, True, 0)
        if right or right_dynamic:
            detail = label(right or "", ("icon xm-right-icon" if right_icon else "xm-right"), 1.0)
            if right_dynamic:
                detail.set_no_show_all(True)
                detail.set_visible(bool(right))
            row.pack_end(detail, False, False, 0)
            w._device_right = detail
        if isinstance(w, Gtk.Button):
            w.add(row)
        else:
            w.pack_start(row, True, True, 0)
        (container if container is not None else self.box).pack_start(w, False, False, 0)
        return w

    def slider(self, value, on_change, lo, hi):
        row = Gtk.Box(spacing=8)
        add_class(row, "xm-slider-row")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        add_class(scale, "xm-scale")
        scale.set_draw_value(False)
        scale.set_value(value)
        scale.connect("change-value", lambda _s, _sc, v: on_change(round(min(max(v, 0), 100))) and False)
        row.pack_start(label(lo, "icon xm-slider-icon", 0.5), False, False, 0)
        row.pack_start(scale, True, True, 0)
