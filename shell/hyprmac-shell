        for icon, cmd in ((I["prev"], "previous"), (I["play"], "play-pause"), (I["next"], "next")):
            b = Gtk.Button()
            add_class(b, "np-ctrl", "np-" + cmd)
            lb = label(icon, "icon", 0.5)
            b.add(lb)
            b.connect("clicked", lambda _b, c=cmd: self._command(c))
            inner.pack_start(b, False, False, 0)
            if cmd == "play-pause":
                self.play_lbl = lb
