class HotCorners:
    """Cantos ativos do Mac (Ajustes ▸ Desktop & Dock ▸ Hot Corners…; referencias/desejos/
    cantos-ativos-folha.png). Cada canto com ação ganha uma camada de 1×1 px no canto exato
    do monitor (acima da barra, sem zona exclusiva); o ponteiro chegando ali dispara a ação
    uma vez — só dispara de novo depois de sair do canto. ~/.config/hyprmac/config.json:
    "hot_corners": {"tl": "mission-control", "tr": …, "bl": …, "br": …}."""

    CORNERS = (("tl", (E.TOP, E.LEFT)), ("tr", (E.TOP, E.RIGHT)),
               ("bl", (E.BOTTOM, E.LEFT)), ("br", (E.BOTTOM, E.RIGHT)))

    def __init__(self, monitors, actions):
        self.monitors, self.actions, self.wins = monitors, actions, []
        self.reload()

    def reload(self, *_):
        for w in self.wins:
            w.destroy()
        self.wins = []
        conf = load_config().get("hot_corners") or {}
        for mon in self.monitors:
            for key, edges in self.CORNERS:
                act = conf.get(key)
                if act not in self.actions:
                    continue
                win = layer_window("hyprmac-hotcorner", LS.Layer.OVERLAY, mon, anchors=edges,
                                   exclusive=-1)
                win.set_size_request(1, 1)
                win.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
                win.armed = True
                win.connect("enter-notify-event", lambda w, _e, a=act: self._hit(w, a))
                win.connect("leave-notify-event", lambda w, _e: setattr(w, "armed", True))
                win.show_all()
                self.wins.append(win)
        return False

    def _hit(self, win, act):
        if win.armed:
            win.armed = False
            GLib.idle_add(lambda: self.actions[act]() and False)
        return False


def shell_stylesheet(name, accent_path=None):
    """Resolve a mesma paleta nos providers de tema, vidro e acessibilidade.

    Mantém os CSS como fonte de verdade; não gera outro tema ou copia assets.
    A troca simultânea impede que uma cor escolhida seja substituída novamente.
    """
    tons = {}
    accent_path = accent_path or os.path.join(ROOT, "gtk", "accent3.css")
    try:
        with open(accent_path) as f:
            for match in re.finditer(
                r"@define-color (mac_accent|mac_accent_hi|mac_selection)\s+(#[0-9A-Fa-f]{6})",
                f.read(),
            ):
                tons[match.group(1)] = match.group(2)
    except OSError:
        pass
    accent = tons.get("mac_accent", "#007AFF")
    red, green, blue = (int(accent[i : i + 2], 16) for i in (1, 3, 5))
    replacements = {
        "#007aff": accent,
        "#0091ff": accent,
        "#0088ff": accent,
        "#1a9bff": tons.get("mac_accent_hi", "#3395FF"),
        "#0069f9": tons.get("mac_selection", "#0069F9"),
        "rgba(0, 145, 255,": f"rgba({red}, {green}, {blue},",
    }
    with open(os.path.join(HERE, name)) as f:
        text = f.read()
    pattern = "|".join(re.escape(key) for key in replacements)
    return re.sub(pattern, lambda m: replacements[m[0].lower()], text, flags=re.I).encode()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    pid = running_pid()
    if cmd == "toggle-cc":
        if pid:
            os.kill(pid, signal.SIGUSR1)
        return
    if cmd == "window-menu":
        if pid:
            os.kill(pid, signal.SIGUSR2)
        return
    if cmd in ("toggle-nc", "toggle-media", "edit-controls", "toggle-clipboard", "dock-autohide",
               "force-quit"):
        subprocess.run(["gdbus", "call", "--session", "--dest", SHELL_BUS, "--object-path",
                        SHELL_PATH, "--method", SHELL_BUS + ".Command", cmd],
                       stdout=subprocess.DEVNULL)
        return
    if cmd == "reload":
        if pid:
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not running_pid():
                    break
                time.sleep(0.1)
        subprocess.Popen([os.path.realpath(__file__)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if pid:
        print("hyprmac-shell já está rodando (pid %d)" % pid, file=sys.stderr)
        return

    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    GLib.set_prgname("hyprmac-shell")          # app_id das janelas normais (senha da VPN)

    css = Gtk.CssProvider()
    light_css = Gtk.CssProvider()
    glass_css = Gtk.CssProvider()
    glass_light_css = Gtk.CssProvider()

    def load_css():
        """Todos os materiais acompanham a cor de destaque escolhida."""
        for prov, name in (
            (css, "style.css"),
            (light_css, "style-light.css"),
            (glass_css, "vidro-camadas.css"),
            (glass_light_css, "vidro-camadas-claro.css"),
        ):
            prov.load_from_data(shell_stylesheet(name))
        return False

    load_css()
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_USER)
    accent_mon = Gio.File.new_for_path(os.path.join(ROOT, "gtk", "accent3.css")).monitor_file(
        Gio.FileMonitorFlags.NONE, None)
    accent_mon.connect("changed", lambda *_: GLib.timeout_add(150, load_css))

    # Tema claro/escuro: segue org.gnome.desktop.interface color-scheme ao vivo
    iface = Gio.Settings.new("org.gnome.desktop.interface")
    light_on = [False]

    def apply_theme(*_):
        light = iface.get_string("color-scheme") != "prefer-dark"
        if light == light_on[0]:
            return
        screen = Gdk.Screen.get_default()
        if light:
            Gtk.StyleContext.add_provider_for_screen(screen, light_css,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        else:
            Gtk.StyleContext.remove_provider_for_screen(screen, light_css)
        light_on[0] = light

    iface.connect("changed::color-scheme", apply_theme)
    apply_theme()

    # Liquid Glass de verdade (plugin hyprglass): com ele carregado, o CSS deixa de
    # pintar o vidro e só tinge (shell/vidro-camadas.css). `vidro carregar` termina com
    # um reload da config, então o configreloaded do Hyprland reavalia.
    glass_on = [None]

    def apply_glass(*_):
        def check():
            try:
                out = subprocess.run(["hyprctl", "plugin", "list"], capture_output=True,
                                     text=True, timeout=2).stdout
            except (OSError, subprocess.SubprocessError):
                out = ""
            on = "Plugin hyprglass" in out
            GLib.idle_add(set_glass, (on, on and light_on[0]))
        in_thread(check)
        return False

    def set_glass(state):
        """state = (vidro real?, tema claro?). Prioridades: tema claro USER+1 < vidro
        USER+2 < vidro claro USER+3 < acessibilidade USER+4 (Reduzir Transparência vence)."""
        if state != glass_on[0]:
            screen = Gdk.Screen.get_default()
            on, light = state
            for prov in (glass_css, glass_light_css):
                Gtk.StyleContext.remove_provider_for_screen(screen, prov)
            if on:
                Gtk.StyleContext.add_provider_for_screen(screen, glass_css,
                                                         Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
            if light:
                Gtk.StyleContext.add_provider_for_screen(screen, glass_light_css,
                                                         Gtk.STYLE_PROVIDER_PRIORITY_USER + 3)
            glass_on[0] = state
        return False

    iface.connect("changed::color-scheme", apply_glass)
    hypr_events(lambda line: line.startswith("configreloaded") and apply_glass())

    # Monitor que volta do sono profundo (DPMS longo) reaparece como saída nova: as camadas
    # presas ao Gdk.Monitor antigo foram destruídas (sumiam Dock, wallpaper e widgets). O
    # shell se reinicia uma vez, 3 s depois do último monitoradded, como um reload manual.
    _volta = {"id": None}

    def _monitor_voltou(line):
        if not line.startswith("monitoradded>>"):
            return
        if _volta["id"]:
            GLib.source_remove(_volta["id"])

        def recarregar():
            _volta["id"] = None
            subprocess.Popen([os.path.realpath(__file__), "reload"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return False
        _volta["id"] = GLib.timeout_add_seconds(3, recarregar)
    hypr_events(_monitor_voltou)
    apply_glass()
    update_app_menus(hypr_json("activewindow").get("class", ""))
    hypr_events(app_menu_focus_event)

    # Acessibilidade: Reduzir Transparência / Aumentar Contraste (hyprmac-acessibilidade)
