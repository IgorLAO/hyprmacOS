# Proporções da Central do Tahoe: ~9× a altura da barra de menus
# Grade da Central na proporção do Tahoe. Tela tahoe-dark calibrada pela cápsula da
# barra (25 pt = 47 px → 1,88 px/pt): círculo 67,5 pt, vão 13,3 (0,2 × d), ícone do
# bloco médio 37 recuado 15, texto 7 depois dele, Central a 15 da borda e 14 abaixo da
# barra. O texto lá tem 13 pt e aqui 13 px, então a grade usa os mesmos números.
# Recalibrado em 2026-10-04 pela largura do relógio da barra (SF 13): tahoe-dark 1,947 px/pt →
# círculo 65,7, vão 12,3, Central 299 pt; imagem oficial (tahoe-photos-central-dock-claro)
# 0,945 px/pt → Central 295 pt. (A foto cc-tahoe-alvo-usuario dá 215 pt — fora da curva,
# provavelmente texto da barra ampliado; vale para o material, não para o tamanho.)
C = 66          # diâmetro dos botões redondos
GAP = 12
CC_TOP, CC_RIGHT = 14, 15
# Excedente do badge de edição: offset -4px em .cc button.ctl-remove
# (style.css). A margem transparente preserva os círculos da referência
# cc-edicao-galeria-sobre-azul sem deslocar a grade na tela.
CC_BLEED = 4
W2 = 2 * C + GAP
W4 = 4 * C + 3 * GAP


class GlassButton(Gtk.Button):
    """Flexão do vidro no gesto, sem alterar layout, foco ou área clicável.

    HIG motion: o material responde ao gesto. A compressão de 3% é uma
    aproximação local, não uma medida Tahoe; usa a mola já existente no Dock.
    A máscara que o compositor recebe acompanha o desenho a cada frame.
    """

    def __init__(self):
        super().__init__()
        self._press_scale = 1.0
        self._press_velocity = 0.0
        self._press_target = 1.0
        self._press_tick = None
        self.connect("state-flags-changed", self._press_state)
        self.connect("unmap", self._reset_press)
        self.connect("destroy", self._reset_press)

    def _reset_press(self, *_):
        if self._press_tick is not None:
            self.remove_tick_callback(self._press_tick)
            self._press_tick = None
        self._press_scale = self._press_target = 1.0
        self._press_velocity = 0.0

    def _press_state(self, *_):
        active = self.is_sensitive() and bool(self.get_state_flags() & Gtk.StateFlags.ACTIVE)
        self._press_target = 0.97 if active else 1.0
        if reduce_motion():
            self._reset_press()
            self.queue_draw()
            return
        if self._press_tick is not None:
            return  # inverter o destino conserva posição e velocidade
        if self._press_scale == self._press_target and self._press_velocity == 0:
            return
        previous = time.monotonic()

        def frame(_widget, clock):
            nonlocal previous
            now = clock.get_frame_time() / 1e6
            if reduce_motion():
                self._press_scale, self._press_velocity = 1.0, 0.0
                self._press_target = 1.0
            else:
                self._press_scale, self._press_velocity = spring_step(
                    self._press_scale, self._press_velocity, self._press_target, now - previous)
            previous = now
            self.queue_draw()
            if self._press_scale == self._press_target and self._press_velocity == 0:
                self._press_tick = None
                return False
            return True

        self._press_tick = self.add_tick_callback(frame)

    def do_draw(self, cr):
        # A volta pode ter overshoot subpixel; limitar o desenho à alocação
        # evita recorte nas bordas, sem modificar o estado da mola.
        scale = min(1.0, self._press_scale)
        cr.save()
        cr.translate(self.get_allocated_width() * (1 - scale) / 2,
                     self.get_allocated_height() * (1 - scale) / 2)
        cr.scale(scale, scale)
        result = Gtk.Button.do_draw(self, cr)
        cr.restore()
        return result


class Circle(GlassButton):
    def __init__(self, icon, tip, on_click, on_detail=None):
        super().__init__()
        add_class(self, "circle")
        self.lbl = label(icon, "icon", 0.5)
        self.add(self.lbl)
        self.set_size_request(C, C)
        # nunca esticar: a grade pode dar mais altura à linha (ex.: Tocando Agora)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        self.set_tooltip_text(tip)
        # clique liga/desliga; botão direito ou pressionamento longo abre o
        # sub-painel do módulo dentro da Central (círculo pequeno não tem “resto”)
        self._did_detail = False
        self._lp = None
        if on_detail:
            def press(_w, ev, det=on_detail):
                self._did_detail = False
                if ev.button == 3:
                    self._did_detail = True
                    det()
                    return True
                if ev.button == 1:
                    def fire():
                        self._did_detail = True
                        self._lp = None
                        det()
                        return False
                    self._lp = GLib.timeout_add(420, fire)
                return False

            def release(*_):
                if self._lp:
                    GLib.source_remove(self._lp)
                    self._lp = None
                return False

            self.connect("button-press-event", press)
            self.connect("button-release-event", release)
            self.connect("leave-notify-event",
                         lambda _w, e: False if e.detail == Gdk.NotifyType.INFERIOR else release())
        self.connect("clicked", lambda _b: None if self._did_detail else on_click())

    def do_get_preferred_width(self):
        return C, C

    def do_get_preferred_width_for_height(self, _h):
        return C, C

    def set_state(self, on, icon=None):
        set_class(self, "on", on)
        if icon:
            self.lbl.set_text(icon)


class Tile(GlassButton):
    """Bloco largo: círculo com ícone + título/subtítulo."""

    def __init__(self, icon, title, subtitle, on_click, dot_cls="", on_detail=None):
        super().__init__()
        add_class(self, "tile")
        self.set_size_request(W2, C)
        box = Gtk.Box(spacing=7)
        self.dot = label(icon, "icon dot " + dot_cls, 0.5)
        self.dot.set_size_request(37, 37)     # 0,55 × C, recuo concêntrico de 15
        self.dot.set_valign(Gtk.Align.CENTER)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        texts.set_valign(Gtk.Align.CENTER)
        self.title = label(title, "title")
        self.subtitle = label(subtitle, "subtitle")
        for lb in (self.title, self.subtitle):
            lb.set_ellipsize(3)  # Pango.EllipsizeMode.END
            lb.set_max_width_chars(8)
            texts.pack_start(lb, False, False, 0)
        box.pack_start(self.dot, False, False, 0)
        box.pack_start(texts, True, True, 0)
        # cc-tahoe-alvo-usuario.png: Wi-Fi/Bluetooth usam toda a largura após
        # o disco para título/estado, sem chevron permanente. O texto continua
        # abrindo o detalhe; reservar outra coluna cortava até "Bluetooth".
        self.add(box)
        # como no Tahoe: o círculo liga/desliga; o resto do bloco
        # abre as opções do módulo dentro da própria Central (redes, aparelhos…)
        self._px = 0
        self.connect("button-press-event", lambda _w, ev: setattr(self, "_px", ev.x) or False)

        def activate(_button):
            detail = on_detail and self._px > self.DOT_END
            self._px = 0
            on_detail() if detail else on_click()

        def key(_button, event):
            self._px = 0
            if on_detail and event.keyval == Gdk.KEY_Right:
                on_detail()
                return True
            return False

        self.connect("clicked", activate)
        self.connect("key-press-event", key)
        self.set_title(title)

    DOT_END = 1 + 14 + 37 + 3     # borda + recuo + círculo de 37 (+ folga)

    # espaço do texto: bloco − borda/padding (1+14 e 9+1) − ícone 37 − vão 7
    TEXT_W = W2 - 2 - 14 - 9 - 37 - 7

    def set_title(self, text):
        """Título Semibold 13; se não couber, 12 e depois 11,5 (medido de verdade)
        antes de recorrer às reticências."""
        self.title.set_text(text)
        layout = self.title.create_pango_layout(text)
        fd = Pango.FontDescription.from_string("SF Pro Semibold")
        size = None
        for px, cls in ((13, None), (12, "tight"), (11.5, "tighter")):
            fd.set_absolute_size(px * Pango.SCALE)
            layout.set_font_description(fd)
            size = cls
            if layout.get_pixel_size()[0] <= self.TEXT_W:
                break
        set_class(self.title, "tight", size == "tight")
        set_class(self.title, "tighter", size == "tighter")

    def do_get_preferred_width(self):
        # largura fixa de 2 círculos + 1 vão: texto longo ganha reticências em vez
        # de esticar a coluna da grade (o que desalinhava os círculos de baixo)
        return W2, W2

    def do_get_preferred_width_for_height(self, _h):
        return W2, W2


def draw_sf(cr, name, w, h, rgba):
    """Ícones dos sliders da Central desenhados como os SF Symbols do Tahoe (formas e
    proporções medidas em tahoe-dark.jpeg; a fonte de símbolos não tem sun.min com pontos,
    speaker.wave.3 nem airplayaudio). Desenha centrado em w×h, na escala de 1 pt = 1,055 px."""
    k = 1.055
    cx, cy = w / 2, h / 2
    cr.set_source_rgba(*rgba)
    if name in ("backward.fill", "forward.fill", "play.fill", "pause.fill"):
        # tahoe-dark.jpeg: transporte duplo ≈0,155 da largura do cartão;
        # altura ≈0,09; pausa ≈0,10×0,14. Sem a barra de skip do glifo MDI.
        if name == "pause.fill":
            for dx in (-7.5, 1.5):
                rounded_rect(cr, cx + dx, cy - 10, 6, 20, 1.5)
                cr.fill()
        else:
            cr.save()
            cr.translate(cx, cy)
            if name == "backward.fill":
                cr.scale(-1, 1)
            single = name == "play.fill"
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            cr.set_line_width(1.2)
            for left in ((-5.5,) if single else (-10.5, 0)):
                half_h = 8.5 if single else 5.8
                right = left + (13 if single else 10)
                cr.move_to(left, -half_h)
                cr.line_to(right, 0)
                cr.line_to(left, half_h)
                cr.close_path()
                cr.fill_preserve()
                cr.stroke()
            cr.restore()
        return
    if name in ("sun.min", "sun.max"):
        cr.arc(cx, cy, 3.0 * k, 0, 2 * math.pi)          # disco de ~6 pt
        cr.fill()
        for i in range(8):
            a = i * math.pi / 4
            if name == "sun.min":                        # pontos a 5,6 pt do centro
                cr.arc(cx + math.cos(a) * 5.6 * k, cy + math.sin(a) * 5.6 * k, 1.0 * k, 0, 2 * math.pi)
                cr.fill()
            else:                                        # raios de 4,6 a 6,8 pt
                cr.set_line_width(1.5 * k)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.move_to(cx + math.cos(a) * 4.7 * k, cy + math.sin(a) * 4.7 * k)
                cr.line_to(cx + math.cos(a) * 6.7 * k, cy + math.sin(a) * 6.7 * k)
                cr.stroke()
        return
    if name in ("speaker", "speaker.wave.3"):
        x0 = cx - (3.8 if name == "speaker" else 9.0) * k   # o alto-falante tem ~7,5 pt
        cr.move_to(x0, cy - 2.3 * k)
        cr.line_to(x0 + 2.6 * k, cy - 2.3 * k)
        cr.line_to(x0 + 7.2 * k, cy - 5.6 * k)
        cr.line_to(x0 + 7.2 * k, cy + 5.6 * k)
        cr.line_to(x0 + 2.6 * k, cy + 2.3 * k)
        cr.line_to(x0, cy + 2.3 * k)
        cr.close_path()
        cr.fill()
        if name == "speaker.wave.3":
            cr.set_line_width(1.25 * k)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            ox = x0 + 7.4 * k
            for r_, ang in ((3.0, 0.75), (5.6, 0.82), (8.2, 0.86)):
                cr.new_sub_path()
                cr.arc(ox, cy, r_ * k, -ang, ang)
                cr.stroke()
        return
    if name == "airplayaudio":
        cr.set_line_width(1.6 * k)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        oy = cy + 0.2 * k
        for r_ in (2.8, 5.3, 7.8):                       # arcos abertos embaixo
            cr.new_sub_path()
            cr.arc(cx, oy, r_ * k, math.radians(140), math.radians(40))
            cr.stroke()
        cr.move_to(cx, oy - 0.6 * k)                     # triângulo cheio
        cr.line_to(cx + 5.6 * k, oy + 7.0 * k)
        cr.line_to(cx - 5.6 * k, oy + 7.0 * k)
        cr.close_path()
        cr.fill()


class SFIcon(Gtk.DrawingArea):
    """Ícone desenhado (draw_sf) na cor do CSS (color) do próprio widget."""

    def __init__(self, name, w, h, *classes):
        super().__init__()
        self.name = name
        self.set_size_request(w, h)
        self.set_valign(Gtk.Align.CENTER)
        add_class(self, *classes)
        self.connect("draw", self._draw)

    def set_name_(self, name):
        if name != self.name:
            self.name = name
            self.queue_draw()

    def _draw(self, _w, cr):
        c = self.get_style_context().get_color(self.get_state_flags())
        draw_sf(cr, self.name, self.get_allocated_width(), self.get_allocated_height(),
                (c.red, c.green, c.blue, c.alpha))
        return False


