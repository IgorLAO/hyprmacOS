class LatestCommand:
    """Aplica só o valor mais novo, um processo por vez e em ordem: arrastar um slider não
    empilha processos nem deixa um valor velho terminar por último. build(v) → argv."""

    def __init__(self, build):
        self.build, self.busy, self.pending = build, False, None

    def set(self, value):
        self.pending = value
        if not self.busy:
            self._next()

    def _next(self):
        if self.pending is None:
            self.busy = False
            return
        value, self.pending = self.pending, None
        try:
            proc = Gio.Subprocess.new(self.build(value), Gio.SubprocessFlags.STDOUT_SILENCE |
                                      Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.busy = False
            return
        self.busy = True
        proc.wait_async(None, lambda p, res: (p.wait_finish(res), self._next()))


def run(cmd, timeout=3):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=timeout).stdout.strip()
    except subprocess.TimeoutExpired:
        return ""


