def _hints(variant):
    """a{sv} → {chave: GLib.Variant} sem desempacotar (image-data pode ser grande)."""
    out = {}
    for i in range(variant.n_children()):
        entry = variant.get_child_value(i)
        out[entry.get_child_value(0).get_string()] = entry.get_child_value(1).get_variant()
    return out


def _pixbuf_from_image_data(v):
    w, h, stride, alpha, bps, _ch = (v.get_child_value(i).unpack() for i in range(6))
    data = v.get_child_value(6).get_data_as_bytes()
    return GdkPixbuf.Pixbuf.new_from_bytes(data, GdkPixbuf.Colorspace.RGB, alpha, bps, w, h, stride)


def _pixbuf_from_icon(name, size=ICON * 2):
    """Caminho, file:// ou nome de ícone do tema → pixbuf (ou None)."""
    if not name:
        return None
    try:
        if name.startswith("file://"):
            name = urllib.parse.unquote(name[7:])
        if name.startswith("/"):
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(name, size, size, True)
        return Gtk.IconTheme.get_default().load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
    except GLib.Error:
        return None


def _pixbuf_from_desktop(entry, size=ICON * 2):
    if not entry:
        return None
    try:
        info = Gio.DesktopAppInfo.new(entry if entry.endswith(".desktop") else entry + ".desktop")
    except TypeError:
        info = None
    if not info or not info.get_icon():
        return None
    look = Gtk.IconTheme.get_default().lookup_by_gicon(info.get_icon(), size, Gtk.IconLookupFlags.FORCE_SIZE)
    try:
        return look.load_icon() if look else None
    except GLib.Error:
        return None


def _safe_markup(text):
    """Corpo com o subconjunto de marcação da especificação; se falhar, texto puro."""
    import re
    text = re.sub(r"<img[^>]*>", "", text or "")
    text = re.sub(r"</?a[^>]*>", "", text)
    gi.require_version("Pango", "1.0")
    from gi.repository import Pango
    try:
        Pango.parse_markup(text, -1, "\0")
        return text
    except GLib.Error:
        return GLib.markup_escape_text(text)


