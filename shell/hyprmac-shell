def menu_check_column(menu):
    """Kit Menus "Menu with Selection" (contornos/Menus.txt): num menu com algum item
    de estado, TODOS os itens ganham a coluna da marca (4 + vão 8) e o glifo Bold 13
    fica centrado no início dela, invadindo o padding (x −6). Menus sem estado
    continuam com o texto rente ao padding. Vale para cada submenu separadamente."""
    items = [c for c in menu.get_children()
             if isinstance(c, Gtk.MenuItem) and not isinstance(c, Gtk.SeparatorMenuItem)]
    has = any(getattr(it, "_hm_check", None) is not None for it in items)
    set_class(menu, "has-check", has)
    for it in items:
        sub = it.get_submenu()
        if sub is not None:
            menu_check_column(sub)
        if not has or getattr(it, "_hm_col", None) is not None:
            continue
        col = label(MENU_CHECK if getattr(it, "_hm_check", False) else "", "check", 0.5)
        box = menu_item_box(it)
        box.pack_start(col, False, False, 0)
        box.reorder_child(col, 0)
        col.show()
        it._hm_col = col
    return menu


