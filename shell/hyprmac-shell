def running_pid():
    try:
        with open(PIDFILE) as f:
            pid = int(f.read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


class HotCorners:
    """Cantos ativos do Mac (Ajustes ▸ Desktop & Dock ▸ Hot Corners…; referencias/desejos/
    cantos-ativos-folha.png). Cada canto com ação ganha uma camada de 1×1 px no canto exato
    do monitor (acima da barra, sem zona exclusiva); o ponteiro chegando ali dispara a ação
    uma vez — só dispara de novo depois de sair do canto. ~/.config/hyprmac/config.json:
    "hot_corners": {"tl": "mission-control", "tr": …, "bl": …, "br": …}."""

    CORNERS = (("tl", (E.TOP, E.LEFT)), ("tr", (E.TOP, E.RIGHT)),
               ("bl", (E.BOTTOM, E.LEFT)), ("br", (E.BOTTOM, E.RIGHT)))

    def __init__(self, monitors, actions):
        self.monitors, self.actions, self.wins = monitors, actions, []
        self.reload()

    def reload(self, *_):
        for w in self.wins:
            w.destroy()
        self.wins = []
        conf = load_config().get("hot_corners") or {}
        for mon in self.monitors:
            for key, edges in self.CORNERS:
                act = conf.get(key)
                if act not in self.actions:
                    continue
                win = layer_window("hyprmac-hotcorner", LS.Layer.OVERLAY, mon, anchors=edges,
                                   exclusive=-1)
                win.set_size_request(1, 1)
                win.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
                win.armed = True
                win.connect("enter-notify-event", lambda w, _e, a=act: self._hit(w, a))
                win.connect("leave-notify-event", lambda w, _e: setattr(w, "armed", True))
                win.show_all()
                self.wins.append(win)
        return False

    def _hit(self, win, act):
        if win.armed:
            win.armed = False
            GLib.idle_add(lambda: self.actions[act]() and False)
        return False


def shell_stylesheet(name, accent_path=None):
    """Resolve a mesma paleta nos providers de tema, vidro e acessibilidade.

    Mantém os CSS como fonte de verdade; não gera outro tema ou copia assets.
    A troca simultânea impede que uma cor escolhida seja substituída novamente.
    """
    tons = {}
    accent_path = accent_path or os.path.join(ROOT, "gtk", "accent3.css")
    try:
        with open(accent_path) as f:
            for match in re.finditer(
                r"@define-color (mac_accent|mac_accent_hi|mac_selection)\s+(#[0-9A-Fa-f]{6})",
                f.read(),
            ):
                tons[match.group(1)] = match.group(2)
    except OSError:
        pass
    accent = tons.get("mac_accent", "#007AFF")
    red, green, blue = (int(accent[i : i + 2], 16) for i in (1, 3, 5))
    replacements = {
        "#007aff": accent,
        "#0091ff": accent,
        "#0088ff": accent,
        "#1a9bff": tons.get("mac_accent_hi", "#3395FF"),
        "#0069f9": tons.get("mac_selection", "#0069F9"),
        "rgba(0, 145, 255,": f"rgba({red}, {green}, {blue},",
    }
    with open(os.path.join(HERE, name)) as f:
        text = f.read()
    pattern = "|".join(re.escape(key) for key in replacements)
    return re.sub(pattern, lambda m: replacements[m[0].lower()], text, flags=re.I).encode()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    pid = running_pid()
    if cmd == "toggle-cc":
        if pid:
            os.kill(pid, signal.SIGUSR1)
        return
    if cmd == "window-menu":
        if pid:
            os.kill(pid, signal.SIGUSR2)
        return
    if cmd in ("toggle-nc", "toggle-media", "edit-controls", "toggle-clipboard", "dock-autohide",
               "force-quit"):
        subprocess.run(["gdbus", "call", "--session", "--dest", SHELL_BUS, "--object-path",
                        SHELL_PATH, "--method", SHELL_BUS + ".Command", cmd],
                       stdout=subprocess.DEVNULL)
        return
    if cmd == "reload":
        if pid:
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not running_pid():
                    break
                time.sleep(0.1)
        subprocess.Popen([os.path.realpath(__file__)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if pid:
        print("hyprmac-shell já está rodando (pid %d)" % pid, file=sys.stderr)
        return

    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    GLib.set_prgname("hyprmac-shell")          # app_id das janelas normais (senha da VPN)

    css = Gtk.CssProvider()
    light_css = Gtk.CssProvider()
    glass_css = Gtk.CssProvider()
    glass_light_css = Gtk.CssProvider()

    def load_css():
        """Todos os materiais acompanham a cor de destaque escolhida."""
        for prov, name in (
            (css, "style.css"),
            (light_css, "style-light.css"),
            (glass_css, "vidro-camadas.css"),
            (glass_light_css, "vidro-camadas-claro.css"),
        ):
            prov.load_from_data(shell_stylesheet(name))
        return False

    load_css()
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_USER)
    accent_mon = Gio.File.new_for_path(os.path.join(ROOT, "gtk", "accent3.css")).monitor_file(
        Gio.FileMonitorFlags.NONE, None)
    accent_mon.connect("changed", lambda *_: GLib.timeout_add(150, load_css))

    # Tema claro/escuro: segue org.gnome.desktop.interface color-scheme ao vivo
    iface = Gio.Settings.new("org.gnome.desktop.interface")
    light_on = [False]

    def apply_theme(*_):
        light = iface.get_string("color-scheme") != "prefer-dark"
        if light == light_on[0]:
            return
        screen = Gdk.Screen.get_default()
        if light:
            Gtk.StyleContext.add_provider_for_screen(screen, light_css,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        else:
            Gtk.StyleContext.remove_provider_for_screen(screen, light_css)
        light_on[0] = light

    iface.connect("changed::color-scheme", apply_theme)
    apply_theme()

    # Liquid Glass de verdade (plugin hyprglass): com ele carregado, o CSS deixa de
    # pintar o vidro e só tinge (shell/vidro-camadas.css). `vidro carregar` termina com
    # um reload da config, então o configreloaded do Hyprland reavalia.
    glass_on = [None]

    def apply_glass(*_):
        def check():
            try:
                out = subprocess.run(["hyprctl", "plugin", "list"], capture_output=True,
                                     text=True, timeout=2).stdout
            except (OSError, subprocess.SubprocessError):
                out = ""
            on = "Plugin hyprglass" in out
            GLib.idle_add(set_glass, (on, on and light_on[0]))
        in_thread(check)
        return False

    def set_glass(state):
        """state = (vidro real?, tema claro?). Prioridades: tema claro USER+1 < vidro
        USER+2 < vidro claro USER+3 < acessibilidade USER+4 (Reduzir Transparência vence)."""
        if state != glass_on[0]:
            screen = Gdk.Screen.get_default()
            on, light = state
            for prov in (glass_css, glass_light_css):
                Gtk.StyleContext.remove_provider_for_screen(screen, prov)
            if on:
                Gtk.StyleContext.add_provider_for_screen(screen, glass_css,
                                                         Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
            if light:
                Gtk.StyleContext.add_provider_for_screen(screen, glass_light_css,
                                                         Gtk.STYLE_PROVIDER_PRIORITY_USER + 3)
            glass_on[0] = state
        return False

    iface.connect("changed::color-scheme", apply_glass)
    hypr_events(lambda line: line.startswith("configreloaded") and apply_glass())

    # Monitor que volta do sono profundo (DPMS longo) reaparece como saída nova: as camadas
    # presas ao Gdk.Monitor antigo foram destruídas (sumiam Dock, wallpaper e widgets). O
    # shell se reinicia uma vez, 3 s depois do último monitoradded, como um reload manual.
    _volta = {"id": None}

    def _monitor_voltou(line):
        if not line.startswith("monitoradded>>"):
            return
        if _volta["id"]:
            GLib.source_remove(_volta["id"])

        def recarregar():
            _volta["id"] = None
            subprocess.Popen([os.path.realpath(__file__), "reload"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return False
        _volta["id"] = GLib.timeout_add_seconds(3, recarregar)
    hypr_events(_monitor_voltou)
    apply_glass()
    update_app_menus(hypr_json("activewindow").get("class", ""))
    hypr_events(app_menu_focus_event)

    # Acessibilidade: Reduzir Transparência / Aumentar Contraste (scripts/acessibilidade)
    a11y_css = {"reduce_transparency": Gtk.CssProvider(), "increase_contrast": Gtk.CssProvider()}
    a11y_css["reduce_transparency"].load_from_path(os.path.join(HERE, "a11y-transparencia.css"))
    a11y_css["increase_contrast"].load_from_path(os.path.join(HERE, "a11y-contraste.css"))
    a11y_on = {}

    def apply_a11y(*_):
        try:
            with open(A11Y_PATH) as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        screen = Gdk.Screen.get_default()
        for k, prov in a11y_css.items():
            on = bool(d.get(k))
            A11Y[k] = on
            if on and not a11y_on.get(k):
                Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_USER + 4)
            elif not on and a11y_on.get(k):
                Gtk.StyleContext.remove_provider_for_screen(screen, prov)
            a11y_on[k] = on
        for d_ in DOCKS:
            d_.area.queue_draw()
        return False

    apply_a11y()

    # A mesma preferência que governa Cairo/Hyprland governa as transições GTK.
    motion_css = Gtk.CssProvider()
    motion_css.load_from_data(b".hyprmac * { transition: none; animation: none; }")

    def apply_motion(*_):
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.remove_provider_for_screen(screen, motion_css)
        if reduce_motion():
            Gtk.StyleContext.add_provider_for_screen(
                screen, motion_css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 5
            )

    _anim_settings.connect("changed::enable-animations", apply_motion)
    apply_motion()

    # Estilo de ícones e widgets (View ▸ Icon & Widget Style) e cor de destaque:
    # o Dock refaz os ícones e os widgets trocam de classe
    def apply_appearance(*_):
        st = icon_style()
        for d_ in DOCKS:
            d_.style, d_._style_cache = icon_style_effective(), {}
            d_.area.queue_draw()
        for w_ in WIDGET_SETS:
            w_.set_style(st)
        return False
    for path in (APPEARANCE_PATH, os.path.join(ROOT, "gtk", "accent3.css")):
        mon_ = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, None)
        mon_.connect("changed", lambda *_: GLib.timeout_add(150, apply_appearance))
        MONITORS.append(mon_)
    os.makedirs(os.path.dirname(A11Y_PATH), exist_ok=True)
    a11y_mon = Gio.File.new_for_path(A11Y_PATH).monitor_file(Gio.FileMonitorFlags.NONE, None)
    a11y_mon.connect("changed", lambda *_: GLib.timeout_add(120, apply_a11y))

    by_name, all_mons = gdk_monitors()
    wallpaper = Wallpaper(all_mons)
    global WALLPAPER
    WALLPAPER = wallpaper
    main_mon = by_name.get(CFG["main_monitor"]) or (all_mons[0] if all_mons else None)
    widgets = DesktopWidgets(main_mon, wallpaper)
    desktop_icons = DesktopIcons(main_mon, wallpaper)   # noqa: F841  (arquivos de ~/Desktop, como no Finder)
    global APPS
    APPS = AppIndex(app_name, _pixbuf_from_icon, SW_ICON)
    cc = ControlCenter()
    wmenu = WindowMenu()
    app_menu = AppMenu()
    view_menu = ViewMenu()
    cc_menu = CCContextMenu()
    wifi_menu = WifiMenu()
    bt_menu = BluetoothMenu()
    sound_menu = SoundMenu()
    osd = LevelOSD(cc)
    notifs = NotificationCenter(main_mon)
    cc.notifs = notifs
    media = MediaPanel()
    clip = ClipboardPanel()
    spot = Spotlight(clip)
    try:
        NMSecretAgent()
    except Exception as e:  # sem NetworkManager ou sem libsecret
        print("agente de senhas desativado:", e, file=sys.stderr)
    switcher = AppSwitcher(APPS)
    force_quit = ForceQuit(APPS)
    dock = Dock(by_name.get(CFG.get("dock_monitor") or CFG["main_monitor"]) or main_mon, APPS) \
        if CFG.get("dock", True) else None
    if dock:
        dock.notifs = notifs
        notifs.listeners.append(dock.area.queue_draw)
    hot = HotCorners(all_mons, {
        "mission-control": lambda: spawn(f"{ROOT}/shell/hyprmac-overview toggle"),
        "app-windows": lambda: spawn(f"{ROOT}/shell/hyprmac-overview app"),
        "desktop": lambda: spawn(f"{ROOT}/scripts/janela show-desktop"),
        "notification-center": notifs.panel.toggle,
        "apps": lambda: spot.command("apps"),            # o modo Apps do Spotlight (⌘1)
        "display-sleep": lambda: dispatch('hl.dsp.dpms({ action = "off" })'),
        "lock-screen": lambda: spawn(f"{ROOT}/shell/hyprmac-lock"),
    })
    serve_commands({
        "hot-corners-reload": hot.reload,
        "switcher-next": switcher.next,
        "switcher-prev": switcher.prev,
        "switcher-quit": switcher._quit_selected,
        "switcher-hide": switcher._hide_selected,
        "force-quit": force_quit.toggle,
        "toggle-cc": cc.toggle,
        "edit-controls": cc.edit,
        "cc-preview": cc.preview,
        "toggle-dnd": cc._dnd_click,
        "toggle-nc": notifs.panel.toggle,
        # testes: abre a Central com todos os grupos expandidos (sem clicar)
        "nc-preview-actions": lambda: (setattr(notifs.panel, "preview_actions", True),
                                       notifs.panel.show() if not notifs.panel.open
                                       else notifs.panel.refresh(),
                                       setattr(notifs.panel, "preview_actions", False)),
        "nc-preview-expanded": lambda: (setattr(notifs.panel, "expanded",
                                                {e["app"] for e in notifs.history}),
                                        notifs.panel.show() if not notifs.panel.open
                                        else notifs.panel.refresh()),
        "toggle-media": media.toggle,
        "toggle-clipboard": clip.toggle,
        "clipboard-preview": clip.preview,
        "spotlight": spot.command,
        "window-menu": wmenu.popup,
        "app-menu": app_menu.popup,
        "view-menu": view_menu.popup,
        "cc-menu": cc_menu.popup,
        "toggle-wifi": wifi_menu.toggle,
        "toggle-bluetooth": bt_menu.toggle,
        "toggle-sound": sound_menu.toggle,
        "osd": osd.command,
        "brightness": osd.brightness,
        "dock-autohide": dock.toggle_autohide if dock else (lambda: None),
        "dock-focus": dock.focus_keyboard if dock else (lambda: None),
        "minimize": dock.minimize if dock else (lambda *_: dispatch(
            'hl.dsp.window.move({ workspace = "special:minimized", follow = false })')),
    })
    if os.path.exists(CC_STATE):
        os.remove(CC_STATE)

    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda: cc.toggle() or True)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, lambda: wmenu.popup() or True)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: Gtk.main_quit() or False)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda: Gtk.main_quit() or False)
    try:
        Gtk.main()
    finally:
        for p in (PIDFILE, CC_STATE, ACTIVE_CLASS_STATE):
            try:
                os.remove(p)
            except OSError:
                pass
        spawn("pkill -RTMIN+8 -x waybar")


if __name__ == "__main__":
    main()
