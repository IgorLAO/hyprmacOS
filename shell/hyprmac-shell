        self.bar_gallery = False
        self.g_stack.set_visible_child_name("controls")
        self.g_hint.set_text("Drag a control to Control Center")
        self.g_search.set_placeholder_text("Search Controls")
        self.g_placeholder.set_text("Search Controls")

    def _bar_card(self, key, title, glyph, detail, action=None):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        add_class(card, "ccg-bar-card")
        card.set_size_request(185, 142)
        icon = label(glyph, "ccg-bar-icon", 0.5)
        icon.set_halign(Gtk.Align.START)
        card.pack_start(icon, False, False, 0)
        card.pack_start(label(title, "ccg-bar-title"), False, False, 0)
        caption = label(detail, "ccg-bar-detail")
        caption.set_line_wrap(True)
        caption.set_max_width_chars(23)
        card.pack_start(caption, False, False, 0)
        button = Gtk.Button()
        add_class(button, "ccg-bar-action")
        button.set_halign(Gtk.Align.START)
        if key:
            def update():
                button.set_label("Remove" if key not in menubar_items.hidden() else "Add to Menu Bar")
            update()
            def toggle(_button):
                menubar_items.set_shown(key, key in menubar_items.hidden())
                update()
            button.connect("clicked", toggle)
        elif action:
            button.set_label(action[0])
            button.connect("clicked", action[1])
        else:
            button.set_label("Appears when active")
            button.set_sensitive(False)
        card.pack_end(button, False, False, 0)
        return card

    def _build_bar_gallery(self):
        for child in self.bar_content.get_children():
            child.destroy()
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        add_class(head, "ccg-bar-heading")
