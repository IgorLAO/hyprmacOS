class WindowMenu(ShellMenu):
    """Menu "Janela" da barra, montado na hora para listar as áreas de trabalho."""

    def _workspaces(self):
        """[(id, nome, monitor, [apps])] ordenado; inclui 1..10 mesmo vazias."""
        clients = hypr_json("clients")
        apps = {}
        for c in clients:
            apps.setdefault(c["workspace"]["id"], []).append(app_name(c.get("class")))
        info = {w["id"]: w for w in hypr_json("workspaces")}
        ids = sorted(set(range(1, 11)) | {i for i in info if i > 0})
        out = [(i, info.get(i, {}).get("name", str(i)), info.get(i, {}).get("monitor"),
                apps.get(i, [])) for i in ids]
        special = [(i, w["name"], w["monitor"], apps.get(i, []))
                   for i, w in info.items() if i < 0]
        return out, special

    @staticmethod
    def _summary(names):
        counts = {}
        for n in names:
            counts[n] = counts.get(n, 0) + 1
        return ", ".join(f"{n} ×{k}" if k > 1 else n for n, k in counts.items())

    def _workspace_menu(self, target_action, show_current=True):
        sub = Gtk.Menu()
        sub.set_reserve_toggle_size(False)
        active = hypr_json("activeworkspace").get("id")
        multi_mon = len(hypr_json("monitors")) > 1
        normal, special = self._workspaces()
        for wid, _name, mon, names in normal:
            is_cur = show_current and wid == active
            title = f"<b>Desktop {wid}</b>" if is_cur else f"Desktop {wid}"
            if names:
                desc = GLib.markup_escape_text(self._summary(names))
                extra = f'<span alpha="55%">  —  {desc}</span>'
            else:
                extra = '<span alpha="35%">  —  empty</span>'
            if multi_mon and mon:
                extra += f'<span alpha="35%">  ·  {GLib.markup_escape_text(mon)}</span>'
            self._item(sub, f"{title}{extra}", lambda w=wid: target_action(w), markup=True,
                       check=is_cur if show_current else None)
        if special:
            self._sep(sub)
            for wid, name, _mon, names in special:
                label = name.replace("special:", "")
                label = "Scratchpad" if label == "magic" else label.capitalize()
                desc = GLib.markup_escape_text(self._summary(names)) or "empty"
                self._item(sub, f'{label}<span alpha="55%">  —  {desc}</span>',
                           lambda n=name: target_action(n), markup=True)
        return sub

    def _build(self):
        m = self._new_menu()

        def go(w):
            if isinstance(w, str) and w.startswith("special:"):
                dispatch(f'hl.dsp.workspace.toggle_special("{w[8:]}")')
            else:
                dispatch(f"hl.dsp.focus({{ workspace = {w} }})")

        def move(w):
            ws = f'"{w}"' if isinstance(w, str) else w
            dispatch(f"hl.dsp.window.move({{ workspace = {ws} }})")

        def minimize():
            # ⌘M: a janela vai para o Dock (área especial "minimized", que nunca abre)
            if DOCKS:
                DOCKS[0].minimize()
            else:
                dispatch('hl.dsp.window.move({ workspace = "special:minimized", follow = false })')

        def new_space():
            normal, _ = self._workspaces()
            used = {wid for wid, _n, _m, names in normal if names}
            free = next(i for i in range(1, 100) if i not in used)
            go(free)

        # Ordem do HIG (the-menu-bar ▸ Window menu): Minimize, Zoom | arranjo |
        # Bring All to Front | lista de janelas. Fechar fica em File; tela cheia, em View.
        active = hypr_json("activewindow") or {}
        has_win = bool(active.get("address"))
        self._item(m, "Minimize", minimize, sensitive=has_win, shortcut="⌘M")
        self._item(m, "Zoom", lambda: dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })'),
                   sensitive=has_win)
        self._item(m, "Center", lambda: dispatch("hl.dsp.window.center()"), sensitive=has_win)
        self._sep(m)
        arrange = Gtk.Menu()
        arrange.set_reserve_toggle_size(False)
        self._item(arrange, "Float / Tile",
                   lambda: dispatch('hl.dsp.window.float({ action = "toggle" })'), sensitive=has_win)
        self._item(arrange, "Keep on All Desktops", lambda: dispatch("hl.dsp.window.pin()"),
                   sensitive=has_win)
        mv = self._item(arrange, "Move to Desktop",
                        submenu=self._workspace_menu(move, show_current=False))
        mv.set_sensitive(has_win)
        self._item(m, "Move & Resize", submenu=arrange)
        self._item(m, "Desktops", submenu=self._workspace_menu(go))
        self._item(m, "New Desktop", new_space)
        self._sep(m)
        self._item(m, "Bring All to Front", lambda: dispatch("hl.dsp.window.bring_to_top()"),
                   sensitive=has_win)
        # janelas do app ativo, em ordem alfabética, ✓ na janela em foco
        cls = active.get("class")
        wins = sorted((c for c in hypr_json("clients")
                       if cls and c.get("class") == cls and c.get("mapped")),
                      key=lambda c: (c.get("title") or "").lower())
        if wins:
            self._sep(m)
            for c in wins:
                title = (c.get("title") or display_name(cls)).strip()
                title = title if len(title) <= 60 else title[:57] + "…"

                def focus(c=c):
                    if c["workspace"]["name"].startswith("special"):
                        ws = hypr_json("activeworkspace").get("id", 1)
                        dispatch(f'hl.dsp.window.move({{ workspace = {ws}, follow = false, '
                                 f'window = "address:{c["address"]}" }})')
                    dispatch(f'hl.dsp.focus({{ window = "address:{c["address"]}" }})')
                self._item(m, title, focus, check=c["address"] == active.get("address"))
        m.show_all()
        return m


