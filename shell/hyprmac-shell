    if exclusive is not None:
        LS.set_exclusive_zone(win, exclusive)
    LS.set_keyboard_mode(win, keyboard)
    return win


# ── surgir a partir da origem (WWDC25 "Meet Liquid Glass") ──
# "Liquid Glass objects materialize in and out" e superfícies "spring from the action
# itself": a camada nasce menor (layer rule "popin 90%" no hyprmac.lua) e cresce com
# uma mola curta. O popin do Hyprland escala em torno do CENTRO da camada; para o vidro
# brotar do ícone clicado, o shell desloca as margens no mesmo ritmo, mantendo parado o
# ponto de origem (onde está o ponteiro, sobre a barra). Curva e duração precisam ser
# as mesmas do layersIn no hyprmac.lua.
POP_FROM = 0.90
POP_MS = 320
POP_CURVE = (0.2, 1.08, 0.32, 1.0)     # bezier "macPop": leve flexão no fim


def cubic_bezier(x1, y1, x2, y2):
    def coord(t, a, b):
        return 3 * a * t * (1 - t) ** 2 + 3 * b * t * t * (1 - t) + t ** 3

    def f(x):
        lo, hi = 0.0, 1.0
        for _ in range(30):            # x(t) é monotônica: bisseção
            mid = (lo + hi) / 2
            if coord(mid, x1, x2) < x:
                lo = mid
            else:
                hi = mid
        return coord((lo + hi) / 2, y1, y2)
    return f


_pop_ease = cubic_bezier(*POP_CURVE)
_anim_settings = Gio.Settings.new("org.gnome.desktop.interface")


def reduce_motion():
    """Reduzir Movimento: "reduce_motion" no config ou animações desligadas no GNOME
    (gsettings org.gnome.desktop.interface enable-animations)."""
    return bool(CFG.get("reduce_motion")) or not _anim_settings.get_boolean("enable-animations")


def emerge(win, base, origin=None):
    """Anima as margens de `win` (anchors em `base`: {Edge: margem}) para que o ponto
    `origin` — (x, y) relativos ao canto superior esquerdo da camada, ou None para o
    ponteiro — fique fixo enquanto o Hyprland escala a camada de POP_FROM a 100%.
    Curva e duração são as do popin (macPop, POP_MS em hypr/hyprmac.lua); com outra
    curva o ponto de origem escorrega. Reabrir no meio recomeça junto com o popin."""
    stop_emerge(win, base)
    if reduce_motion():
        set_margins(win, base)
        return
    nat = win.get_preferred_size()[1]
    w, h = nat.width, nat.height
    if not w or not h:
        set_margins(win, base)
        return
    ox, oy = origin if origin else (w / 2, 0)
    ox, oy = min(max(ox, 0), w), min(max(oy, 0), h)
    margins = {}

    def place(s):
        dx, dy = (1 - s) * (ox - w / 2), (1 - s) * (oy - h / 2)
        for edge, m in base.items():
            if edge == E.TOP:
                value = round(m + dy)
            elif edge == E.BOTTOM:
                value = round(m - dy)
            elif edge == E.LEFT:
                value = round(m + dx)
            elif edge == E.RIGHT:
                value = round(m - dx)
            else:
                value = m
            if margins.get(edge) != value:
                LS.set_margin(win, edge, value)
                margins[edge] = value

    t0 = [None]

    def step(_widget, clock):
        now = clock.get_frame_time() / 1e6
        if t0[0] is None:
            t0[0] = now
        t = 1.0 if reduce_motion() else min(1.0, (now - t0[0]) * 1000 / POP_MS)
        place(POP_FROM + (1 - POP_FROM) * _pop_ease(t))
        if t >= 1:
            win._emerge = None
            return False
        return True
    place(POP_FROM)
    win._emerge = win.add_tick_callback(step)


def stop_emerge(win, base):
    """Interrompe a abertura em curso sem salto: as margens ficam onde estão enquanto o
    Hyprland esmaece a camada (layersOut); a próxima abertura recalcula a partir de `base`."""
    pending = getattr(win, "_emerge", None)
    if pending is not None:
        win.remove_tick_callback(pending)
    win._emerge = None


def set_margins(win, base):
    for edge, margin in base.items():
        LS.set_margin(win, edge, margin)


