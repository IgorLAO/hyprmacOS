CLIP_DIR = os.path.expanduser("~/.cache/hyprmac/clipboard")
CLIP_INDEX = os.path.join(CLIP_DIR, "index.json")
CLIP_KEEP_S = 8 * 3600
TERMINALS = ("ghostty", "kitty", "konsole", "alacritty", "foot", "wezterm", "xterm",
             "gnome-terminal", "terminator", "tilix")


def clip_ago(t):
    m = int((time.time() - t) // 60)
    if m < 1:
        return "Now"
    return f"{m} min ago" if m < 60 else f"{m // 60} hr ago"   # interface em inglês, como no Mac


class ClipboardPanel:
    """Histórico da área de transferência (o que o scripts/clipboard guarda).
    Abre como o scratchpad: no centro, na frente de tudo, com a tela esmaecida
    atrás. Digitar filtra, ↑↓ escolhem, Enter/clique colam, Esc ou clique fora fecham."""

    W, H = 600, 470

    def __init__(self):
        self.open = False
        self.items = []
        register_panel(self)
        # camada da tela inteira: o fundo esmaecido é a própria janela
        # (teclado exclusivo; o clique fora do painel cai no fundo e fecha)
        self.win = layer_window("hyprmac-clipboard", LS.Layer.OVERLAY,
                                anchors=(E.TOP, E.BOTTOM, E.LEFT, E.RIGHT), exclusive=-1,
                                keyboard=LS.KeyboardMode.EXCLUSIVE)
        add_class(self.win, "clip-backdrop")
        # a janela é "app-paintable": o fundo esmaecido do CSS é pintado aqui
        self.win.connect("draw", lambda w, cr: Gtk.render_background(
            w.get_style_context(), cr, 0, 0, w.get_allocated_width(), w.get_allocated_height()))
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect("button-press-event", self._backdrop_click)
        self.win.connect("key-press-event", self._on_key)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self.panel, "clip-panel")
        self.panel.set_size_request(self.W, self.H)
        self.panel.set_halign(Gtk.Align.CENTER)
        self.panel.set_valign(Gtk.Align.CENTER)

        head = Gtk.Box(spacing=8)
        add_class(head, "clip-head")
        head.pack_start(label("Clipboard", "clip-title"), True, True, 0)
        # Tahoe (Mac User Guide ▸ Clipboard history): "click the More button to the right of
        # the search field, then choose Clear History"
        self.clear_btn = Gtk.Button()
        add_class(self.clear_btn, "clip-pill", "clip-more")
        self.clear_btn.add(label(G("f01d8"), "icon", 0.5))
        self.clear_btn.set_tooltip_text("More")
        self.clear_btn.connect("clicked", self._more_menu)
        head.pack_end(self.clear_btn, False, False, 0)

        self.search = Gtk.SearchEntry()
        self._cocoa_keys = CocoaEntryKeys(self.search)
        add_class(self.search, "clip-search")
        self.search.set_placeholder_text("Search History")
        self.search.connect("search-changed", lambda _e: self.list.invalidate_filter())
        self.search.connect("activate", lambda _e: self._paste_selected())

        self.list = Gtk.ListBox()
        add_class(self.list, "clip-list")
        self.list.set_selection_mode(Gtk.SelectionMode.BROWSE)
        self.list.set_filter_func(self._filter)
        self.list.set_activate_on_single_click(True)
        self.list.connect("row-activated", lambda _l, row: self._paste(row.item))
        self.scroll = scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.list)
        self.empty = label("Nothing copied in the last 8 hours", "clip-empty", xalign=0.5)
        self.empty.set_no_show_all(True)

        self.foot = label("", "clip-foot")
        self.panel.pack_start(head, False, False, 0)
        self.panel.pack_start(self.search, False, False, 0)
        self.panel.pack_start(scroll, True, True, 0)
        self.panel.pack_start(self.empty, True, True, 0)
        self.panel.pack_end(self.foot, False, False, 0)

        # o painel engole os cliques (não chegam ao fundo)
        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        ev.add(self.panel)
        ev.set_halign(Gtk.Align.CENTER)
        ev.set_valign(Gtk.Align.CENTER)
        ev.connect("button-press-event", lambda *_: True)
        self.win.add(ev)
        ev.show_all()

    # ── abrir/fechar ──
    def toggle(self):
        self.hide() if self.open else self.show()

    def show(self):
        close_other_panels(self)
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)
        self.open = True
        self._load()
        self.search.set_text("")
        self.win.show()
        self.search.grab_focus()

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        self.win.hide()
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.EXCLUSIVE)

    def preview(self, *_):
        """Testes: mostra o histórico por 2 s sem pegar o teclado."""
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.NONE)
        self.show()
        GLib.timeout_add(2000, lambda: self.hide() and False)

    def _backdrop_click(self, _w, ev):
        self.hide()
        return True

    def _on_key(self, _w, ev):
        if is_modified_arrow(ev):
            return False
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            self.hide()
            return True
        # "select the item and press Command-C": no Linux o copiar dos apps é Ctrl+C
        # (Super+C fecha a janela no Hyprland); só sem texto selecionado no campo
        if (k in (Gdk.KEY_c, Gdk.KEY_C) and ev.state & Gdk.ModifierType.CONTROL_MASK
                and not self.search.get_selection_bounds()):
            row = self._selected_row()
            if row is not None:
                in_thread(self._to_clipboard, row.item)
            return True
        if k in (Gdk.KEY_Down, Gdk.KEY_Up):
            rows = [r for r in self.list.get_children() if self._filter(r)]
            if not rows:
                return True
            cur = self.list.get_selected_row()
            i = rows.index(cur) if cur in rows else -1
            i = min(len(rows) - 1, i + 1) if k == Gdk.KEY_Down else max(0, i - 1)
            self.list.select_row(rows[i])
            rows[i].grab_focus()
            self.search.grab_focus_without_selecting()
            return True
        return False

    # ── conteúdo ──
    def _load(self):
        try:
            with open(CLIP_INDEX) as f:
                items = json.load(f)
        except (OSError, ValueError):
            items = []
        now = time.time()
        self.items = [i for i in items if now - i.get("t", 0) < CLIP_KEEP_S]
        for row in self.list.get_children():
            row.destroy()
        for item in self.items:
            self.list.add(self._row(item))
        self.list.show_all()
        has = bool(self.items)
        self.empty.set_visible(not has)
        self.scroll.set_visible(has)
        n = len(self.items)
        self.foot.set_text(f"{n} {'item' if n == 1 else 'items'}  ·  ↩ Paste  ·  ⌃C Copy  ·  esc Close"
                           if has else "esc Close")
        first = self.list.get_row_at_index(0)
        if first:
            self.list.select_row(first)

    def _row(self, item):
        row = Gtk.ListBoxRow()
        row.item = item
        box = Gtk.Box(spacing=12)
        add_class(box, "clip-row")
        kind = item.get("kind")
        if kind == "image":
            pb = None
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(item.get("thumb") or item["file"], 44, 44, True)
            except Exception:
                pass
            cache = {}
            thumb = Gtk.DrawingArea()
            thumb.set_size_request(44, 44)
            thumb.connect("draw", lambda a, cr: paint_cover(
                cr, pb, a.get_allocated_width(), a.get_allocated_height(), radius=8, cache=cache)
                if pb else None)
            box.pack_start(thumb, False, False, 0)
            text = f"Image  ·  {item.get('w')}×{item.get('h')}"
            row.search = "image imagem"
        else:
            icon = (label(I["folder"], "icon clip-kind", 0.5) if kind == "files"
                    else label("Aa", "clip-kind clip-kind-text", 0.5))
            icon.set_size_request(44, 44)
            box.pack_start(icon, False, False, 0)
            raw = item.get("text", "")
            if kind == "files":
                names = [urllib.parse.unquote(os.path.basename(u.rstrip("/"))) for u in raw.split()]
                text = ", ".join(n for n in names if n)
            else:
                text = " ".join(raw.split())
            row.search = raw.lower()
        main = label(text[:300], "clip-text")
        main.set_ellipsize(3)
        main.set_lines(2)
        main.set_line_wrap(True)
        main.set_line_wrap_mode(2)
        main.set_max_width_chars(48)
        box.pack_start(main, True, True, 0)
        # "Click the copy icon to the right of the item" (copia sem colar)
        copy = Gtk.Button()
        add_class(copy, "clip-copy")
        copy.set_relief(Gtk.ReliefStyle.NONE)
        copy.set_can_focus(False)
        copy.set_valign(Gtk.Align.CENTER)
        copy.add(label(G("f018f"), "icon", 0.5))
        copy.set_tooltip_text("Copy")
        copy.connect("clicked", lambda _b, it=item: in_thread(self._to_clipboard, it))
        box.pack_end(copy, False, False, 0)
        box.pack_end(label(clip_ago(item["t"]), "clip-time", xalign=1.0), False, False, 0)
        row.add(box)
        return row

    def _filter(self, row):
        q = self.search.get_text().strip().lower()
        return not q or q in getattr(row, "search", "")

    # ── colar ──
    def _selected_row(self):
        row = self.list.get_selected_row()
        if row is None or not self._filter(row):
            row = next((r for r in self.list.get_children() if self._filter(r)), None)
        return row

    def _paste_selected(self):
        row = self._selected_row()
        if row is not None:
            self._paste(row.item)

    def _paste(self, item):
        self.hide()
        in_thread(self._do_paste, item)

    @staticmethod
    def _to_clipboard(item):
        if item.get("kind") == "image":
            with open(item["file"], "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], stdin=f)
        else:
            # como no macOS: o histórico cola texto puro
            subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"],
                           input=item.get("text", "").encode())

    @staticmethod
    def _do_paste(item):
        ClipboardPanel._to_clipboard(item)
        time.sleep(0.2)   # o teclado volta para a janela de antes
        cls = (hypr_json("activewindow") or {}).get("class", "").lower()
        mods = "CTRL SHIFT" if any(t in cls for t in TERMINALS) else "CTRL"
        run("hyprctl dispatch " + GLib.shell_quote(
            f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "v" }})'))

    def _more_menu(self, button):
        menu = Gtk.Menu()
        add_class(menu, "xmenu")
        mi = Gtk.MenuItem(label="Clear History")
        mi.set_sensitive(bool(self.items))
        mi.connect("activate", lambda _m: self._clear())
        menu.append(mi)
        menu.show_all()
        menu.popup_at_widget(button, Gdk.Gravity.SOUTH_EAST, Gdk.Gravity.NORTH_EAST, None)

    def _clear(self):
        spawn(os.path.join(ROOT, "scripts", "clipboard") + " clear")
        self.items = []
        for row in self.list.get_children():
            row.destroy()
        GLib.timeout_add(300, lambda: self.open and self._load() and False)


