        self.parts = {"cover": self.cover, "head": self.head, "air": self.air,
                      "prog": self.prog, "ctrl": self.ctrl, "vol": self.vol}
        for w in self.parts.values():
            self.fixed.put(w, 0, 0)

        panel = Gtk.Box()
        add_class(panel, "media-panel")
