class WifiMenu(BarPanel):
    """Menu Wi‑Fi: interruptor, rede atual, redes conhecidas, "Other Networks"
    (abre/fecha) e "Wi‑Fi Settings…". Sem placa Wi‑Fi mostra a(s) Ethernet."""

    def __init__(self, hosted=False):
        super().__init__(hosted)
        self.show_other = False
        self._scanned = 0

    def show(self):
        if self.show_other:
            self.show_other = False
            if self.data is not None:
                self.rebuild()
        super().show()

    def fetch(self):
        wifi_dev, eth = None, []
        for line in run("nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device").splitlines():
            f = nm_fields(line) + ["", "", "", ""]
            dev, typ, state, conn = f[:4]
            if typ == "wifi" and wifi_dev is None:
                wifi_dev = (dev, state, conn)
            elif typ == "ethernet":
                eth.append((dev, state.startswith("connected"), conn))
        radio = run("nmcli radio wifi") == "enabled"
        nets = {}
        profiles = {}
        if wifi_dev and radio:
            if time.monotonic() - self._scanned > 20:     # pede uma busca nova de vez em quando
                self._scanned = time.monotonic()
                spawn("nmcli device wifi rescan")
            for line in run("nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan no").splitlines():
                f = nm_fields(line) + ["", "", "", ""]
                inuse, ssid, sig, sec = f[:4]
                if not ssid:
                    continue
                try:
                    sig = int(sig)
                except ValueError:
                    sig = 0
                old = nets.get(ssid)
                cur = (inuse.strip() == "*") or (old and old[1])
                if not old or sig > old[0] or cur:
                    nets[ssid] = (max(sig, old[0] if old else 0), bool(cur),
                                  bool(sec and sec != "--"))
            uuids = set()
            for line in run("nmcli -t -f UUID,TYPE connection show").splitlines():
                f = nm_fields(line)
                if len(f) >= 2 and f[0] and f[1] == "802-11-wireless":
                    uuids.add(f[0])
            now = time.monotonic()
            if (uuids != getattr(self, "_profile_ids", None) or
                    now - getattr(self, "_profiles_read", 0) >= 20):
                saved = {}
                for uuid in sorted(uuids):
                    # O nome do perfil pode ser renomeado; SSID identifica a
                    # rede e UUID identifica as credenciais a reutilizar.
                    detail = run("nmcli -t -f 802-11-wireless.ssid connection show uuid "
                                 + GLib.shell_quote(uuid))
                    fields = nm_fields(detail)
                    if len(fields) == 2 and fields[0] == "802-11-wireless.ssid":
                        saved.setdefault(fields[1], uuid)
                self._saved_profiles = saved
                self._profile_ids = uuids
                self._profiles_read = now
            # SSID muda raramente: reler a cada scan ou mudança de UUID evita
            # N subprocessos extras em cada polling dos sinais da rede.
            profiles = {ssid: uuid for ssid, uuid in self._saved_profiles.items() if ssid in nets}
        nets = sorted(((ssid, *v, ssid in profiles) for ssid, v in nets.items()),
                      key=lambda n: (-n[2], -n[1]))
        return {"dev": wifi_dev, "radio": radio, "eth": eth, "nets": nets,
                "profiles": profiles}

    @staticmethod
    def _bars(sig):
        return I["wifi4"] if sig >= 75 else I["wifi3"] if sig >= 50 else I["wifi2"] if sig >= 25 else I["wifi1"]

    def signature(self, d):
        # RSSI oscila durante o polling. Preserva ordem, hover e foco enquanto
        # a lista e os estados de conexão/segurança continuam os mesmos.
        networks = sorted((ssid, connected, secure, known)
                          for ssid, _signal, connected, secure, known in d["nets"])
        return repr((d["dev"], d["radio"], d["eth"], networks,
                     sorted(d.get("profiles", {}).items())))

    def update(self, d):
        for ssid, signal, *_ in d["nets"]:
            row = self._network_rows.get(ssid)
            if row is not None:
                row._device_dot.set_text(self._bars(signal))

    def build(self, d):
        if getattr(self, "_other_tick", None) is not None:
            self.box.remove_tick_callback(self._other_tick)
            self._other_tick = None
        self._network_rows = {}
        if d["dev"]:
            self.title_row("Wi‑Fi", d["radio"], self._set_radio)
            if d["radio"]:
                nets = d["nets"]
                cur = [n for n in nets if n[2]]
                known = [n for n in nets if n[4] and not n[2]]
                other = [n for n in nets if not n[4] and not n[2]]
                for ssid, sig, _c, secure, _k in cur:
                    self._network_rows[ssid] = self.device(
                        self._bars(sig), ssid, True, right=I["lock"] if secure else None,
                        right_icon=True, action=None)
                if known:
                    self.head("Known Networks" if len(known) > 1 else "Known Network")
                    for n in known:
                        self._net_row(*n)
                if other:
                    self._other_button = self.disclosure("Other Networks", self.show_other, self._toggle_other)
                    self._other_revealer, group = self.reveal_group(self.show_other)
                    for n in other:
                        self._net_row(*n, container=group)
                if not nets:
                    self.note("Searching for networks…")
        else:
            self.title_row("Wi‑Fi", False, sensitive=False)
            self.note("No Wi‑Fi hardware found")
        if d["eth"]:
            self.sep()
            self.head("Ethernet")
            for dev, up, conn in d["eth"]:
                self.device(I["ethernet"], conn if up and conn else dev, up,
                            sub="Connected" if up else "Not Connected")
        self.sep()
        self.item("Wi‑Fi Settings…" if d["dev"] else "Network Settings…",
                  lambda: open_settings("wifi" if d["dev"] else "network"))

    def _net_row(self, ssid, sig, _cur, secure, known, container=None):
        # conhecida: sobe a conexão salva; nova: o NetworkManager pede a senha ao
        # agente do shell (NMSecretAgent), que mostra a janela de senha
        uuid = self.data.get("profiles", {}).get(ssid) if known else None
        cmd = ("nmcli connection up uuid " + GLib.shell_quote(uuid) if uuid else
               "nmcli device wifi connect " + GLib.shell_quote(ssid))
        self._network_rows[ssid] = self.device(
            self._bars(sig), ssid, False, action=lambda: spawn(cmd),
            right=I["lock"] if secure else None, right_icon=True, container=container)

    def _toggle_other(self):
        self.show_other = not self.show_other
        self._other_button._chevron.set_text(I["chev_d"] if self.show_other else I["chev_r"])
        revealer = self._other_revealer
        revealer.set_transition_duration(0 if reduce_motion() else 240)
        revealer.set_reveal_child(self.show_other)
        # Ajustar também a superfície; deixar a altura anterior mantinha um
        # espaço vazio após recolher. Sem reconstruir switch, foco ou callbacks.
        if getattr(self, "_other_tick", None) is not None:
            self.box.remove_tick_callback(self._other_tick)
        started, last_height = None, None
        def frame(_box, clock):
            nonlocal started, last_height
            now = clock.get_frame_time() / 1e6
            if started is None:
                started = now
            if reduce_motion():
                revealer.set_transition_duration(0)
                revealer.set_reveal_child(self.show_other)
            height = self.box.get_preferred_height()[1]
            if height != last_height:
                self.box.get_toplevel().resize(1, 1)
                last_height = height
            if reduce_motion() or now - started >= 0.26:
                self._other_tick = None
                return False
            return True
        self._other_tick = self.box.add_tick_callback(frame)

    def _set_radio(self, on):
        spawn(f"nmcli radio wifi {'on' if on else 'off'}")
        self.refresh_soon(900)


