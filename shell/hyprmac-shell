# Ajustes ▸ Aparência ▸ Estilo de ícones e widgets: default · dark · clear · tinted
APPEARANCE_PATH = os.path.expanduser("~/.config/hyprmac/aparencia.json")
ICON_STYLES = ("default", "dark", "clear", "tinted")


def icon_style():
    try:
        with open(APPEARANCE_PATH) as f:
            v = json.load(f).get("icon_style", "default")
        return v if v in ICON_STYLES else "default"
    except (OSError, ValueError, AttributeError):
        return "default"


def icon_style_effective():
    """O estilo que o Dock desenha (Ajustes ▸ Aparência, referencias/telas/clear-dark-1 e
    dark-icons-widgets-macos-1): Dark tem "Always / Auto" (Auto = só no tema escuro); Clear
    tem "Light / Dark / Auto" (o vidro dos ícones claro ou escuro)."""
    st = icon_style()
    try:
        with open(APPEARANCE_PATH) as f:
            var = json.load(f).get("icon_style_variant", {})
    except (OSError, ValueError, AttributeError):
        var = {}
    v = var.get(st) if isinstance(var, dict) else None
    if st == "dark" and v == "auto" and not is_dark():
        return "default"
    if st == "clear" and (v == "dark" or (v == "auto" and is_dark())):
        return "clear-dark"
    return st


def set_icon_style(style):
    try:
        with open(APPEARANCE_PATH) as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    d["icon_style"] = style
    os.makedirs(os.path.dirname(APPEARANCE_PATH), exist_ok=True)
    with open(APPEARANCE_PATH, "w") as f:
        json.dump(d, f, indent=1)


def accent_rgb():
    """Cor de destaque atual (gerada por scripts/accent em gtk/accent3.css)."""
    try:
        with open(os.path.join(ROOT, "gtk", "accent3.css")) as f:
            m = re.search(r"@define-color mac_accent\s+#([0-9A-Fa-f]{6})", f.read())
        if m:
            h = m.group(1)
            return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except OSError:
        pass
    return (0.0, 122 / 255, 1.0)


def styled_icon(pb, style):
    """Ícone de app no estilo do sistema (Tahoe): Dark escurece mantendo as cores;
    Clear vira vidro monocromático claro; Tinted vira monocromático na cor de destaque.
    Devolve uma superfície do tamanho do pixbuf."""
    w, h = pb.get_width(), pb.get_height()
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(surf)
    orig = Gdk.cairo_surface_create_from_pixbuf(pb, 1, None)
    if style in ("clear", "clear-dark", "tinted"):
        gray = pb.copy()
        pb.saturate_and_pixelate(gray, 0.0, False)
        cr.set_source_surface(Gdk.cairo_surface_create_from_pixbuf(gray, 1, None), 0, 0)
    else:
        cr.set_source_surface(orig, 0, 0)
    cr.paint()
    if style == "dark":
        cr.set_operator(cairo.OPERATOR_ATOP)
        cr.set_source_rgba(0, 0, 0, 0.42)
        cr.paint()
    elif style == "clear":
        cr.set_operator(cairo.OPERATOR_SCREEN)
        cr.set_source_rgba(1, 1, 1, 0.38)
        cr.paint()
    elif style == "clear-dark":                      # vidro escuro: cinza puxado para baixo
        cr.set_operator(cairo.OPERATOR_ATOP)
        cr.set_source_rgba(0, 0, 0, 0.38)
        cr.paint()
    elif style == "tinted":
        cr.set_operator(cairo.OPERATOR_MULTIPLY)
        cr.set_source_rgb(*accent_rgb())
        cr.paint()
        cr.set_operator(cairo.OPERATOR_SCREEN)
        cr.set_source_rgba(*accent_rgb(), 0.28)
        cr.paint()
    cr.set_operator(cairo.OPERATOR_DEST_IN)          # só onde o ícone original existe
    cr.set_source_surface(orig, 0, 0)
    cr.paint()
    return surf


def display_name(cls):
    """Nome do app como na barra ("Brave", "Ghostty"); sem apelido conhecido,
    o Name do .desktop; por último a classe com inicial maiúscula."""
    if not cls:
        return ""
    known = APP_NAMES.get(cls.lower())
    if known:
        return known
    if APPS is not None:
        name = APPS.name(cls)
        if name:
            return name
    return app_name(cls)


