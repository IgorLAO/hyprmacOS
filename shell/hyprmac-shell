SHELL_BUS = "dev.hyprmac.Shell"
SHELL_PATH = "/dev/hyprmac/Shell"
SHELL_XML = """
<node>
  <interface name="dev.hyprmac.Shell">
    <method name="Command"><arg type="s" name="command" direction="in"/></method>
  </interface>
</node>
"""


def serve_commands(handlers):
    """dev.hyprmac.Shell.Command("toggle-nc" | "toggle-cc" | "window-menu" …).
    O que vier depois do primeiro espaço é passado ao comando ("toggle-media 812 1920")."""
    iface = Gio.DBusNodeInfo.new_for_xml(SHELL_XML).interfaces[0]

    def method(_conn, _sender, _path, _iface, _method, params, invocation):
        name, _, arg = params.get_child_value(0).get_string().partition(" ")
        fn = handlers.get(name)
        if fn:
            GLib.idle_add(lambda: (fn(arg) if arg else fn()) and False)
        invocation.return_value(None)

    def acquired(conn, _name):
        conn.register_object(SHELL_PATH, iface, method, None, None)

    return Gio.bus_own_name(Gio.BusType.SESSION, SHELL_BUS, Gio.BusNameOwnerFlags.NONE,
                            acquired, None, None)


