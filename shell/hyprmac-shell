def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def paint_cover(cr, pixbuf, w, h, radius=0, cache=None):
    """Desenha o pixbuf cobrindo w×h (como background-size: cover)."""
    if pixbuf is None or w <= 0 or h <= 0:
        return
    key = (id(pixbuf), w, h)
    scaled = cache.get(key) if cache is not None else None
    if scaled is None:
        pw, ph = pixbuf.get_width(), pixbuf.get_height()
        s = max(w / pw, h / ph)
        sw, sh = max(1, round(pw * s)), max(1, round(ph * s))
        scaled = pixbuf.scale_simple(sw, sh, GdkPixbuf.InterpType.HYPER)
        if cache is not None:
            # O crossfade mantém a capa anterior e a nova por alguns quadros.
            # Reescalar ambas em todo frame causaria engasgos perceptíveis.
            if len(cache) >= 4:
                cache.clear()
            cache[key] = scaled
    if radius:
        rounded_rect(cr, 0, 0, w, h, radius)
        cr.clip()
    Gdk.cairo_set_source_pixbuf(cr, scaled, (w - scaled.get_width()) / 2,
                                (h - scaled.get_height()) / 2)
    cr.paint()


def label(text="", cls=None, xalign=0.0, markup=False):
    lb = Gtk.Label()
    if markup:
        lb.set_markup(text)
    else:
        lb.set_text(text)
    lb.set_xalign(xalign)
    if cls:
        for c in cls.split():
            lb.get_style_context().add_class(c)
    return lb


def add_class(widget, *classes):
    ctx = widget.get_style_context()
    for c in classes:
        ctx.add_class(c)
    return widget


def set_class(widget, cls, on):
    ctx = widget.get_style_context()
    (ctx.add_class if on else ctx.remove_class)(cls)


