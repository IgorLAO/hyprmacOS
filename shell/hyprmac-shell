class ShellMenu:
    """Menu da barra montado na hora (Gtk.Menu), com o visual dos menus do kit.

    Um Gtk.Menu precisa de uma superfície-mãe: usamos uma camada invisível de
    1×30 px sobre a barra, na posição do cursor, e abrimos o menu logo abaixo.
    Só um menu do shell fica aberto por vez (e nenhum painel junto)."""

    current = None

    def __init__(self):
        self.anchor_win = None
        self.menu = None

    def popup(self):
        if self.menu is not None:          # clicar de novo fecha
            self.menu.popdown()
            self._closed()                 # popdown() nem sempre emite "deactivate"
            return
        other = ShellMenu.current
        if other is not None and other.menu is not None:
            other.menu.popdown()
            other._closed()
        close_other_panels(None)
        cur = hypr_json("cursorpos") or {"x": 0, "y": 0}
        mon_name, mon_x = None, 0
        for m in hypr_json("monitors"):
            if m["x"] <= cur["x"] < m["x"] + m["width"] and m["y"] <= cur["y"] < m["y"] + m["height"]:
                mon_name, mon_x = m["name"], m["x"]
        gmon = gdk_monitors()[0].get(mon_name)

        win = layer_window("hyprmac-menu", LS.Layer.TOP, gmon, anchors=(E.TOP, E.LEFT),
                           margins={E.LEFT: max(0, cur["x"] - mon_x - 16)}, exclusive=-1)
        area = Gtk.Box()
        area.set_size_request(1, 30)
        win.add(area)
        self.anchor_win = win

        menu = menu_check_column(self._build())
        menu.connect("deactivate", lambda _m: GLib.idle_add(self._closed, _m))
        self.menu = menu
        ShellMenu.current = self
        # Abrir após mapear a âncora, sem uma espera arbitrária. Um clique rápido
        # pode fechar/trocar o menu antes deste idle; nesse caso não o ressuscitar.
        def present():
            if self.menu is menu and self.anchor_win is win and area.get_mapped():
                menu.popup_at_widget(area, Gdk.Gravity.SOUTH_WEST,
                                     Gdk.Gravity.NORTH_WEST, None)
            return False
        area.connect("map", lambda *_: GLib.idle_add(present))
        win.show_all()

    def _closed(self, expected_menu=None):
        if expected_menu is not None and self.menu is not expected_menu:
            return False
        if self.menu is None and self.anchor_win is None:
            return False
        self.menu = None
        if ShellMenu.current is self:
            ShellMenu.current = None
        if self.anchor_win:
            self.anchor_win.destroy()
            self.anchor_win = None
        return False

    # ── conteúdo ──
    @staticmethod
    def _new_menu():
        m = Gtk.Menu()
        m.set_reserve_toggle_size(False)
        add_class(m, "hyprmac-menu")
        return m

    @staticmethod
    def _attach_submenu(item, submenu):
        # Menus.txt distingue Hover (seleção) de Submenu/Open (tint neutro).
        # O estado acompanha o popup real, tanto pelo mouse quanto pelo teclado.
        item.set_submenu(submenu)
        # Chevron do kit (􀆊 Bold 13, cinza dos atalhos) no lugar da seta do tema GTK
        box = menu_item_box(item)
        chevron = label(MENU_CHEVRON, "shortcut chevron", 1.0)
        chevron.set_margin_start(24)
        box.pack_end(chevron, False, False, 0)
        chevron.show()
        submenu.connect("map", lambda _menu: set_class(item, "submenu-open", True))
        submenu.connect("unmap", lambda _menu: set_class(item, "submenu-open", False))

    def _item(self, menu, text, action=None, markup=False, sensitive=True, submenu=None,
              shortcut=None, check=None):
        """Item de 24 px; `shortcut` (ex.: "⌘H") vai à direita, em cinza; `check`
        True/False faz dele um item de estado (coluna da marca, menu_check_column)."""
        it = Gtk.MenuItem()
        lb = Gtk.Label(xalign=0)
        (lb.set_markup if markup else lb.set_text)(text)
        if shortcut:
            box = Gtk.Box()
            box.pack_start(lb, True, True, 0)
            sc = label(shortcut, "shortcut", 1.0)
            sc.set_margin_start(24)
            box.pack_end(sc, False, False, 0)
            it.add(box)
        else:
            it.add(lb)
        if check is not None:
            menu_check(it, check)
        it.set_sensitive(sensitive)
        if submenu is not None:
            self._attach_submenu(it, submenu)
        elif action:
            it.connect("activate", lambda _i: action())
        menu.append(it)
        return it

    def _sep(self, menu):
        menu.append(Gtk.SeparatorMenuItem())

    def _build(self):
        raise NotImplementedError


