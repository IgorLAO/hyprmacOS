class AppleMenu(ShellMenu):
    """Menu Apple no shell: submenus GTK ficam no mesmo processo que o popup."""

    def _recent_item(self, menu, title, icon, action):
        item = self._item(menu, title, action)
        box = menu_item_box(item)
        if icon:
            picture = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.MENU)
            picture.set_pixel_size(16)
            picture.set_margin_end(7)
            box.pack_start(picture, False, False, 0)
            box.reorder_child(picture, 0)
        child = next((widget for widget in box.get_children()
                      if isinstance(widget, Gtk.Label)), None)
        if child:
            child.set_max_width_chars(48)
            child.set_ellipsize(Pango.EllipsizeMode.END)
        return item

    def _recent_menu(self):
        menu = self._new_menu()
        manager = Gtk.RecentManager.get_default()
        recent = sorted(manager.get_items(), key=lambda info: info.get_modified(), reverse=True)
        try:
            with open(os.path.expanduser("~/.config/hyprmac/ajustes.json")) as state:
                limit = int(json.load(state).get("recents", 10))
        except (OSError, ValueError, TypeError, AttributeError):
            limit = 10
        limit = limit if limit in (5, 10, 15) else 10
        apps, documents, servers = [], [], []
        seen_apps = set()
        installed_apps = {}
        for app in Gio.AppInfo.get_all():
            app_id = app.get_id()
            names = (app.get_name(), app.get_display_name(),
                     app_id, app_id.removesuffix(".desktop") if app_id else None)
            for name in names:
                if name:
                    installed_apps.setdefault(name, app)
        for info in recent:
            uri = info.get_uri()
            if not uri:
                continue
            if uri.startswith("file:"):
                if len(documents) < limit:
                    documents.append(info)
            elif len(servers) < limit:
                servers.append(info)
            for app_name in info.get_applications():
                if app_name in seen_apps or len(apps) >= limit:
                    continue
                app = installed_apps.get(app_name)
                if app:
                    apps.append(app)
                    seen_apps.add(app_name)

        for title, entries in (("Applications", apps), ("Documents", documents),
                               ("Servers", servers)):
            menu.append(menu_header(title))
            if not entries:
                self._item(menu, "No Recent Items", sensitive=False)
            for entry in entries:
                if title == "Applications":
                    self._recent_item(menu, entry.get_name(), entry.get_icon(),
                                      lambda app=entry: app.launch([], None))
                else:
                    self._recent_item(menu, entry.get_display_name(), entry.get_gicon(),
                                      lambda uri=entry.get_uri():
                                      Gio.AppInfo.launch_default_for_uri(uri, None))
            self._sep(menu)
        self._item(menu, "Clear Menu", manager.purge_items,
                   sensitive=bool(recent))
        return menu

    def _build(self):
        menu = self._new_menu()
        self._item(menu, "About This Mac", lambda: open_settings("about"),
                   icon_name="dialog-information-symbolic")
        self._sep(menu)
        self._item(menu, "System Settings…", open_settings,
                   icon_name="preferences-system-symbolic")
        self._item(menu, "App Store", lambda: spawn(os.path.join(HERE, "hyprmac-app")
                                                   + " dev.hyprmac.AppStore"),
                   icon_name="system-software-install-symbolic")
        self._sep(menu)
        self._item(menu, "Recent Items", submenu=self._recent_menu(),
                   icon_name="document-open-recent-symbolic")
        self._sep(menu)
        self._item(menu, "Force Quit…", lambda: spawn(os.path.join(HERE, "hyprmac-shell")
                                                    + " force-quit"), shortcut="⌥⌘⎋",
                   icon_name="process-stop-symbolic")
        self._sep(menu)
        self._item(menu, "Sleep", lambda: spawn("systemctl suspend"),
                   icon_name="weather-clear-night-symbolic")
        self._item(menu, "Restart…", lambda: spawn("systemctl reboot"),
                   icon_name="system-reboot-symbolic")
        self._item(menu, "Shut Down…", lambda: spawn("systemctl poweroff"),
                   icon_name="system-shutdown-symbolic")
        self._sep(menu)
        self._item(menu, "Lock Screen", lambda: spawn(os.path.join(HERE, "hyprmac-lock")),
                   shortcut="⌃⌘Q", icon_name="system-lock-screen-symbolic")
        username = os.environ.get("USER", "User").capitalize()
        self._item(menu, f"Log Out {username}…", lambda: dispatch("hl.dsp.exit()"),
                   icon_name="system-log-out-symbolic")
        menu.show_all()
        return menu


