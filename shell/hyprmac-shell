MESES = ["January", "February", "March", "April", "May", "June", "July", "August",
         "September", "October", "November", "December"]


def when_text(ts, now=None):
    """Horário relativo da Central de Notificações (NotificationCenter.app 26.6.1,
    Localizable: now, %dm ago, Yesterday, %d days ago)."""
    now = time.time() if now is None else now
    delta = now - ts
    if delta < 60:
        return "now"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    lt = time.localtime(ts)
    dias = (datetime.date.fromtimestamp(now) - datetime.date.fromtimestamp(ts)).days
    if dias <= 0:
        return f"{lt.tm_hour}:{lt.tm_min:02d}"
    if dias == 1:
        return "Yesterday"
    if dias < 7:
        return f"{dias} days ago"
    return f"{lt.tm_mon}/{lt.tm_mday}/{lt.tm_year % 100:02d}"


class ClickCatchers:
    """Camadas por monitor; deixam a Waybar receber o clique de troca de menu."""

    def __init__(self, namespace, on_click):
        self.windows = []
        for mon in gdk_monitors()[1]:
            c = layer_window(namespace, LS.Layer.TOP, mon,
                             anchors=(E.TOP, E.BOTTOM, E.LEFT, E.RIGHT),
                             margins={E.TOP: BAR_STRIP}, exclusive=-1)
            c.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.TOUCH_MASK)
            c.connect("button-press-event", lambda *_: on_click())
            c.connect("touch-event", lambda *_: on_click())
            self.windows.append(c)

    def show(self):
        for c in self.windows:
            c.show_all()

    def hide(self):
        for c in self.windows:
            c.hide()


class CalendarWidget(Gtk.Box):
    """Widget de calendário do mês, com o dia de hoje num círculo vermelho."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        add_class(self, "notif", "calendar")
        self.refresh()

    def refresh(self):
        import calendar
        for child in self.get_children():
            child.destroy()
        today = time.localtime()
        self.pack_start(label(MESES[today.tm_mon - 1].upper(), "cal-month"), False, False, 0)
        grid = Gtk.Grid(column_homogeneous=True, row_spacing=2)
        for col, d in enumerate("SMTWTFS"):
            grid.attach(label(d, "cal-head", xalign=0.5), col, 0, 1, 1)
        cal = calendar.Calendar(firstweekday=6)          # semana começa no domingo
        for row, week in enumerate(cal.monthdayscalendar(today.tm_year, today.tm_mon), start=1):
            for col, day in enumerate(week):
                if not day:
                    continue
                cls = "cal-day cal-today" if day == today.tm_mday else "cal-day"
                grid.attach(label(str(day), cls, xalign=0.5), col, row, 1, 1)
        self.pack_start(grid, False, False, 0)
        self.show_all()


class NotifPanel:
