def spot_shift(width, field_w, over, controls_w, margin=8, center_group=False):
    """Centraliza o conjunto vazio ou desloca apenas o necessário para evitar recorte."""
    overflow = width / 2 + field_w / 2 - over + controls_w + margin - width
    group = (controls_w - over) / 2 if center_group else 0
    return max(0, int(round(overflow)), int(round(group)))


