    # ── arranjos ──
    def _layout_rects(self, name):
        """Retângulos (x, y, w, h) de cada bloco + tamanho total, por arranjo."""
        hh, hp, hc, hv, air = self.H_HEAD, self.H_PROG, self.H_CTRL, self.H_VOL, self.AIR
        if name == "large":
            W = c = 300
            y = c + 16
            r = {"cover": (0, 0, c, c),
                 "head": (0, y, W - air - 8, hh),
                 "air": (W - air, y + (hh - air) / 2, air, air),
                 "prog": (0, y + hh + 8, W, hp),
                 "ctrl": (0, y + hh + 8 + hp + 6, W, hc),
                 "vol": (0, y + hh + 8 + hp + 6 + hc + 8, W, hv)}
        elif name == "side":
            W, c = 420, 150
            x = c + 20
            cw = W - x
            col = hh + 6 + hp + 4 + hc + 6 + hv
            r = {"cover": (0, (col - c) / 2, c, c),
                 "head": (x, 0, cw - air - 8, hh),
                 "air": (W - air, (hh - air) / 2, air, air),
                 "prog": (x, hh + 6, cw, hp),
                 "ctrl": (x, hh + 6 + hp + 4, cw, hc),
                 "vol": (x, hh + 6 + hp + 4 + hc + 6, cw, hv)}
        else:   # compact: como a tela de bloqueio (capa pequena ao lado do título)
            W, c = 320, 62
            x = c + 14
            r = {"cover": (0, 0, c, c),
                 "head": (x, (c - hh) / 2, W - x - air - 8, hh),
                 "air": (W - air, (c - air) / 2, air, air),
                 "prog": (0, c + 14, W, hp),
                 "ctrl": (0, c + 14 + hp + 4, W, hc),
                 "vol": (0, c + 14 + hp + 4 + hc + 8, W, hv)}
        H = max(y + h for (_x, y, _w, h) in r.values())
        r["size"] = (W, H)
        return r

    def _apply_rects(self, r):
        for key, w in self.parts.items():
            x, y, ww, hh = r[key]
            self.fixed.move(w, round(x), round(y))
            w.set_size_request(max(1, round(ww)), max(1, round(hh)))
        W, H = r["size"]
        self.fixed.set_size_request(round(W), round(H))
        self.win.resize(1, 1)

    def _cycle_layout(self):
        i = MEDIA_LAYOUTS.index(self.layout)
        self.layout = MEDIA_LAYOUTS[(i + 1) % len(MEDIA_LAYOUTS)]
        self._save_layout()
        start, end = self.rects, self._layout_rects(self.layout)
        if reduce_motion():
            if self._anim:
                self.fixed.remove_tick_callback(self._anim)
                self._anim = None
            self.rects = end
            self._apply_rects(end)
            self.cover.queue_draw()
            return True
        t0 = time.monotonic()

        def frame(*_):
            t = min(1.0, (time.monotonic() - t0) * 1000 / MEDIA_ANIM_MS)
            e = ease_in_out(t)
            cur = {k: tuple(a + (b - a) * e for a, b in zip(start[k], end[k])) for k in end}
            self.rects = cur
            self._apply_rects(cur)
            self.cover.queue_draw()
            if t >= 1.0:
                self._anim = None
                return False
            return True
        if self._anim:
            self.fixed.remove_tick_callback(self._anim)
        self._anim = self.fixed.add_tick_callback(frame)
        return True

    def _load_layout(self):
        try:
            with open(MEDIA_STATE) as f:
                name = json.load(f).get("layout")
            return name if name in MEDIA_LAYOUTS else "compact"
        except (OSError, ValueError, AttributeError):
            return "compact"

    def _save_layout(self):
        try:
            os.makedirs(os.path.dirname(MEDIA_STATE), exist_ok=True)
            with open(MEDIA_STATE, "w") as f:
                json.dump({"layout": self.layout}, f)
        except OSError:
            pass

    # ── abrir/fechar ──
    def toggle(self, arg=""):
        self.hide() if self.open else self.show(arg)

    def show(self, arg=""):
        close_other_panels(self)
        mons = hypr_json("monitors")
        mon = next((m for m in mons if m.get("focused")), None)
        gmon = gdk_monitors()[0].get(mon["name"]) if mon else None
        if gmon:
            LS.set_monitor(self.win, gmon)
        # centraliza sob o nome na barra ("x largura-da-barra", vindo do módulo)
        right = 10
        try:
            cx, bar_w = (int(v) for v in arg.split())
            outer = self.rects["size"][0] + 36
            right = max(10, round(bar_w - cx - outer / 2))
        except ValueError:
            pass
        LS.set_margin(self.win, E.RIGHT, right)
        self._right = right
        self.open = True
        self.refresh()
        self.catchers.show()
        self.win.show()
        emerge(self.win, {E.TOP: 8, E.RIGHT: right})   # do nome da música, no centro
        self._polls = [GLib.timeout_add(1000, self._tick), GLib.timeout_add(250, self._advance)]

    def hide(self):
        if not self.open:
            return
        self.open = False
        self._grid_on = False
        for p in self._polls:
            GLib.source_remove(p)
        self._polls = []
        self.win.hide()
        stop_emerge(self.win, {E.TOP: 8, E.RIGHT: self._right})
        self.catchers.hide()

    # ── estado ──
    def _tick(self):
        self.refresh()
        return True

    def refresh(self):
        in_thread(self._fetch)

    def _fetch(self):
        fmt = ("{{playerName}}\t{{status}}\t{{title}}\t{{artist}}\t{{album}}\t"
               "{{mpris:artUrl}}\t{{mpris:length}}\t{{position}}")
        rows = [ln.split("\t") for ln in
                run(f"playerctl -a metadata --format '{fmt}' 2>/dev/null").splitlines()]
        rows = [r for r in rows if len(r) == 8]
        # o mesmo critério da barra: quem está tocando; senão, o primeiro
        row = next((r for r in rows if r[1] == "Playing"), rows[0] if rows else None)
        # a saída que está tocando (nem sempre é a padrão) — a mesma das barrinhas
        try:
            sinks = json.loads(run("pactl -f json list sinks") or "[]")
        except ValueError:
            sinks = []
        default = run("pactl get-default-sink")
        running = [x for x in sinks if x.get("state") == "RUNNING"]
        sink = (next((x for x in running if x.get("name") == default), None)
                or (running[0] if running else None)
                or next((x for x in sinks if x.get("name") == default), None))
        GLib.idle_add(self._apply, row, sink)

    def _apply(self, row, sink_info):
        sink = ""
        if sink_info:
            self.sink = sink_info.get("name")
            sink = sink_info.get("description", "")
            try:
                ch = next(iter(sink_info["volume"].values()))
                vol = 0 if sink_info.get("mute") else int(ch["value_percent"].rstrip("%"))
                if not self.vol_scale.has_grab():
                    self.vol_scale.set_value(vol)
            except (KeyError, StopIteration, ValueError, AttributeError):
                pass
        if not row:
            self.player, self.status, self.length, self.position = None, "Stopped", 0, 0
            self.source.set_text(sink)
            self.title.set_text("Not Playing")
            self.artist.set_text("")
            self.play_lbl.set_text(I["play"])
            self._set_art(None)
            self._show_progress()
            return False
        name, status, title, artist, album, art, length, pos = row
        self.player, self.status = name, status
        player = app_name(name.split(".")[0])
        self.source.set_text(f"{player}  ›  {sink}" if sink else player)
        self.title.set_text(title or "Sem título")
        self.artist.set_text(" — ".join(p for p in (artist, album) if p))
        self.play_lbl.set_text(I["pause"] if status == "Playing" else I["play"])
        try:
            self.length = int(length) / 1e6
        except ValueError:
            self.length = 0
        # O polling pode devolver a posição anterior ao seek. Enquanto o
        # puxador pertence ao gesto, conservar também o tempo escolhido;
        # só proteger o GtkScale deixava os rótulos saltarem para trás.
        if not self.seek.has_grab():
            try:
                self.position = int(pos) / 1e6
            except ValueError:
                self.position = 0
            self.pos_at = time.monotonic()
        self._set_art(art)
        self._show_progress()
        return False

    def _current_pos(self):
        p = self.position
        if self.status == "Playing":
            p += time.monotonic() - self.pos_at
        return min(p, self.length) if self.length else p

    def _advance(self):
        if self.status == "Playing":
            self._show_progress()
        return True

    def _show_progress(self, preview=None):
        if not self.length:
            self.elapsed.set_text("-:--")
            self.remain.set_text("--:--")
            if not self.seek.has_grab():
                self.seek.set_value(0)
            return
        p = (preview if preview is not None else
             self.seek.get_value() * self.length if self.seek.has_grab()
             else self._current_pos())
        self.elapsed.set_text(fmt_time(p))
        self.remain.set_text("-" + fmt_time(self.length - p))
        if not self.seek.has_grab():
            self.seek.set_value(p / self.length)

    # ── ações ──
    def _pctl(self, args):
        who = f"-p {GLib.shell_quote(self.player)} " if self.player else ""
        spawn(f"playerctl {who}{args}")

    def _command(self, cmd):
        self._pctl(cmd)
        if cmd == "play-pause":
            playing = self.status != "Playing"
            self.position, self.pos_at = self._current_pos(), time.monotonic()
            self.status = "Playing" if playing else "Paused"
            self.play_lbl.set_text(I["pause"] if playing else I["play"])
        GLib.timeout_add(350, lambda: self.refresh() and False)

    def _on_seek(self, _scale, _scroll, value):
        if not self.length:
            return True
        value = min(max(value, 0), 1)
        self.position, self.pos_at = value * self.length, time.monotonic()
        self._pctl(f"position {self.position:.2f}")
        self._show_progress(preview=self.position)
        return False

    def _on_volume(self, _scale, _scroll, value):
        v = round(min(max(value, 0), 100))
        target = GLib.shell_quote(self.sink) if self.sink else "@DEFAULT_SINK@"
        spawn(f"pactl set-sink-mute {target} 0; pactl set-sink-volume {target} {v}%")
        return False

    # ── capa ──
    def _set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url:
            in_thread(self._load_art, url)
        else:
            self._transition_art(None)

    def _load_art(self, url):
        try:
            if url.startswith("file://"):
                path = urllib.parse.unquote(url[7:])
            else:
                os.makedirs(CACHE, exist_ok=True)
                path = os.path.join(CACHE, "art-media")
                urllib.request.urlretrieve(url, path)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 640, 640, True)
        except Exception:
            return
        GLib.idle_add(self._art_loaded, url, pb)

    def _art_loaded(self, url, pb):
        if url == self.art_url:
            # superfície do cairo: redimensiona rápido a cada quadro da animação
            self._transition_art(Gdk.cairo_surface_create_from_pixbuf(pb, 1, None))
        return False

    def _transition_art(self, surface):
        previous = self.art_surface
        if self._art_tick is not None and not reduce_motion():
            w, h = self.cover.get_allocated_width(), self.cover.get_allocated_height()
            if w > 0 and h > 0:
                previous = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
                self._draw_cover(self.cover, cairo.Context(previous))
        if self._art_tick is not None:
            self.cover.remove_tick_callback(self._art_tick)
            self._art_tick = None
        self._art_previous = previous
        self.art_surface = surface
        if reduce_motion() or self._art_previous is surface:
            self._art_previous = None
            self._art_mix = 1.0
            self.cover.queue_draw()
            return
        self._art_mix = 0.0
        started = None
        def frame(_area, clock):
            nonlocal started
            now = clock.get_frame_time() / 1e6
            if started is None:
                started = now
            u = min(1.0, (now - started) / 0.24)
            self._art_mix = 1 - (1 - u) ** 3
            self.cover.queue_draw()
            if u >= 1:
                self._art_previous = None
                self._art_tick = None
                return False
            return True
        self._art_tick = self.cover.add_tick_callback(frame)

    def _draw_cover(self, area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        # concêntrica com o painel: raio 30 − padding 18 (a capa encosta no canto)
        radius = MEDIA_COVER_R
        cr.save()
        rounded_rect(cr, 0, 0, w, h, radius)
        cr.clip()
        cr.push_group()
        if self._art_previous is not None or self._art_mix < 1:
            self._paint_art(cr, self._art_previous, w, h, 1 - self._art_mix)
        self._paint_art(cr, self.art_surface, w, h, self._art_mix)
        cr.pop_group_to_source()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.paint()
        cr.restore()

    def _paint_art(self, cr, s, w, h, alpha):
        if alpha <= 0:
            return
        cr.save()
        cr.push_group()
        cr.set_operator(cairo.OPERATOR_OVER)
        if s is None:
            g = cairo.LinearGradient(0, 0, w, h)
            g.add_color_stop_rgba(0, 0.36, 0.52, 0.86, 0.55)
            g.add_color_stop_rgba(1, 0.62, 0.66, 0.74, 0.35)
            cr.set_source(g)
            cr.paint()
            cr.set_source_rgba(1, 1, 1, 0.75)
            cr.select_font_face("Symbols Nerd Font")
            cr.set_font_size(min(w, h) * 0.38)
            ext = cr.text_extents(I["note"])
            cr.move_to((w - ext.width) / 2 - ext.x_bearing, (h - ext.height) / 2 - ext.y_bearing)
            cr.show_text(I["note"])
        else:
            sw, sh = s.get_width(), s.get_height()
            k = max(w / sw, h / sh)
            cr.translate((w - sw * k) / 2, (h - sh * k) / 2)
            cr.scale(k, k)
            cr.set_source_surface(s, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint()
        cr.pop_group_to_source()
        cr.set_operator(cairo.OPERATOR_ADD)
        cr.paint_with_alpha(alpha)
        cr.restore()


