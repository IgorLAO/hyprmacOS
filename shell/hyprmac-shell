class NowPlaying(Gtk.Box):
    def do_get_preferred_width(self):
        return W2, W2

    def do_get_preferred_width_for_height(self, _h):
        return W2, W2

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(self, "tile", "nowplaying")
        self.set_size_request(W2, W2)
        self.art_pixbuf = None
        self._old_art_pixbuf = None
        self._art_mix = 1.0
        self._art_tick = None
        self.art_url = None
        self.cache = {}
        self.art = Gtk.DrawingArea()
        self.art.set_size_request(NP_ART, NP_ART)
        self.art.set_halign(Gtk.Align.START)
        self.art.connect("draw", self._draw_art)
        self.title = label("Not Playing", "title")
        self.artist = label("", "subtitle")
        for lb in (self.title, self.artist):
            lb.set_ellipsize(3)
            lb.set_max_width_chars(9)
        ctr = Gtk.Box(spacing=0, homogeneous=True)
        self.play = None
        self.play_button = None
        self.transport = []
        for icon, cmd in (("backward.fill", "previous"), ("play.fill", "play-pause"),
                          ("forward.fill", "next")):
            b = Gtk.Button()
            add_class(b, "media")
            b.set_tooltip_text({"previous": "Previous Track", "play-pause": "Play",
                                "next": "Next Track"}[cmd])
            lb = SFIcon(icon, 24, 24, "media-glyph")
            b.add(lb)
            b.connect("clicked", lambda _b, c=cmd: (spawn(f"playerctl {c}"),
                                                    GLib.timeout_add(300, self.refresh)))
            ctr.pack_start(b, True, True, 0)
            self.transport.append(b)
            if cmd == "play-pause":
                self.play = lb
                self.play_button = b
                add_class(b, "play")
        self.pack_start(self.art, False, False, 0)
        self.pack_end(ctr, False, False, 0)
        self.pack_end(self.artist, False, False, 0)
        self.pack_end(self.title, False, False, 0)
        self._apply([])

    def refresh(self):
        in_thread(self._fetch)
        return False

    def _fetch(self):
        out = run("playerctl metadata --format "
                  "'{{status}}\t{{title}}\t{{artist}}\t{{mpris:artUrl}}' 2>/dev/null")
        # run() tira whitespace final, incluindo campos opcionais vazios.
        parts = out.split("\t") if out else []
        if parts and parts[0] in ("Playing", "Paused", "Stopped"):
            parts += [""] * max(0, 4 - len(parts))
        GLib.idle_add(self._apply, parts)

    def _apply(self, parts):
        available = len(parts) >= 4
        for button in self.transport:
            button.set_sensitive(available)
        if len(parts) < 4:
            self.title.set_text("Not Playing")
            self.artist.set_text("")
            self.play.set_name_("play.fill")
            self.play_button.set_tooltip_text("Play")
            self._set_art(None)
            return False
        status, title, artist, art = parts[:4]
        self.title.set_text(title or "Sem título")
        self.artist.set_text(artist)
        self.play.set_name_("pause.fill" if status == "Playing" else "play.fill")
        self.play_button.set_tooltip_text("Pause" if status == "Playing" else "Play")
        self._set_art(art)
        return False

    def _set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url:
            in_thread(self._load_art, url)
        else:
            self._transition_art(None)

    def _load_art(self, url):
        try:
            if url.startswith("file://"):
                path = urllib.parse.unquote(url[7:])
            else:
                os.makedirs(CACHE, exist_ok=True)
                path = os.path.join(CACHE, "art")
                urllib.request.urlretrieve(url, path)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 160, 160, True)
        except Exception:
            return
        GLib.idle_add(self._art_loaded, url, pb)

    def _art_loaded(self, url, pb):
        if url == self.art_url:
            self._transition_art(pb)
        return False

    def _transition_art(self, pixbuf):
        previous = self.art_pixbuf
        if self._art_tick is not None and not reduce_motion():
            w, h = self.art.get_allocated_width(), self.art.get_allocated_height()
            if w > 0 and h > 0:
                surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
                self._draw_art(self.art, cairo.Context(surface))
                previous = Gdk.pixbuf_get_from_surface(surface, 0, 0, w, h)
        if self._art_tick is not None:
            self.art.remove_tick_callback(self._art_tick)
            self._art_tick = None
        self._old_art_pixbuf = previous
        self.art_pixbuf = pixbuf
        if reduce_motion() or self._old_art_pixbuf is pixbuf:
            self._old_art_pixbuf = None
            self._art_mix = 1.0
            self.art.queue_draw()
            return
        self._art_mix = 0.0
        started = None
        def frame(_area, clock):
            nonlocal started
            now = clock.get_frame_time() / 1e6
            if started is None:
                started = now
            u = min(1.0, (now - started) / 0.24)
            self._art_mix = 1 - (1 - u) ** 3
            self.art.queue_draw()
            if u >= 1:
                self._old_art_pixbuf = None
                self._art_tick = None
                return False
            return True
        self._art_tick = self.art.add_tick_callback(frame)

    def _draw_art(self, area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        def paint(pixbuf, alpha):
            if alpha <= 0:
                return
            cr.save()
            cr.push_group()
            cr.set_operator(cairo.OPERATOR_OVER)
            if pixbuf:
                paint_cover(cr, pixbuf, w, h, radius=NP_ART_R, cache=self.cache)
            else:
                # Placeholder do estado "Not Playing".
                rounded_rect(cr, 0, 0, w, h, NP_ART_R)
                cr.set_source_rgba(0.82, 0.82, 0.86, 0.26)
                cr.fill()
            cr.pop_group_to_source()
            cr.set_operator(cairo.OPERATOR_ADD)
            cr.paint_with_alpha(alpha)
            cr.restore()
        # Interpolar as duas imagens em um grupo isolado evita que o fundo
        # atravesse a capa no meio do crossfade (OVER + OVER deixava alpha 0,75).
        cr.save()
        cr.push_group()
        if self._old_art_pixbuf is not None or self._art_mix < 1:
            paint(self._old_art_pixbuf, 1 - self._art_mix)
        paint(self.art_pixbuf, self._art_mix)
        cr.pop_group_to_source()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.paint()
        cr.restore()


CONTROLS_PATH = os.path.expanduser("~/.config/hyprmac/controls.json")
SPANS = {"small": (1, 1), "medium": (2, 1), "large": (2, 2), "wide": (4, 1)}


def cc_pack(sizes, cols=4):
    """Posições (col, row, w, h) dos controles, na ordem, no primeiro lugar livre."""
    used, out = set(), []
    for size in sizes:
        cw, ch = SPANS[size]
        row = 0
        while True:
            col = next((c for c in range(cols + 1 - cw)
                        if all((c + dx, row + dy) not in used
                               for dx in range(cw) for dy in range(ch))), None)
            if col is not None:
                break
            row += 1
        used |= {(col + dx, row + dy) for dx in range(cw) for dy in range(ch)}
        out.append((col, row, cw, ch))
    return out


def cc_reorder(order, dragged, cell, sizes):
    """Arrasto na Central: o controle arrastado toma o lugar (na ordem) de quem ocupa a
    célula sob o ponteiro e os outros se realocam; célula vazia leva ao fim. A decisão
    usa a disposição prevista, então o controle sob o ponteiro não fica alternando."""
    pos = cc_pack([sizes[i] for i in order])
    cx, cy = cell
    hit = next((k for k, (c, r, w, h) in enumerate(pos)
                if c <= cx < c + w and r <= cy < r + h), None)
    k = order.index(dragged)
    new = [i for i in order if i != dragged]
    if hit is None:
        if cy > max((r + h - 1 for _c, r, _w, h in pos), default=-1) or k == len(order) - 1:
            new.append(dragged)
        else:
            return order                     # buraco no meio: fica como está
    elif hit == k:
        return order
    else:
        new.insert(hit, dragged)
    return new


def cc_fit_size(sizes, current, span):
    """Alça de redimensionar: entre os tamanhos que o controle aceita, o mais perto do
    vão (w, h) puxado; empate fica com o atual."""
    w, h = span
    return min(sizes, key=lambda s: (abs(SPANS[s][0] - w) + abs(SPANS[s][1] - h), s != current))
