            box.pack_start(ic, False, False, 0)
            box.pack_start(label(name, "ccg-cat-name"), False, False, 0)
            row.add(box)
            cats.add(row)
        cats.connect("row-selected", lambda _l, row: row and self._pick_category(row.cat))
        cats.select_row(cats.get_row_at_index(0))
        side.pack_start(cats, False, False, 0)
        reset = Gtk.Button()
        add_class(reset, "ccg-reset")
        reset.add(label("Restore Defaults", xalign=0.5))
        reset.set_halign(Gtk.Align.START)
        reset.connect("clicked", lambda _b: self._reset_layout())
        side.pack_end(reset, False, False, 0)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
