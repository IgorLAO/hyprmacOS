    def _preview(self, key, size):
        """Cópia estática do controle no tamanho dado (só para mostrar)."""
        ctl, _sizes = self.catalog[key]
        name = self.names.get(key) or ctl.title
        if size == "small":
            w = Circle(ctl.icon, name, lambda: None)
        elif size == "medium":
            w = Tile(ctl.icon, ctl.title, "", lambda: None)
            w.dot.get_style_context().add_class("off")
            w.subtitle.set_no_show_all(True)     # sem estado: o título fica centrado
            w.subtitle.hide()
        elif size == "large":
            w = NowPlaying()
        else:
            w = SliderTile(name, I.get(GALLERY_SLIDER_ICONS[key][0]),
                           I.get(GALLERY_SLIDER_ICONS[key][1]), lambda _v: None)
            w.scale.set_value(55)
        return w

    def _build_gallery(self):
        """Remonta as seções; clique adiciona e arrasto posiciona na Central."""
        for child in self.g_content.get_children():
            child.destroy()
        present = dict(self.layout)
        self.g_sections = []
        width = GALLERY_W - GALLERY_SIDE - 2 * 18
        for cat, title, _g, _c in GALLERY_CATS[1:]:
            keys = [k for k in self.catalog if GALLERY_KEY_CAT.get(k) == cat]
            if not keys:
                continue
            sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            add_class(sec, "ccg-section")
            sec.pack_start(label(title, "ccg-head"), False, False, 0)
            cells, row, used = [], None, width
            for key in keys:
                ctl, sizes = self.catalog[key]
                name = self.names.get(key) or ctl.title
                for size in sorted(sizes, key=lambda s: GALLERY_SIZE_ORDER.index(s)):
                    cw = SPANS[size][0] * C + (SPANS[size][0] - 1) * GAP
                    cell_w = max(cw, 72)
                    if used + cell_w + 14 > width:
                        row = Gtk.Box(spacing=14)
                        sec.pack_start(row, False, False, 0)
                        used = -14
                    used += cell_w + 14
                    cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
                    cell.set_size_request(cell_w, -1)
                    cell.set_hexpand(False)    # o hexpand do slider não pode esticar a célula
                    prev = self._preview(key, size)
                    prev.set_halign(Gtk.Align.CENTER)
                    prev.set_valign(Gtk.Align.START)
                    ev = Gtk.EventBox()
                    ev.set_above_child(True)
                    ev.set_visible_window(False)
                    ev.add(prev)
                    ev.drag_source_set(Gdk.ModifierType.BUTTON1_MASK,
                                       [Gtk.TargetEntry.new("application/x-hyprmac-control", 0, 0)],
                                       Gdk.DragAction.COPY)
                    ev.connect("drag-data-get", lambda _w, _c, data, _i, _t, k=key, sz=size:
                               data.set(data.get_target(), 8, f"{k}:{sz}".encode()))
                    added = present.get(key) == size
                    if added:
                        # cc-edicao-galeria-sobre-azul: controles já presentes
                        # continuam legíveis e disponíveis para arrastar.
                        ev.set_tooltip_text("Drag to reposition in Control Center")
                    else:
                        ev.set_tooltip_text(f"Add {name} ({GALLERY_SIZE_NAMES[size]})")
                        ev.connect("button-release-event",
                                   lambda _w, e, k=key, sz=size: e.button == 1 and self._gallery_add(k, sz))
                    if key in menubar_items.CC_TO_BAR:
                        ev.connect("button-press-event",
                                   lambda _w, e, k=key: e.button == 3 and self._gallery_bar_menu(k, e))
                    cell.pack_start(ev, False, False, 0)
                    cap = label(name, "ccg-caption", 0.5)
                    cap.set_ellipsize(3)
                    cap.set_max_width_chars(12)
                    cell.pack_start(cap, False, False, 0)
                    row.pack_start(cell, False, False, 0)
                    cells.append((cell, name.lower() + " " + key))
            self.g_content.pack_start(sec, False, False, 0)
            self.g_sections.append((cat, sec, cells))
        self.g_empty = label("No Results", "ccg-empty", 0.5)
        self.g_content.pack_start(self.g_empty, False, False, 0)
        self.g_content.show_all()
        self._filter_gallery()

    def _gallery_bar_menu(self, key, event):
        """Clique direito num controle da galeria: "Add to Menu Bar"/"Remove from Menu Bar"
        (BentoGallery.loctable do Tahoe 26.6.1); liga o item da barra correspondente."""
        bar_key = menubar_items.CC_TO_BAR[key]
        shown = bar_key not in menubar_items.hidden()
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label="Remove from Menu Bar" if shown else "Add to Menu Bar")
        item.connect("activate", lambda _i: menubar_items.set_shown(bar_key, not shown))
        menu.append(item)
        menu.show_all()
        menu.attach_to_widget(self.gwin, None)
        menu.popup_at_pointer(event)
        return True

    def _pick_category(self, cat):
        self.g_cat = cat
        self._filter_gallery()
        if hasattr(self, "g_scroll"):
            self.g_scroll.get_vadjustment().set_value(0)

    def _drop_control(self, _w, context, x, y, data, _info, stamp):
        success = False
        try:
            key, size = bytes(data.get_data()).decode().split(":")
            if self.editing and key in self.catalog and size in self.catalog[key][1]:
                target_key = None
                hit = False
                for widget in self.wrappers + self.ghosts:
                    a = widget.get_allocation()
                    if (widget.get_visible() and a.x <= x < a.x + a.width
                            and a.y <= y < a.y + a.height):
                        target_key = getattr(widget, "key", None)
                        hit = True
                        break
                if hit:
                    layout = [(k, s) for k, s in self.layout if k != key]
                    target = next((i for i, (k, _s) in enumerate(layout)
                                   if k == target_key), len(layout))
                    if target_key == key:
                        target = next(i for i, (k, _s) in enumerate(self.layout) if k == key)
                    layout.insert(target, (key, size))
                    # Termina o DnD antes de reconstruir a galeria que contém a origem.
                    GLib.idle_add(lambda: self._change(layout) or False)
                    success = True
        except (ValueError, TypeError, UnicodeError):
            pass
        Gtk.drag_finish(context, success, False, stamp)

    def _filter_gallery(self):
        q = self.g_search.get_text().strip().lower()
        shown = 0
        for cat, sec, cells in self.g_sections:
            n = 0
            for cell, text in cells:
                ok = not q or q in text
                cell.set_visible(ok)
                n += ok
            vis = n > 0 and (q or self.g_cat in ("all", cat))
            sec.set_visible(bool(vis))
            shown += bool(vis)
        if getattr(self, "g_empty", None):
            self.g_empty.set_visible(shown == 0)

    def _gallery_add(self, key, size):
        if any(k == key for k, _s in self.layout):
            self._change([(k, size if k == key else s) for k, s in self.layout])
        else:
            self._add(key, size)
        return True

    def _place_gallery(self):
        """À esquerda da Central, alinhada pelo topo, com o mesmo vão da grade."""
        gmon = LS.get_monitor(self.win)
        if gmon:
            LS.set_monitor(self.gwin, gmon)
        # a largura da Central é a da grade (W4); a alocação do GTK ainda pode
        # estar com o tamanho antigo neste momento
        LS.set_margin(self.gwin, E.RIGHT, CC_RIGHT + W4 + GAP)

    def _clip_to(self, h):
        """Altura do recorte da grade (mínima = máxima, senão o resize(1, 1) da
        camada encolhe a grade até a altura mínima do ScrolledWindow)."""
        self.clip.set_max_content_height(-1)
        self.clip.set_min_content_height(h)
        self.clip.set_max_content_height(h)
        self.win.resize(1, 1)

    def _animate_height(self, h0):
        """Altura interruptível, no frame clock; 250 ms é estimativa local."""
        h1 = self.grid.get_preferred_height()[1]
        if self._resize_anim is not None:
            self.win.remove_tick_callback(self._resize_anim)
            self._resize_anim = None
        if reduce_motion() or not self.open or h0 <= 0 or h0 == h1:
            self._clip_to(h1)
            return
        t0 = None
        last_height = h0

        def step(_widget, clock):
            nonlocal t0, last_height
            now = clock.get_frame_time() / 1e6
            if t0 is None:
                t0 = now
            t = 1.0 if reduce_motion() else min(1.0, (now - t0) / 0.25)
            k = 1 - (1 - t) ** 3
            height = round(h0 + (h1 - h0) * k)
            if height != last_height:
                self._clip_to(height)
                last_height = height
            if t >= 1:
                self._resize_anim = None
                return False
            return True
        self._clip_to(h0)
        self._resize_anim = self.win.add_tick_callback(step)

    def _set_editing(self, on):
        if on:
            self.close_detail(animate=False)
        h0 = self.clip.get_allocated_height()
        self.editing = on
        set_class(self.win, "editing", on)
        self.edit_btn.set_visible(not on)
        for wrap in self.wrappers:
            for w in wrap.get_children()[1:]:
                w.set_visible(on)
        for g in self.ghosts:
            g.set_visible(on)
        self._sync_mic()
        self.win.resize(1, 1)
        self._animate_height(h0)
        if on and self.open:
            self.g_search.set_text("")
            self.g_cats.select_row(self.g_cats.get_row_at_index(0))
            self.g_scroll.get_vadjustment().set_value(0)
            self._place_gallery()
            self.gwin.show()
            self.g_search.grab_focus()
        else:
            self.gwin.hide()

    def _sync_mic(self):
        """O bloco do microfone só aparece com um microfone (sempre, ao editar)."""
        for wrap in getattr(self, "wrappers", []):
            if wrap.key == "mic":
                wrap.set_visible(self.mic_available or self.editing)
        if hasattr(self, "clip") and not self._resize_anim:
            self._clip_to(self.grid.get_preferred_height()[1])

    def _change(self, layout):
        h0 = self.clip.get_allocated_height()
        self.layout = layout
        self._save_layout()
        self._build_grid()
        self._animate_height(h0)

    def _remove(self, idx):
        self._change([it for i, it in enumerate(self.layout) if i != idx])

    def _add(self, key, size):
        self._change(self.layout + [(key, size)])

    def _reset_layout(self):
        self._change(list(DEFAULT_CONTROLS))

    def _edit_press(self, w, ev, idx):
        control = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        if ev.button == 3 or (ev.button == 1 and control):
            self._edit_menu(idx, ev)
            return True
        if ev.button != 1:
            return False
        self._drag = {"idx": idx, "x": ev.x_root, "y": ev.y_root, "moving": False, "target": None}
        return True

    def _edit_motion(self, w, ev):
        d = self._drag
        if not d:
            return False
        if not d["moving"] and math.hypot(ev.x_root - d["x"], ev.y_root - d["y"]) > 6:
            d["moving"] = True
            add_class(self.wrappers[d["idx"]], "dragging")
        if d["moving"]:
            point = w.translate_coordinates(self.grid, int(ev.x), int(ev.y))
            if point is None:
                return True
            gx, gy = point  # PyGObject retorna (x, y), sem o gboolean do C.
            target = None
            hit = lambda w: (w.get_visible() and w.get_allocation().x <= gx
                             < w.get_allocation().x + w.get_allocation().width
                             and w.get_allocation().y <= gy
                             < w.get_allocation().y + w.get_allocation().height)
            for i, wrap in enumerate(self.wrappers):
                if hit(wrap):
                    target = i
            # soltar num espaço vazio (fantasma) leva o controle para o fim
            ghost = None if target is not None else next((g for g in self.ghosts if hit(g)), None)
            if ghost is not None:
                target = "end"
            a = self.grid.get_allocation()
            if not (-CC_BLEED <= gx < a.width + CC_BLEED and -CC_BLEED <= gy < a.height + CC_BLEED):
                target = "out"                # fora da Central: soltar remove
            set_class(self.wrappers[d["idx"]], "removing", target == "out")
            for i, wrap in enumerate(self.wrappers):
                set_class(wrap, "drop-target", i == target and i != d["idx"])
            for g in self.ghosts:
                set_class(g, "drop-target", g is ghost)
            d["target"] = target
        return True

    def _edit_release(self, w, ev, idx):
        d, self._drag = self._drag, None
        if not d or ev.button != 1:
            return False
        if d["moving"]:
            t = d["target"]
            if t == "out":
                self._remove(d["idx"])
            elif t == "end":
                layout = list(self.layout)
                layout.append(layout.pop(d["idx"]))
                self._change(layout)
            elif t is not None and t != d["idx"]:
                layout = list(self.layout)
                layout.insert(t, layout.pop(d["idx"]))
                self._change(layout)
            else:
                for wrap in self.wrappers + self.ghosts:
                    set_class(wrap, "dragging", False)
                    set_class(wrap, "drop-target", False)
                    set_class(wrap, "removing", False)
            return True
        return True     # clique simples não muda nada (o tamanho é pelo Control-clique)

    CC_SIZE_NAMES = {"small": "Small", "medium": "Medium", "large": "Large", "wide": "Wide"}

    def _edit_menu(self, idx, event):
        """Control-clique num controle em edição: "choose a different size" e, quando o
        controle tem item na barra, Add/Remove from Menu Bar."""
        key, size = self.layout[idx]
        sizes = self.catalog[key][1]
        menu = Gtk.Menu()
        for s in sizes if len(sizes) > 1 else ():
            item = Gtk.CheckMenuItem(label=self.CC_SIZE_NAMES.get(s, s.title()))
            item.set_draw_as_radio(True)
            item.set_active(s == size)
            item.connect("activate", lambda _i, s=s: s != size and self._resize(idx, s))
            menu.append(item)
        bar_key = menubar_items.CC_TO_BAR.get(key)
        if bar_key:
            if menu.get_children():
                menu.append(Gtk.SeparatorMenuItem())
            shown = bar_key not in menubar_items.hidden()
            item = Gtk.MenuItem(label="Remove from Menu Bar" if shown else "Add to Menu Bar")
            item.connect("activate", lambda _i: menubar_items.set_shown(bar_key, not shown))
            menu.append(item)
        if not menu.get_children():
            return
        menu.show_all()
        menu.attach_to_widget(self.win, None)
        menu.popup_at_pointer(event)

    def _resize(self, idx, size):
        layout = list(self.layout)
        layout[idx] = (layout[idx][0], size)
        self._change(layout)

    # ── estado ──
    def _tick(self):
        in_thread(self._read_fast)
        self.np.refresh()
        return True

    def refresh(self):
        self._tick()
        in_thread(self._read_brightness)

    def _read_fast(self):
        dev = run("nmcli -t -f TYPE,STATE,CONNECTION device")
        wifi_radio = run("nmcli radio wifi")
        net = ("none", "")
        for line in dev.splitlines():
            typ, state, conn = (line.split(":") + ["", ""])[:3]
            if state == "connected" and typ in ("wifi", "ethernet"):
                net = (typ, conn)
                if typ == "wifi":
                    break
        vpns = []
        for line in run("nmcli -t -f NAME,TYPE,ACTIVE connection show").splitlines():
            parts = line.rsplit(":", 2)
            if len(parts) == 3 and parts[1] in ("vpn", "wireguard"):
                vpns.append((parts[0].replace("\\:", ":"), parts[2] == "yes"))
        vpn = next((v for v in vpns if v[1]), vpns[0] if vpns else None)
        bt = "Powered: yes" in run("bluetoothctl show")
        mic = self._read_mic()
        vol = run("wpctl get-volume @DEFAULT_AUDIO_SINK@")
        dark = "prefer-dark" in run("gsettings get org.gnome.desktop.interface color-scheme")
        GLib.idle_add(self._apply_fast, net, wifi_radio == "enabled", bt, mic, vol, vpn, dark)

    @staticmethod
    def _read_mic():
        """(mostrar, em uso, volume 0–100, mudo) da entrada padrão.
        Mostra só se a porta ativa informa um microfone plugado ("available")
        ou se algum app está usando a entrada agora. Portas que não detectam
        nada ("availability unknown", comum em placas USB) só aparecem em uso."""
        try:
            default = run("pactl get-default-source")
            sources = json.loads(run("pactl -f json list sources") or "[]")
            outs = json.loads(run("pactl -f json list source-outputs") or "[]")
            # capturas do monitor da saída (as barrinhas da barra) não contam
            in_use = any(o.get("properties", {}).get("stream.monitor") != "true"
                         and o.get("properties", {}).get("node.name") != "hyprmac-visualizer"
                         for o in outs)
        except ValueError:
            return (False, False, 0, False)
        src = next((x for x in sources if x.get("name") == default), None)
        if not src or default.endswith(".monitor"):
            return (False, in_use, 0, False)
        active = src.get("active_port")
        port = next((p for p in src.get("ports", []) if p.get("name") == active), None)
        available = bool(port) and port.get("availability") == "available"
        vol = run("wpctl get-volume @DEFAULT_AUDIO_SOURCE@")
        try:
            level = round(float(vol.split()[1]) * 100)
        except (IndexError, ValueError):
            level = 0
        return (available or in_use, in_use, level, "MUTED" in vol)

    def _apply_fast(self, net, wifi_on, bt, mic, vol, vpn=None, dark=None):
        self.vpn = vpn
        if vpn is None:
            self.vpn_tile.set(on=False, subtitle="Not Connected")
        elif not getattr(self, "_vpn_busy", False):
            name, active = vpn
            self.vpn_tile.set(on=active, subtitle=f"{name} · Conectada" if active else name)
        typ, conn = net
        if typ == "ethernet":
            self.net.set(on=True, icon=I["ethernet"], title="Network", subtitle="Ethernet")
        else:
            self.net.set(on=wifi_on, icon=I["wifi"] if wifi_on else I["wifi_off"], title="Wi‑Fi",
                         subtitle=conn if typ == "wifi" else ("On" if wifi_on else "Off"))
        self.bt.set(on=bt, icon=I["bt"] if bt else I["bt_off"],
                    subtitle="On" if bt else "Off")
        available, in_use, level, muted = mic
        self.mic_available = available
        self._sync_mic()
        if available:
            self.mic.set_value(0 if muted else level)
            if in_use:
                self.mic.set_badge("In Use")
            else:
                self.mic.set_badge("Muted" if muted else "", muted=True)
        dnd = bool(self.notifs and self.notifs.dnd)
        self.dnd.set(on=dnd, subtitle="On" if dnd else "Off")
        if dark is not None:
            self.dark.set(on=dark, subtitle="On" if dark else "Off")
        try:
            level = round(float(vol.split()[1]) * 100)
        except (IndexError, ValueError, OverflowError):
            self.sound.set_available(False)
        else:
            self.sound.set_available(True)
            self.sound.set_value(level)
            self.sound.set_badge("Muted" if "MUTED" in vol else "", muted=True)
        return False

    # ── ações ──
    def _net_click(self):
        if run("nmcli -t -f TYPE device | grep -x wifi"):
            spawn('[ "$(nmcli radio wifi)" = enabled ] && nmcli radio wifi off || nmcli radio wifi on')
            GLib.timeout_add(800, lambda: self._tick() and False)
        else:      # sem Wi‑Fi: o bloco Rede mostra a vista de rede na própria Central
            self.open_detail("wifi")

    def _vpn_click(self):
        if not self.vpn:
            self.hide()
            open_settings("network")
            return
        name, active = self.vpn
        q = GLib.shell_quote(name)
        if active:
            spawn(f"nmcli connection down id {q}")
            self.vpn_tile.set(subtitle="Desconectando…")
        else:
            # o agente de senhas do shell busca a senha no chaveiro (como o GNOME)
            spawn(f"{os.path.join(ROOT, 'scripts', 'vpn')} up {q}")
            self.vpn_tile.set(subtitle="Conectando…")
        self._vpn_busy = True

        def done():
            self._vpn_busy = False
            self._tick()
            return False
        GLib.timeout_add(3500, done)

    def _bt_click(self):
        spawn("bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on")
        GLib.timeout_add(800, lambda: self._tick() and False)

    def _dnd_click(self):
        if self.notifs:
            self.notifs.dnd = not self.notifs.dnd
            self.dnd.set(on=self.notifs.dnd,
                         subtitle="On" if self.notifs.dnd else "Off")

    def _dark_click(self):
        self.dark.set(on=not self.dark.on)
        spawn(os.path.join(ROOT, "scripts", "theme") + " toggle")

    def _set_mic(self, v):
        self._mic_cmd = getattr(self, "_mic_cmd", None) or LatestCommand(lambda x: [
            "sh", "-c", f"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0; "
                        f"wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {x / 100:.2f}"])
        self._mic_cmd.set(v)

    def _set_volume(self, v):
        # como no Mac, mexer no volume tira o mudo
        self._vol_cmd = getattr(self, "_vol_cmd", None) or LatestCommand(volume_argv)
        self._vol_cmd.set(v)

    # Brilho via DDC/CI (ddcutil) em todos os monitores externos.
    def _detect_ddc(self):
        out = run("ddcutil detect --brief 2>/dev/null", timeout=20)
        self.ddc_displays = [ln.split()[-1] for ln in out.splitlines() if ln.startswith("Display ")]
        self._read_brightness()     # o OSD de brilho parte do valor real

    def _read_brightness(self):
        if not self.ddc_displays:
            GLib.idle_add(self.display.set_available, False)
            return
        out = run(f"ddcutil getvcp 10 --brief --display {self.ddc_displays[0]}", timeout=8)
        try:
            v = int(out.split()[3])
        except (IndexError, ValueError):
            GLib.idle_add(self.display.set_available, False)
            return
        self.brightness = v

        def apply():
            self.display.set_available(True)
            self.display.set_value(v)
            return False

        GLib.idle_add(apply)

    def _set_brightness(self, v):
        """DDC/CI é lento (~0,1 s por escrita): um ddcutil por monitor, sempre com o valor
        mais novo, já durante o arrasto (antes esperava 350 ms parado)."""
        if not self.display.get_sensitive():
            return
        self.brightness = v
        cmds = getattr(self, "_bright_cmds", {})
        for d in self.ddc_displays or []:
            if d not in cmds:
                cmds[d] = LatestCommand(lambda x, d=d: ["ddcutil", "setvcp", "10", str(x),
                                                        "--noverify", "--display", str(d)])
            cmds[d].set(v)
        self._bright_cmds = cmds


