        self.vol_scale.set_hexpand(True)
        self.vol_scale.connect("change-value", self._on_volume)
        self.vol.pack_start(label(I["vol_lo"], "icon np-vol-icon", 0.5), False, False, 0)
        self.vol.pack_start(self.vol_scale, True, True, 0)
