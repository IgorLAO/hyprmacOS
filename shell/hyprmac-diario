def is_dark():
    try:
        settings = Gio.Settings.new("org.gnome.desktop.interface")
        return "dark" in settings.get_string("color-scheme")
    except Exception:
        return True

def load_css(is_dark_theme):
    css_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "diario.css")
    if os.path.exists(css_path):
        with open(css_path, "r") as f:
            css_data = f.read()
        provider = Gtk.CssProvider()
        provider.load_from_data(css_data.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

class Entry:
    def __init__(self, path, title, text, mtime):
        self.path = path
        self.title = title
        self.text = text
        self.mtime = mtime

def get_diario_dir(root=None):
    if root:
        d = root
    else:
        d = os.path.expanduser("~/.local/share/hyprmac/diario")
    os.makedirs(d, exist_ok=True)
    return d

def load_entries(root=None):
    d = get_diario_dir(root)
    entries = []
    for f in os.listdir(d):
        if f.endswith(".md"):
            p = os.path.join(d, f)
            mtime = os.path.getmtime(p)
            try:
                with open(p, "r", encoding="utf-8") as file:
                    lines = file.readlines()
                title = lines[0].strip() if lines else "Untitled"
                text = "".join(lines[1:]) if len(lines) > 1 else ""
                entries.append(Entry(p, title, text, mtime))
            except Exception:
                pass
    entries.sort(key=lambda e: e.mtime, reverse=True)
    return entries

def count_this_year(entries):
    current_year = datetime.datetime.now().year
    count = 0
    for e in entries:
        dt = datetime.datetime.fromtimestamp(e.mtime)
        if dt.year == current_year:
            count += 1
    return count

def save_entry(title, text, path=None, root=None):
    if not path:     # só cria/usa o diretório padrão quando a entrada é nova
        fd, path = tempfile.mkstemp(prefix="entry_", suffix=".md", dir=get_diario_dir(root))
        os.close(fd)
    with open(path, "w", encoding="utf-8") as file:
        file.write(title + "\n" + text)
    return path

def entry_streak(entries, today=None):
    day = today if today is not None else datetime.date.today()
    days = {datetime.datetime.fromtimestamp(e.mtime).date() for e in entries}
    count = 0
    while day in days:
        count += 1
        day -= datetime.timedelta(days=1)
    return count

def filter_entries(entries, query):
    query = query.casefold()
    return [e for e in entries if query in e.title.casefold() or query in e.text.casefold()]

def group_entries_by_month(entries):
    # Nomes ingleses independentes do locale do desktop.
    months = ("January", "February", "March", "April", "May", "June",
              "July", "August", "September", "October", "November", "December")
    groups = {}
    for entry in sorted(entries, key=lambda e: e.mtime, reverse=True):
        date = datetime.datetime.fromtimestamp(entry.mtime)
        label = f"{months[date.month - 1]} {date.year}"
        groups.setdefault(label, []).append(entry)
    return list(groups.items())

class InsightsCard(Gtk.DrawingArea):
    def __init__(self, count=0):
        super().__init__()
        self.set_size_request(216, 112)
        self.count = count
        self.streak = 0
        self.connect("draw", self.on_draw)

    def set_count(self, count, streak=0):
        self.count = count
        self.streak = streak
        self.set_size_request(216, 136 if streak >= 2 else 112)
        self.queue_draw()

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        
        pat = cairo.LinearGradient(0, 0, w, h)
        pat.add_color_stop_rgb(0, 0.431, 0.357, 0.831)
        pat.add_color_stop_rgb(1, 0.557, 0.435, 0.878)
        
        cr.set_source(pat)
        r = 14
        cr.new_sub_path()
        cr.arc(w - r, r, r, -1.5708, 0)
        cr.arc(w - r, h - r, r, 0, 1.5708)
        cr.arc(r, h - r, r, 1.5708, 3.1416)
        cr.arc(r, r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.fill()
        
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("SF Pro Text", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(13)
        cr.move_to(14, 24)
        cr.show_text("Insights")
        
        cr.set_font_size(34)
        cr.move_to(14, 68)
        cr.show_text(str(self.count))
        
        cr.select_font_face("SF Pro Text", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(12)
        cr.move_to(14, 88)
        cr.show_text("Entries")
        cr.move_to(14, 100)
        cr.show_text("This Year")
        if self.streak >= 2:
            cr.move_to(14, 122)
            cr.show_text(f"{self.streak}-day streak")

