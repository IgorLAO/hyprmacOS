            self.window.close()

    def on_minimize_clicked(self, btn):
        if self.window:
            self.window.iconify()

    def on_zoom_clicked(self, btn):
        if self.window:
            if self.window.is_maximized():
                self.window.unmaximize()
            else:
                self.window.maximize()

    def on_toggle_sidebar(self, btn):
        visible = self.sidebar.get_visible()
        self.sidebar.set_visible(not visible)

    def load_and_refresh(self):
        entries = load_entries(self.root_dir)
        count = len(entries)
        this_year_count = count_this_year(entries)
        
        self.count_lbl.set_text(str(count))
        self.insights_card.set_count(this_year_count, entry_streak(entries))
        
        # Limpar lista
        for child in self.entries_list.get_children():
            self.entries_list.remove(child)
            
        filtered = filter_entries(entries, self.search_entry.get_text())
        for month, month_entries in group_entries_by_month(filtered):
            header_row = Gtk.ListBoxRow()
            header_row.set_activatable(False)
            header_row.set_selectable(False)
            header = Gtk.Label(label=month)
            header.set_halign(Gtk.Align.START)
            header.get_style_context().add_class("month-header")
            header_row.add(header)
            self.entries_list.add(header_row)
            for entry in month_entries:
                row = EntryRow(entry)
                row.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
                row.connect("button-press-event", self.on_entry_button_press)
                self.entries_list.add(row)
            
        self.entries_list.show_all()
        
        if not entries:
            self.show_empty_state()
        else:
            self.show_entries_list()

    def show_empty_state(self):
        self.content_stack.set_visible_child_name("empty")
        self.header_right_stack.set_visible_child_name("view")

    def show_entries_list(self):
        self.content_stack.set_visible_child_name("list")
        self.header_right_stack.set_visible_child_name("view")

    def on_new_entry(self):
        self.current_entry = None
        self.textview.get_buffer().set_text("")
        self.content_stack.set_visible_child_name("edit")
        self.header_right_stack.set_visible_child_name("edit")
        self.textview.grab_focus()

    def on_entry_activated(self, listbox, row):
        if not isinstance(row, EntryRow):
            return
        self.current_entry = row.entry
        self.textview.get_buffer().set_text(row.entry.title + "\n" + row.entry.text)
        self.content_stack.set_visible_child_name("edit")
        self.header_right_stack.set_visible_child_name("edit")
        self.textview.grab_focus()

    def on_entry_button_press(self, row, event):
        if event.button != 3:
            return False
        menu = Gtk.Menu()
        delete_item = Gtk.MenuItem(label="Delete Entry")
        delete_item.connect("activate", lambda _: self.on_delete_entry(row.entry))
        menu.append(delete_item)
        menu.attach_to_widget(row, None)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def on_delete_entry(self, entry):
        dialog = Gtk.MessageDialog(
            transient_for=self.window, modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text="Delete this entry?")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Delete", Gtk.ResponseType.ACCEPT)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.ACCEPT:
            return
        try:
            if not Gio.File.new_for_path(entry.path).trash(None):
                raise OSError("Could not move the entry to Trash.")
        except (GLib.Error, OSError) as error:
            dialog = Gtk.MessageDialog(
                transient_for=self.window, modal=True,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.CLOSE, text="Could not delete entry.")
            dialog.format_secondary_text(str(error))
            dialog.run()
            dialog.destroy()
            return
        if self.current_entry and self.current_entry.path == entry.path:
            self.current_entry = None
        self.load_and_refresh()

    def on_done_clicked(self):
        buffer = self.textview.get_buffer()
        start, end = buffer.get_bounds()
        full_text = buffer.get_text(start, end, False)
        
        if full_text.strip() or self.current_entry is not None:
            lines = full_text.split("\n")
            title = lines[0].strip() if lines else "Untitled"
            text = "\n".join(lines[1:]) if len(lines) > 1 else ""
            
            path = self.current_entry.path if self.current_entry else None
            save_entry(title, text, path, self.root_dir)
        self.current_entry = None
        self.load_and_refresh()

    def on_buffer_changed(self, buffer):
        start = buffer.get_start_iter()
        end = start.copy()
        end.forward_to_line_end()
        
        buffer.remove_tag_by_name("titulo", buffer.get_start_iter(), buffer.get_end_iter())
        buffer.apply_tag_by_name("titulo", start, end)

    def on_search_changed(self, entry):
        self.load_and_refresh()

    def on_key_press(self, widget, event):
        state = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SUPER_MASK)
        keyval = event.keyval
        
        if state and (keyval == Gdk.KEY_n or keyval == Gdk.KEY_N):
            self.on_new_entry()
            return True
            
        if keyval == Gdk.KEY_Escape:
            if self.content_stack.get_visible_child_name() == "edit":
                self.load_and_refresh()
                return True
                
        return False

class JournalApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.hyprmac.Journal", flags=Gio.ApplicationFlags.FLAGS_NONE)
        
    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self)
        win.set_title("Journal")
        win.set_decorated(False)
        win.set_default_size(900, 650)
        
        load_css(is_dark())
        
        view = JournalView(window=win)
        win.add(view)
        win.show_all()

def run_snapshot(output_path, with_entries=False):
    temp_dir = tempfile.mkdtemp()
    if with_entries:
        save_entry("Trip to Tokyo", "It was an amazing day exploring Shibuya and eating delicious ramen.", root=temp_dir)
        save_entry("Reflections on Tahoe", "The new macOS Tahoe design feels incredibly fluid and clean.", root=temp_dir)
    
    load_css(is_dark())
    off = Gtk.OffscreenWindow()
    off.set_default_size(900, 650)
    off.set_size_request(900, 650)
    
    view = JournalView(root_dir=temp_dir, window=off)
    off.add(view)
    off.show_all()
    
    if not with_entries:
        view.show_empty_state()
    else:
        view.show_entries_list()
        
    end = time.time() + 2.0
    while time.time() < end:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        time.sleep(0.02)
    off.get_pixbuf().savev(output_path, "png", [], [])
    print(output_path)

def main():
    GLib.set_prgname("dev.hyprmac.Journal")
    if len(sys.argv) > 2 and sys.argv[1] == "--snapshot":
        return run_snapshot(sys.argv[2], with_entries=False)
    elif len(sys.argv) > 2 and sys.argv[1] == "--snapshot-entries":
        return run_snapshot(sys.argv[2], with_entries=True)
    return JournalApp().run(sys.argv[:1])

if __name__ == "__main__":
    sys.exit(main())
