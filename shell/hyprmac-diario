class ButterflyGlyph(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_size_request(48, 48)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        cr.translate((w - 48) / 2, (h - 48) / 2)
        
        pat = cairo.LinearGradient(0, 0, 48, 48)
        pat.add_color_stop_rgb(0, 0.482, 0.424, 0.965)
        pat.add_color_stop_rgb(1, 0.949, 0.380, 0.478)
        cr.set_source(pat)
        
        cr.save()
        cr.translate(24, 24)
        cr.move_to(0, -4)
        cr.curve_to(-10, -20, -22, -15, -20, -2)
        cr.curve_to(-18, 8, -8, 10, 0, 2)
        cr.curve_to(-8, 12, -15, 18, -10, 22)
        cr.curve_to(-5, 24, -2, 15, 0, 6)
        cr.fill()
        cr.restore()
        
        cr.save()
        cr.translate(24, 24)
        cr.scale(-1, 1)
        cr.move_to(0, -4)
        cr.curve_to(-10, -20, -22, -15, -20, -2)
        cr.curve_to(-18, 8, -8, 10, 0, 2)
        cr.curve_to(-8, 12, -15, 18, -10, 22)
        cr.curve_to(-5, 24, -2, 15, 0, 6)
        cr.fill()
        cr.restore()
        
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(2)
        cr.move_to(24, 10)
        cr.line_to(24, 38)
        cr.stroke()

