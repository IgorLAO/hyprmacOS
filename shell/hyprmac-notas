def is_dark():
    try:
        settings = Gio.Settings.new("org.gnome.desktop.interface")
        return "dark" in settings.get_string("color-scheme")
    except Exception:
        return True

def load_css(is_dark_theme):
    css_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "notas.css")
    if os.path.exists(css_path):
        with open(css_path, "r") as f:
            css_data = f.read()
        provider = Gtk.CssProvider()
        provider.load_from_data(css_data.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

MARGEM = 24          # recuo do editor (título em x = margem)
CHECK_D = 17         # círculo da lista: 17 de diâmetro, centro em margem + 10, texto em margem + 24


class NotesTextView(Gtk.TextView):
    """Editor: desenha os círculos das listas de verificação acima do texto, como no Notes."""

    def do_draw_layer(self, layer, cr):
        if layer != Gtk.TextViewLayer.ABOVE_TEXT:
            return
        buf = self.get_buffer()
        it = buf.get_start_iter()
        while True:
            fim = it.copy()
            fim.forward_to_line_end()
            texto = buf.get_text(it, fim, True)
            if notes_store.is_check(texto):
                r = self.get_iter_location(it)
                cx, cy = MARGEM + 10, r.y + r.height / 2
                rad = CHECK_D / 2
                if notes_store.is_checked(texto):
                    cr.set_source_rgb(0.898, 0.690, 0.0)          # #E5B000
                    cr.new_sub_path()
                    cr.arc(cx, cy, rad, 0, 6.2832)
                    cr.fill()
                    cr.set_source_rgb(1, 1, 1)
                    cr.set_line_width(1.6)
                    cr.move_to(cx - 4, cy + 0.2)
                    cr.line_to(cx - 1.2, cy + 3)
                    cr.line_to(cx + 4, cy - 3)
                    cr.stroke()
                else:
                    cr.set_source_rgba(0.6, 0.6, 0.62, 1)
                    cr.set_line_width(1.2)
                    cr.new_sub_path()
                    cr.arc(cx, cy, rad - 0.6, 0, 6.2832)
                    cr.stroke()
            if not it.forward_line():
                break


class NoteRow(Gtk.ListBoxRow):
    def __init__(self, note):
        super().__init__()
        self.note = note
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_size_request(184, 56)
        box.get_style_context().add_class("note-card")
        
        title_lbl = Gtk.Label(label=note.title)
        title_lbl.set_halign(Gtk.Align.START)
        title_lbl.get_style_context().add_class("note-card-title")
        title_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        
        sub_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        
        time_lbl = Gtk.Label(label=notes_store.list_time(note.mtime))
        time_lbl.get_style_context().add_class("note-card-time")
        
        preview_lbl = Gtk.Label(label=note.preview)
        preview_lbl.set_halign(Gtk.Align.START)
        preview_lbl.get_style_context().add_class("note-card-preview")
        preview_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        preview_lbl.set_hexpand(True)
        
        sub_box.pack_start(time_lbl, False, False, 0)
        sub_box.pack_start(preview_lbl, True, True, 0)
        
        box.pack_start(title_lbl, False, False, 0)
        box.pack_start(sub_box, False, False, 0)
        
        self.add(box)
        self.show_all()


class FolderRow(Gtk.ListBoxRow):
    def __init__(self, path, name, count, deleted=False):
        super().__init__()
        self.path = path
        self.deleted = deleted
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.get_style_context().add_class("folder-card")
        icon = Gtk.Image.new_from_icon_name(
            "user-trash-symbolic" if deleted else "folder-symbolic", Gtk.IconSize.MENU)
        icon.get_style_context().add_class("folder-icon")
        box.pack_start(icon, False, False, 0)
        self.label = Gtk.Label(label=name, xalign=0)
        self.label.set_ellipsize(Pango.EllipsizeMode.END)
        self.label.set_width_chars(1)
        box.pack_start(self.label, True, True, 0)
        self.entry = Gtk.Entry()
        self.entry.set_width_chars(1)
        self.entry.get_style_context().add_class("folder-name-entry")
        self.entry.set_no_show_all(True)
        box.pack_start(self.entry, True, True, 0)
        count_label = Gtk.Label(label=str(count))
        count_label.get_style_context().add_class("folder-count")
        box.pack_end(count_label, False, False, 0)
        self.add(box)
        self.show_all()


