class SidebarRow(Gtk.ListBoxRow):
    def __init__(self, label_text, icon_name, enabled=True, album_thumb=None):
        super().__init__()
        self.label_text = label_text
        self.enabled = enabled
        self.get_style_context().add_class("sidebar-row")
        if not enabled:
            self.set_sensitive(False)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_size_request(-1, 30)
        if album_thumb:
            img = Gtk.Image()
            img.set_from_pixbuf(album_thumb)
            box.pack_start(img, False, False, 0)
        elif icon_name:
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            img.set_pixel_size(16)
            box.pack_start(img, False, False, 0)
        lbl = Gtk.Label(label=label_text)
        lbl.get_style_context().add_class("sidebar-label")
        lbl.set_halign(Gtk.Align.START)
        box.pack_start(lbl, True, True, 0)
        self.add(box)
        self.show_all()

class PhotoCell(Gtk.DrawingArea):
    def __init__(self, filepath, is_video=False):
        super().__init__()
        self.filepath = filepath
        self.is_video = is_video
        self.pixbuf = None
        self.duration = None
        self.selected = False
        self.favorite = False
        self.viewer_mode = False
        self.video_pending = False
        self.connect("draw", self.on_draw)
        self.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)

    def set_selected(self, selected):
        self.selected = selected
        self.queue_draw()

    def set_pixbuf(self, pixbuf):
        self.pixbuf = pixbuf
        self.queue_draw()

    def on_draw(self, widget, cr):
        self._draw_base(widget, cr)
        if self.is_video and self.duration:
            # duração no canto inferior direito da imagem, branca com sombra (como no Photos)
            w, h = widget.get_allocated_width(), widget.get_allocated_height()
            if self.pixbuf:
                esc = min(w / self.pixbuf.get_width(), h / self.pixbuf.get_height())
                iw, ih = self.pixbuf.get_width() * esc, self.pixbuf.get_height() * esc
            else:
                iw, ih = w, h
            x1, y1 = (w + iw) / 2, (h + ih) / 2
            cr.select_font_face("SF Pro Text", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(11)
            ext = cr.text_extents(self.duration)
            x, y = x1 - ext.x_advance - 7, y1 - 7
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.move_to(x + 0.5, y + 1)
            cr.show_text(self.duration)
            cr.set_source_rgb(1, 1, 1)
            cr.move_to(x, y)
            cr.show_text(self.duration)
        if self.favorite:
            w, h = widget.get_allocated_width(), widget.get_allocated_height()
            scale = min(w / self.pixbuf.get_width(), h / self.pixbuf.get_height()) if self.pixbuf else 1
            iw = self.pixbuf.get_width() * scale if self.pixbuf else w
            ih = self.pixbuf.get_height() * scale if self.pixbuf else h
            x, y = (w - iw) / 2 + 7, (h + ih) / 2 - 7
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(16)
            cr.set_source_rgba(0, 0, 0, 0.65)
            cr.move_to(x + 1, y + 1)
            cr.show_text("♥")
            cr.set_source_rgb(1, 1, 1)
            cr.move_to(x, y)
            cr.show_text("♥")
        return False

    def _draw_base(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        if self.pixbuf:
            pw = self.pixbuf.get_width()
            ph = self.pixbuf.get_height()
            scale = min(w / pw, h / ph)
            nw = pw * scale
            nh = ph * scale
            nx = (w - nw) / 2
            ny = (h - nh) / 2
            cr.save()
            cr.translate(nx, ny)
            cr.scale(scale, scale)          # ajusta à célula (antes pintava 256 px e cortava)
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
            cr.paint()
            cr.restore()
            if self.selected:
                cr.set_source_rgb(0.039, 0.518, 1.0)
                cr.set_line_width(3)
                r = 6
                cr.new_sub_path()
                cr.arc(nx + nw - r, ny + r, r, -1.5708, 0)
                cr.arc(nx + nw - r, ny + nh - r, r, 0, 1.5708)
                cr.arc(nx + r, ny + nh - r, r, 1.5708, 3.1416)
                cr.arc(nx + r, ny + r, r, 3.1416, 4.7124)
                cr.close_path()
                cr.stroke()
        else:
            if self.viewer_mode:
                return
            if self.is_video:
                cr.set_source_rgb(0, 0, 0)
                cr.rectangle(0, 0, w, h)
                cr.fill()
                cr.set_source_rgb(0, 0, 0)
                cr.select_font_face("SF Pro Text", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(11)
            else:
                cr.set_source_rgb(0.15, 0.15, 0.15)
                cr.rectangle(0, 0, w, h)
                cr.fill()
            if self.selected:
                cr.set_source_rgb(0.039, 0.518, 1.0)
                cr.set_line_width(3)
                cr.rectangle(1.5, 1.5, w - 3, h - 3)
                cr.stroke()

