    def on_sidebar_row_selected(self, listbox, row):
        if not hasattr(self, "header_title") or row is None:
            return      # a lateral seleciona antes de a área principal existir
        if hasattr(row, "album_path") and row.album_path is not None:
            self.current_filter = "Album"
            self.current_album_path = row.album_path
            self.header_title.set_label(os.path.basename(row.album_path))
        elif row.label_text == "Library":
            self.current_filter = "Library"
            self.current_album_path = None
            self.header_title.set_label("Library")
        else:
            self.current_filter = row.label_text
            self.current_album_path = None
            self.header_title.set_label(row.label_text)
        if self.viewer_state.current:
            self.close_viewer()
        self.load_items()

    def load_items(self):
        self.flowbox.foreach(lambda w: self.flowbox.remove(w))
        for source in self.lazy_loads:
            if GLib.MainContext.default().find_source_by_id(source):
                GLib.source_remove(source)
        self.lazy_loads.clear()
        self.selected_cell = None
        search = self.search_entry.get_text().lower().strip()
        base = []
        if self.current_filter == "Library":
            base = self.all_files
        elif self.current_filter == "Album" and self.current_album_path:
            base = get_media_files(self.current_album_path)
        elif self.current_filter == "Favorites":
            base = [f for f in self.all_files if f in self.favoritos]
        else:
            base = []
        if search:
            base = [f for f in base if os.path.basename(f).lower().find(search) != -1]
        self.grid_files = list(base)
        visible_limit = 400
        for i, filepath in enumerate(base):
            cell = PhotoCell(filepath, is_video=filepath.lower().endswith(('.mp4', '.mov', '.webm', '.mkv')))
            cell.favorite = filepath in self.favoritos
            cell.connect("button-press-event", self.on_cell_button_press)
            lado = self.cell_size()
            cell.set_size_request(lado, lado)
            self.flowbox.add(cell)
            cell.get_parent().connect("focus-in-event", lambda child, _e: self.select_cell(child.get_child()))
            if filepath == self.selected_filepath:
                self.select_cell(cell)
            if i < visible_limit:
                lid = GLib.idle_add(self._load_thumbnail_for_cell, cell, filepath)
                self.lazy_loads.append(lid)
        self.flowbox.show_all()

    def _load_thumbnail_for_cell(self, cell, filepath):
        if cell.is_video:
            if cell.video_pending:
                return GLib.SOURCE_REMOVE
            cell.video_pending = True
            def entregar(png, dur, cell=cell):
                cell.video_pending = False
                cell.duration = dur
                pb = None
                if png:
                    try:
                        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(png, 256, 256, True)
                    except GLib.Error:
                        pb = None
                if cell.get_parent():
                    cell.set_pixbuf(pb)
                    if self.viewer_state.current == filepath:
                        self.viewer_image.set_pixbuf(pb)
                return False
            _video_fila.put((filepath, entregar))
            return GLib.SOURCE_REMOVE
        if filepath in self.pixbuf_cache:
            pixbuf = self.pixbuf_cache[filepath]
        else:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(filepath, 256, 256, True)
                self.pixbuf_cache[filepath] = pixbuf
            except Exception:
                pixbuf = None
        if cell.get_parent():
            cell.set_pixbuf(pixbuf)
        return GLib.SOURCE_REMOVE

    def on_item_button_press(self, widget, event):
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 1:
            child = self.flowbox.get_child_at_pos(int(event.x), int(event.y))
            if child:
                self.select_cell(child.get_child())
        return False

    def select_cell(self, cell):
        if self.selected_cell:
            self.selected_cell.set_selected(False)
        self.selected_cell = cell
        cell.set_selected(True)
        self.selected_filepath = cell.filepath

    def on_item_activated(self, flowbox, child):
        cell = child.get_child()
        if isinstance(cell, PhotoCell):
            self.select_cell(cell)
            self.open_viewer(cell.filepath)

    def on_key_pressed(self, controller, keyval, keycode, state):
        # A busca recebe texto sem disparar os atalhos da biblioteca.
        if self.window and isinstance(self.window.get_focus(), Gtk.Entry):
            return False
        if self.viewer_state.current:
            if keyval == Gdk.KEY_Escape:
                self.close_viewer()
                return True
            if keyval in (Gdk.KEY_Left, Gdk.KEY_Right):
                self.viewer_state.move(-1 if keyval == Gdk.KEY_Left else 1)
                self.update_viewer()
                return True
        elif keyval in (Gdk.KEY_space, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.selected_filepath:
                self.open_viewer(self.selected_filepath)
                return True
        if keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.toggle_favorite()
            return True
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_KP_Delete):
            self.delete_selected()
            return True
        return False

    def toggle_favorite(self):
        if not self.selected_filepath:
            return
        toggle_favorite_path(self.favoritos, self.selected_filepath)
        save_favoritos(self.favoritos)
        self.favorite_button.set_label("♥" if self.selected_filepath in self.favoritos else "♡")
        if self.current_filter == "Favorites":
            self.load_items()
        else:
            for child in self.flowbox.get_children():
                cell = child.get_child()
                cell.favorite = cell.filepath in self.favoritos
                cell.queue_draw()

    def delete_selected(self):
        if not self.selected_filepath:
            return
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Move to Trash?",
            secondary_text="Are you sure you want to move \"{}\" to the trash?".format(os.path.basename(self.selected_filepath))
        )
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.YES:
            try:
                file = Gio.File.new_for_path(self.selected_filepath)
                file.trash(None)
                if self.selected_filepath in self.favoritos:
                    self.favoritos.remove(self.selected_filepath)
                    save_favoritos(self.favoritos)
                self.all_files = get_media_files(self.pictures_dir)
                if self.viewer_state.current:
                    self.close_viewer()
                self.selected_filepath = None
                self.load_items()
            except Exception as e:
                print("Error trashing:", e)

    def cell_size(self):
        n = int(self.zoom_scale.get_value()) if hasattr(self, "zoom_scale") else 5
        w = self.scrolled_grid.get_allocated_width() if hasattr(self, "scrolled_grid") else 0
        if w < 200:
            w = 860          # antes da primeira alocação (largura típica da área)
        return max(80, int((w - 32 - 8 * (n - 1)) / n) - 2)

    def on_zoom_changed(self, scale):
        n = int(scale.get_value())
        self.flowbox.set_min_children_per_line(n)
        self.flowbox.set_max_children_per_line(n)
        self.load_items()

    def on_search_changed(self, entry):
        self.load_items()


def load_css():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS_DATA.encode())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_USER + 100)   # acima do tema GTK do usuário (gtk.css)


class PhotosApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.hyprmac.Photos",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)

    def do_activate(self):
        if not self.window:
            self.window = Gtk.ApplicationWindow(application=self)
            self.window.set_decorated(False)
            self.window.set_default_size(1100, 700)

            load_css()

            view = PhotosAppView(window=self.window)
            self.window.add(view)
            self.window.show_all()
        self.window.present()

    def do_shutdown(self):
        Gtk.Application.do_shutdown(self)


def run_snapshot(path, viewer=False):
    load_css()
    win = Gtk.OffscreenWindow()
    win.set_size_request(1100, 700)
    view = PhotosAppView(window=win)
    win.add(view)
    win.show_all()
    if viewer:
        first_photo = next((f for f in view.grid_files
                            if not f.lower().endswith(('.mp4', '.mov', '.webm', '.mkv'))), None)
        if first_photo:
            view.open_viewer(first_photo)

    def capture():
        pb = win.get_pixbuf()
        if pb:
            pb.savev(path, "png", [], [])
        Gtk.main_quit()

    GLib.timeout_add_seconds(2, capture)
    Gtk.main()


def main():
    if len(sys.argv) > 2 and sys.argv[1] in ("--snapshot", "--snapshot-viewer"):
        snapshot_path = sys.argv[2]
        run_snapshot(snapshot_path, viewer=sys.argv[1] == "--snapshot-viewer")
        return 0
    GLib.set_prgname("dev.hyprmac.Photos")
    app = PhotosApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
