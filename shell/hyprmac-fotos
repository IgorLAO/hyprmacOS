# Vídeos: um quadro e a duração por ffmpeg/ffprobe, numa única thread de fundo com prioridade
# mínima e tempo limite, com cache em disco — a biblioteca não pode pesar na máquina.
VIDEO_CACHE = os.path.expanduser("~/.cache/hyprmac/fotos")
_video_fila = queue.Queue()


def _duracao_texto(segundos):
    s = int(round(segundos))
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def video_info(path):
    """(png do quadro ou None, duração 'm:ss' ou None), com cache por caminho+mtime."""
    try:
        chave = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()
    except OSError:
        return None, None
    os.makedirs(VIDEO_CACHE, exist_ok=True)
    png, meta = os.path.join(VIDEO_CACHE, chave + ".png"), os.path.join(VIDEO_CACHE, chave + ".json")
    if os.path.exists(meta):
        try:
            with open(meta) as fh:
                dur = json.load(fh).get("duracao")
            return (png if os.path.exists(png) else None), dur
        except (OSError, ValueError):
            pass
    dur = None
    try:
        out = subprocess.run(["nice", "-n", "19", "ffprobe", "-v", "error", "-show_entries",
                              "format=duration", "-of", "csv=p=0", path],
                             capture_output=True, text=True, timeout=10).stdout.strip()
        dur = _duracao_texto(float(out)) if out else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    try:
        subprocess.run(["nice", "-n", "19", "ffmpeg", "-v", "error", "-ss", "1", "-i", path,
                        "-frames:v", "1", "-vf", "scale=256:-1", "-y", png],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass
    with open(meta, "w") as fh:
        json.dump({"duracao": dur}, fh)
    return (png if os.path.exists(png) else None), dur


def _video_trabalhador():
    while True:
        path, entregar = _video_fila.get()
        png, dur = video_info(path)
        GLib.idle_add(entregar, png, dur)


threading.Thread(target=_video_trabalhador, daemon=True, name="fotos-video").start()

