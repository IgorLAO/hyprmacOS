    return os.path.expanduser("~/Pictures")

def get_media_files(directory):
    extensions = ('.jpg', '.jpeg', '.png', '.heic', '.webp', '.gif', '.mp4', '.mov', '.webm', '.mkv')
    files = []
    if not os.path.exists(directory):
        return files
    for root, dirs, filenames in os.walk(directory):
        dirs[:] = [d for d in dirs if not d.startswith('.')]
        for f in filenames:
            if f.lower().endswith(extensions) and not f.startswith('.'):
                path = os.path.join(root, f)
                try:
                    mtime = os.path.getmtime(path)
                    files.append((path, mtime))
                except Exception:
                    pass
    files.sort(key=lambda x: x[1], reverse=True)
    return [f[0] for f in files]

FAVORITOS_PATH = os.path.expanduser("~/.config/hyprmac/fotos.json")

def load_favoritos():
    if os.path.exists(FAVORITOS_PATH):
        try:
            with open(FAVORITOS_PATH, 'r') as f:
                data = json.load(f)
                return set(data.get("favoritos", []))
        except Exception:
            pass
    return set()

def save_favoritos(favoritos):
    os.makedirs(os.path.dirname(FAVORITOS_PATH), exist_ok=True)
    try:
        with open(FAVORITOS_PATH, 'w') as f:
            json.dump({"favoritos": list(favoritos)}, f)
    except Exception:
        pass

def photo_date(path):
    # Data local do arquivo; meses independentes do locale do desktop.
    try:
        date = datetime.fromtimestamp(os.path.getmtime(path))
    except (OSError, ValueError, OverflowError):
        return "Unknown Date"
    months = ("January", "February", "March", "April", "May", "June",
              "July", "August", "September", "October", "November", "December")
    return f"{months[date.month - 1]} {date.day}, {date.year}"


