        self.play_button.set_halign(Gtk.Align.CENTER)
        self.play_button.set_valign(Gtk.Align.CENTER)
        self.play_button.set_no_show_all(True)
        self.play_button.connect("clicked", self.play_video)
        overlay.add_overlay(self.play_button)
        page.pack_start(overlay, True, True, 0)
        self.viewer_info = Gtk.Label()
        self.viewer_info.get_style_context().add_class("viewer-info")
        self.viewer_info.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        self.viewer_info.set_no_show_all(True)
        page.pack_start(self.viewer_info, False, False, 0)
        self.page_stack.add_named(page, "viewer")

    def switch_page(self, name):
        self.page_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.page_stack.set_transition_duration(160 if animations_enabled() else 0)
        self.page_stack.set_visible_child_name(name)

    def open_viewer(self, path):
        if self.viewer_state.open(self.grid_files, path):
            self.update_viewer()
            self.switch_page("viewer")
            self.page_stack.child_focus(Gtk.DirectionType.TAB_FORWARD)

    def update_viewer(self):
        path = self.viewer_state.current
        self.selected_filepath = path
        self.viewer_date.set_text(photo_date(path))
        self.favorite_button.set_label("♥" if path in self.favoritos else "♡")
        self.viewer_info.set_text(f"{os.path.basename(path)}\n{photo_date(path)}")
        cell = next((c.get_child() for c in self.flowbox.get_children()
                     if c.get_child().filepath == path), None)
        video = path.lower().endswith(('.mp4', '.mov', '.webm', '.mkv'))
        pb = cell.pixbuf if video and cell else None
        if video and cell and pb is None:
            self._load_thumbnail_for_cell(cell, path)
        if not video:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(path)
            except GLib.Error:
                pb = None
        self.viewer_image.set_pixbuf(pb)
        self.play_button.set_visible(video)

    def close_viewer(self):
        path = self.viewer_state.close()
        self.switch_page("grid")
        self.viewer_info.hide()
        for child in self.flowbox.get_children():
            if child.get_child().filepath == path:
                self.select_cell(child.get_child())
                child.grab_focus()
                break

    def play_video(self, _button):
        path = self.viewer_state.current
        if path:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)

    def on_cell_button_press(self, cell, event):
        if event.button == 1:
            self.select_cell(cell)
            cell.get_parent().grab_focus()
            if event.type == Gdk.EventType.DOUBLE_BUTTON_PRESS:
                self.open_viewer(cell.filepath)
            return True
        return False

