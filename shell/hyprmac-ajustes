    def _on_key(self, _w, ev):
        ctrl = ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SUPER_MASK
                           | Gdk.ModifierType.MOD4_MASK)
        if ev.keyval == Gdk.KEY_Escape and self.search.get_text():
            self.search.set_text("")
            return True
        if ctrl and ev.keyval in (Gdk.KEY_w, Gdk.KEY_q):
            self.close()
            return True
        if ctrl and ev.keyval == Gdk.KEY_f:
            self.search.grab_focus()
            return True
        if ctrl and ev.keyval == Gdk.KEY_bracketleft:
            self._step(-1)
            return True
        if ctrl and ev.keyval == Gdk.KEY_bracketright:
            self._step(1)
            return True
        return False

