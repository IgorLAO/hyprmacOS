CLOCK_STYLES = [("sf", "SF Pro"), ("rounded", "SF Pro Rounded"), ("stencil", None),
                ("serif", "New York"), ("heavy", None), ("rails", None)]
CLOCK_WEIGHT_DEFAULT = 647        # medido no relógio da tela oficial; o slider vai de 100 a 900
