def draw_picture(cr, w, h, path, cache, radius):
    pb = cache.get("pb")
    if pb is None and path and os.path.exists(path):
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w * 2, h * 2, False)
        except Exception:
            pb = None
        cache["pb"] = pb
    squircle(cr, 0, 0, w, h, radius)
    cr.clip()
    if pb:
        cr.scale(w / pb.get_width(), h / pb.get_height())
        Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
        cr.paint()
    else:
        cr.set_source_rgb(0.3, 0.3, 0.32)
        cr.paint()
    return False


