_provider = None


def load_css():
    global _provider
    dark = is_dark()
    acc = ACCENTS.get(accent_name(), ACCENTS["blue"])[0 if dark else 1]
    with open(os.path.join(HERE, "ajustes.css")) as f:
        css = f.read()
    # seleção da barra lateral: o destaque escurecido (medido no Tahoe com o azul: 0,84,196)
    if accent_name() in ("blue", None, ""):
        sel = "#0054C4"
    else:
        r, g, b = (int(acc[i:i + 2], 16) for i in (1, 3, 5))
        sel = "#%02X%02X%02X" % (int(r * 0.74), int(g * 0.70), int(b * 0.77))
    css = css.replace("@ACCENT_SEL@", sel).replace("@ACCENT@", acc)
    prov = Gtk.CssProvider()
    prov.load_from_data(css.encode())
    screen = Gdk.Screen.get_default()
    if _provider:
        Gtk.StyleContext.remove_provider_for_screen(screen, _provider)
    Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_USER + 10)
    _provider = prov


def snapshot(pane, out):
    """Testes: desenha um painel numa janela fora da tela e salva o PNG."""
    load_css()
    win = Settings(pane, offscreen=True)
    end = time.time() + 2.5
    while time.time() < end:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        time.sleep(0.02)
    pb = win.off.get_pixbuf()
    pb.savev(out, "png", [], [])
    print(out, pb.get_width(), pb.get_height())


def main():
    if len(sys.argv) > 3 and sys.argv[1] == "--snapshot":
        return snapshot(sys.argv[2], sys.argv[3])
    first = sys.argv[1] if len(sys.argv) > 1 else "appearance"
    # uma instância só: se já houver uma, ela vai para o painel pedido
    app = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
    GLib.set_prgname(APP_ID)
    state = {"win": None}

    def cmdline(a, cl):
        args = cl.get_arguments()[1:]
        pane = args[0] if args else None
        # "about" = General ▸ About (menu Apple ▸ About This Mac)
        sobre = pane == "about"
        if sobre:
            pane = "general"
        if state["win"] is None:
            load_css()
            state["win"] = Settings(pane or first)
            a.add_window(state["win"])
        elif pane:
            state["win"].open_pane(pane)
        if sobre:
            state["win"].push("About", state["win"].sub_about)
        state["win"].present()
        return 0
    app.connect("command-line", cmdline)
    app.run(sys.argv)


if __name__ == "__main__":
    main()
