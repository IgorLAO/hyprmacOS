    def sub_storage(self):
        st = os.statvfs(os.path.expanduser("~"))
        total = st.f_blocks * st.f_frsize / 1e9
        free = st.f_bavail * st.f_frsize / 1e9
        used = total - free
        home = run("du -sb ~/Documents ~/Downloads ~/Pictures ~/Music ~/Videos 2>/dev/null | awk '{s+=$1} END {print s}'", 6)
        docs = (int(home) / 1e9) if home.isdigit() else used * 0.3
        parts = [("Documents", min(docs, used), "#FF9F0A"), ("System Data", max(used - docs, 0), "#8E8E93")]
