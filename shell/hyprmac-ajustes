        right.pack_start(f.outer, False, False, 0)
        btns = Gtk.Box(spacing=0)
        btns.set_halign(Gtk.Align.END)
        ss = push_button("Screen Saver…", lambda: self._screen_saver_sheet(cur))
        ca = push_button("Clock Appearance…", lambda: None)
        ca.connect("clicked", lambda b: self._clock_popover(b))
        test = os.environ.get("HYPRMAC_AJUSTES_OPEN")      # testes (--snapshot): abre já
        if test == "clock":
            GLib.timeout_add(700, lambda: (ca.clicked(), False)[1])
        elif test == "saver":
