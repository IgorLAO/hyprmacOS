def _capsule(cr, x, y, w, h):
    r = h / 2
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, math.pi / 2)
    cr.arc(x + r, y + r, r, math.pi / 2, 3 * math.pi / 2)
    cr.close_path()


class GlassKnob:
    """Puxador do slider do Tahoe com a lente de verdade (referencias/desejos/
    slider-brilho-parado e -arrastando, 1 px = 1 pt): parado, cápsula branca 33×21; ao pegar
    cresce 1,3× (43×28) em 160 ms e vira vidro — transparente, a trilha passa por dentro
    levemente ampliada (a faixa azul termina arredondada no centro), o fundo escurece ~2 %,
    o aro é um filete de 1 pt azul-acinzentado onde o azul refrata (metade esquerda) e claro
    embaixo. O GTK desenha só trilha e preenchimento; o puxador do CSS fica invisível."""

    IDLE = (33.0, 21.0)
    GLASS = (43.0, 28.0)
    TRACK = 6.0

    def __init__(self, sc):
        self.sc, self.t, self.target, self._tick = sc, 0.0, 0.0, None
        if os.environ.get("HYPRMAC_AJUSTES_GLASS"):     # testes (--snapshot): já "arrastando"
            self.t = self.target = 1.0
        add_class(sc, "glass-knob")
        sc.set_size_request(-1, 30)
        sc.connect_after("draw", self._draw)
        sc.connect("button-press-event", lambda *_: self._go(1.0) or False)
        sc.connect("button-release-event", lambda *_: self._go(0.0) or False)

    def _go(self, target):
        if target == self.target:
            return
        self.target = target
        if not Gio.Settings.new("org.gnome.desktop.interface").get_boolean("enable-animations"):
            self.t = target          # Reduzir Movimento: estado final, sem transição
            self.sc.queue_draw()
            return
        # Soltar antes do fim da expansão inicia o retorno no tamanho atual.
        self._t0, self._from = None, self.t
        if self._tick is None:
            self._tick = self.sc.add_tick_callback(self._frame)

    def _frame(self, _w, clock):
        now = clock.get_frame_time() / 1e6
        if self._t0 is None:
            self._t0, self._from = now, self.t
        u = min(1.0, (now - self._t0) / 0.16)
        e = 1 - (1 - u) ** 3
        self.t = self._from + (self.target - self._from) * e
        self.sc.queue_draw()
        if u >= 1 or abs(self.t - self.target) < 1e-3:
            self.t = self.target
            self._tick = None
            return False
        return True

    def _color(self, name, fallback):
        ok, c = self.sc.get_style_context().lookup_color(name)
        return (c.red, c.green, c.blue) if ok else fallback

    def _draw(self, w, cr):
        a = w.get_allocation()
        rr = w.get_range_rect()
        s0, s1 = w.get_slider_range()
        cx = (s0 + s1) / 2
        cy = rr.y + rr.height / 2
        t = self.t
        kw = self.IDLE[0] + (self.GLASS[0] - self.IDLE[0]) * t
        kh = self.IDLE[1] + (self.GLASS[1] - self.IDLE[1]) * t
        x, y = cx - kw / 2, cy - kh / 2
        win = w.get_toplevel()
        light = win.get_style_context().has_class("light") if win else True
        accent = self._color("mac_accent", (0.13, 0.49, 0.89))
        cr.save()
        # sombra de queda (kit: 0 0.5 6 #000/0.12), mais fraca no vidro
        for i in range(4, 0, -1):
            cr.set_source_rgba(0, 0, 0, 0.022 * (1 - 0.5 * t))
            _capsule(cr, x - i * 0.7, y + 0.5 - i * 0.7 + 0.6, kw + i * 1.4, kh + i * 1.4)
            cr.fill()
        # 1) corpo opaco (parado) que se dissolve no vidro
        knob = (1, 1, 1) if light else (0.871, 0.871, 0.871)       # #FFF / #DEDEDE do kit
        if t < 1:
            cr.set_source_rgba(*knob, 1 - t)
            _capsule(cr, x, y, kw, kh)
            cr.fill()
        if t > 0:
            cr.save()
            _capsule(cr, x, y, kw, kh)
            cr.clip()
            # fundo da lente: um véu sobre o que está atrás
            cr.set_source_rgba(*((0, 0, 0, 0.02 * t) if light else (1, 1, 1, 0.05 * t)))
            cr.paint()
            # a faixa azul vista pela lente: 15 % mais grossa e um pouco mais clara (print:
            # 33,125,226 fora → 53,135,237 dentro), até o centro com a ponta redonda; a trilha
            # cinza é a do GTK (redesenhá-la dobraria o alfa)
            th = self.TRACK * 1.15
            lit = tuple(c + (1 - c) * 0.08 for c in accent)
            cr.set_source_rgba(*lit, t)
            _capsule(cr, x - kw, cy - th / 2, kw + kw / 2, th)
            cr.fill()
            # borda da lente um pouco mais escura (fundo puxado de fora, como no print)
            g = cairo.RadialGradient(cx, cy, kh * 0.25, cx, cy, kw * 0.62)
            g.add_color_stop_rgba(0.6, 0, 0, 0, 0)
            g.add_color_stop_rgba(1.0, 0, 0, 0, (0.05 if light else 0.10) * t)
            cr.set_source(g)
            cr.paint()
            cr.restore()
            # aro de 1 pt: azul refratado na metade esquerda, cinza na direita, claro embaixo
            lg = cairo.LinearGradient(x, 0, x + kw, 0)
            mix = tuple(0.45 * c + 0.55 * m for c, m in zip(accent, (0.38, 0.46, 0.58)))
            lg.add_color_stop_rgba(0.0, *mix, 0.85 * t)
            lg.add_color_stop_rgba(0.45, *mix, 0.55 * t)
            lg.add_color_stop_rgba(0.62, 0.5, 0.5, 0.55, 0.22 * t)
            lg.add_color_stop_rgba(1.0, 0.5, 0.5, 0.55, 0.30 * t)
            cr.set_source(lg)
            cr.set_line_width(1.0)
            _capsule(cr, x + 0.5, y + 0.5, kw - 1, kh - 1)
            cr.stroke()
            vg = cairo.LinearGradient(0, y, 0, y + kh)
            vg.add_color_stop_rgba(0.55, 1, 1, 1, 0)
            vg.add_color_stop_rgba(1.0, 1, 1, 1, (0.85 if light else 0.35) * t)
            cr.set_source(vg)
            cr.set_line_width(1.2)
            _capsule(cr, x + 1.4, y + 1.4, kw - 2.8, kh - 2.8)
            cr.stroke()
        else:
            cr.set_source_rgba(0, 0, 0, 0.06 if light else 0.18)       # contorno de 0,5
            cr.set_line_width(0.5)
            _capsule(cr, x + 0.25, y + 0.25, kw - 0.5, kh - 0.5)
            cr.stroke()
        cr.restore()
        return False


def sun_icon(name):
    """sun.min (disco + 8 pontos) e sun.max (disco + 8 raios) dos SF Symbols, como nas pontas
    do slider de brilho do Tahoe (referencias/desejos/slider-brilho-parado.png) — a fonte de
    símbolos não os tem; as mesmas formas da Central (draw_sf do hyprmac-shell)."""
    area = Gtk.DrawingArea()
    area.set_size_request(16, 16)
    area.set_valign(Gtk.Align.CENTER)
