            if c == "multicolor":
                draw_multicolor(cr, 14)
            else:
                draw_dot(cr, 14, c)
            return False
        da.connect("draw", _paint)
        box.pack_start(da, False, False, 0)
    names = dict(options)
    val = label(names.get(current, str(current)), "popup-value")
    val.set_valign(Gtk.Align.CENTER)
    box.pack_start(val, False, False, 0)
    arrow = label(G("f054f"), "glyph popup-arrow", 0.5)
    arrow.set_size_request(24, 24)
    box.pack_start(arrow, False, False, 0)
    btn.add(box)
    btn.set_valign(Gtk.Align.CENTER)
    state = {"cur": current}

    def clicked(_b):
        menu = Gtk.Menu()
        for key, name in options:
            it = Gtk.CheckMenuItem(label=name)
            it.set_draw_as_radio(True)
            it.set_active(key == state["cur"])
            it.connect("activate", lambda _i, k=key, n=name: (
                state.__setitem__("cur", k), val.set_text(n), on_change(k)))
            menu.append(it)
        menu.show_all()
        menu.attach_to_widget(btn, None)
        menu.popup_at_widget(btn, Gdk.Gravity.SOUTH_EAST, Gdk.Gravity.NORTH_EAST, None)
    btn.connect("clicked", clicked)
    return btn


