            path = os.path.join(HERE, "icones", f"relogio-estilo-{index}.png")
            if os.path.exists(path):
                self.mask = cairo.ImageSurface.create_from_png(path)
            self.set_sensitive(False)
            self.set_tooltip_text("Fonte do sistema da Apple — não disponível no Linux")
        area = Gtk.DrawingArea()
        area.set_size_request(42, 42)
        area.connect("draw", self._draw)
        self.area = area
        self.add(area)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("clicked", lambda _b: on_pick(key))

    def _draw(self, w, cr):
        a = w.get_allocation()
        fg = w.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        rgba = (fg.red, fg.green, fg.blue, 1.0 if self.available else 0.55)
        if self.available:
            # peso fixo das amostras: área da tinta da referência = SF Pro wght ≈ 720 (o relógio
            # em si usa o peso do slider)
            draw_clock_text(cr, "12", self.key, self.SAMPLE_WEIGHT, 35, a.width / 2, a.height / 2, rgba)
        elif self.mask is not None:
            k = 1 / self.MASK_SCALE
            mw, mh = self.mask.get_width() * k, self.mask.get_height() * k
            cr.translate((a.width - mw) / 2, (a.height - mh) / 2)
            cr.scale(k, k)
            cr.set_source_rgba(*rgba)
            cr.mask_surface(self.mask, 0, 0)
        return False


def window_control_symbol(symbol):
    """Símbolo limitado à caixa do semáforo, independente da fonte de fallback.

    O glifo ⤢ pode ter line-height de 24 px. Caixa 14×14 do kit
    [real:BaseConhecimento/referencias/kit/contornos/Titlebars_and_Toolbars.txt:1144];
    símbolo de 8 px como [real:gtk/gtk4.css:112].
    """
    area = Gtk.DrawingArea()
    area.set_size_request(14, 14)
    add_class(area, "light-symbol")
    layout = area.create_pango_layout(symbol)

    def draw(widget, cr):
        style = widget.get_style_context()
        state = widget.get_state_flags()
        layout.set_font_description(style.get_font(state))
        ink, _logical = layout.get_pixel_extents()
        scale = min(1.0, 8 / max(1, ink.width), 8 / max(1, ink.height))
        cr.translate((widget.get_allocated_width() - ink.width * scale) / 2,
                     (widget.get_allocated_height() - ink.height * scale) / 2)
        cr.scale(scale, scale)
        cr.move_to(-ink.x, -ink.y)
        color = style.get_color(state)
        cr.set_source_rgba(color.red, color.green, color.blue, color.alpha)
        PangoCairo.show_layout(cr, layout)
        return False

    area.connect("draw", draw)
    return area


