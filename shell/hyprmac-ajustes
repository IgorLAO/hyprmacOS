    # ── navegação ──
    def open_pane(self, key, record=True):
        builder = getattr(self, "pane_" + key.replace("-", "_"), None)
        if builder is None:
            builder = lambda: self.pane_mock(key)
        self.current = key
        row = self.rows.get(key)
        if row is not None and self.side_list.get_selected_row() is not row:
            self.side_list.select_row(row)
        self._show(TITLES.get(key, key), builder)
        if record:
            self.history = self.history[:self.pos + 1] + [("pane", key)]
            self.pos = len(self.history) - 1
        self._nav_state()

    def push(self, title, builder):
        """Subpágina (Geral ▸ Sobre…): entra no histórico do voltar."""
        self._next_transition = Gtk.StackTransitionType.SLIDE_LEFT
        self._show(title, builder)
        self.history = self.history[:self.pos + 1] + [("sub", (title, builder))]
        self.pos = len(self.history) - 1
        self._nav_state()

    def _step(self, d):
        p = self.pos + d
        if not 0 <= p < len(self.history):
            return
        self.pos = p
        self._next_transition = (Gtk.StackTransitionType.SLIDE_RIGHT if d < 0
                                 else Gtk.StackTransitionType.SLIDE_LEFT)
        if self.search.get_text():
            self.search.set_text("")  # _filter restaura o destino já escolhido
        else:
            self._restore_history()
        self._nav_state()

    def _restore_history(self):
        """Restaura página e seleção lateral juntas, inclusive após uma busca."""
        if not 0 <= self.pos < len(self.history):
            return
        p = self.pos
        kind, val = self.history[p]
        if kind == "pane":
            self.open_pane(val, record=False)
        else:
            parent = next(
                (value for kind, value in reversed(self.history[:p]) if kind == "pane"),
                self.current,
            )
            self.current = parent
            selected = self.rows.get(parent)
            if selected is not None:
                self.side_list.select_row(selected)
            self._show(*val)

    def _nav_state(self):
        self.back.set_sensitive(self.pos > 0)
        self.fwd.set_sensitive(self.pos < len(self.history) - 1)

    def _show(self, title, builder):
        self.title_lbl.set_text(title)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        add_class(page, "page")
        try:
            items = builder()
        except Exception as e:     # um painel com erro não derruba o app
            items = [Form().outer]
            items[0].get_children()[0].add_row(row("This pane could not load", sub=str(e)))
        for w in items:
            page.pack_start(w, False, False, 0)
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(page)
        sc.get_vadjustment().connect("value-changed", lambda *_: self.edge.queue_draw())
        sc.show_all()
        if os.environ.get("HYPRMAC_AJUSTES_SCROLL"):     # testes (--snapshot): rola N px
            GLib.timeout_add(500, lambda: sc.get_vadjustment().set_value(
                float(os.environ["HYPRMAC_AJUSTES_SCROLL"])) and False)
        name = f"p{time.monotonic_ns()}"
        old = self.stack.get_visible_child()    # antes: num Stack vazio o 1º filho já é o visível
        self.stack.add_named(sc, name)
        transition = self._next_transition or Gtk.StackTransitionType.CROSSFADE
        self._next_transition = None
        self.stack.set_visible_child_full(name, transition)
        if old is not None:
            GLib.timeout_add(300, lambda: old.destroy() and False)

    def refresh(self, delay=600):
        """Remonta a página atual (depois de mudar algo do sistema)."""
        def go():
            if 0 <= self.pos < len(self.history):
                # Uma atualização pendente não deve apagar a busca em andamento.
                if not self.search.get_text():
                    self._restore_history()
            return False
        GLib.timeout_add(delay, go)

