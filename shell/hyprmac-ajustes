        right.pack_start(btns, False, False, 0)
        top.pack_start(right, True, True, 0)
        sep = Gtk.Box()
        add_class(sep, "wall-sep")
        # seções como no Tahoe (prints 2×): miniaturas de 107,5×71 com o nome embaixo, 4 por
        # linha com vão de 10; "Your Photos" começa pelo bloco "Add Photo…" e tem "Show All (n)"
        conf = load_json(SHELL_CONF, {})
        added = [p for p in conf.get("user_wallpapers", []) if os.path.isfile(p)]
        mine, seen = [], set()
        for p in added + self._picture_files():
            rp = os.path.realpath(p)
            if rp not in seen:
                seen.add(rp)
                mine.append(p)
        builtin = [p for p in files if "-mini." not in os.path.basename(p)
                   and os.path.realpath(p) not in seen]
        show_all = getattr(self, "_wall_show_all", False)
        out = [top, sep]
        # Your Photos
        hdr = Gtk.Box()
        hdr.pack_start(label("Your Photos", "form-header"), False, False, 0)
        if len(mine) > 7:
            more = Gtk.Button(label="Show Less" if show_all else f"Show All ({len(mine)})")
            add_class(more, "wall-more")
            more.set_valign(Gtk.Align.CENTER)
            more.connect("clicked", lambda _b: (setattr(self, "_wall_show_all", not show_all),
                                                self.refresh(0)))
            hdr.pack_end(more, False, False, 0)
        out.append(hdr)
        g1 = self._wall_grid()
        g1.add(self._wall_add_tile())
        for p in (mine if show_all else mine[:7]):
            g1.add(self._wall_thumb(p, cur))
        out.append(g1)
        if builtin:
            out.append(label("Pictures", "form-header"))
            g2 = self._wall_grid()
            for p in builtin:
                g2.add(self._wall_thumb(p, cur))
            out.append(g2)
        return out

    @staticmethod
    def _picture_files():
        """Fotos do usuário: ~/Pictures/Wallpapers e o nível de cima de ~/Pictures, as mais
        novas primeiro (no Mac, "Your Photos" vem da fototeca)."""
        out = []
        for d in (os.path.expanduser("~/Pictures/Wallpapers"), os.path.expanduser("~/Pictures")):
            try:
                names = os.listdir(d)
            except OSError:
                continue
            for n in names:
                p = os.path.join(d, n)
                if n.lower().endswith((".jpg", ".jpeg", ".png", ".webp", ".heic")) and os.path.isfile(p):
                    out.append(p)
        out.sort(key=lambda p: -os.path.getmtime(p))
        return out

