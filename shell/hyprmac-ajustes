        # o conteúdo se apaga num degradê logo abaixo do título ("scroll edge effect"), com
        # uma sombra levíssima; parado no topo não aparece nada
        ov = Gtk.Overlay()
        ov.add(self.stack)
        self.edge = Gtk.DrawingArea()
        self.edge.set_size_request(-1, 22)
        self.edge.set_valign(Gtk.Align.START)
        self.edge.connect("draw", self._draw_edge)
        ov.add_overlay(self.edge)
        ov.set_overlay_pass_through(self.edge, True)
        content.pack_start(ov, True, True, 0)

        self.connect("key-press-event", self._on_key)
        self.theme = Gio.Settings.new("org.gnome.desktop.interface")
        self.theme.connect("changed::color-scheme", lambda *_: self._retheme())
        self.theme.connect("changed::accent-color", lambda *_: load_css())
        if offscreen:      # --snapshot: desenha fora da tela, sem janela no desktop
            self.remove(root)
            self.off = Gtk.OffscreenWindow()
            add_class(self.off, "settings", "dark" if self.dark else "light")
            self.off.set_size_request(W, H)
            self.off.add(root)
            self.off.show_all()
        else:
            self.show_all()
            # Liquid Glass: declara as peças de vidro ao compositor (barra lateral e cápsula
            # < >) e refaz quando a janela muda de tamanho
            self._glass_addr = None
            self._glass_sent = None
            self.connect("size-allocate", lambda *_: GLib.idle_add(self._send_glass_shapes))
            GLib.timeout_add(400, self._send_glass_shapes)
        self.open_pane(first)

    # ── janela ──
    def _draw_side_frame(self, w, cr):
        """Fundo opaco da coluna da barra lateral, com o recorte arredondado da barra
        (recuo 8, raio 18) vazado: ali só o vidro. CSS não fura um fundo, então é cairo."""
        import math
        a = w.get_allocation()
        m, r = 8, 18
        cr.set_source_rgb(*((0.118, 0.118, 0.118) if self.dark else (1, 1, 1)))
        cr.set_fill_rule(1)  # cairo.FILL_RULE_EVEN_ODD
        cr.rectangle(0, 0, a.width, a.height)
        x, y, x2, y2 = m, m, a.width, a.height - m
        cr.new_sub_path()
        cr.arc(x2 - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x2 - r, y2 - r, r, 0, math.pi / 2)
        cr.arc(x + r, y2 - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.fill()
        return False

    def _rounded(self, cr, x, y, w, h, r):
        import math
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def _draw_content_bg(self, w, cr):
        """Fundo opaco do conteúdo com a cápsula < > vazada: ela é vidro (kit: Liquid Glass/
        Dark/Regular - Small, distorção 0,4), desenhado pelo compositor por trás da janela."""
        a = w.get_allocation()
        cr.set_source_rgb(*((0.118, 0.118, 0.118) if self.dark else (1, 1, 1)))
        cr.set_fill_rule(1)  # even-odd
        cr.rectangle(0, 0, a.width, a.height)
        pos = self.nav.translate_coordinates(w, 0, 0) if getattr(self, "nav", None) else None
        if pos:
            na = self.nav.get_allocation()
            self._rounded(cr, pos[0], pos[1], na.width, na.height, na.height / 2)
        cr.fill()
        return False

    def _draw_edge(self, w, cr):
        sc = self.stack.get_visible_child()
        v = sc.get_vadjustment().get_value() if isinstance(sc, Gtk.ScrolledWindow) else 0
        k = min(1.0, v / 12)                  # aparece nos primeiros 12 px de rolagem
        if k <= 0:
            return False
        a = w.get_allocation()
        bg = (0.118, 0.118, 0.118) if self.dark else (1, 1, 1)
        g = cairo.LinearGradient(0, 0, 0, a.height)
        g.add_color_stop_rgba(0.0, *bg, 1.0 * k)
        g.add_color_stop_rgba(0.35, *bg, 0.75 * k)
        g.add_color_stop_rgba(1.0, *bg, 0.0)
        cr.set_source(g)
        cr.paint()
        # sombra muito leve colada ao título
        sh = cairo.LinearGradient(0, 0, 0, 6)
        sh.add_color_stop_rgba(0, 0, 0, 0, (0.10 if self.dark else 0.035) * k)
        sh.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.set_source(sh)
        cr.rectangle(0, 0, a.width, 6)
        cr.fill()
        return False

    def _send_glass_shapes(self):
        """Compatibilidade com builds antigos que ofereciam `hyprglass shape`.

        O upstream v0.9.0 não registra esse comando. A chamada é mantida sem erro visível
        para não quebrar uma instalação que ainda use o patch local antigo; o preset da
        janela e o fallback do Hyprland continuam funcionando sem ele.
        """
        if not self.get_mapped():
            return False
        shapes = []
        for wdg, r in ((self.side, 18), (self.nav, None)):
            pos = wdg.translate_coordinates(self, 0, 0)
            if not pos:
                continue
            al = wdg.get_allocation()
            shapes.append((pos[0], pos[1], al.width, al.height, al.height / 2 if r is None else r))
        if shapes == self._glass_sent:
            return False
        if not self._glass_addr:
            try:
                for c in json.loads(run("hyprctl clients -j")):
                    if c.get("pid") == os.getpid() and c.get("class") == APP_ID:
                        self._glass_addr = c["address"]
            except ValueError:
                pass
        if not self._glass_addr:
            GLib.timeout_add(300, self._send_glass_shapes)
            return False
        self._glass_sent = shapes
        cmd = "hyprglass shape " + self._glass_addr + " " + " ".join(
            ",".join(f"{v:.1f}" for v in sh) for sh in shapes)
        hypr_socket(cmd)
        return False

