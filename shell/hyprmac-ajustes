    def _wall_add_tile(self):
        """Bloco "Add Photo…" (Tahoe: cinza, ícone de foto com +, texto embaixo, dentro)."""
        b = Gtk.Button()
        add_class(b, "wall-thumb", "wall-add")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        add_class(tile, "wall-add-tile")
        tile.set_size_request(WALL_THUMB_W, WALL_THUMB_H)
        tile.set_halign(Gtk.Align.CENTER)
        # ícone "photo.badge.plus" da referência: imagem + selo redondo com "+" no canto
        ic = Gtk.DrawingArea()
        add_class(ic, "wall-add-icon")
        ic.set_size_request(34, 28)
        ic.set_halign(Gtk.Align.CENTER)
        ic.set_valign(Gtk.Align.END)
        ic.set_vexpand(True)

        def draw_icon(w, cr):
            col = w.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            cr.push_group()                      # o CLEAR só pode recortar o próprio ícone
            cr.set_source_rgba(col.red, col.green, col.blue, 1)
            lay = PangoCairo.create_layout(cr)
            fd = Pango.FontDescription("Symbols Nerd Font")
            fd.set_absolute_size(26 * Pango.SCALE)
            lay.set_font_description(fd)
            lay.set_text(G("f02e9"), -1)
            cr.move_to(0, -1)
            PangoCairo.show_layout(cr, lay)
            bx, by, r = 26.5, 20.5, 6.5          # selo: recorta um anel e desenha o círculo com +
            cr.set_operator(cairo.OPERATOR_CLEAR)
            cr.arc(bx, by, r + 1.5, 0, 6.2832)
            cr.fill()
            cr.set_operator(cairo.OPERATOR_OVER)
            cr.arc(bx, by, r, 0, 6.2832)
            cr.fill()
            cr.set_operator(cairo.OPERATOR_CLEAR)
            cr.set_line_width(1.6)
            cr.move_to(bx - 3.2, by)
            cr.line_to(bx + 3.2, by)
            cr.move_to(bx, by - 3.2)
            cr.line_to(bx, by + 3.2)
            cr.stroke()
            cr.pop_group_to_source()
            cr.paint_with_alpha(col.alpha)
            return False
        ic.connect("draw", draw_icon)
        tile.pack_start(ic, True, True, 0)
        tx = label("Add Photo…", "wall-add-text", 0.5)
        tx.set_valign(Gtk.Align.START)
        tx.set_vexpand(True)
        tile.pack_start(tx, True, True, 0)
        box.pack_start(tile, False, False, 0)
        box.pack_start(label(" ", "wall-name", 0.5), False, False, 0)
        b.add(box)
        b.connect("clicked", lambda _b: self._wall_add_photo())
        return b

    def _wall_add_photo(self):
        dlg = Gtk.FileChooserNative.new("Add Photo", self, Gtk.FileChooserAction.OPEN, "Add", "Cancel")
        flt = Gtk.FileFilter()
        flt.set_name("Images")
        for pat in ("*.jpg", "*.jpeg", "*.png", "*.webp", "*.heic", "*.JPG", "*.JPEG", "*.PNG"):
            flt.add_pattern(pat)
        dlg.add_filter(flt)
        dlg.set_select_multiple(True)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            paths = [f.get_path() for f in dlg.get_files() if f.get_path()]
            if paths:
                conf = load_json(SHELL_CONF, {})
                lst = [p for p in conf.get("user_wallpapers", []) if p not in paths]
                conf["user_wallpapers"] = paths + lst
                save_json(SHELL_CONF, conf)
                set_wallpaper(paths[0])
                self.refresh(400)
        dlg.destroy()

    def _draw_wall_preview(self, cr, w, h, path, cache):
        """Prévia do papel de parede; com o popover do relógio aberto vira a miniatura da tela
        de bloqueio (como no Tahoe): traço da data, relógio no estilo escolhido, avatar e os
        traços do nome e da dica (proporções medidas no print a 1,43×)."""
        cr.save()
        draw_picture(cr, w, h, path, cache, 8)
        cr.restore()
        if not self._wall_lock_preview:
            return False
        cc = clock_conf()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)

        def bar(cy, frac, thick):
            cr.set_line_width(thick * h)
            cr.move_to(w / 2 - frac * w / 2, cy * h)
            cr.line_to(w / 2 + frac * w / 2, cy * h)
            cr.set_source_rgba(1, 1, 1, 0.9)
            cr.stroke()
        bar(0.062, 0.21, 0.027)
        if cc["show"] != "never":
            draw_clock_text(cr, time.strftime("%-H:%M"), cc["style"], cc["weight"],
                            0.19 * h / 0.7046, w / 2, 0.25 * h, (1, 1, 1, 0.92))
        cr.arc(w / 2, 0.81 * h, 0.0385 * h, 0, 6.2832)
        cr.set_source_rgba(1, 1, 1, 0.92)
        cr.fill()
        bar(0.885, 0.10, 0.023)
        bar(0.93, 0.21, 0.027)
        return False

    def _clock_popover(self, button):
        """Clock Appearance… (popover do Tahoe, medido a 1×: 441 de largura, grupo interno com
        recuo de 11; linhas de 41 / 74 / 39; amostras a cada 67,75; trilho do peso de 218)."""
        cc = clock_conf()
        state = {"weight": cc["weight"], "style": cc["style"]}
        pop = Gtk.Popover.new(button)
        add_class(pop, "clock-pop")
        pop.set_position(Gtk.PositionType.BOTTOM)
        pop.set_constrain_to(Gtk.PopoverConstraint.NONE)
        f = Form()
        add_class(f, "clock-form")
        f.add_row(row("Show large clock", trailing=popup_button(
            [("lock", "On Lock Screen"), ("never", "Never")], cc["show"],
            lambda v: (set_clock_conf("lock_clock", v), self._wall_art.queue_draw()))))
        styles = Gtk.Box(homogeneous=True)
        add_class(styles, "clock-styles")
        samples = []

        def pick(key):
            state["style"] = key
            set_clock_conf("lock_clock_style", key)
            for smp in samples:
                (add_class if smp.key == key else remove_class)(smp, "selected")
            self._wall_art.queue_draw()
        for i, (key, _fam) in enumerate(CLOCK_STYLES, 1):
            smp = ClockSample(i, key, lambda: state["weight"], pick)
            if key == state["style"]:
                add_class(smp, "selected")
            samples.append(smp)
            styles.pack_start(smp, True, True, 0)
        f.add_row(styles)

        def weight(v):
            state["weight"] = int(round(v))
            set_clock_conf("lock_clock_weight", state["weight"])
            for smp in samples:
                smp.area.queue_draw()
            self._wall_art.queue_draw()
        f.add_row(row("Weight", trailing=slider(state["weight"], weight, rng=(100, 900), width=218)))
        pop.add(f.outer)

        def shown(on):
            self._wall_lock_preview = on
            self._wall_art.queue_draw()
        pop.connect("closed", lambda *_: shown(False))
        f.outer.show_all()
        if os.environ.get("HYPRMAC_AJUSTES_OPEN") == "clock" and hasattr(self, "off"):
            # --snapshot: popover não desenha fora da tela; mostra o conteúdo no lugar dele
            pop.remove(f.outer)
            fake = Gtk.Box()
            add_class(fake, "clock-pop-test")
            fake.add(f.outer)
            fake.set_halign(Gtk.Align.END)
            fake.set_valign(Gtk.Align.START)
            fake.set_margin_top(178)
            self.overlay.add_overlay(fake)
            fake.show_all()
        else:
            pop.popup()
        shown(True)

