    def pane_wifi(self):
        dev = run("nmcli -t -f DEVICE,TYPE device | awk -F: '$2==\"wifi\"{print $1; exit}'")
        top = Form()
        if not dev:
            top.add_row(row("Wi‑Fi", icon=(G("f05a9"), "#0A84FF"), sub="No Wi‑Fi hardware installed"))
            return [top.outer]
        on = run("nmcli radio wifi") == "enabled"
        top.add_row(row("Wi‑Fi", icon=(G("f05a9"), "#0A84FF"), trailing=switch(
            on, lambda v: (spawn(f"nmcli radio wifi {'on' if v else 'off'}"), self.refresh(1500)))))
        out = [top.outer]
        if not on:
            return out
        nets, cur = [], None
        for line in run("nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list", 8).splitlines():
            f = re.split(r"(?<!\\):", line)
            if len(f) < 4 or not f[1]:
                continue
            ssid = f[1].replace("\\:", ":")
