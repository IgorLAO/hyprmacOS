    MASK_SCALE = 20 / 14       # recortes tirados de um print a 1,43 px/pt
    SAMPLE_WEIGHT = 720

    def __init__(self, index, key, get_weight, on_pick):
        super().__init__()
        add_class(self, "clock-style")
        self.key, self.get_weight = key, get_weight
        self.available = clock_style_family(key) is not None
        self.mask = None
