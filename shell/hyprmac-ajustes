    def _menubar_controls(self):
        hidden = set(load_json(os.path.join(CONF_DIR, "barra.json"), {}).get("hidden", []))

        def set_shown(key, on):
            menubar_items.set_shown(key, on, CONF_DIR, ROOT)    # mesmo código da galeria da Central

        # cartão de apresentação
        intro = Gtk.Overlay()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        add_class(card, "form", "mbc-intro")
        txt = label("System and app controls can be configured to appear in both Control "
                    "Center and the menu bar.", "row-sub mbc-text")
        txt.set_line_wrap(True)
        txt.set_max_width_chars(38)        # quebra em "configured to / appear…" (ui_0002)
        txt.set_halign(Gtk.Align.START)
        card.pack_start(txt, False, False, 0)
        add = push_button("Add Controls…", lambda: shell_cmd("edit-controls"))
        add.set_halign(Gtk.Align.START)
        add_class(add, "mbc-add")
        card.pack_start(add, False, False, 0)
        art = Gtk.DrawingArea()
        art.set_size_request(120, -1)
        art.set_halign(Gtk.Align.END)
        art.connect("draw", self._draw_mbc_art)
        intro.add(card)
        intro.add_overlay(art)
        intro.set_overlay_pass_through(art, True)
        head = label("Menu Bar Controls", "form-header")
        ctl = Form()
        for key, title, (g, c), sel, extra in self.BAR_ITEMS:
            lead = Gtk.Box(spacing=10)
            if sel:
                cb = Gtk.CheckButton()
                cb.set_active(key not in hidden)
                cb.set_valign(Gtk.Align.CENTER)
                cb.connect("toggled", lambda b, k=key: set_shown(k, b.get_active()))
                lead.pack_start(cb, False, False, 0)
            else:
                sp = Gtk.Box()
                add_class(sp, "mbc-nocheck")
                lead.pack_start(sp, False, False, 0)
            lead.pack_start(AppIcon(glyph_of(g), c), False, False, 0)
            trail = None
            if extra == "clock":
                trail = push_button("Clock Options…", self._clock_options_sheet)
                if os.environ.get("HYPRMAC_AJUSTES_OPEN") == "clockoptions":   # testes (--snapshot)
                    GLib.timeout_add(700, lambda: self._clock_options_sheet() and False)
            elif extra == "battery":
                trail = push_button("Battery Options…", lambda: self.open_pane("energy"))
            elif extra == "active":
                trail = popup_button([("active", "Show When Active")], "active", lambda v: None)
            ctl.add_row(row(title, icon=lead, trailing=trail))
        sections = [head, intro, ctl.outer]
        # Lista exclusivamente registros SNI, nunca todos os apps abertos.
        helper = os.path.join(ROOT, "scripts", "menu-extras")
        try:
            extras = json.loads(subprocess.check_output(
                [helper, "list", "--json"], text=True, timeout=4))
        except (OSError, subprocess.SubprocessError, ValueError):
            extras = []
        prefs = load_json(os.path.join(CONF_DIR, "menu-extras.json"), {}).get("tray", {})
        hidden_apps = set(prefs.get("hidden-items", []))
        app_controls = Form()
        seen = set()
        for extra in extras:
            app_id, title = extra["id"], extra["title"]
            # Electron pode compartilhar Id: Title é o seletor explícito nesses casos.
            duplicate_id = app_id == "chrome_status_icon_1" or sum(it["id"] == app_id for it in extras) > 1
            identity = "title:" + title if duplicate_id and title else app_id
            if not identity or identity in seen:
                continue
            seen.add(identity)
            checkbox = Gtk.CheckButton()
            checkbox.set_active(app_id not in hidden_apps and "title:" + title not in hidden_apps)
            checkbox.set_sensitive(os.path.isfile(os.path.join(
                os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                "hyprmac", "waybar-tahoe", "waybar")))
            checkbox.connect("toggled", lambda button, key=identity:
                subprocess.Popen([helper, "show" if button.get_active() else "hide", key]))
            app_controls.add_row(row(title or app_id, icon=checkbox))
        if seen:
            sections.extend([label("Allow in the Menu Bar", "form-header"), app_controls.outer])
        return sections

    def _draw_mbc_art(self, w, cr):
        """A Central em miniatura, cortada pela borda direita do cartão (ui_0002): cápsulas e
        círculos cinza-claros, com a barra de menus de pontinhos em cima."""
        a = w.get_allocation()
        ink = (1, 1, 1, 0.10) if self.dark else (0, 0, 0, 0.07)
        cr.set_source_rgba(*ink)
        x0, y0, u = 10, 8, 13
        for i in range(6):                       # "barra de menus" pontilhada
            cr.arc(x0 + 30 + i * 9, y0, 2, 0, 2 * math.pi)
            cr.fill()
        y = y0 + 10
        cr.set_source_rgba(*ink)
        for (cx, cy, kind) in ((0, 0, "pill"), (60, 0, "sq"), (0, 1, "c"), (1, 1, "c"),
                               (0, 2, "pill"), (2, 2, "c"), (3, 2, "c")):
            if kind == "pill":
                squircle(cr, x0, y + cy * (u + 4), 2 * u + 4, u, u / 2)
            elif kind == "sq":
                squircle(cr, x0 + cx - 26, y, 2 * u + 4, 2 * u + 4, 6)
            else:
                cr.arc(x0 + u / 2 + cx * (u + 4), y + cy * (u + 4) + u / 2, u / 2, 0, 2 * math.pi)
            cr.fill()
        return False

