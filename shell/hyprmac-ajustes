def G(code):
    return chr(int(code, 16))


def run(cmd, timeout=4):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=timeout).stdout.strip()
    except subprocess.TimeoutExpired:
        return ""


def hypr_socket(cmd):
    """Comando direto no socket do Hyprland (como o hyprctl, sem abrir processo)."""
    import socket
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return ""
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as so:
            so.settimeout(1)
            so.connect(path)
            so.sendall(cmd.encode())
            return so.recv(4096).decode(errors="replace")
    except OSError:
        return ""


def spawn(cmd):
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def shell_cmd(cmd):
    spawn("gdbus call --session --dest dev.hyprmac.Shell --object-path /dev/hyprmac/Shell "
          f"--method dev.hyprmac.Shell.Command {GLib.shell_quote(cmd)}")


