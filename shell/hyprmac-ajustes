    def pane_appearance(self):
        dark = is_dark()
        mode = load_json(SHELL_CONF, {}).get("appearance_mode") or mock("appearance_mode", "dark" if dark else "light")
        f1 = Form()
        choices = Gtk.Box(spacing=10)
        refs = {}

        def pick(m):
            set_mock("appearance_mode", m)
            set_clock_conf("appearance_mode", m)    # scripts/aparencia: o Auto troca sozinho
            for k, c in refs.items():
                c.set_selected(k == m)
            want = m if m != "auto" else ("dark" if not 7 <= time.localtime().tm_hour < 19 else "light")
            if (want == "dark") != is_dark():
                spawn(f"{ROOT}/scripts/theme {want}")
        for m, cap in (("auto", "Auto"), ("light", "Light"), ("dark", "Dark")):
            refs[m] = Choice(lambda cr, w, h, m=m: draw_mode_thumb(cr, w, h, m), cap, m == mode,
                             lambda m=m: pick(m))
            choices.pack_start(refs[m], False, False, 0)
        f1.add_row(row("Appearance", trailing=choices, tall=True, top=True))

        # Liquid Glass (macOS 27: "from ultraclear to fully tinted"): vale na hora no vidro
        # do hyprglass (hypr/vidro-presets.lua lê aparencia.json; reaplicar = reler a config)
        glass_timer = [0]

        def set_glass(v):
            d = load_json(APPEARANCE_PATH, {})
            d["glass_tint"] = round(v)
            save_json(APPEARANCE_PATH, d)
            if glass_timer[0]:
                GLib.source_remove(glass_timer[0])

            def apply():
                glass_timer[0] = 0
                spawn(f"{ROOT}/scripts/vidro recarregar")
                return False
            glass_timer[0] = GLib.timeout_add(250, apply)
        f1.add_row(row("Liquid Glass", trailing=slider(
            load_json(APPEARANCE_PATH, {}).get("glass_tint", 5), set_glass, "Clear", "Tinted")))

        f2 = Form(header="Theme")
        # Tahoe: a primeira é a Multicolor (cada app usa a sua; aqui = azul do sistema) e o
        # nome da cor escolhida aparece embaixo dela, em Subheadline cinza
        cur = "multicolor" if mock("accent_multicolor", False) and accent_name() == "blue" else accent_name()
        dots = Gtk.Box(spacing=8)
        dot_refs = {}

        def nome(n):
            return {"slate": "Graphite", "multicolor": "Multicolor"}.get(n, n.title())

        # legenda única, sobreposta e centrada sob a bolinha escolhida (não mexe no espaçamento)
        lay = Gtk.Overlay()
        lay.add(dots)
        fixo = Gtk.Fixed()
        fixo.set_halign(Gtk.Align.FILL)
        fixo.set_valign(Gtk.Align.FILL)
        acc_cap = label("", "accent-acc_cap", 0.5)
        fixo.put(acc_cap, 0, 0)
        lay.add_overlay(fixo)
        lay.set_overlay_pass_through(fixo, True)
        escolha = [cur]

        def pos_cap(*_):
            b = dot_refs.get(escolha[0])
            if not b:
                return False
            al = b.get_allocation()
            da = dots.get_allocation()
            cw = acc_cap.get_preferred_width()[1]
            fixo.move(acc_cap, max(0, al.x - da.x + al.width // 2 - cw // 2), al.y - da.y + al.height + 1)
            return False

        def set_accent(name):
            set_mock("accent_multicolor", name == "multicolor")
            real = "blue" if name == "multicolor" else name
            spawn(f"{ROOT}/scripts/accent {'graphite' if real == 'slate' else real}")
            escolha[0] = name
            acc_cap.set_text(nome(name))
            for k, b in dot_refs.items():
                set_cls(b, "selected", k == name)
            GLib.idle_add(pos_cap)
        for name in ("multicolor", "blue", "purple", "pink", "red", "orange", "yellow", "green", "slate"):
            b = Gtk.Button()
            add_class(b, "accent-dot")
            b.set_valign(Gtk.Align.START)
            area = Gtk.DrawingArea()
            area.set_size_request(22, 22)
            if name == "multicolor":
                area.connect("draw", lambda a, cr: draw_multicolor(cr, 22))
            else:
                col = ACCENTS[name][0 if dark else 1]
                area.connect("draw", lambda a, cr, col=col: draw_dot(cr, 22, col))
            b.add(area)
            b.set_tooltip_text(nome(name))
            set_cls(b, "selected", name == cur)
            b.connect("clicked", lambda _b, n=name: set_accent(n))
            dot_refs[name] = b
            dots.pack_start(b, False, False, 0)
        acc_cap.set_text(nome(cur))
        dots.set_margin_bottom(14)          # espaço da legenda (Subheadline 11)
        dots.connect("size-allocate", lambda *_: GLib.idle_add(pos_cap))
        dots = lay
        f2.add_row(row("Color", trailing=dots, tall=True, top=True))
        f2.add_row(row("Text highlight color", trailing=popup_button(
            [("auto", "Automatic"), ("accent", "Accent Color"), ("graphite", "Graphite")],
            mock("highlight", "auto"), lambda v: set_mock("highlight", v),
            dot=lambda: "multicolor" if escolha[0] == "multicolor" else
            ACCENTS.get("slate" if escolha[0] == "slate" else escolha[0], ACCENTS["blue"])[0 if dark else 1])))

        f3 = Form()
        style = load_json(APPEARANCE_PATH, {}).get("icon_style", "default")
        st_refs = {}

        # sob os ícones, um rádio conforme o estilo (referencias/telas/dark-icons-widgets-macos-1
        # e clear-dark-1): Dark → "Always / Auto"; Clear → "Light / Dark / Auto"
        VARIANTS = {"dark": (("always", "Always"), ("auto", "Auto")),
                    "clear": (("light", "Light"), ("dark", "Dark"), ("auto", "Auto"))}
        radios = Gtk.Box(spacing=14)
        radios.set_halign(Gtk.Align.END)
        add_class(radios, "style-variant")

        def fill_radios(s):
            for ch in radios.get_children():
                ch.destroy()
            opts = VARIANTS.get(s)
            radios.set_visible(bool(opts))
            if not opts:
                return
            var = load_json(APPEARANCE_PATH, {}).get("icon_style_variant", {})
            cur = var.get(s, opts[0][0]) if isinstance(var, dict) else opts[0][0]
            group = None
            for key, cap in opts:
                rb = Gtk.RadioButton.new_with_label_from_widget(group, cap)
                group = group or rb
