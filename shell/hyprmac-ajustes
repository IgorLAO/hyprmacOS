def draw_multicolor(cr, s):
    """Bolinha Multicolor do Tahoe: roda de cores (as 7 cores do sistema em fatias suaves)."""
    import math
    cores = [hex_rgb(ACCENTS[n][0]) for n in ("red", "orange", "yellow", "green", "blue", "purple", "pink")]
    c, r, passos = s / 2, s / 2 - 1, 84
    for i in range(passos):
        t = i / passos * len(cores)
        a, b = cores[int(t) % len(cores)], cores[(int(t) + 1) % len(cores)]
        f = t - int(t)
        cr.set_source_rgb(*(a[k] + (b[k] - a[k]) * f for k in range(3)))
        a0 = -math.pi / 2 + 2 * math.pi * i / passos
        cr.move_to(c, c)
        cr.arc(c, c, r, a0, a0 + 2 * math.pi / passos + 0.02)
        cr.close_path()
        cr.fill()


def draw_dot(cr, s, col):
    import math
    cr.arc(s / 2, s / 2, s / 2 - 1, 0, 2 * math.pi)
    cr.set_source_rgb(*hex_rgb(col))
    cr.fill()


def draw_mode_thumb(cr, w, h, mode):
    """Miniatura de Aparência: mesa com uma janelinha clara/escura (Auto = metade)."""
    def paint(dark):
        bg = (0.16, 0.20, 0.42) if dark else (0.45, 0.62, 0.92)
        cr.set_source_rgb(*bg)
        cr.paint()
        squircle(cr, w * 0.16, h * 0.22, w * 0.68, h * 0.62, 5)
        cr.set_source_rgb(*((0.17, 0.17, 0.18) if dark else (0.97, 0.97, 0.98)))
        cr.fill()
        cr.rectangle(w * 0.16, h * 0.22, w * 0.68, h * 0.14)
        cr.set_source_rgb(0.0, 0.53, 1.0)
        cr.fill()
        for i, c in enumerate(((1, 0.37, 0.36), (0.98, 0.78, 0), (0.21, 0.78, 0.35))):
            cr.arc(w * 0.24 + i * 7, h * 0.72, 2.3, 0, 6.3)
            cr.set_source_rgb(*c)
            cr.fill()
    squircle(cr, 0, 0, w, h, 7)
    cr.clip()
    if mode == "auto":
        cr.save()
        cr.rectangle(0, 0, w / 2, h)
        cr.clip()
        paint(False)
        cr.restore()
        cr.rectangle(w / 2, 0, w / 2, h)
        cr.clip()
        paint(True)
    else:
        paint(mode == "dark")
    return False


def draw_style_thumb(cr, w, h, style):
    """Estilo de ícones: o mesmo ícone de clima Default/Dark/Clear/Tinted."""
    cols = {"default": ((0.18, 0.55, 1.0), (0.02, 0.38, 0.92)), "dark": ((0.15, 0.15, 0.16), (0.08, 0.08, 0.09)),
            "clear": ((0.55, 0.57, 0.62), (0.40, 0.42, 0.47)), "tinted": ((0.90, 0.93, 0.98), (0.80, 0.85, 0.94))}
    a, b = cols[style]
    squircle(cr, 0, 0, w, h, w * 0.235)
    g = __import__("cairo").LinearGradient(0, 0, 0, h)
    g.add_color_stop_rgb(0, *a)
    g.add_color_stop_rgb(1, *b)
    cr.set_source(g)
    cr.fill()
    cr.arc(w * 0.62, h * 0.38, w * 0.14, 0, 6.3)
    cr.set_source_rgb(1.0, 0.80, 0.15) if style in ("default", "dark") else cr.set_source_rgba(1, 1, 1, 0.9)
    cr.fill()
    for cx, cy, r in ((0.40, 0.60, 0.17), (0.56, 0.58, 0.20), (0.70, 0.64, 0.14)):
        cr.arc(w * cx, h * cy, w * r, 0, 6.3)
    cr.set_source_rgba(1, 1, 1, 0.95 if style != "tinted" else 0.75)
    cr.fill()
    return False


