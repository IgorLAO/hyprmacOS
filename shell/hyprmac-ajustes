    def _browser_popup(self):
        """Navegador padrão (ui_0192: ícone + nome num pop-up); escolher muda de verdade
        (xdg-settings)."""
        cur = run("xdg-settings get default-web-browser 2>/dev/null").strip()
        apps = {}
        for info in Gio.AppInfo.get_all_for_type("x-scheme-handler/https"):
            if isinstance(info, Gio.DesktopAppInfo) and info.should_show():
                apps[info.get_id()] = info
        if cur and cur not in apps:
            info = Gio.DesktopAppInfo.new(cur)
            if info:
                apps[cur] = info
        opts = sorted(((k, i.get_name()) for k, i in apps.items()), key=lambda t: t[1].lower())
        btn = popup_button(opts or [("", "—")], cur, lambda v: spawn(
            f"xdg-settings set default-web-browser {GLib.shell_quote(v)}"))
        info = apps.get(cur)
        if info and info.get_icon():
            img = Gtk.Image.new_from_gicon(info.get_icon(), Gtk.IconSize.MENU)
            img.set_pixel_size(16)
            box = btn.get_child()
            box.pack_start(img, False, False, 0)
            box.reorder_child(img, 0)
        return btn

