    def _filter(self):
        q = search_text(self.search.get_text().strip())
        words = q.split()
        if not hasattr(self, "search_index"):
            records = settings_search_index(include_targets=True)
            self.search_index = list(dict.fromkeys((k, t) for k, t, _target in records))
            self.search_targets = {(k, t): target for k, t, target in records}
        matches = [(k, t) for k, t in self.search_index
                   if all(w in search_text(TITLES[k] + " " + t) for w in words)] if q else []
        if q:
            for entry in SIDEBAR:
                if entry and all(w in search_text(entry[1] + " " + entry[4]) for w in words):
                    matches.insert(0, (entry[0], entry[1]))
        keys = {k for k, _t in matches}
        for r in self.side_list.get_children():
            r.set_visible(not q or r.key in keys or
                          all(w in search_text(r.search) for w in words))
        self.side_list.invalidate_headers()
        if q:
            self._show("Search", lambda: self._search_results(matches))
        elif hasattr(self, "current"):
            self._restore_history()

    def _search_results(self, matches):
        form = Form()
        self.search_matches = matches
        for key, title in matches:
            form.add_row(row(title, sub=TITLES[key],
                             on_click=lambda k=key, t=title: self._search_open(k, t)))
        if not matches:
            form.add_row(row("No matching options", sub="Try a panel name or an option such as Folder color."))
        return [form.outer]

    def _search_open(self, key, title):
        self.search.set_text("")
        self.open_pane(key)
        target = getattr(self, "search_targets", {}).get((key, title))
        if target:
            # Open the actual subpage before scrolling to the matching option.
            self.push(SETTINGS_SUBPAGE_TITLES.get(target, TITLES[key]), getattr(self, target))
        def reveal():
            sc = self.stack.get_visible_child()
            def visit(widget):
                if isinstance(widget, Gtk.Label) and widget.get_text() == title:
                    pos = widget.translate_coordinates(sc.get_child(), 0, 0)
                    if pos:
                        adj = sc.get_vadjustment()
                        adj.set_value(max(adj.get_lower(), min(pos[1] - 20,
                                      adj.get_upper() - adj.get_page_size())))
                    return True
                if isinstance(widget, Gtk.Container):
                    return any(visit(child) for child in widget.get_children())
                return False
            visit(sc)
            return False
        GLib.timeout_add(350, reveal)

    def _search_go(self):
        matches = getattr(self, "search_matches", [])
        if self.search.get_text() and matches:
            self._search_open(*matches[0])
            return
        for r in self.side_list.get_children():
            if r.get_visible():
                self.side_list.select_row(r)
                return

