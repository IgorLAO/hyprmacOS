def screen_aspect():
    """Proporção do monitor principal (a prévia do papel de parede segue a tela, como no Mac)."""
    try:
        disp = Gdk.Display.get_default()
        m = disp.get_primary_monitor() or disp.get_monitor(0)
        g = m.get_geometry()
        return g.width / g.height if g.height else 16 / 9
    except Exception:
        return 16 / 9


def remove_class(w, *classes):
    ctx = w.get_style_context()
    for c in classes:
        ctx.remove_class(c)


def add_class(w, *classes):
    for c in classes:
        w.get_style_context().add_class(c)
    return w


def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def squircle(cr, x, y, w, h, r):
    """Retângulo de cantos contínuos (aproximação do squircle da Apple)."""
    k = 0.62
    cr.new_sub_path()
    cr.move_to(x + r, y)
    cr.line_to(x + w - r, y)
    cr.curve_to(x + w - r * (1 - k), y, x + w, y + r * (1 - k), x + w, y + r)
    cr.line_to(x + w, y + h - r)
    cr.curve_to(x + w, y + h - r * (1 - k), x + w - r * (1 - k), y + h, x + w - r, y + h)
    cr.line_to(x + r, y + h)
    cr.curve_to(x + r * (1 - k), y + h, x, y + h - r * (1 - k), x, y + h - r)
    cr.line_to(x, y + r)
    cr.curve_to(x, y + r * (1 - k), x + r * (1 - k), y, x + r, y)
    cr.close_path()


def glyph_of(code):
    """Código da Nerd Font ("f035c") → glifo; nomes de ícones desenhados ("toggles") passam."""
    return G(code) if re.fullmatch(r"f[0-9a-f]{3,4}", code) else code


class AppIcon(Gtk.DrawingArea):
    """Ícone dos Ajustes: quadrado de cantos contínuos com degradê da cor (mais clara
    em cima) e o símbolo branco no meio — como os do Tahoe."""

    def __init__(self, glyph, color, size=ICON, fg="#FFFFFF"):
        super().__init__()
        self.glyph, self.color, self.size, self.fg = glyph, color, size, fg
        self.set_size_request(size, size)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self._draw)

    def _draw(self, _w, cr):
        s = self.size
        r, g, b = hex_rgb(self.color)
        squircle(cr, 0, 0, s, s, s * 0.235)
        grad = __import__("cairo").LinearGradient(0, 0, 0, s)
        lift = lambda c: min(1.0, c + 0.10)
        grad.add_color_stop_rgb(0, lift(r), lift(g), lift(b))
        grad.add_color_stop_rgb(1, r, g, b)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.14)       # aro claro de 0,5
        cr.set_line_width(0.6)
        cr.stroke()
        if self.glyph == "toggles":
            # Menu Bar (video/frames-ui/ui_0002): dois interruptores brancos — o de cima em
            # contorno com o botão à esquerda, o de baixo cheio com o botão (cinza) à direita
            cr.set_source_rgb(*hex_rgb(self.fg))
            w_, h_ = s * 0.62, s * 0.24
            x_ = (s - w_) / 2
            for i, y_ in enumerate((s * 0.22, s * 0.54)):
                rr = h_ / 2
                cr.new_sub_path()
                cr.arc(x_ + w_ - rr, y_ + rr, rr, -math.pi / 2, math.pi / 2)
                cr.arc(x_ + rr, y_ + rr, rr, math.pi / 2, 3 * math.pi / 2)
                cr.close_path()
                if i == 0:
                    cr.set_line_width(max(1.0, s * 0.055))
                    cr.stroke()
                    cr.arc(x_ + rr, y_ + rr, rr * 0.62, 0, 2 * math.pi)
                    cr.fill()
                else:
                    cr.fill()
                    cr.set_source_rgb(r, g, b)
                    cr.arc(x_ + w_ - rr, y_ + rr, rr * 0.62, 0, 2 * math.pi)
                    cr.fill()
            return False
        layout = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription.from_string("Symbols Nerd Font")
        fd.set_absolute_size(s * 0.66 * Pango.SCALE)
        layout.set_font_description(fd)
        layout.set_text(self.glyph, -1)
        _ink, logical = layout.get_pixel_extents()
        cr.move_to((s - logical.width) / 2 - logical.x, (s - logical.height) / 2 - logical.y)
        cr.set_source_rgb(*hex_rgb(self.fg))
        PangoCairo.show_layout(cr, layout)
        return False


class Avatar(Gtk.DrawingArea):
    """Foto da conta (~/.face ou a do AccountsService) ou as iniciais num círculo."""

    def __init__(self, size, name):
        super().__init__()
        self.size, self.name = size, name
        self.set_size_request(size, size)
        self.set_valign(Gtk.Align.CENTER)
        self.pb = None
        user = getpass.getuser()
        for p in (os.path.expanduser("~/.face"), f"/var/lib/AccountsService/icons/{user}"):
            try:
                self.pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, size * 2, size * 2, True)
                break
            except Exception:
                pass
        self.connect("draw", self._draw)

    def _draw(self, _w, cr):
        import math
        s = self.size
        cr.arc(s / 2, s / 2, s / 2, 0, 2 * math.pi)
        cr.clip()
        if self.pb:
            cr.scale(s / self.pb.get_width(), s / self.pb.get_height())
            Gdk.cairo_set_source_pixbuf(cr, self.pb, 0, 0)
            cr.paint()
            return False
        grad = __import__("cairo").LinearGradient(0, 0, 0, s)
        grad.add_color_stop_rgb(0, 0.66, 0.68, 0.73)
        grad.add_color_stop_rgb(1, 0.47, 0.49, 0.54)
        cr.set_source(grad)
        cr.paint()
        initials = "".join(w[0] for w in self.name.split()[:2]).upper() or "?"
        layout = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription.from_string("SF Pro Rounded Semibold")
        fd.set_absolute_size(s * 0.40 * Pango.SCALE)
        layout.set_font_description(fd)
        layout.set_text(initials, -1)
        _i, lg = layout.get_pixel_extents()
        cr.move_to((s - lg.width) / 2 - lg.x, (s - lg.height) / 2 - lg.y)
        cr.set_source_rgb(1, 1, 1)
        PangoCairo.show_layout(cr, layout)
        return False


class StorageBar(Gtk.DrawingArea):
    """Barra de armazenamento em segmentos coloridos (iCloud, Armazenamento)."""

    def __init__(self, parts, total, height=14):
        super().__init__()
        self.parts, self.total = parts, max(total, 1)
        self.set_size_request(-1, height)
        self.connect("draw", self._draw)

    def _draw(self, w, cr):
        width, h = w.get_allocated_width(), w.get_allocated_height()
        squircle(cr, 0, 0, width, h, h / 2)
        cr.clip()
        dark = is_dark_cached()
        cr.set_source_rgba(1, 1, 1, 0.10) if dark else cr.set_source_rgba(0, 0, 0, 0.08)
        cr.paint()
        x = 0
        for _name, size, color in self.parts:
            pw = width * size / self.total
            cr.rectangle(x, 0, max(pw - 1.5, 0), h)
            cr.set_source_rgb(*hex_rgb(color))
            cr.fill()
            x += pw
        return False


