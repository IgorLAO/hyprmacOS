        hdr.pack_end(label(f"{used:.1f} GB of {total:.0f} GB used", "row-value"), False, False, 0)
        box.pack_start(hdr, False, False, 0)
        box.pack_start(StorageBar(parts, total), False, False, 0)
        f.add_row(box)
        f2 = Form()
        for t, s in (("Documents", docs), ("System Data", max(used - docs, 0))):
