                   if not unicodedata.combining(c))


SETTINGS_SUBPAGE_TITLES = {}


def settings_search_index(include_targets=False):
    """Index pane/subpage row titles without building UI or executing system commands."""
    with open(__file__, encoding="utf-8") as source:
        tree = ast.parse(source.read())
    # Preserve the same title used by ordinary navigation to each subpage.
    for node in ast.walk(tree):
        title, target = None, None
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == "push" and len(node.args) >= 2:
            title, target = node.args[:2]
        elif isinstance(node, ast.Tuple) and node.elts:
            title = node.elts[0]
            target = next((e for e in node.elts if isinstance(e, ast.Attribute) and e.attr.startswith("sub_")), None)
        if isinstance(title, ast.Constant) and isinstance(title.value, str) and isinstance(target, ast.Attribute):
            SETTINGS_SUBPAGE_TITLES[target.attr] = title.value
    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "Settings")
    methods = {n.name: n for n in cls.body if isinstance(n, ast.FunctionDef)}
    records = []

    def literal_titles(node):
        loop_values = {}
        for loop in ast.walk(node):
            if not isinstance(loop, ast.For) or not isinstance(loop.iter, (ast.Tuple, ast.List)):
                continue
            names = loop.target.elts if isinstance(loop.target, (ast.Tuple, ast.List)) else [loop.target]
            for values in loop.iter.elts:
                values = values.elts if isinstance(values, (ast.Tuple, ast.List)) else [values]
                for name, value in zip(names, values):
                    if isinstance(name, ast.Name) and isinstance(value, ast.Constant) and isinstance(value.value, str):
                        loop_values.setdefault(name.id, []).append(value.value)
        for call in ast.walk(node):
            if not isinstance(call, ast.Call) or not call.args:
                continue
            if not isinstance(call.func, ast.Name) or call.func.id not in ("row", "radios"):
                continue
            title = call.args[0]
            if isinstance(title, ast.Constant) and isinstance(title.value, str):
                yield title.value
            elif isinstance(title, ast.Name):
                yield from loop_values.get(title.id, [])

    for name, pane in methods.items():
        if not name.startswith("pane_"):
            continue
        key = name[5:].replace("_", "-")
        if key not in TITLES:
            continue
        visited = set()
        def visit(method):
            if method in visited or method not in methods:
                return
            visited.add(method)
            node = methods[method]
            for title in literal_titles(node):
                record = (key, title, method if method.startswith("sub_") else None)
                if record not in records:
                    records.append(record)
            for attr in ast.walk(node):
                if isinstance(attr, ast.Attribute) and isinstance(attr.value, ast.Name) and attr.value.id == "self":
                    if attr.attr.startswith("sub_"):
                        visit(attr.attr)
        visit(name)
    if include_targets:
        return records
    return list(dict.fromkeys((k, t) for k, t, _target in records))


