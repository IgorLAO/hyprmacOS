    # cantos ativos: ações que o hyprmac-shell sabe fazer (HotCorners), na ordem do Mac;
    # "-" (nada) fica por último, como no menu da Apple
    # menu do Tahoe (video/frames-ui/ui_0197.png): grupos separados por filete; None = filete;
    # chave None = item que o hyprmac não tem (aparece esmaecido, como manda o HIG)
    HOT_ACTIONS = [("mission-control", "Mission Control"), ("app-windows", "Application Windows"),
                   ("desktop", "Desktop"), ("notification-center", "Notification Center"), None,
                   ("apps", "Apps"), None,
                   (None, "Quick Note"), None,
                   (None, "Start Screen Saver"), (None, "Disable Screen Saver"), None,
                   ("display-sleep", "Put Display to Sleep"), None,
                   ("lock-screen", "Lock Screen"), None,
                   ("none", "–")]

    def _hot_corners_sheet(self):
        """Folha "Hot Corners…" do Tahoe (referencias/desejos/cantos-ativos-folha.png, 1,3 px/pt):
        547 de largura, grupo recuado 14 com 4 menus de 198×21 (passo 40) em volta da
        miniatura do papel de parede 87×61 (vão 7) com os cantos marcados, filete e "Done"."""
        conf = load_json(SHELL_CONF, {}).get("hot_corners") or {}
        veil = Gtk.EventBox()
        add_class(veil, "sheet-veil")
        veil.set_visible_window(True)
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        add_class(sheet, "sheet", "hc-sheet")
        sheet.set_halign(Gtk.Align.CENTER)
        sheet.set_valign(Gtk.Align.CENTER)
        sheet.set_size_request(547, -1)
        group = Gtk.Grid(column_spacing=7, row_spacing=19)
        add_class(group, "hc-group")

        def set_corner(key, v):
            d = load_json(SHELL_CONF, {})
            hc = d.get("hot_corners") if isinstance(d.get("hot_corners"), dict) else {}
            if v == "none":
                hc.pop(key, None)
            else:
                hc[key] = v
            d["hot_corners"] = hc
            save_json(SHELL_CONF, d)
            shell_cmd("hot-corners-reload")

        def menu(key):
            names = dict(a for a in self.HOT_ACTIONS if a and a[0])
            cur = conf.get(key, "none")
            btn = Gtk.Button()
            add_class(btn, "hc-popup")
            box = Gtk.Box(spacing=6)
            val = label(names.get(cur, "–"), "hc-value")
            val.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(val, True, True, 0)
            box.pack_end(label(G("f054f"), "glyph hc-arrow", 0.5), False, False, 0)
            btn.add(box)
            btn.set_size_request(198, 21)
            btn.set_valign(Gtk.Align.CENTER)

            def pick(_b):
                m = Gtk.Menu()
                for a in self.HOT_ACTIONS:
                    if a is None:
                        m.append(Gtk.SeparatorMenuItem())
                        continue
                    k, n = a
                    it = Gtk.CheckMenuItem(label=n)
                    it.set_draw_as_radio(True)
                    it.set_active(k == cur)
                    it.set_sensitive(k is not None)
                    it.connect("activate", lambda _i, k=k, n=n: (
                        val.set_text(n), set_corner(key, k)))
                    m.append(it)
                m.show_all()
                m.attach_to_widget(btn, None)
                m.popup_at_widget(btn, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)
            btn.connect("clicked", pick)
            return btn

        cur_wall = run("gsettings get org.gnome.desktop.background picture-uri-dark" if is_dark()
                       else "gsettings get org.gnome.desktop.background picture-uri").strip("'")
        cur_wall = cur_wall.replace("file://", "")
        art = Gtk.DrawingArea()
        art.set_size_request(87, 61)
        cache = {}

        def draw_art(a, cr):
            cr.save()
            draw_picture(cr, 87, 61, cur_wall, cache, 0)
            cr.restore()
            # filete escuro de 1 em volta da miniatura (ui_0197: 52,49,55), cantos retos
            cr.set_source_rgba(0.2, 0.19, 0.22, 0.9)
            cr.set_line_width(1)
            cr.rectangle(0.5, 0.5, 86, 60)
            cr.stroke()
            # cantos marcados: triângulo branco com contorno escuro fino em cada canto
            L = 8
            for (x, y, dx, dy) in ((2, 2, 1, 1), (85, 2, -1, 1), (2, 59, 1, -1), (85, 59, -1, -1)):
                cr.move_to(x, y)
                cr.line_to(x + dx * L, y)
                cr.line_to(x, y + dy * L)
                cr.close_path()
                cr.set_source_rgba(1, 1, 1, 0.95)
                cr.fill_preserve()
                cr.set_source_rgba(0, 0, 0, 0.35)
                cr.set_line_width(0.6)
                cr.stroke()
