def font_families():
    global _FAMILIES
    if _FAMILIES is None:
        _FAMILIES = {f.get_name() for f in PangoCairo.FontMap.get_default().list_families()}
    return _FAMILIES


def clock_style_family(key):
    fam = dict(CLOCK_STYLES).get(key)
    return fam if fam and fam in font_families() else None


def clock_conf():
    c = load_json(SHELL_CONF, {})
    style = c.get("lock_clock_style", "sf")
    if not clock_style_family(style):
        style = "sf"
    return {"show": c.get("lock_clock", "lock"), "style": style,
            "weight": int(c.get("lock_clock_weight", CLOCK_WEIGHT_DEFAULT))}


def set_clock_conf(key, value):
    c = load_json(SHELL_CONF, {})
    c[key] = value
    save_json(SHELL_CONF, c)


def clock_font(style, weight, size):
    d = Pango.FontDescription()
    d.set_family(clock_style_family(style) or "SF Pro")
    d.set_variations(f"wght={int(weight)}")
    d.set_weight(Pango.Weight.BOLD if weight >= 700 else Pango.Weight.SEMIBOLD
                 if weight >= 590 else Pango.Weight.MEDIUM if weight >= 500 else Pango.Weight.NORMAL)
    d.set_absolute_size(size * Pango.SCALE)
    return d


def draw_clock_text(cr, text, style, weight, size, cx, cy, rgba):
    """Texto centrado pela tinta em (cx, cy)."""
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(clock_font(style, weight, size))
    layout.set_text(text, -1)
    ink, _l = layout.get_pixel_extents()
    cr.move_to(cx - ink.width / 2 - ink.x, cy - ink.height / 2 - ink.y)
    cr.set_source_rgba(*rgba)
    PangoCairo.show_layout(cr, layout)


class ClockSample(Gtk.Button):
