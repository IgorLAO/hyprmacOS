    def draw(w, cr):
        c = w.get_style_context().get_color(w.get_state_flags())
        cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
        cx, cy = w.get_allocated_width() / 2, w.get_allocated_height() / 2
        cr.arc(cx, cy, 3.0, 0, 2 * math.pi)
        cr.fill()
        for i in range(8):
            ang = i * math.pi / 4
            if name == "sun.min":
                cr.arc(cx + math.cos(ang) * 5.6, cy + math.sin(ang) * 5.6, 1.0, 0, 2 * math.pi)
                cr.fill()
            else:
                cr.set_line_width(1.5)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.move_to(cx + math.cos(ang) * 4.7, cy + math.sin(ang) * 4.7)
                cr.line_to(cx + math.cos(ang) * 6.7, cy + math.sin(ang) * 6.7)
                cr.stroke()
        return False
    area.connect("draw", draw)
    return area


