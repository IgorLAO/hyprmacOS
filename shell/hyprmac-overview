def spaces_layout(width, height, count):
    """Miniaturas centradas, reservando espaço para o botão de adicionar."""
    top = round(height * DESK_TOP_FRAC)
    available = max(1, width - 2 * PLUS_RIGHT - PLUS - 16)
    gap = min(DESK_GAP, available / max(1, count * 4))
    dw = min(round(width * DESK_W_FRAC),
             max(1, (available - gap * max(0, count - 1)) / max(1, count)))
    dh = max(1, dw * height / max(1, width))
    total = count * dw + max(0, count - 1) * gap
    x = PLUS_RIGHT + (available - total) / 2
    rects = [(x + i * (dw + gap), top, dw, dh) for i in range(count)]
    plus = (width - PLUS_RIGHT - PLUS, top + (dh - PLUS) / 2, PLUS, PLUS)
    return rects, plus


def space_hit(x, y, rects, plus, expansion):
    """Mesmo destino para clique e arrasto; nomes também são alvos."""
    for i, (dx, dy, dw, dh) in enumerate(rects):
        label_y = lerp((BAND_COLLAPSED - LABEL_PX) / 2, dy + dh + LABEL_GAP, expansion)
        # Mantém o nome clicável enquanto ele desce na expansão.
        top = min(dy, (BAND_COLLAPSED - LABEL_PX) / 2) if expansion > 0 else label_y
        if inside(x, y, (dx, top - 6, dw, label_y + LABEL_PX + 6 - top)):
            return ("desk", i)
    if expansion > 0 and inside(x, y, plus):
        return ("plus",)
    return None


def scaled_surface(src, w, h):
    """Redimensiona uma superfície cairo (filtro GOOD = média de caixa ao reduzir)."""
    w, h = max(1, int(round(w))), max(1, int(round(h)))
    out = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(out)
    cr.scale(w / src.get_width(), h / src.get_height())
    cr.set_source_surface(src, 0, 0)
    cr.get_source().set_filter(cairo.FILTER_GOOD)
    cr.paint()
    return out


def pixbuf_surface(pb):
    return Gdk.cairo_surface_create_from_pixbuf(pb, 1, None) if pb else None


def capture(args):
    """grim → pixbuf (PPM pela saída padrão, sem arquivo temporário)."""
    try:
        data = subprocess.run(["grim", "-t", "ppm", *args, "-"], capture_output=True,
                              timeout=1.5).stdout
        if not data:
            return None
        loader = GdkPixbuf.PixbufLoader.new_with_type("pnm")
        loader.write(data)
        loader.close()
        return loader.get_pixbuf()
    except (subprocess.TimeoutExpired, OSError, GLib.Error):
        return None


def capture_scaled(args, sizes):
    """Captura e já reduz na thread (o GdkPixbuf solta o GIL): → [pixbuf por tamanho].
    Tamanho None = a captura como veio."""
    pb = capture(args)
    if pb is None:
        return None
    out = []
    for size in sizes:
        if size is None or (round(size[0]), round(size[1])) == (pb.get_width(), pb.get_height()):
            out.append(pb)
        else:
            out.append(pb.scale_simple(max(1, round(size[0])), max(1, round(size[1])),
                                       GdkPixbuf.InterpType.BILINEAR))
    return out


def pango_layout(cr, text, px, weight=Pango.Weight.MEDIUM, width=None):
    layout = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription.from_string(FONT)
    fd.set_absolute_size(px * Pango.SCALE)
    fd.set_weight(weight)
    layout.set_font_description(fd)
    layout.set_text(text, -1)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
    return layout


def show_text(cr, layout, x, y, alpha=1.0, shadow=True):
    if shadow:   # sombra discreta para ler sobre qualquer papel de parede
        cr.move_to(x, y + 1)
        cr.set_source_rgba(0, 0, 0, 0.45 * alpha)
        PangoCairo.show_layout(cr, layout)
    cr.move_to(x, y)
    cr.set_source_rgba(1, 1, 1, 0.92 * alpha)
    PangoCairo.show_layout(cr, layout)


