def app_name(cls):
    if not cls:
        return "Window"
    known = APP_NAMES.get(cls.lower())
    if known:
        return known
    base = cls.split(".")[-1] if "." in cls else cls
    return base[:1].upper() + base[1:]


def icon_pixbuf(name, size):
    if not name:
        return None
    try:
        if name.startswith("/"):
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(name, size, size, True)
        return Gtk.IconTheme.get_default().load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
    except GLib.Error:
        return None


class AppIndex:
    """Classe da janela → (nome, ícone) a partir dos .desktop instalados."""

    def __init__(self, size=64):
        self.size = size
        self.built = False
        self.cache = {}

    def _build(self):
        self.by_id, self.by_wm, self.by_exec = {}, {}, {}
        for info in Gio.AppInfo.get_all():
            if not hasattr(info, "get_startup_wm_class"):
                continue
            app_id = (info.get_id() or "").removesuffix(".desktop").lower()
            if app_id:
                self.by_id.setdefault(app_id, info)
            wm = (info.get_startup_wm_class() or "").lower()
            if wm:
                self.by_wm.setdefault(wm, info)
            args = [t for t in (info.get_commandline() or "").split() if not t.startswith("%")]
            exe = os.path.basename(info.get_executable() or "").lower()
            if exe and len(args) <= 1:
                self.by_exec.setdefault(exe, info)
        self.built = True

    def lookup(self, cls):
        c = (cls or "").lower()
        if c in self.cache:
            return self.cache[c]
        if not self.built:
            self._build()
        short = c.split(".")[-1]
        info = (self.by_id.get(c) or self.by_wm.get(c) or self.by_exec.get(c)
                or self.by_id.get(short) or self.by_wm.get(short))
        name = info.get_name() if info else app_name(cls)
        pb = None
        if info and info.get_icon():
            look = Gtk.IconTheme.get_default().lookup_by_gicon(
                info.get_icon(), self.size, Gtk.IconLookupFlags.FORCE_SIZE)
            try:
                pb = look.load_icon() if look else None
            except GLib.Error:
                pb = None
        pb = pb or icon_pixbuf(c, self.size) or icon_pixbuf("application-x-executable", self.size)
        self.cache[c] = (name, pixbuf_surface(pb))
        return self.cache[c]


# ───────────────────────────── papel de parede ─────────────────────────────

class WallpaperCache:
    """Papel de parede (mesma origem do hyprmac-shell: caminho ou "gnome") em três
    versões por tamanho de tela: nítida, desfocada+escurecida e miniatura das mesas.

    Papéis de parede enormes (o atual tem 30000×21059) levam segundos para decodificar,
    então a versão no tamanho da tela é gerada em segundo plano (vipsthumbnail, se
    houver) e guardada em ~/.cache/hyprmac/overview/. Até ficar pronta, fundo neutro."""

    DIR = os.path.expanduser("~/.cache/hyprmac/overview")

    def __init__(self):
        self.ready = {}            # (chave, w, h) → pixbuf w×h
        self.sizes = {}
        self.pending = set()
        try:
            bg = Gio.Settings.new("org.gnome.desktop.background")
            iface = Gio.Settings.new("org.gnome.desktop.interface")
            self._keep = (bg, iface)
            for st, key in ((bg, "picture-uri"), (bg, "picture-uri-dark"),
                            (iface, "color-scheme")):
                st.connect(f"changed::{key}", lambda *_: self.prefetch())
        except Exception:
            pass
        self.wanted = set()

    @staticmethod
    def _path():
        cfg = load_config()
        if str(cfg.get("wallpaper")).lower() != "gnome":
            return os.path.expanduser(cfg.get("wallpaper") or DEFAULT_WALLPAPER)
        try:
            bg = Gio.Settings.new("org.gnome.desktop.background")
            dark = Gio.Settings.new("org.gnome.desktop.interface").get_string(
                "color-scheme") == "prefer-dark"
            uri = bg.get_string("picture-uri-dark" if dark else "picture-uri") \
                or bg.get_string("picture-uri")
            path = Gio.File.new_for_uri(uri).get_path() if uri else None
            if path and path.endswith(".xml"):
                import xml.etree.ElementTree as ET
                node = ET.parse(path).getroot().find(".//file")
                path = node.text.strip() if node is not None and node.text else None
            return path or DEFAULT_WALLPAPER
        except Exception:
            return DEFAULT_WALLPAPER

    @staticmethod
    def _key():
        path = WallpaperCache._path()
        try:
            return path, int(os.path.getmtime(path))
        except OSError:
            return DEFAULT_WALLPAPER, 0

    def _file(self, key, w, h):
        import hashlib
        tag = hashlib.sha1(f"{key[0]}|{key[1]}".encode()).hexdigest()[:16]
        return os.path.join(self.DIR, f"wall-{tag}-{w}x{h}.png")

    @staticmethod
    def _cover(pb, w, h):
        pw, ph = pb.get_width(), pb.get_height()
        s = max(w / pw, h / ph)
        sw, sh = max(w, round(pw * s)), max(h, round(ph * s))
        scaled = pb.scale_simple(sw, sh, GdkPixbuf.InterpType.HYPER)
        return scaled.new_subpixbuf((sw - w) // 2, (sh - h) // 2, w, h)

    def _render(self, key, w, h):
        """(thread) gera o PNG w×h no cache em disco e devolve o pixbuf."""
        out = self._file(key, w, h)
        if not os.path.exists(out):
            os.makedirs(self.DIR, exist_ok=True)
            tmp = out + ".tmp.png"
            pb = None
            if subprocess.run(["sh", "-c", "command -v vipsthumbnail"],
                              capture_output=True).returncode == 0:
                subprocess.run(["vipsthumbnail", key[0], "-s", f"{w}x{h}", "--smartcrop",
                                "centre", "-o", tmp], capture_output=True, timeout=60)
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file(tmp)
                except GLib.Error:
                    pb = None
            if pb is None or (pb.get_width(), pb.get_height()) != (w, h):
                _fmt, pw, ph = GdkPixbuf.Pixbuf.get_file_info(key[0])
                s = min(1.0, max(w / pw, h / ph))
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    key[0], math.ceil(pw * s) + 1, math.ceil(ph * s) + 1, True)
                pb = self._cover(pb, w, h)
            pb.savev(tmp, "png", ["compression"], ["1"])
            os.replace(tmp, out)
        return GdkPixbuf.Pixbuf.new_from_file(out)

    def prefetch(self, sizes=None):
        """Prepara (em segundo plano) o papel de parede atual nos tamanhos de tela."""
        if sizes:
            self.wanted |= set(sizes)
        key = self._key()
        for w, h in self.wanted:
            k = (key, w, h)
            if k in self.ready or k in self.pending:
                continue
            if os.path.exists(self._file(key, w, h)):
                try:
                    self.ready[k] = GdkPixbuf.Pixbuf.new_from_file(self._file(key, w, h))
                    continue
                except GLib.Error:
                    pass
            self.pending.add(k)

            def work(k=k):
                try:
                    pb = self._render(*k)
                except Exception as e:  # imagem ilegível: fica o fundo neutro
                    print("papel de parede:", e, file=sys.stderr)
                    pb = None
                GLib.idle_add(lambda: self._done(k, pb))
            import threading
            threading.Thread(target=work, daemon=True).start()

    def _done(self, k, pb):
        self.pending.discard(k)
        if pb is not None:
            self.ready[k] = pb
        return False

    def get(self, w, h, dw, dh):
        """→ (nítida, final [desfocada+escurecida], miniatura dw×dh)."""
        key = self._key()
        self.wanted.add((w, h))
        pb = self.ready.get((key, w, h))
        if pb is None:
            self.prefetch()
            if pb is None and os.path.exists(self._file(key, w, h)):
                pb = self.ready[(key, w, h)] = GdkPixbuf.Pixbuf.new_from_file(self._file(key, w, h))
        k = (key, w, h, dw, dh) if pb is not None else ("neutro", w, h, dw, dh)
        if k not in self.sizes:
            if pb is None:   # ainda gerando: fundo escuro neutro (não fica em cache)
                pb = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h)
                pb.fill(0x1c1c22ff)
            small = pb.scale_simple(max(1, w // (BLUR * 2)), max(1, h // (BLUR * 2)),
                                    GdkPixbuf.InterpType.HYPER)
            mid = small.scale_simple(max(1, w // 2), max(1, h // 2), GdkPixbuf.InterpType.BILINEAR)
            blur_pb = mid.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
            sharp = pixbuf_surface(pb)
            final = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
            cr = cairo.Context(final)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
            Gdk.cairo_set_source_pixbuf(cr, blur_pb, 0, 0)
            cr.paint_with_alpha(0.85)
            cr.set_source_rgba(0, 0, 0, DIM)
            cr.paint()
            thumb = pixbuf_surface(pb.scale_simple(dw, dh, GdkPixbuf.InterpType.HYPER))
            self.sizes = {kk: v for kk, v in self.sizes.items() if kk[0] == key}
            self.sizes[k] = (sharp, final, thumb)
        return self.sizes[k]


# ───────────────────────────── modelo ─────────────────────────────

class Win:
    """Uma janela da mesa atual de um monitor."""

    def __init__(self, c, mon, apps):
        self.addr = c["address"]
        self.sid = c.get("stableId")
        self.cls = c.get("class") or c.get("initialClass") or ""
        self.title = c.get("title") or ""
        self.name, self.icon = apps.lookup(self.cls)
        x, y = c["at"]
        w, h = c["size"]
        self.real = (x - mon["x"], y - mon["y"], w, h)
        self.grid = self.real
        self.prev = None           # retângulo anterior (reorganização animada)
        self.pbs = None            # capturas já reduzidas (grade, grande)
        self.small = None          # superfície no tamanho da grade
        self.big = None            # superfície maior, para o começo do voo
        self.hidden = c["workspace"]["name"].startswith("special")   # oculta (App Exposé)


class Desk:
    def __init__(self, wid, name, current, extra):
        self.id, self.name, self.current, self.extra = wid, name, current, extra
        self.items = []            # [(superfície ou None, ícone, retângulo real)] de baixo p/ cima
        self.thumb = None
        self.rect = (0, 0, 0, 0)


