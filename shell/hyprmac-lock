# ───────────────────────────── PAM (ctypes) ─────────────────────────────

PAM_SUCCESS = 0
PAM_BUF_ERR = 5
PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON, PAM_ERROR_MSG, PAM_TEXT_INFO = 1, 2, 3, 4
PAM_REFRESH_CRED = 0x0010


class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]


PAM_CONV_FUNC = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int,
                                 ctypes.POINTER(ctypes.POINTER(PamMessage)),
                                 ctypes.POINTER(ctypes.POINTER(PamResponse)),
                                 ctypes.c_void_p)


class PamConv(ctypes.Structure):
    _fields_ = [("conv", PAM_CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]


class Pam:
    """Autenticação via libpam (sem depender do módulo python-pam)."""

    def __init__(self):
        self.lib = ctypes.CDLL(ctypes.util.find_library("pam") or "libpam.so.0")
        self.libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6")
        self.libc.calloc.restype = ctypes.c_void_p
        self.libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
        self.libc.strdup.restype = ctypes.c_void_p
        self.libc.strdup.argtypes = [ctypes.c_char_p]
        L = self.lib
        L.pam_start.restype = ctypes.c_int
        L.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(PamConv),
                                ctypes.POINTER(ctypes.c_void_p)]
        for fn in ("pam_authenticate", "pam_setcred"):
            getattr(L, fn).restype = ctypes.c_int
            getattr(L, fn).argtypes = [ctypes.c_void_p, ctypes.c_int]
        L.pam_end.restype = ctypes.c_int
        L.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
        L.pam_strerror.restype = ctypes.c_char_p
        L.pam_strerror.argtypes = [ctypes.c_void_p, ctypes.c_int]

    def can_start(self, service, user):
        """Confere se o serviço abre (antes de travar a tela — segurança)."""
        conv = PamConv(PAM_CONV_FUNC(lambda *a: PAM_BUF_ERR), None)
        h = ctypes.c_void_p()
        rc = self.lib.pam_start(service.encode(), user.encode(), ctypes.byref(conv), ctypes.byref(h))
        if rc == PAM_SUCCESS:
            self.lib.pam_end(h, rc)
        return rc == PAM_SUCCESS

    def authenticate(self, service, user, password):
        """→ (ok, texto_do_erro, [mensagens do PAM])"""
        pw, usr = password.encode(), user.encode()
        messages = []
        libc = self.libc

        def conv_cb(n, msgs, resp_out, _data):
            arr = libc.calloc(n, ctypes.sizeof(PamResponse))
            if not arr:
                return PAM_BUF_ERR
            resps = ctypes.cast(arr, ctypes.POINTER(PamResponse))
            for i in range(n):
                m = msgs[i].contents
                text = (m.msg or b"").decode(errors="replace").strip()
                if m.msg_style == PAM_PROMPT_ECHO_OFF:
                    resps[i].resp = libc.strdup(pw)
                elif m.msg_style == PAM_PROMPT_ECHO_ON:
                    resps[i].resp = libc.strdup(usr)
                elif text:
                    messages.append(text)
            resp_out[0] = resps
            return PAM_SUCCESS

        cb = PAM_CONV_FUNC(conv_cb)     # referência viva enquanto o PAM roda
        conv = PamConv(cb, None)
        h = ctypes.c_void_p()
        rc = self.lib.pam_start(service.encode(), usr, ctypes.byref(conv), ctypes.byref(h))
        if rc != PAM_SUCCESS:
            return False, f"pam_start: {rc}", messages
        rc = self.lib.pam_authenticate(h, 0)
        err = (self.lib.pam_strerror(h, rc) or b"").decode(errors="replace")
        if rc == PAM_SUCCESS:
            self.lib.pam_setcred(h, PAM_REFRESH_CRED)   # renova credenciais (ex.: kerberos)
        self.lib.pam_end(h, rc)
        return rc == PAM_SUCCESS, err, messages


def default_service():
    if ARGS.service:
        return ARGS.service
    return "hyprmac-lock" if os.path.exists("/etc/pam.d/hyprmac-lock") else "login"


USER = pwd.getpwuid(os.getuid()).pw_name


def faillock_count(user):
    """Número de falhas registradas pelo pam_faillock (Arch: 3 falhas = 10 min bloqueado)."""
    try:
        out = subprocess.run(["faillock", "--user", user], capture_output=True, text=True,
                             timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return sum(1 for ln in out.splitlines() if ln[:4].isdigit())


def test_auth():
    service = default_service()
    pam = Pam()
    print(f"serviço PAM: {service}  usuário: {USER}")
    if not pam.can_start(service, USER):
        print("FALHA: pam_start não abriu o serviço")
        return 2
    before = faillock_count(USER)
    wrong = "hyprmac-wrong-" + secrets.token_hex(8)
    t0 = time.monotonic()
    ok, err, msgs = pam.authenticate(service, USER, wrong)
    dt = time.monotonic() - t0
    print(f"senha errada → {'ACEITA (ERRO!)' if ok else 'recusada'}  ({err}; {dt:.1f}s)")
    for m in msgs:
        print("  PAM:", m)
    after = faillock_count(USER)
    if before == 0 and after and after > 0:
        # desfaz só a falha que este teste criou (para não somar no limite do faillock)
        subprocess.run(["faillock", "--user", USER, "--reset"], capture_output=True)
        print(f"faillock: {after} falha(s) registrada(s) pelo teste → zerado")
    elif after is not None:
        print(f"faillock: {before} → {after} falha(s)")
    return 1 if ok else 0


if ARGS.test_auth:
    sys.exit(test_auth())


