CLOCK_FAMILIES = {"sf": "SF Pro", "rounded": "SF Pro Rounded", "serif": "New York"}


def clock_conf():
    """Relógio grande: ~/.config/hyprmac/config.json (lock_clock, lock_clock_style,
    lock_clock_weight), gravado pelos Ajustes. Estilo sem fonte instalada → SF Pro."""
    try:
        c = json.load(open(CONFIG_PATH))
    except (OSError, ValueError):
        c = {}
    fam = CLOCK_FAMILIES.get(c.get("lock_clock_style", "sf"), "SF Pro")
    fams = {f.get_name() for f in PangoCairo.FontMap.get_default().list_families()}
    if fam not in fams:
        fam = "SF Pro"
    try:
        weight = max(100, min(900, int(c.get("lock_clock_weight", M["clock_weight"]))))
    except (TypeError, ValueError):
        weight = M["clock_weight"]
    return {"show": c.get("lock_clock", "lock"), "family": fam, "weight": weight}


def run(cmd, timeout=2):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def resolve_wallpaper():
    """Mesma lógica do hyprmac-shell: caminho do config.json, ou "gnome" para seguir
    org.gnome.desktop.background (picture-uri-dark se o esquema for escuro)."""
    if ARGS.wallpaper:
        return os.path.expanduser(ARGS.wallpaper)
    wp = str(CFG.get("wallpaper", DEFAULT_WALLPAPER))
    if wp.lower() != "gnome":
        return os.path.expanduser(wp)
    try:
        src = Gio.SettingsSchemaSource.get_default()
        if not src or not src.lookup("org.gnome.desktop.background", True):
            return DEFAULT_WALLPAPER
        bg = Gio.Settings.new("org.gnome.desktop.background")
        dark = Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme") == "prefer-dark"
        uri = bg.get_string("picture-uri-dark" if dark else "picture-uri") or bg.get_string("picture-uri")
        path = Gio.File.new_for_uri(uri).get_path() if uri else None
        if path and path.endswith(".xml"):
            import xml.etree.ElementTree as ET
            node = ET.parse(path).getroot().find(".//file")
            path = node.text.strip() if node is not None and node.text else None
        return path or DEFAULT_WALLPAPER
    except Exception:  # noqa: BLE001 — fundo nunca pode impedir o bloqueio
        return DEFAULT_WALLPAPER


def load_cover(path, w, h):
    """Carrega a imagem já no tamanho que cobre w×h (rápido mesmo com imagens enormes)."""
    for p in (path, DEFAULT_WALLPAPER):
        try:
            _fmt, pw, ph = GdkPixbuf.Pixbuf.get_file_info(p)
            if not pw:
                continue
            k = max(w / pw, h / ph)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, max(1, round(pw * k)),
                                                         max(1, round(ph * k)), False)
            x, y = (pb.get_width() - w) // 2, (pb.get_height() - h) // 2
            return pb.new_subpixbuf(max(0, x), max(0, y), min(w, pb.get_width()),
                                    min(h, pb.get_height())).copy()
        except (GLib.Error, TypeError):
            continue
    return None


def cache_path(path, w, h):
    """~/.cache/hyprmac/lock/<hash>-WxH.jpg — papel de parede já recortado no tamanho."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    import hashlib
    key = hashlib.sha1(f"{os.path.realpath(path)}|{st.st_mtime_ns}|{st.st_size}".encode()).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"{key}-{w}x{h}.jpg")


def cached_cover(path, w, h):
    pb = load_cover(path, w, h)
    out = cache_path(path, w, h)
    if pb is not None and out and pb.get_width() == w and pb.get_height() == h:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = out + ".tmp"
            pb.savev(tmp, "jpeg", ["quality"], ["94"])
            os.replace(tmp, out)
        except (OSError, GLib.Error) as e:
            print("cache do papel de parede:", e, file=sys.stderr)
    return pb


def make_surfaces(pb, w, h):
    """→ (fundo levemente desfocado, fundo bem desfocado p/ a refração, luminância 0–1
    da faixa do relógio — o véu do vidro se adapta: mais claro sobre fundo escuro)."""
    light = blurred(pb, 6) if pb is not None else None       # "desfocado levemente"
    strong = blurred(pb, 28) if pb is not None else None     # o que o vidro refrata
    lum = 0.5
    if pb is not None:
        sub = pb.new_subpixbuf(int(w * 0.3), int(h * 0.12), int(w * 0.4), int(h * 0.18))
        px = sub.scale_simple(1, 1, GdkPixbuf.InterpType.HYPER).get_pixels()
        lum = (0.2126 * px[0] + 0.7152 * px[1] + 0.0722 * px[2]) / 255
    return to_surface(light, w, h), to_surface(strong, w, h), lum


def warm_cache():
    """Prepara o cache para todos os monitores (rodar no início da sessão)."""
    path = resolve_wallpaper()
    try:
        mons = json.loads(run(["hyprctl", "monitors", "-j"]) or "[]")
    except ValueError:
        mons = []
    sizes = {(round(m["width"] / m.get("scale", 1)), round(m["height"] / m.get("scale", 1)))
             for m in mons if m.get("transform", 0) % 2 == 0} | \
            {(round(m["height"] / m.get("scale", 1)), round(m["width"] / m.get("scale", 1)))
             for m in mons if m.get("transform", 0) % 2 == 1}
    for w, h in sorted(sizes):
        cp = cache_path(path, w, h)
        if cp and os.path.exists(cp):
            print(f"{w}x{h}: já em cache")
            continue
        t0 = time.monotonic()
        cached_cover(path, w, h)
        print(f"{w}x{h}: {cp} ({time.monotonic() - t0:.1f}s)")
    return 0


def blurred(pb, factor):
    """Desfoque barato: reduz (média de área) e amplia de novo, em duas etapas."""
    w, h = pb.get_width(), pb.get_height()
    small = pb.scale_simple(max(1, w // factor), max(1, h // factor), GdkPixbuf.InterpType.HYPER)
    mid = small.scale_simple(max(1, w // 2), max(1, h // 2), GdkPixbuf.InterpType.BILINEAR)
    return mid.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)


def to_surface(pb, w, h):
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0.1, 0.12, 0.18)
    cr.paint()
    if pb is not None:
        Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
        cr.paint()
    return surf


def user_info():
    if ARGS.demo:
        return "Erica Souza", None
    pw = pwd.getpwuid(os.getuid())
    name = (pw.pw_gecos or "").split(",")[0].strip()
    if not name:
        name = pw.pw_name[:1].upper() + pw.pw_name[1:]
    avatar = None
    for p in (os.path.expanduser("~/.face"), os.path.expanduser("~/.face.icon"),
              f"/var/lib/AccountsService/icons/{pw.pw_name}"):
        if os.path.isfile(p) and os.access(p, os.R_OK):
            avatar = p
            break
    return name, avatar


def keyboard_layout():
    if ARGS.demo:
        return "U.S."
    try:
        kbs = json.loads(run(["hyprctl", "devices", "-j"]) or "{}").get("keyboards", [])
    except ValueError:
        return ""
    kb = next((k for k in kbs if k.get("main")), kbs[0] if kbs else None)
    km = (kb or {}).get("active_keymap", "")
    # "English (US)" → "US", "Portuguese (Brazil)" → "Brazil" (o macOS mostra "U.S.", "Brazilian")
    if "(" in km and km.endswith(")"):
        km = km[km.index("(") + 1:-1]
    return {"US": "U.S."}.get(km, km)       # "U.S." como na foto oficial


def battery():
    if ARGS.demo:
        return 100, "Full"
    base = "/sys/class/power_supply"
    try:
        names = sorted(n for n in os.listdir(base) if n.startswith("BAT"))
    except OSError:
        return None
    for n in names:
        try:
            cap = int(open(f"{base}/{n}/capacity").read().strip())
            status = open(f"{base}/{n}/status").read().strip()
            return cap, status
        except (OSError, ValueError):
            continue
    return None


