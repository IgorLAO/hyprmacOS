def font(size, weight=600, family="SF Pro"):
    """SF Pro é variável: o peso vai como eixo "wght" (aceita 650, entre Semibold e Bold) e o
    tamanho óptico como "opsz" (17 = Text … 28 = Display), que o macOS segue pelo tamanho."""
    d = Pango.FontDescription()
    d.set_family(family)
    d.set_weight(Pango.Weight.BOLD if weight >= 700 else Pango.Weight.SEMIBOLD
                 if weight >= 590 else Pango.Weight.MEDIUM if weight >= 500 else Pango.Weight.NORMAL)
    d.set_variations(f"wght={weight},opsz={min(28, max(17, round(size)))}")
    d.set_absolute_size(size * Pango.SCALE)
    return d


def text_path(cr, text, desc, cx, top, track=0.0):
    """Caminho do texto centrado em cx, com o topo da TINTA (não da caixa) em `top`;
    `track` = espaçamento entre letras em pt."""
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(desc)
    layout.set_text(text, -1)
    if track:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_letter_spacing_new(round(track * Pango.SCALE)))
        layout.set_attributes(attrs)
    ink, _logical = layout.get_pixel_extents()
    x = cx - ink.width / 2 - ink.x
    y = top - ink.y
    cr.move_to(x, y)
    PangoCairo.layout_path(cr, layout)
    path = cr.copy_path()
    cr.new_path()
    return path, (cx - ink.width / 2, top, ink.width, ink.height)


def draw_glass_text(cr, path, box, bg_strong, s, lum=0.5):
    """Texto de vidro (estilo do kit "Lock Screen Time": #F8F8F8/0.25 luminosity +
    #1A1A1A plus-lighter, vidro raio 3, saturação 1.4, distorção 0.2, aros claros)."""
    x, y, w, h = box
    cx, cy = x + w / 2, y + h / 2
    # 1) sombra difusa bem leve (#000/0.02 0 8 15 no kit) — halos sobrepostos
    cr.save()
    cr.translate(0, 6 * s)
    for lw, a in ((26, 0.012), (16, 0.016), (8, 0.022)):
        cr.append_path(path)
        cr.set_line_width(lw * s)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.set_source_rgba(0, 0, 0, a)
        cr.stroke()
    cr.restore()

    cr.save()
    cr.append_path(path)
    cr.clip()
    # 2) refração: o fundo (mais desfocado) ampliado ~5% a partir do centro do relógio
    cr.save()
    cr.translate(cx, cy)
    cr.scale(1.05, 1.05)
    cr.translate(-cx, -cy)
    cr.set_source_surface(bg_strong, 0, 0)
    cr.paint()
    cr.restore()
    # 3) preenchimento claro (luminosity + plus-lighter ≈ véu branco translúcido)
    cr.set_source_rgba(0.973, 0.973, 0.973, max(0.36, min(0.64, 0.66 - 0.32 * lum)))
    cr.paint()
    cr.set_operator(cairo.OPERATOR_ADD)          # "plus-lighter" #1A1A1A
    cr.set_source_rgba(0.08, 0.08, 0.08, 1)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_OVER)
    g = cairo.LinearGradient(0, y, 0, y + h)
    g.add_color_stop_rgba(0.0, 1, 1, 1, 0.22)
    g.add_color_stop_rgba(0.55, 1, 1, 1, 0.04)
    g.add_color_stop_rgba(1.0, 1, 1, 1, 0.12)
    cr.set_source(g)
    cr.paint()
    # 4) aro interno claro em volta (realce especular), mais forte em cima.
    #    Feito por "texto menos texto deslocado" (e não com stroke), porque a SF Pro
    #    variável tem contornos sobrepostos e o stroke desenharia as emendas internas.
    rim(cr, path, 1.6 * s, 0.55, dirs=8)
    rim(cr, path, 2.4 * s, 0.40, dirs=((0, 1),))
    cr.restore()
    # 6) filete externo (#D9D9D9 0.5 no kit)
    cr.push_group()
    for dx, dy in circle_dirs(8):
        cr.save()
        cr.translate(dx * 0.9 * s, dy * 0.9 * s)
        cr.append_path(path)
        cr.restore()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.fill()
    cr.set_operator(cairo.OPERATOR_DEST_OUT)
    cr.append_path(path)
    cr.fill()
    cr.pop_group_to_source()
    cr.paint_with_alpha(0.28)


def circle_dirs(n):
    return [(math.cos(2 * math.pi * i / n), math.sin(2 * math.pi * i / n)) for i in range(n)]


def rim(cr, path, width, alpha, dirs=8):
    """Faixa interna junto à borda: (texto) − (texto deslocado), na direção `dirs`."""
    cr.push_group()
    for dx, dy in (circle_dirs(dirs) if isinstance(dirs, int) else dirs):
        cr.push_group()
        cr.append_path(path)
        cr.set_source_rgba(1, 1, 1, 1)
        cr.fill()
        cr.set_operator(cairo.OPERATOR_DEST_OUT)
        cr.save()
        cr.translate(dx * width, dy * width)
        cr.append_path(path)
        cr.restore()
        cr.fill()
        cr.pop_group_to_source()
        cr.paint()
    cr.pop_group_to_source()
    cr.paint_with_alpha(alpha)


BACKDROP_VEIL = 0.06     # véu mínimo para o branco ler bem sobre fundos claros
DATE_ADD = (100 / 255,) * 3   # data: plus-lighter #646464


class Backdrop:
    """Fundo + data + relógio de um monitor (tudo em cairo, para o vidro poder
    "enxergar" o papel de parede que está atrás dele)."""

    def __init__(self, wallpaper_path, on_ready=None):
        self.path = wallpaper_path
        self.on_ready = on_ready
        self.surfaces = {}
        self.loading = set()
        self.area = Gtk.DrawingArea()
        self.area.set_hexpand(True)
        self.area.set_vexpand(True)
        self.area.set_draw_func(self._draw)

    def _surfaces(self, w, h):
        """Fundo pronto, ou None enquanto carrega numa thread (imagens enormes levam
        segundos; a tela de bloqueio tem de aparecer na hora)."""
        key = (w, h)
        if key in self.surfaces:
            return self.surfaces[key]
        cached = cache_path(self.path, w, h)
        if cached and os.path.exists(cached):
            self.surfaces[key] = make_surfaces(load_cover(cached, w, h), w, h)
            return self.surfaces[key]
        if key not in self.loading:
            self.loading.add(key)

            def work():
                pb = cached_cover(self.path, w, h)
                GLib.idle_add(done, pb)

            def done(pb):
                self.surfaces[key] = make_surfaces(pb, w, h)
                self.loading.discard(key)
                self.area.queue_draw()
                if self.on_ready:
                    self.on_ready()
                return False

            threading.Thread(target=work, daemon=True).start()
        return None

    def _draw(self, _area, cr, w, h):
        surf = self._surfaces(w, h)
        if surf is None:            # ainda carregando: gradiente neutro escuro
            g = cairo.LinearGradient(0, 0, 0, h)
            g.add_color_stop_rgb(0, 0.20, 0.26, 0.38)
            g.add_color_stop_rgb(1, 0.06, 0.08, 0.14)
            cr.set_source(g)
            cr.paint()
            strong = cairo.ImageSurface(cairo.FORMAT_RGB24, 1, 1)
            ctx = cairo.Context(strong)
            ctx.set_source_rgb(0.3, 0.35, 0.45)
            ctx.paint()
            lum = 0.3
        else:
            bg, strong, lum = surf
            cr.set_source_surface(bg, 0, 0)
            cr.paint()
        # véu mínimo para o branco ler bem sobre fundos claros (a Apple quase não escurece)
        cr.set_source_rgba(0, 0, 0, BACKDROP_VEIL)
        cr.paint()
        s = 1.0     # tamanhos fixos em pt (1 pt = 1 px lógico), como no Mac
        # data (SF Pro entre Medium e Semibold, branco levemente translúcido)
        dpath, _ = text_path(cr, date_text(), font(M["date_size"] * s, M["date_weight"]), w / 2,
                             M["date_top"] * s, M["date_track"] * s)
        # cor vibrante: SOMA ≈ 100 ao fundo em cada canal (plus-lighter #646464) — medido em
        # três telas (WWDC +99, 26.0 final +95, praia +102/+107): sobre céu azul sai
        # azul-claro, não branco; sem sombra
        cr.append_path(dpath)
        cr.set_operator(cairo.OPERATOR_ADD)
        cr.set_source_rgb(*DATE_ADD)
        cr.fill()
        cr.set_operator(cairo.OPERATOR_OVER)
        # relógio de vidro (Ajustes ▸ Wallpaper ▸ Clock Appearance…: mostrar, estilo, peso)
        cc = clock_conf()
        if cc["show"] == "never":
            return
        cpath, box = text_path(cr, clock_text(), font(M["clock_size"] * s, cc["weight"], cc["family"]),
                               w / 2, M["clock_top"] * s, M["clock_track"] * s)
        draw_glass_text(cr, cpath, box, strong, s, lum)


class Avatar(Gtk.DrawingArea):
    SIZE = 49       # medido na foto oficial: 49,2 pt de diâmetro

    def __init__(self, path, name):
        super().__init__()
        self.set_content_width(self.SIZE)
        self.set_content_height(self.SIZE)
        self.set_halign(Gtk.Align.CENTER)
        self.initial = (name.strip()[:1] or "?").upper()
        self.pb = None
        if path:
            try:
                self.pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, self.SIZE * 2, self.SIZE * 2, True)
            except GLib.Error:
                self.pb = None
        self.set_draw_func(self._draw)

    def _draw(self, _a, cr, w, h):
        r = min(w, h) / 2
        cx, cy = w / 2, h / 2
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        if self.pb is not None:
            cr.save()
            cr.clip()
            pw, ph = self.pb.get_width(), self.pb.get_height()
            k = max(w / pw, h / ph)
            cr.translate(cx - pw * k / 2, cy - ph * k / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, self.pb, 0, 0)
            cr.paint()
            cr.restore()
            return
        # monograma num círculo de vidro
        g = cairo.LinearGradient(0, 0, 0, h)
        g.add_color_stop_rgba(0, 1, 1, 1, 0.42)
        g.add_color_stop_rgba(1, 1, 1, 1, 0.22)
        cr.set_source(g)
        cr.fill()
        cr.arc(cx, cy, r - 0.5, 0, 2 * math.pi)
        cr.set_line_width(1)
        cr.set_source_rgba(1, 1, 1, 0.45)
        cr.stroke()
        # centraliza verticalmente pela tinta
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(font(21))
        layout.set_text(self.initial, -1)
        ink, _l = layout.get_pixel_extents()
        cr.move_to(cx - ink.width / 2 - ink.x, cy - ink.height / 2 - ink.y)
        PangoCairo.layout_path(cr, layout)
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.fill()


class VibrantLabel(Gtk.DrawingArea):
    """Texto "vibrante" (kit: Labels/Dark - Vibrant, Secondary #999999, mistura plus-lighter):
    a cor é SOMADA ao fundo, então o texto puxa o tom do papel de parede (na foto oficial,
    "Touch ID or Enter Password" sai azulado sobre o azul, com o canal azul saturado).
    O GTK não tem plus-lighter: o widget redesenha o pedaço do fundo que está atrás dele
    e soma o texto por cima (cairo ADD)."""

    def __init__(self, text, size, weight, color=(0x99 / 255,) * 3):
        super().__init__()
        self.text, self.size, self.weight, self.color = text, size, weight, color
        self.set_halign(Gtk.Align.CENTER)
        self.set_draw_func(self._draw)
        self._measure()

    def _layout(self, ctx):
        layout = PangoCairo.create_layout(ctx) if isinstance(ctx, cairo.Context) else Pango.Layout.new(ctx)
        layout.set_font_description(font(self.size, self.weight))
        layout.set_text(self.text, -1)
        return layout

    def _measure(self):
        _ink, logical = self._layout(self.get_pango_context()).get_pixel_extents()
        self.set_content_width(logical.width + 2)
        self.set_content_height(logical.height)

    def set_text(self, text):
        self.text = text
        self._measure()
        self.queue_draw()

    def _backdrop(self):
        view = self.get_ancestor(LockView)
        if view is None:
            return None, None
        surf = view.backdrop.surfaces.get((view.get_width(), view.get_height()))
        return view, surf

    def _draw(self, _a, cr, w, h):
        layout = self._layout(cr)
        _ink, logical = layout.get_pixel_extents()
        x, y = (w - logical.width) / 2 - logical.x, (h - logical.height) / 2 - logical.y
        view, surf = self._backdrop()
        ok, pt = (self.compute_point(view, Graphene.Point()) if view else (False, None))
        if surf is None or not ok:
            cr.move_to(x, y)
            cr.set_source_rgba(1, 1, 1, 0.6)
            PangoCairo.show_layout(cr, layout)
            return
        # 1) o mesmo fundo que o Backdrop desenhou aqui (papel de parede + véu)
        cr.set_source_surface(surf[0], -pt.x, -pt.y)
        cr.paint()
        cr.set_source_rgba(0, 0, 0, BACKDROP_VEIL)
        cr.paint()
        # 2) texto somado (plus-lighter)
        cr.set_operator(cairo.OPERATOR_ADD)
        cr.set_source_rgb(*self.color)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)


class AuthPanel(Gtk.Box):
    """Avatar + nome + campo de senha (cápsula de vidro com seta). Existe UM só e
    passa para o monitor que estiver com o foco."""

    def __init__(self, on_success):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add_css_class("lock-auth")
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.END)
        self.on_success = on_success
        self.pam = Pam()
        self.service = default_service()
        self.busy = False

        name, avatar = user_info()
        self.append(Avatar(avatar, name))
        nm = Gtk.Label(label=name)
        nm.add_css_class("lock-name")
        self.append(nm)

        # Em repouso o Mac mostra só a dica (texto vibrante, sem caixa); a cápsula com os
        # pontos aparece quando se digita. As duas ocupam a mesma linha (Overlay).
        self.entry = Gtk.Overlay()
        self.entry.add_css_class("lock-entry")
        self.entry.set_halign(Gtk.Align.CENTER)
        self.field = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.field.add_css_class("lock-field")
        self.field.set_halign(Gtk.Align.CENTER)
        self.field.set_valign(Gtk.Align.CENTER)
        self.field.set_opacity(0)
        self.text = Gtk.Text()
        self.text.set_visibility(False)
        self.text.set_placeholder_text(T["placeholder"])
        self.text.set_hexpand(True)
        self.text.set_alignment(0.5)          # a dica fica centrada, como na Apple
        self.text.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.text.connect("activate", lambda *_: self.submit())
        self.text.connect("changed", self._changed)
        self.field.append(self.text)
        self.go = Gtk.Button(label=ICON["arrow"])
        self.go.add_css_class("lock-go")
        self.go.set_valign(Gtk.Align.CENTER)
        self.go.set_focusable(False)
        self.go.connect("clicked", lambda *_: self.submit())
        self.go.set_opacity(0)
        self.field.append(self.go)
        self.hint = VibrantLabel(T["hint"], 12, 540)
        self.hint.add_css_class("lock-hint")
        self.hint.set_can_target(False)
        self.hint.set_valign(Gtk.Align.CENTER)
        self.entry.set_child(self.field)
        self.entry.add_overlay(self.hint)
        self.entry.set_measure_overlay(self.hint, True)
        self.append(self.entry)

        self.msg = Gtk.Label(label=" ")
        self.msg.add_css_class("lock-msg")
        self.msg.set_wrap(True)
        self.msg.set_max_width_chars(48)
        self.msg.set_justify(Gtk.Justification.CENTER)
        self.msg.set_visible(False)     # só ocupa lugar quando o PAM tem algo a dizer
        self.append(self.msg)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key)
        self.text.add_controller(keys)

    def _changed(self, *_):
        has = bool(self.text.get_text())
        self.go.set_opacity(1 if has else 0)
        self.field.set_opacity(1 if has else 0)
        self.hint.set_opacity(0 if has else 1)
        if has and self.msg.get_visible():
            self.msg.set_visible(False)

    def _key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.text.set_text("")
            return True
        return False

    def focus(self):
        GLib.idle_add(lambda: (self.text.grab_focus(), False)[1])

    def submit(self):
        pw = self.text.get_text()
        if self.busy or not pw:
            return
        self.busy = True
        self.field.set_sensitive(False)

        def work():
            try:
                ok, err, msgs = self.pam.authenticate(self.service, USER, pw)
            except Exception as e:  # noqa: BLE001 — nunca deixar o campo travado
                ok, err, msgs = False, str(e), []
            GLib.idle_add(self._done, ok, err, msgs)

        threading.Thread(target=work, daemon=True).start()

    def _done(self, ok, err, msgs):
        self.busy = False
        self.field.set_sensitive(True)
        if ok:
            self.text.set_text("")
            self.on_success()
            return False
        self.text.set_text("")
        # PAM costuma explicar o motivo (ex.: faillock: "conta bloqueada por 10 min")
        info = [m for m in msgs if m and "password" not in m.lower()[:9]]
        self.msg.set_text("\n".join(info))
        self.msg.set_visible(bool(info))
        self.shake()
        self.focus()
        return False

    def shake(self):
        """Errou: o campo treme (≈ 0,45 s, amplitude que decai) e limpa."""
        t0 = GLib.get_monotonic_time()
        dur, amp = 450_000, 12

        def step():
            t = (GLib.get_monotonic_time() - t0) / dur
            if t >= 1:
                self.entry.set_margin_start(0)
                self.entry.set_margin_end(0)
                return False
            d = round(amp * math.sin(t * math.pi * 6) * (1 - t)) * 2
            self.entry.set_margin_start(max(0, d))
            self.entry.set_margin_end(max(0, -d))
            return True

        GLib.timeout_add(16, step)


class StatusGlyph(Gtk.DrawingArea):
    """Ícones do canto superior direito desenhados em cairo, com as medidas da foto oficial
    (pt): teclado 16,2×10, bateria 22,5×11,6 + polo, Wi‑Fi 14,6×10,4 (leque de 90°).
    `dy` = deslocamento do centro em relação ao centro do texto (13,8 pt do topo)."""

    SPEC = {   # kind: (largura, altura, dy)
        "keyboard": (16.2, 10.0, 0.0),
        "battery": (25.4, 11.6, -1.0),
        "wifi": (14.6, 10.4, -1.0),
    }

    def __init__(self, kind, level=1.0, charging=False):
        super().__init__()
        self.kind, self.level, self.charging = kind, level, charging
        w, h, _dy = self.SPEC[kind]
        self.set_content_width(math.ceil(w))
        self.set_content_height(math.ceil(h))
        self.set_draw_func(self._draw)

    @staticmethod
    def _rrect(cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()

    def _draw(self, _a, cr, w, h):
        sw, sh, _dy = self.SPEC[self.kind]
        cr.translate((w - sw) / 2, (h - sh) / 2)
        getattr(self, "_" + self.kind)(cr, sw, sh)

    def _keyboard(self, cr, w, h):
        lw = 1.1
        self._rrect(cr, lw / 2, lw / 2, w - lw, h - lw, 2.2)
        cr.set_source_rgba(1, 1, 1, 1)
        cr.set_line_width(lw)
        cr.stroke()
        # duas fileiras de teclas e a barra de espaço
        k, cols = 1.0, 7
        x0, x1 = 2.6, w - 2.6
        step = (x1 - x0 - k) / (cols - 1)
        for row_y in (2.6, 4.6):
            for i in range(cols):
                cr.rectangle(x0 + i * step, row_y, k, k)
        cr.rectangle(x0 + 1.2, 6.6, x1 - x0 - 2.4, k)
        cr.fill()

    def _battery(self, cr, w, h):
        bw, lw = 22.5, 1.1
        self._rrect(cr, lw / 2, lw / 2, bw - lw, h - lw, 3.6)
        cr.set_source_rgba(1, 1, 1, 0.42)        # contorno translúcido, como na foto
        cr.set_line_width(lw)
        cr.stroke()
        self._rrect(cr, bw + 1.6, 3.7, 1.3, 4.2, 0.65)   # polo
        cr.fill()
        inner = bw - 2 * 1.9
        fw = max(1.5, inner * max(0.0, min(1.0, self.level)))
        self._rrect(cr, 1.9, 2.15, fw, h - 4.3, 1.8)
        cr.set_source_rgba(1, 1, 1, 1)
        cr.fill()

    def _wifi(self, cr, w, h):
        # leque de ±45° com o vértice embaixo, no centro: miolo + dois arcos
        cx, cy = w / 2, h
        a0, a1 = -math.pi * 3 / 4, -math.pi / 4
        cr.set_source_rgba(1, 1, 1, 1)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        lw = 2.1
        for r in (h - lw / 2, h - lw / 2 - 3.5):
            cr.set_line_width(lw)
            cr.arc(cx, cy, r, a0 + 0.08, a1 - 0.08)
            cr.stroke()
        r = h - 7.1
        cr.move_to(cx, cy - 0.6)
        cr.arc(cx, cy, r, a0, a1)
        cr.close_path()
        cr.set_line_width(1.0)
        cr.stroke_preserve()
        cr.fill()


class LockView(Gtk.Overlay):
    """O conteúdo de um monitor: fundo/data/relógio + status + vaga para o AuthPanel."""

    def __init__(self, wallpaper):
        super().__init__()
        self.add_css_class("hyprmac-lock")
        self.backdrop = Backdrop(wallpaper, on_ready=self._redraw_slot)
        self.set_child(self.backdrop.area)

        self.status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.status.add_css_class("lock-status")
        self.status.set_halign(Gtk.Align.END)
        self.status.set_valign(Gtk.Align.START)
        self.add_overlay(self.status)

        self.slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.slot.add_css_class("lock-slot")
        self.slot.set_halign(Gtk.Align.CENTER)
        self.slot.set_valign(Gtk.Align.END)
        self.add_overlay(self.slot)
        self.refresh_status()

    def refresh_status(self):
        while (c := self.status.get_first_child()) is not None:
            self.status.remove(c)

        def place(widget, dy=0.0):
            # todos centrados na linha do texto (centro das maiúsculas a 13,8 pt do topo)
            widget.set_valign(Gtk.Align.CENTER)
            widget.set_margin_top(max(0, round(2 * dy)))
            widget.set_margin_bottom(max(0, round(-2 * dy)))
            return widget

        def item(*widgets):
            b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)   # tinta: texto ↔ teclado 6,3
            b.add_css_class("lock-status-item")
            for w in widgets:
                b.append(w)
            self.status.append(b)

        def glyph(kind, **kw):
            g = StatusGlyph(kind, **kw)
            return place(g, StatusGlyph.SPEC[kind][2])

        kb = keyboard_layout()
        if kb:
            lb = Gtk.Label(label=kb)
            lb.add_css_class("lock-status-text")
            item(place(lb, -0.5), glyph("keyboard"))
        bat = battery()
        if bat:
            cap, st = bat
            item(glyph("battery", level=cap / 100, charging=st == "Charging"))
        net = network_kind()
        if net == "wifi":
            item(glyph("wifi"))
        elif net == "ethernet":     # sem referência da Apple para cabo no bloqueio
            ic = Gtk.Label(label=ICON["ethernet"])
            ic.add_css_class("lock-status-icon")
            item(place(ic))

    def _redraw_slot(self):
        """O fundo ficou pronto: o texto vibrante (que copia o fundo) precisa redesenhar."""
        def walk(w):
            while w is not None:
                if isinstance(w, VibrantLabel):
                    w.queue_draw()
                walk(w.get_first_child())
                w = w.get_next_sibling()
        walk(self.slot.get_first_child())

    def redraw(self):
        self.backdrop.area.queue_draw()


class PlainView(Gtk.Overlay):
    """Reserva de segurança se o LockView falhar: fundo liso + vaga do campo."""

    def __init__(self):
