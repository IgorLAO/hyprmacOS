# ───────────────────────────── aplicação ─────────────────────────────

class LockApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.views = []
        self.windows = []
        self.auth = None
        self.wallpaper = resolve_wallpaper()
        self.last_minute = None
        self.lock = None
        self.connect("activate", self._activate)

    # ── CSS e relógio ──
    def _setup(self):
        prov = Gtk.CssProvider()
        try:
            prov.load_from_path(CSS_PATH)
        except GLib.Error as e:
            print("lock.css:", e, file=sys.stderr)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 10)
        self.auth = AuthPanel(self._unlock)
        GLib.timeout_add_seconds(1, self._tick)
        GLib.timeout_add_seconds(30, self._status_tick)

    def _tick(self):
        m = time.strftime("%Y%m%d%H%M")
        if m != self.last_minute:
            self.last_minute = m
            for v in self.views:
                v.redraw()
        return True

    def _status_tick(self):
        for v in self.views:
            v.refresh_status()
        return True

    def _make_view(self, window):
        try:
            view = LockView(self.wallpaper)
        except Exception as e:  # noqa: BLE001 — sem fundo, mas o campo de senha TEM de existir
            print("hyprmac-lock: visual simplificado:", e, file=sys.stderr)
            view = PlainView()
        window.set_child(view)
        window.add_css_class("hyprmac-lock-window")
        self.views.append(view)
        self.windows.append(window)
        window.connect("notify::is-active", lambda w, _p, v=view: w.is_active() and self.host_auth(v))
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_a, v=view: self.host_auth(v))
        view.add_controller(click)
        # qualquer tecla num monitor sem o campo traz o campo para ele
        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", lambda *_a, v=view: self._key_anywhere(v))
        window.add_controller(keys)
        return view

    def _key_anywhere(self, view):
        if self.auth.get_parent() is not view.slot:
            self.host_auth(view)
        elif not self.auth.text.has_focus():
            self.auth.text.grab_focus()
        return False

    def host_auth(self, view):
        if ARGS.preview and ARGS.secondary:
            return False
        parent = self.auth.get_parent()
        if parent is not view.slot:
            if parent is not None:
                parent.remove(self.auth)
            view.slot.append(self.auth)
        self.auth.focus()
        return False

    def _unlock(self):
        if self.lock is not None:
            self.lock.unlock()
            GLib.timeout_add(1500, lambda: (self.quit(), False)[1])   # garantia
        else:
            print("preview: senha correta — fechando")
            self.quit()

    # ── modos ──
    def _activate(self, _app):
        self._setup()
        if LOCK_MODE:
            self._activate_lock()
        else:
            self._activate_preview()

    def _activate_preview(self):
        win = Gtk.ApplicationWindow(application=self, title="hyprmac-lock (preview)")
        view = self._make_view(win)
        mons = Gdk.Display.get_default().get_monitors()
        target = None
        for i in range(mons.get_n_items()):
            m = mons.get_item(i)
            if m.get_connector() == (ARGS.monitor or focused_connector()):
                target = m
        if not ARGS.secondary:
            self.host_auth(view)
        if ARGS.size:
            sw, sh = (int(v) for v in ARGS.size.lower().split("x"))
            win.set_default_size(sw, sh)
            view.set_size_request(sw, sh)    # o Broadway limita a janela à "tela" dele
        elif target is not None:
            win.fullscreen_on_monitor(target)
        else:
            win.set_default_size(1920, 1080)
        win.present()
        if ARGS.snapshot:
            if os.environ.get("HYPRMAC_LOCK_TYPED"):    # testes: estado "digitando"
                self.auth.text.set_text(os.environ["HYPRMAC_LOCK_TYPED"])
            self._snapshot_when_ready(win, view)
        if ARGS.quit_after:
            GLib.timeout_add(int(ARGS.quit_after * 1000), lambda: (self.quit(), False)[1])

    def _snapshot_when_ready(self, win, view):
        """--snapshot: espera o papel de parede carregar e salva a tela inteira em PNG."""
        t0 = time.time()

        def save():
            w, h = view.get_width(), view.get_height()
            bd = getattr(view, "backdrop", None)
            ready = w > 0 and (bd is None or bd._surfaces(w, h) is not None)
            if not ready and time.time() - t0 < 20:
                return True
            snap = Gtk.Snapshot()
            Gtk.WidgetPaintable.new(view).snapshot(snap, w, h)
            node = snap.to_node()
            if node is None:            # ainda sem nada desenhado (fundo acabou de carregar)
                return time.time() - t0 < 20
            win.get_renderer().render_texture(node, node.get_bounds()).save_to_png(ARGS.snapshot)
            print(ARGS.snapshot, w, h)
            self.quit()
            return False

        GLib.timeout_add(300, save)

    def _activate_lock(self):
        from gi.repository import Gtk4SessionLock as SL
        if not SL.is_supported():
            print("hyprmac-lock: o compositor não suporta ext-session-lock", file=sys.stderr)
            self.quit()
            return
        # segurança: se o PAM não abrir, NÃO trava (senão não haveria como destravar)
        if not Pam().can_start(default_service(), USER):
            print(f"hyprmac-lock: serviço PAM '{default_service()}' indisponível — não travo",
                  file=sys.stderr)
            self.quit()
            return
        self.hold()
        self.focused = focused_connector()
        self.lock = SL.Instance.new()
        self.lock.connect("monitor", self._on_monitor)
        self.lock.connect("failed", lambda *_: (print("hyprmac-lock: falha ao travar", file=sys.stderr),
                                                self.release(), self.quit()))
        self.lock.connect("locked", self._locked)
        self.lock.connect("unlocked", lambda *_: (self.release(), self.quit()))
        self.lock.lock()

    def _locked(self, *_):
        """Advertise readiness only after ext-session-lock confirms the lock."""
        self._ensure_auth()
        temporary = READYFILE + f".{os.getpid()}"
        try:
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as state:
                state.write(str(os.getpid()))
            os.replace(temporary, READYFILE)
        except OSError as e:
            # The session is locked, but idle must not mistake this for readiness.
            print(f"hyprmac-lock: não consegui sinalizar bloqueio: {e}", file=sys.stderr)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass

    def _ensure_auth(self):
        """Garante que algum monitor tem o campo de senha."""
        if self.auth.get_parent() is None and self.views:
            self.host_auth(self.views[0])

    def _on_monitor(self, _lock, monitor):
        win = Gtk.ApplicationWindow(application=self)
        self.lock.assign_window_to_monitor(win, monitor)
        view = self._make_view(win)
        if self.auth.get_parent() is None and (self.focused is None or monitor.get_connector() == self.focused):
            self.host_auth(view)
        win.present()


def main():
    if LOCK_MODE:
        # uma instância só
        fd = os.open(LOCKFILE, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(fd)
            print("hyprmac-lock: já está travado", file=sys.stderr)
            return 0
    try:
        if LOCK_MODE:
            try:
                os.unlink(READYFILE)  # discard stale state after acquiring the instance lock
            except FileNotFoundError:
                pass
        app = LockApp()
        app.run([sys.argv[0]])
    finally:
        if LOCK_MODE:
            try:
                os.unlink(READYFILE)
            except FileNotFoundError:
                pass
            os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
