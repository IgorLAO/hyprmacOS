#!/usr/bin/env python3
"""hyprmac — histórico da área de transferência (como o ⌘Espaço ⌘4 do Tahoe).

  clipboard watch    vigia a área de transferência (autostart do hyprmac.lua)
  clipboard store    guarda o conteúdo atual (chamado pelo wl-paste --watch)
  clipboard pick     abre o histórico (painel do hyprmac-shell); o item escolhido é colado
  clipboard clear    apaga o histórico

Como no macOS: texto, imagens e arquivos copiados ficam ~8 horas; colar a
partir do histórico cola texto puro. Conteúdo marcado como senha (gerenciadores
de senha) não é guardado.
"""
import hashlib
import json
import os
import subprocess
import sys
import time

H = os.path.expanduser("~/Projects/hyprmac")
DIR = os.path.expanduser("~/.cache/hyprmac/clipboard")
INDEX = os.path.join(DIR, "index.json")
KEEP_S = 8 * 3600
MAX_ITEMS = 100
MAX_TEXT = 1 << 20    # textos maiores que 1 MB não entram


def sh(args, stdin=None, timeout=3):
    try:
        return subprocess.run(args, input=stdin, capture_output=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return b""


def load():
    try:
        with open(INDEX) as f:
            items = json.load(f)
    except (OSError, ValueError):
        items = []
    now = time.time()
    keep = [i for i in items if now - i["t"] < KEEP_S][:MAX_ITEMS]
    for old in items:
        if old not in keep:
            forget_files(old)
    return keep


def save(items):
    os.makedirs(DIR, exist_ok=True)
    tmp = INDEX + ".tmp"
    with open(tmp, "w") as f:
        json.dump(items, f, ensure_ascii=False)
    os.replace(tmp, INDEX)


def forget_files(item):
    for k in ("file", "thumb"):
        p = item.get(k)
        if p:
            try:
                os.remove(p)
            except OSError:
                pass


# ───────────── guardar ─────────────

def store():
    sys.stdin.buffer.read()   # o wl-paste --watch manda o conteúdo; lemos nós mesmos o tipo certo
    if os.environ.get("CLIPBOARD_STATE") in ("sensitive", "clear", "nil"):
        return
    types = sh(["wl-paste", "--list-types"]).decode(errors="replace").split()
    if not types or "x-kde-passwordManagerHint" in types:
        return
    os.makedirs(DIR, exist_ok=True)
    image = next((t for t in ("image/png", "image/jpeg", "image/webp") if t in types), None)
    if image:
        data = sh(["wl-paste", "--type", image], timeout=5)
        if not data:
            return
        digest = hashlib.sha1(data).hexdigest()
        path = os.path.join(DIR, digest + ".png")
        item = {"kind": "image", "id": digest, "file": path}
        if not os.path.exists(path):
            if not save_image(data, path, item):
                return
        else:
            item.update(image_meta(path))
    else:
        data = sh(["wl-paste", "--no-newline", "--type", "text"])
        if not data.strip() or len(data) > MAX_TEXT:
            return
        text = data.decode(errors="replace")
        # o mesmo texto com outra quebra de linha no fim não vira um item novo
        digest = hashlib.sha1(text.strip().encode()).hexdigest()
        kind = "files" if "text/uri-list" in types else "text"
        item = {"kind": kind, "id": digest, "text": text}
    item["t"] = time.time()
    items = [i for i in load() if i["id"] != item["id"]]   # repetido sobe para o topo
    items.insert(0, item)
    for old in items[MAX_ITEMS:]:
        forget_files(old)
    save(items[:MAX_ITEMS])


def save_image(data, path, item):
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, GLib
    try:
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pb = loader.get_pixbuf()
        pb.savev(path, "png", [], [])
        w, h = pb.get_width(), pb.get_height()
        s = 96 / max(w, h)
        thumb = path[:-4] + "-thumb.png"
        pb.scale_simple(max(1, round(w * s)), max(1, round(h * s)),
                        GdkPixbuf.InterpType.BILINEAR).savev(thumb, "png", [], [])
    except GLib.Error:
        return False
    item.update({"w": w, "h": h, "thumb": thumb})
    return True


def image_meta(path):
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
    _fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
    return {"w": w, "h": h, "thumb": path[:-4] + "-thumb.png"}


# ───────────── abrir ─────────────

def pick():
    """O histórico é um painel do hyprmac-shell (ClipboardPanel)."""
    subprocess.run(["gdbus", "call", "--session", "--dest", "dev.hyprmac.Shell",
                    "--object-path", "/dev/hyprmac/Shell", "--method",
                    "dev.hyprmac.Shell.Command", "toggle-clipboard"], stdout=subprocess.DEVNULL)


def clear():
    for i in load():
        forget_files(i)
    save([])


def watch():
    # uma instância só: a anterior (de um reload) sai
    subprocess.run(["pkill", "-f", "^wl-paste --watch .*/scripts/clipboard store$"])
    os.execvp("wl-paste", ["wl-paste", "--watch", os.path.realpath(__file__), "store"])


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "pick"
    {"store": store, "pick": pick, "clear": clear, "watch": watch}.get(cmd, pick)()
