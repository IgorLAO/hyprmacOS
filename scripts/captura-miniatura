#!/usr/bin/env python3
"""hyprmac — miniatura flutuante depois de uma captura de tela (como no macOS).

  captura-miniatura <imagem.png> [--abrir <arquivo>]

Entra deslizando no canto inferior direito e some sozinha em 5 s (para enquanto
o ponteiro estiver em cima). Clique abre o editor (Spectacle); arrastar solta o
arquivo em outros apps; botão direito descarta. Com `--abrir <arquivo>`, a
miniatura mostra <imagem.png> mas o clique/arraste age sobre <arquivo> (usado
pela gravação: pôster da imagem, mas abre/solta o .mp4).

A Apple não publica as medidas da miniatura: o visual segue o kit macOS 27 por
extrapolação — cantos de 12, filete branco 20% e sombra de janela.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402
from gi.repository import GtkLayerShell as LS  # noqa: E402

LARGURA = 220          # largura máxima da miniatura
MARGEM = 20            # distância das bordas da tela
RAIO = 12
DURACAO_MS = 5000
SOMBRA = 16            # espaço em volta da imagem para a sombra
CSS = "window { background: transparent; }"


def editor(path):
    # vídeo (gravação): sem editor de marcação — abre no player padrão
    if path.lower().endswith((".mp4", ".mkv", ".webm", ".mov")):
        subprocess.Popen(["xdg-open", path], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    for cmd in (["spectacle", "--edit-existing", path], ["gwenview", path], ["xdg-open", path]):
        try:
            subprocess.Popen(cmd, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except FileNotFoundError:
            continue


def rounded(cr, w, h, r):
    import math
    cr.new_sub_path()
    cr.arc(w - r, r, r, -math.pi / 2, 0)
    cr.arc(w - r, h - r, r, 0, math.pi / 2)
    cr.arc(r, h - r, r, math.pi / 2, math.pi)
    cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def main():
    if len(sys.argv) < 2 or not os.path.exists(sys.argv[1]):
        sys.exit(__doc__)
    imagem = os.path.abspath(sys.argv[1])          # o que a miniatura mostra
    path = imagem                                   # o que o clique/arraste usa
    if "--abrir" in sys.argv:
        alvo = sys.argv[sys.argv.index("--abrir") + 1]
        if os.path.exists(alvo):
            path = os.path.abspath(alvo)
    pb = GdkPixbuf.Pixbuf.new_from_file(imagem)
    w = min(LARGURA, pb.get_width())
    h = max(1, round(pb.get_height() * w / pb.get_width()))
    if h > LARGURA:                      # capturas altas: limita a altura também
        h = LARGURA
        w = max(1, round(pb.get_width() * h / pb.get_height()))
    thumb = pb.scale_simple(w, h, GdkPixbuf.InterpType.HYPER)

    prov = Gtk.CssProvider()
    prov.load_from_data(CSS.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Gtk.Window()
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)
    win.set_app_paintable(True)
    LS.init_for_window(win)
    LS.set_namespace(win, "hyprmac-captura")
    LS.set_layer(win, LS.Layer.OVERLAY)
    for e in (LS.Edge.BOTTOM, LS.Edge.RIGHT):
        LS.set_anchor(win, e, True)
    LS.set_margin(win, LS.Edge.BOTTOM, MARGEM - SOMBRA)
    LS.set_margin(win, LS.Edge.RIGHT, MARGEM - SOMBRA)

    area = Gtk.DrawingArea()
    area.set_size_request(w + 2 * SOMBRA, h + 2 * SOMBRA)

    def draw(widget, cr):
        # sombra macia de janela (deslocada para baixo) + filete escuro de 1px
        for i in range(SOMBRA, 0, -2):
            cr.save()
            cr.translate(SOMBRA - i, SOMBRA - i + 5)
            rounded(cr, w + 2 * i, h + 2 * i, RAIO + i)
            cr.set_source_rgba(0, 0, 0, 0.035)
            cr.fill()
            cr.restore()
        cr.translate(SOMBRA, SOMBRA)
        cr.save()
        cr.translate(-1, -1)
        rounded(cr, w + 2, h + 2, RAIO + 1)
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.fill()
        cr.restore()
        rounded(cr, w, h, RAIO)
        cr.clip()
        Gdk.cairo_set_source_pixbuf(cr, thumb, 0, 0)
        cr.paint()
        # filete claro por dentro, como o aro das janelas do Tahoe
        rounded(cr, w - 1, h - 1, RAIO - 0.5)
        cr.translate(0.5, 0.5)
        cr.set_source_rgba(1, 1, 1, 0.20)
        cr.set_line_width(1)
        cr.stroke()
        return False
    area.connect("draw", draw)

    ev = Gtk.EventBox()
    ev.add(area)
    ev.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                  | Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
    win.add(ev)

    estado = {"timer": None, "arrastou": False}

    def sair(*_):
        Gtk.main_quit()
        return False

    def armar():
        if estado["timer"]:
            GLib.source_remove(estado["timer"])
        estado["timer"] = GLib.timeout_add(DURACAO_MS, sair)

    def soltou(_w, ev):
        if estado["arrastou"]:
            return False
        if ev.button == 1:
            editor(path)
        sair()
        return True

    ev.connect("button-release-event", soltou)
    ev.connect("enter-notify-event", lambda *_: estado["timer"] and GLib.source_remove(estado["timer"])
               or estado.update(timer=None))
    ev.connect("leave-notify-event", lambda _w, e: e.detail != Gdk.NotifyType.INFERIOR and armar())

    # arrastar a miniatura para outro app solta o arquivo (text/uri-list)
    ev.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, [], Gdk.DragAction.COPY)
    ev.drag_source_add_uri_targets()
    ev.drag_source_set_icon_pixbuf(thumb.scale_simple(max(1, w // 2), max(1, h // 2),
                                                      GdkPixbuf.InterpType.BILINEAR))
    ev.connect("drag-begin", lambda *_: estado.update(arrastou=True))
    ev.connect("drag-data-get", lambda _w, _c, data, _i, _t: data.set_uris(["file://" + path]))
    ev.connect("drag-end", sair)

    win.show_all()
    armar()
    Gtk.main()


if __name__ == "__main__":
    main()
