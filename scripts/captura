#!/usr/bin/env python3
"""hyprmac — barra de Captura de Tela (⇧⌘5 do macOS), sem gravação.

Cápsula de vidro escuro no rodapé da tela, como no Tahoe:
  ✕ | Entire Screen · Selected Window · Selected Portion | Options ▾ | Capture
Options: Save to (Desktop, Documents, Screenshots, Clipboard), Timer (None, 5 s,
10 s) e Show Floating Thumbnail — guardadas em
~/.config/hyprmac/captura.json. Enter captura, Esc fecha. A captura em si é
feita por scripts/screenshot (screen / pick / region).
"""
import json
import os
import subprocess
import sys

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402
from gi.repository import GtkLayerShell as LS  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
CONF = os.path.expanduser("~/.config/hyprmac/captura.json")
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hyprmac-captura.pid")
DESTINOS = [("desktop", "Desktop"), ("documents", "Documents"),
            ("screenshots", "Screenshots"), ("clipboard", "Clipboard")]
TEMPOS = [(0, "None"), (5, "5 Seconds"), (10, "10 Seconds")]

# Medidas da barra do Tahoe (referencias/desejos/captura-barra-opcoes.png, 2,39 px/pt pelo "O"
# de "Options", SF 13): barra 577×53, canto 13; ✕ em círculo de 17 com centro a 22 da borda;
# 3 capturas a cada 50,6 (seleção: quadrado 46×37, canto 6) | 3 gravações a cada 60 | "Options ⌄"
# cinza 13 | "Capture" azul 82×38, canto 9, a 6 da borda. Vidro: hyprglass (preset
# hyprmac-texto) quando carregado; sem ele, o tom do vidro pintado.
CSS_BASE = """
window.captura { background: transparent; }
.cap-bar {
  min-height: 53px;
  border-radius: 13px;
  padding: 0 6px 0 13px;
  border: 1px solid @cap_rim;
  background-color: @cap_bg;
  box-shadow: none;
}
.cap-bar button {
  min-height: 37px;
  min-width: 46px;
  padding: 0;
  border-radius: 6px;
  border: none;
  background: transparent;
  box-shadow: none;
}
.cap-bar button.rec            { min-width: 56px; }
.cap-bar button.modo           { margin: 0 1px; }
.cap-bar button.modo.primeiro  { margin-left: 12px; }
.cap-bar button:hover          { background: @cap_hover; }
.cap-bar button.selected       { background: @cap_sel; }
.cap-bar button.texto          { padding: 0 8px; min-width: 0; margin: 0 6px 0 4px; }
.cap-bar button.texto label    { font-family: "SF Pro"; font-size: 13px; font-weight: 400; color: @cap_dim; }
.cap-bar .chev                 { color: @cap_dim; }
.cap-bar button.capturar {
  min-width: 82px;
  min-height: 38px;
  margin: 0;
  padding: 0 14px;
  border-radius: 9px;
  background: @cap_accent;
}
.cap-bar button.capturar label { font-weight: 600; color: #ffffff; }
.cap-bar button.capturar:hover { background: shade(@cap_accent, 1.08); }
.cap-bar button.fechar {
  min-width: 17px;
  min-height: 17px;
  margin: 0;
  border-radius: 999px;
  background: @cap_x;
}
.cap-bar button.fechar:hover   { background: shade(@cap_x, 1.15); }
.cap-bar .x { font-size: 9px; font-weight: 800; color: @cap_xfg; }
.cap-sep { background: @cap_sep; min-width: 1px; min-height: 25px; margin: 0 5px; }
/* dica ("Capture Entire Screen" da referência): cápsula de canto 6 acima da barra */
tooltip { background: @cap_tip; border: 1px solid @cap_rim; border-radius: 6px; }
tooltip label { font-family: "SF Pro"; font-size: 12px; color: @cap_dim; padding: 1px 3px; }
"""
CORES = {   # escuro / claro
    True: dict(cap_bg="rgba(30, 30, 34, 0.80)", cap_rim="rgba(255, 255, 255, 0.14)",
               cap_hover="rgba(255, 255, 255, 0.08)", cap_sel="rgba(255, 255, 255, 0.14)",
               cap_dim="rgba(255, 255, 255, 0.55)", cap_x="rgba(255, 255, 255, 0.30)",
               cap_xfg="rgba(30, 30, 34, 0.90)", cap_sep="rgba(255, 255, 255, 0.14)",
               cap_tip="rgba(40, 40, 44, 0.96)", cap_ink="1,1,1"),
    False: dict(cap_bg="rgba(236, 236, 238, 0.82)", cap_rim="rgba(255, 255, 255, 0.60)",
                cap_hover="rgba(0, 0, 0, 0.05)", cap_sel="rgba(0, 0, 0, 0.08)",
                cap_dim="rgba(0, 0, 0, 0.45)", cap_x="rgba(0, 0, 0, 0.45)",
                cap_xfg="rgba(255, 255, 255, 0.95)", cap_sep="rgba(0, 0, 0, 0.10)",
                cap_tip="rgba(236, 236, 238, 0.96)", cap_ink="0.30,0.30,0.32"),
}


def escuro():
    try:
        return "prefer-dark" in subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
            capture_output=True, text=True).stdout
    except OSError:
        return True


def vidro_real():
    """hyprglass carregado: a barra é vidro do compositor e só leva um véu leve."""
    try:
        return "hyprglass" in subprocess.run(["hyprctl", "plugin", "list"],
                                             capture_output=True, text=True).stdout
    except OSError:
        return False


def css(dark):
    c = dict(CORES[dark])
    if vidro_real():
        c["cap_bg"] = "rgba(255, 255, 255, 0.04)" if dark else "rgba(255, 255, 255, 0.42)"
    acc = "#0091FF" if dark else "#0088FF"
    try:
        with open(os.path.join(HERE, "..", "gtk", "accent3.css")) as f:
            m = __import__("re").search(r"@define-color\s+mac_accent\s+(#[0-9A-Fa-f]{6})", f.read())
            acc = m.group(1) if m else acc
    except OSError:
        pass
    head = "".join(f"@define-color {k} {v};\n" for k, v in c.items() if k != "cap_ink")
    head += f"@define-color cap_accent {acc};\n"
    return (head + CSS_BASE).encode()



def carregar():
    o = {"destino": "screenshots", "tempo": 0, "miniatura": True, "microfone": False, "modo": "region"}
    try:
        with open(CONF) as f:
            o.update(json.load(f))
    except (OSError, ValueError):
        pass
    return o


def salvar(o):
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            json.dump(o, f, indent=1)
    except OSError:
        pass


def pasta(destino, video=False):
    if destino == "desktop":
        return GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or os.path.expanduser("~/Desktop")
    if destino == "documents":
        return GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or os.path.expanduser("~/Documents")
    if video:   # "Capturas de Tela"/"Área de Transferência" não valem para vídeo → Filmes
        return GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_VIDEOS) or os.path.expanduser("~/Movies")
    return os.path.expanduser("~/Pictures/Screenshots")


# ── ícones (traço branco de 1,6, como os SF Symbols da barra) ──
def icone(modo, ink, largura=46):
    """Ícones da barra do Tahoe em contorno (captura-barra-opcoes.png): tela = moldura com a
    barra cheia embaixo; janela = moldura com os três pontos do semáforo; área = moldura
    tracejada; os de gravação levam o ponto de gravação (aro + disco) no canto inferior direito."""
    area = Gtk.DrawingArea()
    area.set_size_request(largura, 37)

    def draw(a, cr):
        W, H = a.get_allocated_width(), a.get_allocated_height()
        w, h = 28.0, 21.0
        rec = modo.startswith("rec-")
        x = (W - w) / 2 - (4 if rec else 0)
        y = (H - h) / 2
        base = modo[4:] if rec else modo
        cr.set_source_rgba(*ink, 0.85)
        cr.set_line_width(1.7)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if base == "region":
            cr.set_dash([3.6, 2.6])
            ret(cr, x + 0.85, y + 0.85, w - 1.7, h - 1.7, 3.5)
            cr.stroke()
            cr.set_dash([])
        else:
            ret(cr, x + 0.85, y + 0.85, w - 1.7, h - 1.7, 4)
            cr.stroke()
            if base == "screen":            # a faixa cheia embaixo da moldura
                cr.rectangle(x + 4, y + h - 7.5, w - 8, 3.4)
                cr.fill()
            else:                           # janela: os três pontos no canto
                for i in range(3):
                    cr.arc(x + 5 + i * 3.2, y + 5, 0.95, 0, 6.3)
                    cr.fill()
        if rec:                             # ponto de gravação: aro + disco, por cima da moldura
            cx, cy = x + w + 1, y + h - 1
            cr.set_operator(cairo.OPERATOR_CLEAR)
            cr.arc(cx, cy, 7.2, 0, 6.3)
            cr.fill()
            cr.set_operator(cairo.OPERATOR_OVER)
            cr.set_source_rgba(*ink, 0.85)
            cr.set_line_width(1.5)
            cr.arc(cx, cy, 5.6, 0, 6.3)
            cr.stroke()
            cr.arc(cx, cy, 3.6, 0, 6.3)
            cr.fill()
        return True
    area.connect("draw", draw)
    return area


def ret(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


class Barra:
    def __init__(self):
        self.o = carregar()
        self.dark = escuro()
        ink = tuple(float(v) for v in CORES[self.dark]["cap_ink"].split(","))
        prov = Gtk.CssProvider()
        prov.load_from_data(css(self.dark))
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        win = Gtk.Window()
        win.get_style_context().add_class("captura")
        vis = win.get_screen().get_rgba_visual()
        if vis:
            win.set_visual(vis)
        win.set_app_paintable(True)
        LS.init_for_window(win)
        LS.set_namespace(win, "hyprmac-captura-barra")
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.BOTTOM, True)
        LS.set_margin(win, LS.Edge.BOTTOM, 110)      # acima do Dock, como no Mac
        teste = os.environ.get("HYPRMAC_CAPTURA_TESTE")      # prints: sem teclado, fecha sozinha
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE if teste else LS.KeyboardMode.EXCLUSIVE)
        if teste:
            GLib.timeout_add(int(teste), lambda: Gtk.main_quit() or False)
        win.connect("key-press-event", self._tecla)
        self.win = win

        bar = Gtk.Box(spacing=2)
        bar.get_style_context().add_class("cap-bar")
        fechar = Gtk.Button()
        fechar.get_style_context().add_class("fechar")
        x = Gtk.Label(label="✕")
        x.set_valign(Gtk.Align.CENTER)
        x.get_style_context().add_class("x")
        fechar.add(x)
        fechar.set_tooltip_text("Close")
        fechar.connect("clicked", lambda _b: Gtk.main_quit())
        fechar.set_valign(Gtk.Align.CENTER)
        bar.pack_start(fechar, False, False, 0)
        self.modos = {}
        grupos = (
            (("screen", "Capture Entire Screen"), ("pick", "Capture Selected Window"),
             ("region", "Capture Selected Portion")),
            (("rec-screen", "Record Entire Screen"), ("rec-pick", "Record Selected Window"),
             ("rec-region", "Record Selected Portion")),
        )
        for gi_, grupo in enumerate(grupos):
            for j, (modo, dica) in enumerate(grupo):
                b = Gtk.Button()
                b.get_style_context().add_class("modo")
                if gi_ == 0 and j == 0:
                    b.get_style_context().add_class("primeiro")
                if modo.startswith("rec-"):
                    b.get_style_context().add_class("rec")
                b.set_valign(Gtk.Align.CENTER)
                b.add(icone(modo, ink, 56 if modo.startswith("rec-") else 46))
                b.set_tooltip_text(dica)
                b.connect("clicked", lambda _b, m=modo: self._modo(m))
                bar.pack_start(b, False, False, 0)
                self.modos[modo] = b
            bar.pack_start(self._sep(), False, False, 0)
        # "Opções" + chevron.down do SF (desenhado: o "⌄" da fonte fica caído na linha de base)
        opc = Gtk.Button()
        caixa = Gtk.Box(spacing=6)
        caixa.pack_start(Gtk.Label(label="Options"), False, False, 0)
        chev = Gtk.DrawingArea()
        chev.set_size_request(9, 9)
        chev.set_valign(Gtk.Align.CENTER)

        def _chev(a, cr):
            c = a.get_style_context().get_color(a.get_state_flags())
            cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
            cr.set_line_width(1.5)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            cr.move_to(1, 3)
            cr.line_to(4.5, 6.5)
            cr.line_to(8, 3)
            cr.stroke()
            return True
        chev.connect("draw", _chev)
        chev.get_style_context().add_class("chev")
        caixa.pack_start(chev, False, False, 0)
        opc.add(caixa)
        opc.set_valign(Gtk.Align.CENTER)
        opc.get_style_context().add_class("texto")
        opc.connect("clicked", self._opcoes)
        bar.pack_start(opc, False, False, 0)
        self.cap = Gtk.Button(label="Capture")
        self.cap.get_style_context().add_class("texto")
        self.cap.get_style_context().add_class("capturar")
        self.cap.connect("clicked", lambda _b: self.capturar())
        self.cap.set_valign(Gtk.Align.CENTER)
        bar.pack_start(self.cap, False, False, 0)
        win.add(bar)
        self._modo(self.o.get("modo", "region"))
        win.show_all()

    @staticmethod
    def _sep():
        s = Gtk.Box()
        s.get_style_context().add_class("cap-sep")
        s.set_valign(Gtk.Align.CENTER)
        return s

    def _modo(self, m):
        self.o["modo"] = m
        for k, b in self.modos.items():
            ctx = b.get_style_context()
            (ctx.add_class if k == m else ctx.remove_class)("selected")
        self.cap.set_label("Record" if m.startswith("rec-") else "Capture")

    def _opcoes(self, botao):
        m = Gtk.Menu()
        m.set_reserve_toggle_size(False)
        m.get_style_context().add_class("hyprmac-menu")

        def cab(t):
            it = Gtk.MenuItem(label=t)
            it.set_sensitive(False)
            m.append(it)

        def opc(t, marcado, acao):
            it = Gtk.MenuItem(label=("✓ " if marcado else "    ") + t)
            it.connect("activate", lambda _i: (acao(), salvar(self.o)))
            m.append(it)
        cab("Save to")
        for k, nome in DESTINOS:
            opc(nome, self.o["destino"] == k, lambda k=k: self.o.update(destino=k))
        m.append(Gtk.SeparatorMenuItem())
        cab("Timer")
        for s, nome in TEMPOS:
            opc(nome, self.o["tempo"] == s, lambda s=s: self.o.update(tempo=s))
        m.append(Gtk.SeparatorMenuItem())
        cab("Options")
        opc("Show Floating Thumbnail", self.o["miniatura"],
            lambda: self.o.update(miniatura=not self.o["miniatura"]))
        opc("Record Microphone", self.o.get("microfone", False),
            lambda: self.o.update(microfone=not self.o.get("microfone", False)))
        m.show_all()
        m.popup_at_widget(botao, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST, None)
        self._menu = m

    def _tecla(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
        elif ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.capturar()
        return True

    def capturar(self):
        salvar(self.o)
        modo = self.o["modo"]
        env = dict(os.environ)
        env["HYPRMAC_SHOT_THUMB"] = "1" if self.o["miniatura"] else "0"
        self.win.hide()
        if modo.startswith("rec-"):      # gravação de tela (scripts/gravacao)
            env["HYPRMAC_REC_DIR"] = pasta(self.o["destino"], video=True)
            env["HYPRMAC_REC_AUDIO"] = "1" if self.o.get("microfone") else "0"
            sub = {"rec-region": "region", "rec-pick": "pick"}.get(modo, "screen")
            GLib.timeout_add(250, lambda: (subprocess.Popen(
                [os.path.join(HERE, "gravacao"), sub], env=env, start_new_session=True),
                Gtk.main_quit()) and False)
            return
        env["HYPRMAC_SCREENSHOT_DIR"] = pasta(self.o["destino"])
        env["HYPRMAC_SHOT_CLIPBOARD"] = "1" if self.o["destino"] == "clipboard" else "0"
        env["HYPRMAC_SHOT_DELAY"] = str(self.o["tempo"])
        # deixa a barra sumir da tela antes da captura
        GLib.timeout_add(250, lambda: (subprocess.Popen(
            [os.path.join(HERE, "screenshot"), modo], env=env, start_new_session=True),
            Gtk.main_quit()) and False)


def main():
    # ⇧⌘5 de novo com a barra aberta: fecha
    try:
        with open(PIDFILE) as f:
            pid = int(f.read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"captura" in f.read():
                os.kill(pid, 15)
                return
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    try:
        Barra()
        Gtk.main()
    finally:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
