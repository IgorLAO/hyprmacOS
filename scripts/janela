#!/usr/bin/env python3
"""hyprmac — comandos de app no estilo macOS (atalhos e menu do app).

  janela quit-app      fecha todas as janelas do app em foco        (⌘Q)
  janela hide-app      oculta o app em foco (vai para o scratchpad) (⌘H)
  janela hide-others   oculta todos os outros apps da área atual    (⌥⌘H)
  janela show-all      traz de volta tudo o que estava oculto       (Show All)
  janela next-window   próxima janela do mesmo app                  (⌘`)
  janela prev-window   janela anterior do mesmo app                 (⇧⌘`)
  janela next-any      próxima janela de qualquer app, nas áreas visíveis   (⌃F4)
  janela prev-any      janela anterior de qualquer app, nas áreas visíveis  (⌃⇧F4)
  janela show-desktop  afasta as janelas da área atual para mostrar a mesa; de novo,
                       traz de volta                                (canto ativo "Desktop")

"Ocultar" usa o scratchpad (área especial "magic"), o mesmo do Window ▸ Minimize:
Super+S mostra o que foi ocultado.
"""
import json
import subprocess
import sys


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def clients():
    try:
        return json.loads(hypr("clients", "-j"))
    except ValueError:
        return []


def active():
    try:
        return json.loads(hypr("activewindow", "-j")) or {}
    except ValueError:
        return {}


def dispatch(lua):
    hypr("dispatch", lua)


def move_hidden(addr):
    # follow = false: some da tela sem abrir o scratchpad
    dispatch(f'hl.dsp.window.move({{ workspace = "special:magic", follow = false, window = "address:{addr}" }})')


def proxima(janelas, atual, passo):
    """Janela seguinte (passo 1) ou anterior (-1) em ordem fixa de abertura; sem
    janela atual na lista, a primeira (ou a última, voltando)."""
    janelas = sorted(janelas, key=lambda c: c.get("stableId", c["address"]))
    if not janelas:
        return None
    i = next((n for n, c in enumerate(janelas) if atual and c["address"] == atual.get("address")), None)
    if i is None:
        return janelas[0 if passo > 0 else -1]
    return janelas[(i + passo) % len(janelas)]


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    win = active()
    cls = win.get("class")
    if cmd == "quit-app" and cls:
        for c in clients():
            if c.get("class") == cls:
                dispatch(f'hl.dsp.window.close({{ window = "address:{c["address"]}" }})')
    elif cmd == "hide-app" and cls:
        for c in clients():
            if c.get("class") == cls and not c["workspace"]["name"].startswith("special"):
                move_hidden(c["address"])
    elif cmd == "hide-others" and cls:
        ws = win["workspace"]["id"]
        for c in clients():
            if c.get("class") != cls and c["workspace"]["id"] == ws:
                move_hidden(c["address"])
    elif cmd == "show-all":
        ws = json.loads(hypr("activeworkspace", "-j") or "{}").get("id", 1)
        for c in clients():
            if c["workspace"]["name"] == "special:magic":
                dispatch(f'hl.dsp.window.move({{ workspace = {ws}, follow = false, window = "address:{c["address"]}" }})')
    elif cmd == "show-desktop":
        # Mostrar Mesa do Mac: as janelas saem (área especial "mesa", uma por área de
        # trabalho) e voltam no mesmo lugar ao repetir
        ws = json.loads(hypr("activeworkspace", "-j") or "{}").get("id", 1)
        cs = clients()
        guardadas = [c for c in cs if c["workspace"]["name"] == f"special:mesa{ws}"]
        if guardadas:
            for c in guardadas:
                dispatch(f'hl.dsp.window.move({{ workspace = {ws}, follow = false, window = "address:{c["address"]}" }})')
        else:
            for c in cs:
                if c["workspace"]["id"] == ws:
                    dispatch(f'hl.dsp.window.move({{ workspace = "special:mesa{ws}", follow = false, window = "address:{c["address"]}" }})')
    elif cmd in ("next-window", "prev-window") and cls:
        # ordem fixa (a de abertura): repetir o atalho passa por todas as janelas
        # do app, como o ⌘` do Mac, em vez de alternar só entre as duas últimas
        mesmas = [c for c in clients() if c.get("class") == cls
                  and not c["workspace"]["name"].startswith("special")]
        alvo = proxima(mesmas, win, 1 if cmd == "next-window" else -1)
        if alvo and len(mesmas) > 1:
            dispatch(f'hl.dsp.focus({{ window = "address:{alvo["address"]}" }})')
    elif cmd in ("next-any", "prev-any"):
        # ⌃F4 / ⌃⇧F4 do Mac (HIG ▸ Keyboards): foco na janela ativa ou na próxima,
        # de qualquer app, nas áreas visíveis de todos os monitores
        visiveis = {m["activeWorkspace"]["id"] for m in json.loads(hypr("monitors", "-j") or "[]")}
        janelas = [c for c in clients() if c["workspace"]["id"] in visiveis and c.get("mapped", True)]
        alvo = proxima(janelas, win if win.get("address") else None, 1 if cmd == "next-any" else -1)
        if alvo:
            dispatch(f'hl.dsp.focus({{ window = "address:{alvo["address"]}" }})')
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
