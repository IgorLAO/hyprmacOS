#!/usr/bin/env bash
# hyprmac — mostra/esconde o scratchpad (área especial "magic").
# Vazio, o Hyprland o fecha na hora (misc:close_special_on_empty) e parecia que
# nada acontecia: aqui avisamos como guardar uma janela nele.
set -uo pipefail
n=$("$HOME/.local/bin/hyprmac-runtime" scratchpad-count)
if [ "${n:-0}" -gt 0 ]; then
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("magic")' >/dev/null
else
  notify-send -a "Scratchpad" -i view-restore "Scratchpad vazio" \
    "Use Window ▸ Minimize (ou Super+Shift+S) para guardar uma janela aqui."
fi
