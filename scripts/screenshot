#!/usr/bin/env bash
# hyprmac — capturas de tela no estilo macOS (grim + slurp)
#
#   screenshot region   seleciona uma área          (Print)
#   screenshot screen   monitor em foco             (Shift+Print)
#   screenshot window   janela ativa                (Ctrl+Print)
#   screenshot pick     clique numa janela para capturá-la (⇧⌘5 ▸ Janela)
#
# Opções por ambiente (usadas pela barra ⇧⌘5 e pelos atalhos com ⌃):
#   HYPRMAC_SCREENSHOT_DIR=<pasta>   onde salvar
#   HYPRMAC_SHOT_CLIPBOARD=1         só para a área de transferência (sem arquivo)
#   HYPRMAC_SHOT_THUMB=0             sem a miniatura flutuante
#   HYPRMAC_SHOT_DELAY=<s>           temporizador antes de capturar
#
# Salva em ~/Pictures/Screenshots como "Captura de Tela AAAA-MM-DD às HH.MM.SS.png"
# e copia para a área de transferência quando o wl-copy estiver disponível.

set -euo pipefail

mode="${1:-region}"
dir="${HYPRMAC_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$dir"
file="$dir/Captura de Tela $(date '+%Y-%m-%d às %H.%M.%S').png"
clip_only="${HYPRMAC_SHOT_CLIPBOARD:-0}"
[ "$clip_only" = 1 ] && file="${XDG_RUNTIME_DIR:-/tmp}/hyprmac-captura.png"

json_field() {  # json_field <hyprctl cmd> <python expr sobre d>
  hyprctl "$1" -j | python3 -c "import json,sys; d=json.load(sys.stdin); print($2)"
}

slurp_args=(-d -b '#0000004d' -c '#ffffffd9' -s '#ffffff14' -w 1 -F 'Inter Variable')

# a seleção vem antes do temporizador (como no Mac: escolhe, depois conta)
delay="${HYPRMAC_SHOT_DELAY:-0}"
espera() { [ "$delay" -gt 0 ] 2>/dev/null && sleep "$delay"; return 0; }

case "$mode" in
  pick)
    # retângulos das janelas visíveis: o slurp deixa escolher com um clique
    rects=$(hyprctl monitors -j | python3 -c "
import json, subprocess, sys
mons = json.load(sys.stdin)
ativas = {m['activeWorkspace']['id'] for m in mons} | {m['specialWorkspace']['id'] for m in mons}
cs = json.loads(subprocess.run(['hyprctl', 'clients', '-j'], capture_output=True, text=True).stdout)
for c in cs:
    if c['mapped'] and not c['hidden'] and c['workspace']['id'] in ativas:
        (x, y), (w, h) = c['at'], c['size']
        print(f'{x},{y} {w}x{h}')")
    geom=$(printf '%s\n' "$rects" | slurp -r "${slurp_args[@]}") || exit 0
    espera
    grim -g "$geom" "$file"
    ;;
  region)
    # Esc cancela a seleção sem erro
    geom=$(slurp "${slurp_args[@]}") || exit 0
    espera
    grim -g "$geom" "$file"
    ;;
  screen)
    mon=$(json_field monitors "next(m['name'] for m in d if m['focused'])")
    espera
    grim -o "$mon" "$file"
    ;;
  window)
    geom=$(json_field activewindow "f\"{d['at'][0]},{d['at'][1]} {d['size'][0]}x{d['size'][1]}\" if d else ''")
    [ -n "$geom" ] || exit 0
    grim -g "$geom" "$file"
    ;;
  *)
    echo "uso: $0 [region|screen|window]" >&2
    exit 2
    ;;
esac

# som do obturador com "Play user interface sound effects" ligado (Ajustes ▸ Som)
if [ -s "$file" ] && python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/hyprmac/config.json")
try: c=json.load(open(p))
except Exception: c={}
sys.exit(0 if c.get("ui_sound_effects", True) else 1)' 2>/dev/null; then
  setsid -f canberra-gtk-play -i screen-capture -d hyprmac-ui >/dev/null 2>&1
fi
if command -v wl-copy >/dev/null; then
  wl-copy --type image/png < "$file"
fi
if [ "$clip_only" = 1 ]; then      # ⌃: só área de transferência, sem arquivo nem miniatura
  rm -f "$file"
  exit 0
fi
[ "${HYPRMAC_SHOT_THUMB:-1}" = 0 ] && exit 0

# Miniatura flutuante no canto, como no macOS (clique = editar, arrastar = soltar
# o arquivo em outro app). Sem ela (GTK ausente), cai no aviso antigo.
setsid -f "$HOME/.local/bin/hyprmac-captura-miniatura" "$file" >/dev/null 2>&1 \
  || notify-send -a "Captura de Tela" -i "$file" -t 3000 \
       "Captura de Tela" "Salva em ${dir/#$HOME/\~}" 2>/dev/null &
