#!/usr/bin/python3
"""Configuração e diagnóstico pontuais dos extras SNI. Só "start" fica residente, como
supervisor da Waybar (relança a barra se ela cair)."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'hyprmac/menu-extras.json'
CACHE = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'hyprmac/waybar-tahoe'
WATCHER = 'org.kde.StatusNotifierWatcher'
INTERFACE = 'org.kde.StatusNotifierItem'


def call(dest, path, interface, method, args=None):
    from gi.repository import Gio
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return bus.call_sync(dest, path, interface, method, args, None,
                         Gio.DBusCallFlags.NONE, 2000, None).unpack()


def items():
    from gi.repository import GLib
    try:
        names = call(WATCHER, '/StatusNotifierWatcher', 'org.freedesktop.DBus.Properties',
                     'Get', GLib.Variant('(ss)', (WATCHER, 'RegisteredStatusNotifierItems')))[0]
    except GLib.Error:
        return []
    result = []
    for service in dict.fromkeys(names):
        bus, sep, tail = service.partition('/')
        path = '/' + tail if sep else '/StatusNotifierItem'
        try:
            props = call(bus, path, 'org.freedesktop.DBus.Properties', 'GetAll',
                         GLib.Variant('(s)', (INTERFACE,)))[0]
            result.append({'service': service, 'id': props.get('Id', ''),
                           'title': props.get('Title', ''), 'status': props.get('Status', ''),
                           'icon': props.get('IconName', ''), 'menu': props.get('Menu', ''),
                           'item_is_menu': props.get('ItemIsMenu', True)})
        except GLib.Error:
            continue  # application may disappear between snapshot and properties
    return result


def load():
    try:
        data = json.loads(CONFIG.read_text())
    except FileNotFoundError:
        data = {'tray': {'hidden-items': [], 'order-items': []}}
    if not isinstance(data, dict) or not isinstance(data.get('tray', {}), dict):
        raise ValueError('Configuração de extras inválida')
    data.setdefault('tray', {})
    for key in ['hidden-items', 'order-items']:
        value = data['tray'].get(key, [])
        if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
            raise ValueError(f'Lista inválida: {key}')
    return data


def save(data):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=CONFIG.parent, prefix='.menu-extras-')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write('\n')
        os.replace(name, CONFIG)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def pids():
    result = subprocess.run(['pgrep', '-u', str(os.getuid()), '-x', 'waybar'],
                            capture_output=True, text=True)
    alive = {}
    for entry in result.stdout.split():
        try:
            state = Path('/proc', entry, 'stat').read_text().rsplit(')', 1)[1].split()[0]
            if state != 'Z':
                alive[int(entry)] = int(Path("/proc", entry, "stat").read_text().rsplit(")", 1)[1].split()[1])
        except FileNotFoundError:
            pass
    return [pid for pid, parent in alive.items() if parent not in alive]


def start():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/hyprmac-{os.getuid()}'))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = os.open(runtime / 'hyprmac-waybar.lock', os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    pidfile = runtime / 'hyprmac-waybar.pid'
    try:
        owner = json.loads(pidfile.read_text())
        stat = Path('/proc', str(owner['pid']), 'stat').read_text().rsplit(')', 1)[1].split()
        if stat[0] != 'Z' and stat[19] == owner['starttime']:
            return
    except (FileNotFoundError, ValueError, KeyError, ProcessLookupError):
        pass
    if pids():
        return
    if not CONFIG.exists():
        save(load())
    binary = CACHE / 'waybar'
    if binary.exists():
        # Conflicting visible hosts cannot be hidden safely on somebody else's panel.
        names = call('org.freedesktop.DBus', '/org/freedesktop/DBus',
                     'org.freedesktop.DBus', 'ListNames')[0]
        hosts = [n for n in names if n.startswith('org.kde.StatusNotifierHost')]
        if hosts:
            print('Hosts SNI externos presentes (não removidos): ' + ', '.join(hosts), file=sys.stderr)
    else:
        from gi.repository import GLib
        try:
            call('org.freedesktop.DBus', '/org/freedesktop/DBus',
                 'org.freedesktop.DBus', 'GetNameOwner', GLib.Variant('(s)', (WATCHER,)))
        except GLib.Error:
            pass
        else:
            raise ValueError('O fallback upstream substituiria um watcher existente; compile a extensão.')
        binary = Path('/usr/bin/waybar')
        print('Tray upstream: sem filtros/ordem individual, attention/overlay ou estado menu-open. '
              'Execute scripts/build-waybar-extras.', file=sys.stderr)
    subprocess.run([str(ROOT / 'scripts/vidro'), 'sync-css'], check=True)
    starttime = Path('/proc/self/stat').read_text().rsplit(')', 1)[1].split()[19]
    pidfile.write_text(json.dumps({'pid': os.getpid(), 'starttime': starttime}))
    # CLOEXEC closes the lock in Waybar before it can leak to long-lived module children.
    os.set_inheritable(lock, False)
    supervise([str(binary)])


def supervise(cmd, run=subprocess.run, sleep=time.sleep, clock=time.monotonic):
    """Waybar como filho: crash (o mpris do Waybar dá SIGSEGV/SIGABRT quando um player some)
    relança a barra; encerramento pedido (TERM, INT, KILL, HUP) ou saída 0 termina junto.
    Mais de 5 crashes em 60 s: desiste, para não ficar em laço."""
    crashes = []
    while True:
        rc = run(cmd).returncode
        if rc == 0 or -rc in (signal.SIGTERM, signal.SIGINT, signal.SIGKILL, signal.SIGHUP):
            return rc
        now = clock()
        crashes = [t for t in crashes if now - t < 60] + [now]
        if len(crashes) > 5:
            print(f'waybar caiu {len(crashes)} vezes em 60 s; desistindo', file=sys.stderr)
            return rc
        print(f'waybar terminou ({rc}); relançando', file=sys.stderr)
        sleep(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    listing = sub.add_parser('list', help='Itens realmente registrados; não lista apps em execução')
    listing.add_argument('--json', action='store_true')
    for cmd in ['hide', 'show']:
        sub.add_parser(cmd).add_argument('identity', help='Id SNI exato; title:Título para Ids compartilhados')
    sub.add_parser('order').add_argument('identities', nargs='*', help='Ids da esquerda para a direita; demais seguem')
    sub.add_parser('diagnose')
    sub.add_parser('start')
    args = parser.parse_args()
    if args.command == 'start':
        start()
    elif args.command == 'list':
        current = items()
        if args.json:
            print(json.dumps(current, ensure_ascii=False))
        else:
            for it in current:
                print(f"{it['id']}\t{it['title']}\t{it['status']}\t{it['service']}")
    elif args.command == 'diagnose':
        print('Waybar PIDs:', pids())
        print('Extensão compilada:', (CACHE / 'waybar').exists())
        print('Configuração:', CONFIG)
        names = call('org.freedesktop.DBus', '/org/freedesktop/DBus',
                     'org.freedesktop.DBus', 'ListNames')[0]
        for n in sorted(names):
            if 'StatusNotifier' in n:
                print(n)
        print('Itens registrados:', len(items()))
    else:
        rust = ROOT / 'core/waybar-status/target/release/hyprmac-waybar'
        if rust.exists():
            identities = args.identities if args.command == 'order' else [args.identity]
            result = subprocess.run([str(rust), 'menu-extras-pref', args.command, *identities],
                                    env={**os.environ, 'HYPRMAC_MENU_EXTRAS_CONFIG': str(CONFIG)},
                                    capture_output=True, text=True)
            if result.returncode:
                raise ValueError(result.stderr.strip() or 'Falha ao salvar extras')
            if not (CACHE / 'waybar').exists():
                print('Preferência salva; requer scripts/build-waybar-extras.', file=sys.stderr)
            return
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        with CONFIG.with_suffix('.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = load()
            tray = data['tray']
            if args.command == 'order':
                tray['order-items'] = list(dict.fromkeys(args.identities))
            else:
                hidden = set(tray.get('hidden-items', []))
                (hidden.add if args.command == 'hide' else hidden.discard)(args.identity)
                tray['hidden-items'] = sorted(hidden)
            save(data)
        if not (CACHE / 'waybar').exists():
            print('Preferência salva; requer scripts/build-waybar-extras.', file=sys.stderr)
        # A extensão observa o arquivo; não reiniciar todos os menus/controles.


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        sys.exit(str(error))
