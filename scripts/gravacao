#!/usr/bin/env python3
"""hyprmac — gravação de tela da ferramenta ⇧⌘5 (como no macOS).

  gravacao screen   grava o monitor em foco
  gravacao region   grava uma área selecionada (slurp)
  gravacao pick     grava a janela escolhida com um clique
  gravacao stop      para a gravação em andamento

Enquanto grava, o aviso ⏹ aparece automaticamente na barra de menus; sem a
Waybar, aparece uma cápsula de vidro no alto. Clicar nele — ou ⇧⌘5 de novo, ou este
mesmo comando com `stop` — encerra e finaliza o arquivo. Ao terminar, a captura
aparece como miniatura flutuante no canto (clique = abrir, arrastar = soltar).

Depende do `wf-recorder`. Opções por ambiente (passadas pela barra ⇧⌘5):
  HYPRMAC_REC_DIR=<pasta>    onde salvar (padrão ~/Movies)
  HYPRMAC_REC_AUDIO=1        grava o microfone junto
  HYPRMAC_SHOT_THUMB=0       sem a miniatura flutuante
"""
import os
import signal
import subprocess
import sys
import time

import gi
import json

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402
from gi.repository import GtkLayerShell as LS  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PIDFILE = os.path.join(RUN, "hyprmac-gravacao.pid")
FILEMARK = os.path.join(RUN, "hyprmac-gravacao.arquivo")

CSS = b"""
window.gravacao { background: transparent; }
.rec-pill {
  border-radius: 999px;
  background-color: rgba(30, 30, 34, 0.80);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 4px 24px rgba(0, 0, 0, 0.30);
  padding: 5px 12px 5px 10px;
}
.rec-pill button {
  min-height: 26px; min-width: 26px; padding: 0; margin: 0;
  border-radius: 999px; border: none; background: transparent; box-shadow: none;
}
.rec-pill button:hover { background: rgba(255, 255, 255, 0.12); }
.rec-stop   { color: #FF383C; font-size: 18px; }
.rec-tempo  { font-family: "SF Pro"; font-size: 13px; font-weight: 600; color: #ffffff; margin-left: 2px; }
.rec-dot    { color: #FF383C; font-size: 11px; margin-right: 2px; }
"""


def destino():
    d = os.environ.get("HYPRMAC_REC_DIR")
    if not d:
        d = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_VIDEOS) or os.path.expanduser("~/Movies")
    os.makedirs(d, exist_ok=True)
    return d


def monitor_focado():
    try:
        import json
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                         capture_output=True, text=True).stdout)
        return next(m["name"] for m in mons if m.get("focused"))
    except Exception:
        return None


def parar_existente():
    """Encerra uma gravação em andamento (SIGINT para o wf-recorder finalizar o arquivo)."""
    try:
        with open(PIDFILE) as f:
            pid = int(f.read())
        os.kill(pid, signal.SIGTERM)   # o processo-controle finaliza o wf-recorder
        return True
    except (OSError, ValueError):
        return False


class Controle:
    """Processo que roda o wf-recorder e mostra o ⏹ na barra de menus."""

    def __init__(self, modo):
        self.proc = None
        self.arquivo = None
        self.inicio = None

        arquivo = os.path.join(
            destino(), time.strftime("Gravação de Tela %Y-%m-%d às %H.%M.%S.mp4"))
        cmd = ["wf-recorder", "-f", arquivo]
        if os.environ.get("HYPRMAC_REC_AUDIO") == "1":
            cmd.append("-a")

        if modo in ("region", "pick"):
            # pick (⇧⌘5 ▸ Gravar Janela Selecionada): o slurp oferece os retângulos das
            # janelas visíveis e um clique escolhe — o mesmo do "screenshot pick"
            args = ["slurp", "-b", "#0000004d", "-c", "#ffffffd9", "-s", "#ffffff14", "-w", "1"]
            entrada = None
            if modo == "pick":
                args.append("-r")
                entrada = janelas_visiveis()
            try:
                geom = subprocess.run(args, input=entrada, capture_output=True,
                                      text=True).stdout.strip()
            except FileNotFoundError:
                self._sem_ferramenta("slurp")
                return
            if not geom:
                raise SystemExit(0)      # Esc: cancela sem erro
            cmd += ["-g", geom]
        else:
            mon = monitor_focado()
            if mon:
                cmd += ["-o", mon]

        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            self._sem_ferramenta("wf-recorder")
            return

        self.arquivo = arquivo
        self.inicio = time.monotonic()
        with open(PIDFILE, "w") as f:
            f.write(str(os.getpid()))
        with open(FILEMARK, "w") as f:
            f.write(arquivo)
        # Com a Waybar, o controle de parada mora na barra; sem ela, usa a
        # cápsula própria para que a gravação nunca fique sem botão de parada.
        if subprocess.run(["pgrep", "-x", "waybar"], capture_output=True).returncode == 0:
            self._signal_bar()
        else:
            self._janela()
        for s in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, s, self.parar)
        GLib.timeout_add_seconds(1, self._watch_recorder)

    def _watch_recorder(self):
        """Retira o aviso se o gravador encerrar por erro ou por outra ação."""
        if self.proc.poll() is None:
            return True
        self.parar()
        return False

    @staticmethod
    def _sem_ferramenta(nome):
        subprocess.Popen(["notify-send", "-a", "Gravação de Tela",
                          "Gravação de Tela",
                          f"Instale o {nome} para gravar a tela (ex.: pacman -S {nome})."])
        raise SystemExit(1)

    def _janela(self):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        win = Gtk.Window()
        win.get_style_context().add_class("gravacao")
        vis = win.get_screen().get_rgba_visual()
        if vis:
            win.set_visual(vis)
        win.set_app_paintable(True)
        LS.init_for_window(win)
        LS.set_namespace(win, "hyprmac-captura")
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_anchor(win, LS.Edge.RIGHT, True)
        LS.set_margin(win, LS.Edge.TOP, 6)
        LS.set_margin(win, LS.Edge.RIGHT, 8)

        pill = Gtk.Box(spacing=4)
        pill.get_style_context().add_class("rec-pill")
        self.dot = Gtk.Label(label="●")
        self.dot.get_style_context().add_class("rec-dot")
        pill.pack_start(self.dot, False, False, 0)
        self.tempo = Gtk.Label(label="0:00")
        self.tempo.get_style_context().add_class("rec-tempo")
        pill.pack_start(self.tempo, False, False, 0)
        stop = Gtk.Button(label="⏹")
        stop.get_style_context().add_class("rec-stop")
        stop.set_tooltip_text("Parar Gravação")
        stop.connect("clicked", lambda _b: self.parar())
        pill.pack_start(stop, False, False, 0)
        win.add(pill)
        win.show_all()
        self.win = win
        # pisca o ponto e atualiza o cronômetro
        GLib.timeout_add(500, self._pisca)
        GLib.timeout_add(1000, self._tic)

    def _pisca(self):
        self.dot.set_opacity(0.3 if self.dot.get_opacity() > 0.6 else 1.0)
        return True

    def _tic(self):
        s = int(time.monotonic() - self.inicio)
        self.tempo.set_text(f"{s // 60}:{s % 60:02d}")
        return True

    def parar(self, *_):
        if self.proc and self.proc.poll() is None:
            self.proc.send_signal(signal.SIGINT)     # finaliza o .mp4
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        for p in (PIDFILE, FILEMARK):
            try:
                os.remove(p)
            except OSError:
                pass
        self._signal_bar()
        # miniatura flutuante com o primeiro quadro, como no Mac
        if self.arquivo and os.path.exists(self.arquivo) and os.environ.get("HYPRMAC_SHOT_THUMB") != "0":
            self._miniatura()
        Gtk.main_quit()
        return False

    @staticmethod
    def _signal_bar():
        subprocess.run(["pkill", "-RTMIN+13", "-x", "waybar"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _miniatura(self):
        poster = self.arquivo + ".png"
        try:
            subprocess.run(["ffmpeg", "-y", "-i", self.arquivo, "-vframes", "1", poster],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            poster = None
        if poster and os.path.exists(poster):
            subprocess.Popen([os.path.expanduser("~/.local/bin/hyprmac-captura-miniatura"), poster, "--abrir", self.arquivo],
                             start_new_session=True)
        else:
            subprocess.Popen(["notify-send", "-a", "Gravação de Tela", "Gravação de Tela",
                              "Salva em " + self.arquivo.replace(os.path.expanduser("~"), "~")])


def janelas_visiveis():
    """"x,y wxh" das janelas mapeadas nos workspaces visíveis (uma por linha)."""
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                         text=True).stdout)
        cs = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                       text=True).stdout)
    except (OSError, ValueError):
        return ""
    ativas = {m["activeWorkspace"]["id"] for m in mons} | {m["specialWorkspace"]["id"] for m in mons}
    out = []
    for c in cs:
        if c.get("mapped") and not c.get("hidden") and c["workspace"]["id"] in ativas:
            (x, y), (w, h) = c["at"], c["size"]
            out.append(f"{x},{y} {w}x{h}")
    return "\n".join(out) + "\n"


def main():
    modo = sys.argv[1] if len(sys.argv) > 1 else "screen"
    if modo == "stop":
        if not parar_existente():
            sys.stderr.write("nenhuma gravação em andamento\n")
        return
    if parar_existente():        # ⇧⌘5/gravar de novo enquanto grava: para e sai
        time.sleep(0.3)
        return
    Controle(modo)
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
